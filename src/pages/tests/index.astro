---
import AppLayout from '../../layouts/AppLayout.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
---

<AppLayout title="Tests disponibles" currentPage="tests">

  <div style="margin-bottom:1.25rem">
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
      <a href="/dashboard" style="color:var(--ui-text-3);text-decoration:none;transition:color 0.15s" onmouseover="this.style.color='var(--brand)'" onmouseout="this.style.color='var(--ui-text-3)'">Dashboard</a>
      <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Tests disponibles</span>
    </div>
    <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:10px">
      <div>
        <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Tests disponibles</h1>
        <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Selecciona un simulacro y comienza a practicar.</p>
      </div>
      <div style="display:flex;gap:8px">
        <div style="text-align:center;padding:8px 14px;background:var(--ui-card);border-radius:10px;border:1px solid var(--ui-border)">
          <p id="count-shown" style="font-size:1.25rem;font-weight:900;color:var(--brand);margin:0;line-height:1">0</p>
          <p style="font-size:0.625rem;color:var(--ui-text-3);margin:2px 0 0;font-weight:600;text-transform:uppercase;letter-spacing:0.4px">Tests</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div style="margin-bottom:1rem">
    <!-- Competence filters -->
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;align-items:center">
      <span style="font-size:0.6875rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin-right:2px">Competencia:</span>
      <button class="fpill active" data-comp="ALL">Todas</button>
      <button class="fpill" data-comp="lc" data-color="#D41224">Lectura Crítica</button>
      <button class="fpill" data-comp="rq" data-color="#2563EB">Razon. Cuantitativo</button>
      <button class="fpill" data-comp="cc" data-color="#059669">Comp. Ciudadanas</button>
      <button class="fpill" data-comp="ce" data-color="#7C3AED">Comun. Escrita</button>
      <button class="fpill" data-comp="en" data-color="#D97706">Inglés</button>
    </div>
    <!-- Mode filters -->
    <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
      <span style="font-size:0.6875rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin-right:2px">Modo:</span>
      <button class="fpill fpill-mode active" data-mode="ALL">Todos</button>
      <button class="fpill fpill-mode" data-mode="PRACTICE">Práctica</button>
      <button class="fpill fpill-mode" data-mode="EXAM">Examen</button>
      <button class="fpill fpill-mode" data-mode="TIMED">Cronometrado</button>
    </div>
  </div>

  <!-- Search -->
  <div style="position:relative;max-width:380px;margin-bottom:1.125rem">
    <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ui-text-3);pointer-events:none" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input id="test-search" type="text" placeholder="Buscar tests..."
      style="width:100%;padding:9px 14px 9px 36px;background:var(--ui-card);border:1.5px solid var(--ui-border);border-radius:11px;font-size:0.8125rem;color:var(--ui-text-1);font-family:inherit;outline:none;transition:border-color 0.2s"
      onfocus="this.style.borderColor='var(--brand)';this.style.boxShadow='0 0 0 3px rgba(212,18,36,0.1)'"
      onblur="this.style.borderColor='var(--ui-border)';this.style.boxShadow='none'">
  </div>

  <!-- Tests grid -->
  <div id="tests-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:12px"></div>
  <div id="empty-state" style="display:none">
    <div style="text-align:center;padding:3rem 1rem;color:var(--ui-text-3)">
      <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="display:block;margin:0 auto 12px"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="7" x2="11" y2="11"/><line x1="11" y1="15" x2="11.01" y2="15"/></svg>
      <p style="font-size:1rem;font-weight:700;color:var(--ui-text-1);margin:0 0 4px">Sin resultados</p>
      <p style="font-size:0.875rem">No hay tests que coincidan con tu búsqueda.</p>
    </div>
  </div>

  <!-- Confirm modal -->
  <div id="confirm-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:200;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
    <div style="background:var(--ui-card);border-radius:18px;padding:2rem;max-width:380px;width:calc(100% - 2rem);box-shadow:0 20px 60px rgba(0,0,0,0.2);animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
      <div style="width:52px;height:52px;background:#FEE2E2;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:1rem">
        <svg width="24" height="24" fill="none" stroke="#D41224" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </div>
      <h3 id="modal-title" style="font-size:1.0625rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem">¿Iniciar simulacro?</h3>
      <p id="modal-desc" style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.25rem;line-height:1.65"></p>
      <div style="display:flex;gap:8px">
        <button id="modal-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
        <button id="modal-confirm" style="flex:1;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(212,18,36,0.28)">Comenzar</button>
      </div>
    </div>
  </div>

</AppLayout>

<style>
  @keyframes modalIn { from { opacity:0; transform: scale(0.92); } to { opacity:1; transform: scale(1); } }

  .fpill {
    padding: 5px 14px; border-radius: 20px;
    font-size: 0.8125rem; font-weight: 700;
    border: 1.5px solid var(--ui-border); background: var(--ui-card); color: var(--ui-text-2);
    cursor: pointer; transition: all 0.15s; font-family: inherit; white-space: nowrap;
  }
  .fpill:hover { border-color: var(--brand); color: var(--brand); }
  .fpill.active { background: var(--brand); color: white; border-color: var(--brand); }

  .test-card {
    background: var(--ui-card); border-radius: 15px; border: 1px solid var(--ui-border);
    overflow: hidden; transition: all 0.2s;
  }
  .test-card:hover { border-color: var(--ui-border-2); transform: translateY(-2px); box-shadow: 0 8px 28px var(--ui-shadow-md); }
</style>

<script>
  import { requireAuth } from '../../lib/auth';
  import { testsApi }    from '../../lib/api/tests.api';
  import { triedsApi }   from '../../lib/api/trieds.api';
  import type { TestDto, TriedDto } from '../../lib/api/types';
  import { getCompStyle } from '../../lib/utils';
  import { TEST_MODE_BG, TEST_MODE_COLOR, TEST_MODE_LABEL } from '../../lib/constants';
  import { toast } from '../../lib/toast';

  try { requireAuth(); } catch { throw new Error('redirect'); }

  let allTests:   TestDto[]  = [];
  let allTrieds:  TriedDto[] = [];
  let filterComp = 'ALL';
  let filterMode = 'ALL';
  let searchStr  = '';
  let pendingStart: { testId: string; competenceId: string } | null = null;

  // Load skeleton
  function showSkeleton() {
    const grid = document.getElementById('tests-grid')!;
    grid.innerHTML = Array(6).fill(`
      <div style="background:var(--ui-card);border-radius:15px;border:1px solid var(--ui-border);overflow:hidden;">
        <div style="height:4px;background:var(--ui-border)"></div>
        <div style="padding:18px 20px">
          <div style="height:16px;background:var(--ui-surface);border-radius:6px;width:55%;margin-bottom:10px;animation:shimmer 1.5s infinite;background:linear-gradient(90deg,var(--ui-surface) 25%,var(--ui-border) 50%,var(--ui-surface) 75%);background-size:400px 100%"></div>
          <div style="height:12px;background:var(--ui-surface);border-radius:6px;width:80%;margin-bottom:16px;animation:shimmer 1.5s infinite;background:linear-gradient(90deg,var(--ui-surface) 25%,var(--ui-border) 50%,var(--ui-surface) 75%);background-size:400px 100%"></div>
          <div style="height:36px;background:var(--ui-surface);border-radius:9px;animation:shimmer 1.5s infinite;background:linear-gradient(90deg,var(--ui-surface) 25%,var(--ui-border) 50%,var(--ui-surface) 75%);background-size:400px 100%"></div>
        </div>
      </div>`).join('');
  }

  function render() {
    const grid  = document.getElementById('tests-grid')!;
    const empty = document.getElementById('empty-state')!;

    const filtered = allTests.filter(t => {
      const s = getCompStyle(t.competenceId, t.competenceName ?? '');
      return (filterComp === 'ALL' || s.key === filterComp)
          && (filterMode === 'ALL' || t.testMode === filterMode)
          && (!searchStr || t.testName.toLowerCase().includes(searchStr) || (t.competenceName ?? '').toLowerCase().includes(searchStr));
    });

    const countEl = document.getElementById('count-shown');
    if (countEl) countEl.textContent = String(filtered.length);

    if (filtered.length === 0) { grid.innerHTML = ''; empty.style.display = 'block'; return; }
    empty.style.display = 'none';
    grid.innerHTML = '';

    filtered.forEach(t => {
      const s       = getCompStyle(t.competenceId, t.competenceName ?? '');
      const durMin  = Math.floor(t.durationSeconds / 60);
      const myTrieds = allTrieds.filter(tr => tr.testId === t.testId && tr.status === 'FINISHED' && tr.score != null);
      const bestScore = myTrieds.length ? Math.max(...myTrieds.map(tr => tr.score ?? 0)) : null;
      const modeColor = TEST_MODE_COLOR[t.testMode] ?? '#6B7280';
      const modeBg    = TEST_MODE_BG[t.testMode]    ?? '#F3F4F6';
      const modeLabel = TEST_MODE_LABEL[t.testMode] ?? t.testMode;

      const card = document.createElement('div');
      card.className = 'test-card';
      card.innerHTML = `
        <div style="height:4px;background:linear-gradient(to right,${s.color},${s.color}66)"></div>
        <div style="padding:1.125rem 1.25rem">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:10px">
            <div style="display:flex;align-items:center;gap:10px;min-width:0">
              <div style="width:40px;height:40px;border-radius:11px;background:${s.bg};display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:900;color:${s.color}">${s.short}</div>
              <div style="min-width:0">
                <p style="font-size:0.625rem;font-weight:700;color:${s.color};text-transform:uppercase;letter-spacing:0.5px;margin:0 0 2px">${t.competenceName ?? t.competenceId}</p>
                <h3 style="font-size:0.875rem;font-weight:800;color:var(--ui-text-1);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px" title="${t.testName}">${t.testName}</h3>
              </div>
            </div>
            <span style="padding:4px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;background:${modeBg};color:${modeColor};flex-shrink:0;white-space:nowrap">${modeLabel}</span>
          </div>
          ${t.description ? `<p style="font-size:0.8125rem;color:var(--ui-text-2);line-height:1.6;margin:0 0 10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">${t.description}</p>` : ''}
          <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:10px">
            <span style="display:flex;align-items:center;gap:4px;font-size:0.75rem;color:var(--ui-text-3)">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              ${durMin} min
            </span>
            <span style="display:flex;align-items:center;gap:4px;font-size:0.75rem;color:var(--ui-text-3)">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              ${t.questionsToPresent ?? '?'} preguntas
            </span>
          </div>
          ${bestScore != null
            ? `<div style="padding:8px 10px;background:${s.bg};border-radius:8px;display:flex;align-items:center;justify-content:space-between"><span style="font-size:0.6875rem;font-weight:600;color:${s.color}">⭐ Mejor puntaje</span><strong style="font-size:1rem;color:${s.color}">${bestScore.toFixed(0)}/100</strong></div>`
            : `<div style="padding:8px 10px;background:var(--ui-surface);border-radius:8px;border:1px dashed var(--ui-border-2);font-size:0.6875rem;color:var(--ui-text-3)">Sin intentos aún</div>`}
        </div>
        <div style="padding:10px 20px;border-top:1px solid var(--ui-border);background:var(--ui-surface);display:flex;align-items:center;justify-content:space-between;gap:8px">
          <span style="font-size:0.8125rem;font-weight:700;color:${s.color}">${modeLabel}</span>
          <button class="test-start-btn" data-test-id="${t.testId}" data-comp-id="${t.competenceId}" data-name="${t.testName.replace(/"/g,'&quot;')}" data-dur="${durMin}" data-q="${t.questionsToPresent ?? '?'}"
            style="display:inline-flex;align-items:center;gap:5px;padding:8px 16px;border-radius:9px;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-size:0.8125rem;font-weight:700;border:none;cursor:pointer;box-shadow:0 3px 10px rgba(212,18,36,0.28);transition:all 0.15s;font-family:inherit">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            ${bestScore != null ? 'Reintentar' : 'Iniciar test'}
          </button>
        </div>`;
      grid.appendChild(card);
    });

    // Start button listeners
    grid.querySelectorAll<HTMLButtonElement>('.test-start-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        pendingStart = { testId: btn.dataset.testId!, competenceId: btn.dataset.compId! };
        const modal = document.getElementById('confirm-modal')!;
        const title = document.getElementById('modal-title')!;
        const desc  = document.getElementById('modal-desc')!;
        title.textContent = `¿Iniciar "${btn.dataset.name}"?`;
        desc.textContent  = `Duración: ${btn.dataset.dur} min · ${btn.dataset.q} preguntas. Se registrará un nuevo intento en tu historial.`;
        modal.style.display = 'flex';
      });
    });
  }

  // Filter handlers
  document.querySelectorAll<HTMLButtonElement>('.fpill:not(.fpill-mode)').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fpill:not(.fpill-mode)').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterComp = btn.dataset.comp ?? 'ALL';
      render();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.fpill-mode').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fpill-mode').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterMode = btn.dataset.mode ?? 'ALL';
      render();
    });
  });

  const searchInput = document.getElementById('test-search') as HTMLInputElement;
  searchInput.addEventListener('input', () => {
    searchStr = searchInput.value.toLowerCase().trim();
    render();
  });

  // Modal
  document.getElementById('modal-cancel')?.addEventListener('click', () => {
    document.getElementById('confirm-modal')!.style.display = 'none';
    pendingStart = null;
  });

  document.getElementById('modal-confirm')?.addEventListener('click', async () => {
    if (!pendingStart) return;
    document.getElementById('confirm-modal')!.style.display = 'none';
    const { testId, competenceId } = pendingStart;
    pendingStart = null;

    try {
      const res = await triedsApi.start(testId, competenceId);
      if (res.data) {
        toast.success('Intento iniciado', { description: `ID: ${res.data.triedId}` });
        window.location.href = `/tests/exam?tried=${res.data.triedId}&test=${testId}&comp=${competenceId}`;
      }
    } catch (err: any) {
      toast.error('No se pudo iniciar', { description: err?.message ?? 'Inténtalo de nuevo.' });
    }
  });

  // Init from URL param
  const urlComp = new URLSearchParams(window.location.search).get('c');
  if (urlComp) {
    filterComp = urlComp;
    document.querySelectorAll<HTMLButtonElement>('.fpill:not(.fpill-mode)').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.comp === urlComp || (urlComp === btn.dataset.comp));
    });
  }

  // Load data
  showSkeleton();
  Promise.allSettled([testsApi.findAll(0, 100), triedsApi.findMy(0, 200)]).then(([testsR, triedsR]) => {
    if (testsR.status === 'fulfilled' && testsR.value.data) allTests = testsR.value.data.content;
    if (triedsR.status === 'fulfilled' && triedsR.value.data) allTrieds = triedsR.value.data.content;
    render();
  });
</script>