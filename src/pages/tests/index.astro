---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Pruebas disponibles" currentPage="tests" requiredRole="STUDENT">

  <div style="margin-bottom:1.25rem">
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
      <a href="/dashboard" style="color:var(--ui-text-3);text-decoration:none" onmouseover="this.style.color='var(--brand)'" onmouseout="this.style.color='var(--ui-text-3)'">Panel de control</a>
      <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Pruebas disponibles</span>
    </div>
    <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:10px">
      <div>
        <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Pruebas disponibles</h1>
        <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Selecciona una prueba y comienza a practicar.</p>
      </div>
      <div style="text-align:center;padding:8px 14px;background:var(--ui-card);border-radius:10px;border:1px solid var(--ui-border)">
        <p id="count-shown" style="font-size:1.25rem;font-weight:900;color:var(--brand);margin:0;line-height:1">0</p>
        <p style="font-size:0.625rem;color:var(--ui-text-3);margin:2px 0 0;font-weight:600;text-transform:uppercase;letter-spacing:0.4px">Pruebas</p>
      </div>
    </div>
  </div>

  <!-- Filtros -->
  <div style="margin-bottom:1rem">
    <!-- Fila competencias -->
    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:8px">
      <span style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3);white-space:nowrap;flex-shrink:0">Competencia:</span>
      <button class="fpill active" id="pill-all-comp" data-comp="ALL">Todas</button>
      <div id="comp-pills-container" style="display:flex;gap:6px;flex-wrap:wrap"></div>
    </div>

    <!-- Fila modo -->
    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:10px">
      <span style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3);white-space:nowrap;flex-shrink:0">Modo:</span>
      <button class="fpill fpill-mode active" data-mode="ALL">Todos</button>
      <button class="fpill fpill-mode" data-mode="PRACTICE">Práctica</button>
      <button class="fpill fpill-mode" data-mode="EXAM">Examen</button>
      <button class="fpill fpill-mode" data-mode="TIMED">Cronometrado</button>
    </div>

    <!-- Búsqueda -->
    <div style="position:relative;max-width:380px;margin-bottom:1.125rem">
      <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ui-text-3);pointer-events:none" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="test-search" type="text" placeholder="Buscar tests..."
        style="width:100%;padding:9px 14px 9px 36px;background:var(--ui-card);border:1.5px solid var(--ui-border);border-radius:11px;font-size:0.8125rem;color:var(--ui-text-1);font-family:inherit;outline:none;transition:all 0.2s"
        onfocus="this.style.borderColor='var(--brand)';this.style.boxShadow='0 0 0 3px rgba(212,18,36,0.1)'"
        onblur="this.style.borderColor='var(--ui-border)';this.style.boxShadow='none'">
    </div>
  </div>

  <!-- Grid de tests -->
  <div id="tests-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:12px"></div>
  <div id="empty-state" style="display:none;text-align:center;padding:3rem 1rem;color:var(--ui-text-3)">
    <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="display:block;margin:0 auto 12px"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <p style="font-size:1rem;font-weight:700;color:var(--ui-text-1);margin:0 0 4px">Sin resultados</p>
    <p style="font-size:0.875rem">No hay tests que coincidan con tu búsqueda.</p>
  </div>

  <!-- Modal confirmar inicio - resumen completo del test -->
  <div id="confirm-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:200;align-items:center;justify-content:center;backdrop-filter:blur(5px);padding:1rem">
    <div style="background:var(--ui-card);border-radius:20px;padding:0;max-width:440px;width:100%;box-shadow:0 24px 64px rgba(0,0,0,0.25);animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both;overflow:hidden">
      <div id="modal-header" style="padding:1.5rem 1.5rem 1.25rem;border-bottom:1px solid var(--ui-border)">
        <div style="display:flex;align-items:center;gap:12px">
          <div id="modal-icon" style="width:48px;height:48px;border-radius:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <div>
            <p id="modal-comp" style="font-size:0.6875rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 2px;opacity:0.7"></p>
            <h3 id="modal-title" style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0;line-height:1.3"></h3>
          </div>
        </div>
      </div>
      <div style="padding:1.25rem 1.5rem">
        <div id="modal-metrics" style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:1rem"></div>
        <div id="modal-difficulty" style="margin-bottom:1rem"></div>
        <div id="modal-mode-desc" style="padding:10px 12px;background:var(--ui-surface);border-radius:10px;border:1px solid var(--ui-border);font-size:0.8125rem;color:var(--ui-text-2);line-height:1.55;margin-bottom:1rem"></div>
        <div style="display:flex;gap:8px">
          <button id="modal-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
          <button id="modal-confirm" style="flex:2;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(212,18,36,0.28)">
            <span id="modal-confirm-txt">▶ Comenzar</span>
          </button>
        </div>
      </div>
    </div>
  </div>

</AppLayout>

<!-- ↓ is:global para que aplique a elementos creados con JS -->
<style is:global>
  @keyframes modalIn  { from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)} }
  @keyframes shimmer  { 0%{background-position:-400px 0}100%{background-position:400px 0} }

  /* Pills de filtro */
  .fpill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 0.8125rem;
    font-weight: 600;
    border: 1.5px solid var(--ui-border);
    background: var(--ui-card);
    color: var(--ui-text-2);
    cursor: pointer;
    transition: all 0.18s;
    font-family: inherit;
    white-space: nowrap;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
  }
  .fpill:hover {
    border-color: var(--brand);
    color: var(--brand);
    background: rgba(212,18,36,0.04);
  }
  .fpill.active {
    background: var(--brand);
    color: white;
    border-color: var(--brand);
    box-shadow: 0 3px 10px rgba(212,18,36,0.25);
  }
  .fpill.active:hover { background: var(--brand-dark); }

  /* Punto de color para competencias */
  .fpill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .fpill.active .fpill-dot { transform: scale(1.2); filter: brightness(1.3); }

  /* Cards de test */
  .test-card {
    background: var(--ui-card);
    border-radius: 15px;
    border: 1px solid var(--ui-border);
    overflow: hidden;
    transition: all 0.2s;
  }
  .test-card:hover {
    border-color: var(--ui-border-2);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px var(--ui-shadow-md);
  }

  /* Botón iniciar test */
  .test-start-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px 16px;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--brand), var(--brand-dark));
    color: white;
    font-size: 0.8125rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(212,18,36,0.28);
    transition: all 0.15s;
    font-family: inherit;
  }
  .test-start-btn:hover {
    box-shadow: 0 5px 16px rgba(212,18,36,0.42);
    transform: translateY(-1px);
  }
</style>

<script>
  import { requireAuth } from '../../lib/auth';
  import { testsApi }    from '../../lib/api/tests.api';
  import { triedsApi }   from '../../lib/api/trieds.api';
  import type { TestDto, TriedDto } from '../../lib/api/types';
  import { getCompStyle } from '../../lib/utils';
  import { TEST_MODE_BG, TEST_MODE_COLOR, TEST_MODE_LABEL } from '../../lib/constants';
  import { toast } from '../../lib/toast';
  import { competencesApi } from '../../lib/api/competences.api';

  try { requireAuth(); } catch { throw new Error('redirect'); }

  let allTests:   TestDto[]  = [];
  let allTrieds:  TriedDto[] = [];
  let filterComp = 'ALL';
  let filterMode = 'ALL';
  let searchStr  = '';
  let pendingStart: { testId: string; testMode: string } | null = null;

  // Helpers multicompetencia: una prueba tiene varias competencias.
  const compsOf = (t: TestDto) => t.competences ?? [];
  const primaryStyle = (t: TestDto) => {
    const c = compsOf(t)[0];
    return c ? getCompStyle(c.competenceId, c.competenceName) : getCompStyle(t.testId, 'Prueba');
  };
  const compNames = (t: TestDto) => compsOf(t).map(c => c.competenceName).join(', ');

  // ── Skeleton ──────────────────────────────────────────────────────
  function showSkeleton() {
    const grid = document.getElementById('tests-grid')!;
    grid.innerHTML = Array(6).fill(`
      <div style="background:var(--ui-card);border-radius:15px;border:1px solid var(--ui-border);overflow:hidden">
        <div style="height:4px;background:var(--ui-border)"></div>
        <div style="padding:18px 20px">
          <div style="height:16px;background:linear-gradient(90deg,var(--ui-surface) 25%,var(--ui-border) 50%,var(--ui-surface) 75%);background-size:400px 100%;border-radius:6px;width:55%;margin-bottom:10px;animation:shimmer 1.5s infinite"></div>
          <div style="height:12px;background:linear-gradient(90deg,var(--ui-surface) 25%,var(--ui-border) 50%,var(--ui-surface) 75%);background-size:400px 100%;border-radius:6px;width:80%;margin-bottom:16px;animation:shimmer 1.5s infinite"></div>
          <div style="height:36px;background:linear-gradient(90deg,var(--ui-surface) 25%,var(--ui-border) 50%,var(--ui-surface) 75%);background-size:400px 100%;border-radius:9px;animation:shimmer 1.5s infinite"></div>
        </div>
      </div>`).join('');
  }

  // ── Pills de competencia ──────────────────────────────────────────
  function setActiveComp(key: string) {
    filterComp = key;
    // "Todas" pill
    const allPill = document.getElementById('pill-all-comp')!;
    allPill.classList.toggle('active', key === 'ALL');
    // Comp pills
    document.querySelectorAll<HTMLButtonElement>('.fpill-comp').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.comp === key);
    });
    render();
  }

  document.getElementById('pill-all-comp')?.addEventListener('click', () => setActiveComp('ALL'));

  // ── Cargar competencias y crear pills ─────────────────────────────
  competencesApi.findAll(true).then(res => {
    if (!res.data) return;
    const container = document.getElementById('comp-pills-container')!;
    container.innerHTML = '';

    res.data.forEach(comp => {
      const s = getCompStyle(comp.competenceId, comp.competenceName);
      const btn = document.createElement('button');
      btn.className = 'fpill fpill-comp';
      btn.dataset.comp = s.key;

      // Punto de color
      const dot = document.createElement('span');
      dot.className = 'fpill-dot';
      dot.style.background = s.color;

      // Texto
      const txt = document.createTextNode(comp.competenceName);

      btn.appendChild(dot);
      btn.appendChild(txt);
      btn.addEventListener('click', () => setActiveComp(s.key));
      container.appendChild(btn);
    });

    // Activar desde URL si hay parámetro
    const urlComp = new URLSearchParams(window.location.search).get('c');
    if (urlComp) setActiveComp(urlComp);
  }).catch(() => {});

  // ── Filtro modo ───────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.fpill-mode').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fpill-mode').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterMode = btn.dataset.mode ?? 'ALL';
      render();
    });
  });

  // ── Búsqueda ──────────────────────────────────────────────────────
  document.getElementById('test-search')?.addEventListener('input', e => {
    searchStr = (e.target as HTMLInputElement).value.toLowerCase().trim();
    render();
  });

  // ── Render ────────────────────────────────────────────────────────
  function render() {
    const grid  = document.getElementById('tests-grid')!;
    const empty = document.getElementById('empty-state')!;

    const filtered = allTests.filter(t => {
      const compMatch = filterComp === 'ALL'
        || compsOf(t).some(c => getCompStyle(c.competenceId, c.competenceName).key === filterComp);
      return compMatch
          && (filterMode === 'ALL' || t.testMode === filterMode)
          && (!searchStr || t.testName.toLowerCase().includes(searchStr) || compNames(t).toLowerCase().includes(searchStr));
    });

    const countEl = document.getElementById('count-shown');
    if (countEl) countEl.textContent = String(filtered.length);

    if (filtered.length === 0) { grid.innerHTML = ''; empty.style.display = 'block'; return; }
    empty.style.display = 'none';
    grid.innerHTML = '';

    filtered.forEach(t => {
      const s         = primaryStyle(t);
      // El icono usa las iniciales de la PRUEBA (no de la primera competencia).
      const testInitials = (t.testName ?? 'Prueba').trim().split(/\s+/)
        .map(w => w[0]).filter(Boolean).slice(0, 2).join('').toUpperCase() || 'PR';
      const durMin    = t.durationSeconds != null ? Math.floor(t.durationSeconds / 60) : null;
      const durLabel  = durMin != null ? `${durMin} min` : 'Sin límite';
      const myTrieds  = allTrieds.filter(tr => tr.testId === t.testId && tr.status === 'FINISHED' && tr.score != null);
      const bestScore = myTrieds.length ? Math.max(...myTrieds.map(tr => tr.score ?? 0)) : null;
      const inProgress = allTrieds.find(tr => tr.testId === t.testId && tr.status === 'IN_PROGRESS');
      const modeColor = TEST_MODE_COLOR[t.testMode] ?? '#6B7280';
      const modeBg    = TEST_MODE_BG[t.testMode]    ?? '#F3F4F6';
      const modeLabel = TEST_MODE_LABEL[t.testMode] ?? t.testMode;

      // Chips de TODAS las competencias de la prueba (multicompetencia).
      const compChips = compsOf(t).map(c => {
        const cs = getCompStyle(c.competenceId, c.competenceName);
        return `<span style="padding:2px 8px;border-radius:10px;font-size:0.625rem;font-weight:700;background:${cs.bg};color:${cs.color}">${c.competenceName}</span>`;
      }).join('') || '<span style="font-size:0.625rem;color:var(--ui-text-3)">Sin competencias</span>';

      const card = document.createElement('div');
      card.className = 'test-card';
      card.innerHTML = `
        <div style="height:4px;background:linear-gradient(to right,${s.color},${s.color}66)"></div>
        <div style="padding:1.125rem 1.25rem">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:8px">
            <div style="display:flex;align-items:center;gap:10px;min-width:0">
              <div style="width:40px;height:40px;border-radius:11px;background:${s.bg};display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:900;color:${s.color}">${testInitials}</div>
              <div style="min-width:0">
                <h3 style="font-size:0.875rem;font-weight:800;color:var(--ui-text-1);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px" title="${t.testName}">${t.testName}</h3>
              </div>
            </div>
            <span style="padding:4px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;background:${modeBg};color:${modeColor};flex-shrink:0;white-space:nowrap">${modeLabel}</span>
          </div>
          <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:10px">${compChips}</div>
          ${t.description ? `<p style="font-size:0.8125rem;color:var(--ui-text-2);line-height:1.6;margin:0 0 10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">${t.description}</p>` : ''}
          <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:10px">
            <span style="display:flex;align-items:center;gap:4px;font-size:0.75rem;color:var(--ui-text-3)">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              ${durLabel}
            </span>
            <span style="display:flex;align-items:center;gap:4px;font-size:0.75rem;color:var(--ui-text-3)">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"/></svg>
              ${t.questionsToPresent ?? t.questionCount ?? '?'} preguntas
            </span>
          </div>
          ${bestScore != null
            ? `<div style="padding:8px 10px;background:${s.bg};border-radius:8px;display:flex;align-items:center;justify-content:space-between"><span style="font-size:0.6875rem;font-weight:600;color:${s.color}">⭐ Mejor puntaje</span><strong style="font-size:1rem;color:${s.color}">${bestScore.toFixed(0)} pts</strong></div>`
            : `<div style="padding:8px 10px;background:var(--ui-surface);border-radius:8px;border:1px dashed var(--ui-border-2);font-size:0.6875rem;color:var(--ui-text-3)">Sin intentos aún</div>`}
        </div>
        <div style="padding:10px 20px;border-top:1px solid var(--ui-border);background:var(--ui-surface);display:flex;align-items:center;justify-content:space-between;gap:8px">
          <span style="font-size:0.8125rem;font-weight:700;color:${s.color}">${modeLabel}</span>
          ${inProgress
            ? `<a class="test-resume-btn" href="/tests/exam?tried=${inProgress.triedId}&test=${t.testId}&mode=${t.testMode}"
                 style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:9px;background:linear-gradient(135deg,#D97706,#B45309);color:#fff;font-size:0.8125rem;font-weight:700;text-decoration:none">
                 <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg> Reanudar
               </a>`
            : `<button class="test-start-btn"
            data-test-id="${t.testId}"
            data-mode="${t.testMode}"
            data-name="${t.testName.replace(/"/g,'&quot;')}"
            data-dur="${durMin ?? ''}"
            data-q="${t.questionsToPresent ?? t.questionCount ?? '?'}"
            data-color="${s.color}"
            data-comp-name="${compNames(t).replace(/"/g,'&quot;')}"
            data-diff-b="${t.difficultyBreakdown?.B ?? 0}"
            data-diff-m="${t.difficultyBreakdown?.M ?? 0}"
            data-diff-a="${t.difficultyBreakdown?.A ?? 0}"
            data-diff-na="${(t.difficultyBreakdown as any)?.NA ?? 0}">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            ${bestScore != null ? 'Reintentar' : 'Iniciar test'}
          </button>`}
        </div>`;
      grid.appendChild(card);
    });

    // Listeners botones de inicio
    grid.querySelectorAll<HTMLButtonElement>('.test-start-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        pendingStart = {
          testId: btn.dataset.testId!,
          testMode: btn.dataset.mode!
        };
        openTestModal(btn);
      });
    });
  }

  const MODE_DESC: Record<string, string> = {
    PRACTICE: '📚 Modo práctica - sin presión de tiempo. Revisa tus respuestas y aprende a tu ritmo.',
    EXAM:     '📝 Modo examen - simula las condiciones reales del Saber Pro. Tiempo límite definido.',
    TIMED:    '⏱ Modo cronometrado - responde tan rápido como puedas. El tiempo corre desde el inicio.',
  };

  function openTestModal(btn: HTMLButtonElement) {
    const name  = btn.dataset.name ?? 'Test';
    const dur   = Number(btn.dataset.dur ?? 0);
    const q     = btn.dataset.q ?? '?';
    const mode  = btn.dataset.mode ?? 'PRACTICE';
    const comp  = btn.dataset.compName ?? '';
    const color = btn.dataset.color ?? '#D41224';
    const diffB  = Number(btn.dataset.diffB ?? 0);
    const diffM  = Number(btn.dataset.diffM ?? 0);
    const diffA  = Number(btn.dataset.diffA ?? 0);
    const diffNA = Number(btn.dataset.diffNa ?? 0);
    const total = Number(q) || (diffB + diffM + diffA + diffNA);

    (document.getElementById('modal-comp') as HTMLElement).textContent = comp;
    (document.getElementById('modal-comp') as HTMLElement).style.color = color;
    (document.getElementById('modal-title') as HTMLElement).textContent = name;
    const iconWrap = document.getElementById('modal-icon')!;
    iconWrap.style.background = color + '1A';
    iconWrap.style.color = color;

    const secPerQ = total > 0 ? Math.round(dur * 60 / total) : 0;
    (document.getElementById('modal-metrics') as HTMLElement).innerHTML = [
      { label:'Duración',     val: dur > 0 ? `${dur} min` : 'Sin límite', icon:'🕐' },
      { label:'Preguntas',    val:q,            icon:'📋' },
      { label:'Seg/pregunta', val: secPerQ > 0 ? `~${secPerQ}s` : '-', icon:'⚡' },
    ].map(m => `
      <div style="text-align:center;padding:10px 6px;background:var(--ui-surface);border-radius:10px;border:1px solid var(--ui-border)">
        <p style="font-size:1rem;margin:0 0 2px">${m.icon}</p>
        <p style="font-size:1.125rem;font-weight:900;color:var(--ui-text-1);margin:0;line-height:1">${m.val}</p>
        <p style="font-size:0.5625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:2px 0 0">${m.label}</p>
      </div>`).join('');

    const diffEl = document.getElementById('modal-difficulty')!;
    if (diffB + diffM + diffA + diffNA > 0) {
      diffEl.innerHTML = `
        <p style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--ui-text-3);margin:0 0 6px">Distribución de dificultad</p>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
          ${diffB  > 0 ? `<span style="padding:4px 10px;border-radius:20px;font-size:0.75rem;font-weight:700;background:#D1FAE5;color:#059669">✓ Básico ×${diffB}</span>` : ''}
          ${diffM  > 0 ? `<span style="padding:4px 10px;border-radius:20px;font-size:0.75rem;font-weight:700;background:#FEF3C7;color:#D97706">◆ Medio ×${diffM}</span>` : ''}
          ${diffA  > 0 ? `<span style="padding:4px 10px;border-radius:20px;font-size:0.75rem;font-weight:700;background:#FEE2E2;color:#DC2626">▲ Alto ×${diffA}</span>` : ''}
          ${diffNA > 0 ? `<span style="padding:4px 10px;border-radius:20px;font-size:0.75rem;font-weight:700;background:#F3F4F6;color:#6B7280">● Sin dificultad ×${diffNA}</span>` : ''}
        </div>
        <div style="display:flex;height:6px;border-radius:3px;overflow:hidden;margin-top:8px;gap:2px">
          ${diffB  > 0 ? `<div style="flex:${diffB};background:#059669;border-radius:3px"></div>` : ''}
          ${diffM  > 0 ? `<div style="flex:${diffM};background:#D97706;border-radius:3px"></div>` : ''}
          ${diffA  > 0 ? `<div style="flex:${diffA};background:#DC2626;border-radius:3px"></div>` : ''}
          ${diffNA > 0 ? `<div style="flex:${diffNA};background:#9CA3AF;border-radius:3px"></div>` : ''}
        </div>`;
      diffEl.style.display = 'block';
    } else { diffEl.style.display = 'none'; }

    (document.getElementById('modal-mode-desc') as HTMLElement).textContent =
      MODE_DESC[mode] ?? 'Prueba disponible. ¡Mucho éxito!';

    (document.getElementById('modal-confirm-txt') as HTMLElement).textContent = '▶ Comenzar';
    (document.getElementById('modal-confirm') as HTMLButtonElement).disabled = false;
    document.getElementById('confirm-modal')!.style.display = 'flex';
  }

  // ── Modal ─────────────────────────────────────────────────────────
  document.getElementById('modal-cancel')?.addEventListener('click', () => {
    document.getElementById('confirm-modal')!.style.display = 'none';
    pendingStart = null;
  });
  document.getElementById('confirm-modal')?.addEventListener('click', e => {
    if (e.target === document.getElementById('confirm-modal')) {
      document.getElementById('confirm-modal')!.style.display = 'none';
      pendingStart = null;
    }
  });
  document.getElementById('modal-confirm')?.addEventListener('click', async () => {
    if (!pendingStart) return;
    const { testId, testMode } = pendingStart;
    document.getElementById('confirm-modal')!.style.display = 'none';
    (document.getElementById('modal-confirm') as HTMLButtonElement).disabled = true;
    (document.getElementById('modal-confirm-txt') as HTMLElement).textContent = 'Iniciando...';
    pendingStart = null;
    (window as any).rpLoader?.show('Verificando acceso...');
    const restoreBtn = () => {
      (window as any).rpLoader?.hide();
      (document.getElementById('modal-confirm') as HTMLButtonElement).disabled = false;
      (document.getElementById('modal-confirm-txt') as HTMLElement).textContent = '▶ Comenzar';
    };
    try {
      // 1. ¿Puede entrar?
      const elig = await triedsApi.eligibility(testId);
      if (!elig.data?.allowed) {
        restoreBtn();
        toast.error('No puedes entrar a esta prueba', { description: elig.data?.reason ?? 'Prueba no disponible.' });
        return;
      }
      // 2. Reanudar intento activo si existe
      if (elig.data.inProgressTriedId) {
        (window as any).rpLoader?.show('Reanudando tu intento...');
        window.location.href = `/tests/exam?tried=${elig.data.inProgressTriedId}&test=${testId}&mode=${testMode}`;
        return;
      }
      // 3. Iniciar intento nuevo
      (window as any).rpLoader?.show('Preparando la prueba...');
      const res = await triedsApi.start(testId);
      if (res.data) {
        (window as any).rpLoader?.show('Cargando preguntas...');
        window.location.href = `/tests/exam?tried=${res.data.triedId}&test=${testId}&mode=${testMode}`;
      }
    } catch (err: any) {
      restoreBtn();
      toast.error('No se pudo iniciar', { description: err?.message ?? 'Inténtalo de nuevo.' });
    }
  });

  // ── Carga inicial ─────────────────────────────────────────────────
  showSkeleton();
  Promise.allSettled([testsApi.findAll(0, 100), triedsApi.findMy(0, 200)]).then(([testsR, triedsR]) => {
    if (testsR.status === 'fulfilled' && testsR.value.data) allTests = testsR.value.data.content;
    if (triedsR.status === 'fulfilled' && triedsR.value.data) allTrieds = triedsR.value.data.content;
    render();
  });
</script>