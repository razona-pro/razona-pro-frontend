---
export const prerender = false;
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Simulacro en curso" currentPage="tests">
  <!-- Header del exam -->
  <div id="exam-header" style="display:none">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:1.25rem">
      <div>
        <p id="exam-competence" style="font-size:0.75rem;font-weight:700;color:var(--brand);text-transform:uppercase;letter-spacing:0.05em;margin:0 0 4px"></p>
        <h1 id="exam-title" style="font-size:1.5rem;font-weight:900;color:var(--ui-text-1);margin:0;letter-spacing:-0.5px"></h1>
      </div>
      <div style="display:flex;align-items:center;gap:10px">
        <div id="timer-chip" style="display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:20px;background:var(--ui-card);border:1.5px solid var(--ui-border);font-size:0.875rem;font-weight:700;color:var(--ui-text-1)">
          <span>⏱</span><span id="timer-display">00:00</span>
        </div>
      </div>
    </div>

    <!-- Barra de progreso -->
    <div style="margin-bottom:1.5rem">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <span id="progress-label" style="font-size:0.75rem;font-weight:600;color:var(--ui-text-3)"></span>
        <span id="answered-label" style="font-size:0.75rem;font-weight:600;color:var(--ui-text-3)"></span>
      </div>
      <div style="height:6px;background:var(--ui-border);border-radius:10px;overflow:hidden">
        <div id="progress-bar" style="height:100%;background:linear-gradient(to right,var(--brand),var(--brand-dark));border-radius:10px;transition:width 0.3s ease;width:0%"></div>
      </div>
    </div>
  </div>

  <!-- Loading inicial -->
  <div id="exam-loading" style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:5rem;gap:1rem">
    <div style="width:48px;height:48px;border-radius:50%;border:3px solid rgba(212,18,36,0.15);border-top-color:#D41224;animation:spin 0.85s linear infinite"></div>
    <p style="font-size:0.875rem;color:var(--ui-text-3)">Iniciando simulacro...</p>
  </div>

  <!-- Tarjeta de pregunta -->
  <div id="question-card" style="display:none;background:var(--ui-card);border-radius:18px;border:1px solid var(--ui-border);overflow:hidden">
    <!-- Stripe top -->
    <div style="height:4px;background:linear-gradient(to right,var(--brand),var(--brand-dark))"></div>

    <div style="padding:1.5rem 1.75rem">
      <!-- Metadata de pregunta -->
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:1.25rem">
        <span id="q-number-badge" style="font-size:0.6875rem;font-weight:800;color:var(--brand);background:var(--brand-pale);padding:3px 12px;border-radius:20px;border:1.5px solid rgba(212,18,36,0.2)"></span>
        <span id="q-diff-badge" style="padding:3px 12px;border-radius:20px;font-size:0.6875rem;font-weight:700"></span>
        <span id="q-answered-badge" style="display:none;padding:3px 12px;border-radius:20px;font-size:0.6875rem;font-weight:700;background:#D1FAE5;color:#059669;border:1px solid #A7F3D0">✓ Respondida</span>
      </div>

      <!-- Enunciado -->
      <div id="q-statement" style="font-size:0.9375rem;color:var(--ui-text-1);line-height:1.85;margin-bottom:1.5rem;font-weight:500;padding:16px 18px;background:var(--ui-surface);border-radius:12px;border:1px solid var(--ui-border)"></div>

      <!-- Opciones -->
      <div id="options-container" style="display:flex;flex-direction:column;gap:8px"></div>

      <!-- Hint cambio de respuesta -->
      <p id="change-hint" style="display:none;font-size:0.75rem;color:var(--ui-text-3);margin:10px 0 0;text-align:center">
        💡 Puedes cambiar tu respuesta antes de pasar a la siguiente pregunta
      </p>
    </div>
  </div>

  <!-- Navegación -->
  <div id="exam-nav" style="display:none;margin-top:1.25rem;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
    <button id="btn-prev" onclick="handlePrev()" style="display:flex;align-items:center;gap:6px;padding:0.75rem 1.25rem;border-radius:12px;border:1.5px solid var(--ui-border);background:var(--ui-card);color:var(--ui-text-2);font-weight:600;font-size:0.875rem;cursor:pointer;font-family:inherit;transition:all 0.15s">
      ← Anterior
    </button>

    <div style="display:flex;align-items:center;gap:8px">
      <!-- Indicadores mini -->
      <div id="dot-nav" style="display:flex;gap:4px;flex-wrap:wrap;max-width:240px;justify-content:center"></div>
    </div>

    <button id="btn-next" onclick="handleNext()" style="display:flex;align-items:center;gap:6px;padding:0.75rem 1.5rem;border-radius:12px;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-weight:700;font-size:0.875rem;cursor:pointer;border:none;font-family:inherit;transition:opacity 0.15s">
      Siguiente →
    </button>
  </div>

  <!-- Modal resumen final -->
  <div id="summary-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:100;display:flex;align-items:center;justify-content:center;padding:1rem">
    <div style="background:var(--ui-card);border-radius:20px;padding:2rem;max-width:420px;width:100%;border:1px solid var(--ui-border)">
      <h2 style="font-size:1.375rem;font-weight:900;color:var(--ui-text-1);margin:0 0 6px;text-align:center">¿Finalizar simulacro?</h2>
      <p style="font-size:0.875rem;color:var(--ui-text-3);text-align:center;margin:0 0 1.5rem">Revisa tu progreso antes de confirmar</p>

      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:1.5rem">
        <div style="text-align:center;padding:14px 10px;background:var(--ui-surface);border-radius:12px;border:1px solid var(--ui-border)">
          <p id="summary-answered" style="font-size:1.75rem;font-weight:900;color:#059669;margin:0;line-height:1">0</p>
          <p style="font-size:0.6875rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;margin:4px 0 0">Respondidas</p>
        </div>
        <div style="text-align:center;padding:14px 10px;background:var(--ui-surface);border-radius:12px;border:1px solid var(--ui-border)">
          <p id="summary-pending" style="font-size:1.75rem;font-weight:900;color:#D97706;margin:0;line-height:1">0</p>
          <p style="font-size:0.6875rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;margin:4px 0 0">Pendientes</p>
        </div>
        <div style="text-align:center;padding:14px 10px;background:var(--ui-surface);border-radius:12px;border:1px solid var(--ui-border)">
          <p id="summary-total" style="font-size:1.75rem;font-weight:900;color:var(--ui-text-1);margin:0;line-height:1">0</p>
          <p style="font-size:0.6875rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;margin:4px 0 0">Total</p>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:8px">
        <button id="btn-confirm-finish" onclick="confirmFinish()" style="width:100%;padding:0.875rem;border-radius:12px;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-weight:700;font-size:0.9375rem;border:none;cursor:pointer;font-family:inherit">
          Finalizar y ver resultados
        </button>
        <button onclick="closeSummary()" style="width:100%;padding:0.875rem;border-radius:12px;border:1.5px solid var(--ui-border);background:var(--ui-card);color:var(--ui-text-2);font-weight:600;font-size:0.875rem;cursor:pointer;font-family:inherit">
          Seguir respondiendo
        </button>
      </div>
    </div>
  </div>
</AppLayout>

<style is:global>
  @keyframes spin { to { transform: rotate(360deg); } }

  .opt-btn {
    display: flex; align-items: stretch;
    border-radius: 12px; border: 2px solid var(--ui-border);
    background: var(--ui-card); cursor: pointer;
    transition: all 0.15s; overflow: hidden; width: 100%;
    font-family: inherit;
  }
  .opt-btn:hover:not(.selected) { border-color: var(--brand); transform: translateX(2px); }
  .opt-btn.selected { border-color: var(--brand); background: var(--brand-pale); }

  .opt-letter {
    min-width: 44px; width: 44px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.8125rem; font-weight: 800; color: var(--ui-text-3);
    background: var(--ui-surface); flex-shrink: 0;
    border-right: 2px solid var(--ui-border);
    transition: all 0.15s;
  }
  .opt-btn.selected .opt-letter { background: var(--brand); color: white; border-color: var(--brand); }

  .opt-text {
    flex: 1; padding: 0.875rem 1rem;
    font-size: 0.875rem; line-height: 1.65;
    color: var(--ui-text-2); text-align: left;
    transition: color 0.15s;
  }
  .opt-btn.selected .opt-text { color: var(--ui-text-1); font-weight: 600; }

  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ui-border); transition: all 0.2s; flex-shrink: 0; }
  .dot.answered { background: #059669; }
  .dot.current { background: var(--brand); transform: scale(1.4); }
  .dot.current.answered { background: var(--brand); }

  #summary-modal[style*="flex"] { display: flex !important; }
  #summary-modal[style*="none"] { display: none !important; }

  @media (max-width: 500px) {
    #dot-nav { display: none; }
  }
</style>

<script>
  import { requireAuth } from '../../lib/auth';
  import { triedsApi }  from '../../lib/api/trieds.api';
  import { toast }      from '../../lib/toast';

  try { requireAuth(); } catch { window.location.replace('/auth/login'); }

  // ── Constantes ─────────────────────────────────────────
  const UNANSWERED_ID = 'OTN000';
  const LETTERS = ['A','B','C','D','E','F','G'];
  const DIFF_LABEL: Record<string,string> = { B:'Básico', M:'Medio', A:'Alto' };
  const DIFF_COLOR: Record<string,string> = { B:'#059669', M:'#D97706', A:'#D41224' };
  const DIFF_BG:    Record<string,string> = { B:'#D1FAE5', M:'#FEF3C7', A:'#FEE2E2' };

  // ── Estado ──────────────────────────────────────────────
  let triedId       = '';
  let questions: any[] = [];
  let currentIndex  = 0;
  let selectedOptions: Record<string, string> = {};   // { questionId: optionId } — solo local hasta navegar
  let savedOptions:    Record<string, string> = {};   // lo que ya fue guardado en backend
  let timerInterval: any = null;
  let elapsedSeconds = 0;
  let isSaving = false;
  let isFinishing = false;

  // ── Helpers DOM ─────────────────────────────────────────
  const $ = (id: string) => document.getElementById(id)!;

  function renderText(el: HTMLElement, raw: string) {
    el.innerHTML = '';
    (raw || '').replace(/\\n/g, '\n').split('\n').forEach((line, i) => {
      if (i > 0) el.appendChild(document.createElement('br'));
      if (line.trim()) el.appendChild(document.createTextNode(line));
    });
  }

  // ── Timer ───────────────────────────────────────────────
  function startTimer() {
    timerInterval = setInterval(() => {
      elapsedSeconds++;
      const m = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
      const s = String(elapsedSeconds % 60).padStart(2, '0');
      $('timer-display').textContent = `${m}:${s}`;
    }, 1000);
  }

  // ── Render pregunta ─────────────────────────────────────
  function renderQuestion(idx: number) {
    currentIndex = idx;
    const q = questions[idx];
    if (!q) return;

    // Badges
    $('q-number-badge').textContent = `Pregunta ${idx + 1} de ${questions.length}`;

    const diffBadge = $('q-diff-badge') as HTMLElement;
    diffBadge.textContent = DIFF_LABEL[q.difficultyLevel] ?? q.difficultyLevel;
    diffBadge.style.background = DIFF_BG[q.difficultyLevel] ?? '#F3F4F6';
    diffBadge.style.color = DIFF_COLOR[q.difficultyLevel] ?? '#6B7280';

    // Badge "Respondida"
    const answeredBadge = $('q-answered-badge') as HTMLElement;
    const isSaved = !!savedOptions[q.questionId];
    answeredBadge.style.display = isSaved ? 'inline-flex' : 'none';

    // Enunciado
    const stmtEl = $('q-statement');
    renderText(stmtEl, q.statement ?? q.questionStatement ?? '');

    // Opciones — excluir OTN000
    const visibleOptions = (q.options ?? []).filter((o: any) => o.optionId !== UNANSWERED_ID);
    const container = $('options-container');
    container.innerHTML = '';

    visibleOptions.forEach((opt: any, oi: number) => {
      const isSelected = selectedOptions[q.questionId] === opt.optionId;
      const btn = document.createElement('button');
      btn.className = `opt-btn${isSelected ? ' selected' : ''}`;
      btn.innerHTML = `
        <div class="opt-letter">${LETTERS[oi] ?? String(oi + 1)}</div>
        <div class="opt-text"></div>
      `;
      (btn.querySelector('.opt-text') as HTMLElement).textContent = opt.optionText;
      btn.onclick = () => handleSelectOption(q.questionId, opt.optionId);
      container.appendChild(btn);
    });

    // Hint cambio
    const hint = $('change-hint') as HTMLElement;
    hint.style.display = selectedOptions[q.questionId] ? 'block' : 'none';

    // Navegación
    updateNav(idx);
    updateProgress();
  }

  function handleSelectOption(questionId: string, optionId: string) {
    // Solo actualizar estado local + UI — NO llamar API todavía
    selectedOptions[questionId] = optionId;

    // Re-render opciones visualmente
    const q = questions[currentIndex];
    const visibleOptions = (q.options ?? []).filter((o: any) => o.optionId !== UNANSWERED_ID);
    const container = $('options-container');
    container.querySelectorAll('.opt-btn').forEach((btn: Element, oi: number) => {
      const opt = visibleOptions[oi];
      const isSelected = opt?.optionId === optionId;
      btn.classList.toggle('selected', isSelected);
    });

    // Mostrar hint
    ($('change-hint') as HTMLElement).style.display = 'block';
    // Mostrar badge respondida localmente
    ($('q-answered-badge') as HTMLElement).style.display = 'inline-flex';

    updateProgress();
    updateDots();
  }

  // ── Guardar respuesta en backend ─────────────────────────
  async function saveCurrentAnswer(): Promise<boolean> {
    const q = questions[currentIndex];
    if (!q) return true;
    const selected = selectedOptions[q.questionId];
    if (!selected) return true; // Sin respuesta, ok seguir
    if (savedOptions[q.questionId] === selected) return true; // Ya guardado, no repetir

    isSaving = true;
    try {
      await triedsApi.submitAnswer(triedId, q.questionId, selected);
      savedOptions[q.questionId] = selected;
      return true;
    } catch (err: any) {
      toast.error('Error al guardar respuesta', { description: err?.message });
      return false;
    } finally {
      isSaving = false;
    }
  }

  // ── Navegación ───────────────────────────────────────────
  async function handleNext() {
    if (isSaving || isFinishing) return;

    // Guardar respuesta actual ANTES de navegar
    const ok = await saveCurrentAnswer();
    if (!ok) return;

    if (currentIndex < questions.length - 1) {
      renderQuestion(currentIndex + 1);
    } else {
      // Última pregunta → mostrar resumen
      showSummaryModal();
    }
  }

  async function handlePrev() {
    if (isSaving || isFinishing) return;
    if (currentIndex === 0) return;

    // Guardar respuesta actual antes de ir atrás
    await saveCurrentAnswer();
    renderQuestion(currentIndex - 1);
  }

  // Exponer globalmente para los onclick
  (window as any).handleNext = handleNext;
  (window as any).handlePrev = handlePrev;

  function updateNav(idx: number) {
    const btnPrev = $('btn-prev') as HTMLButtonElement;
    const btnNext = $('btn-next') as HTMLButtonElement;

    btnPrev.style.opacity = idx === 0 ? '0.4' : '1';
    btnPrev.style.pointerEvents = idx === 0 ? 'none' : 'auto';

    const isLast = idx === questions.length - 1;
    btnNext.textContent = isLast ? 'Finalizar ✓' : 'Siguiente →';

    // Dots
    updateDots();
  }

  function updateDots() {
    const dotNav = $('dot-nav');
    dotNav.innerHTML = '';
    questions.forEach((q, i) => {
      const dot = document.createElement('div');
      dot.className = 'dot' +
        (selectedOptions[q.questionId] ? ' answered' : '') +
        (i === currentIndex ? ' current' : '');
      dotNav.appendChild(dot);
    });
  }

  function updateProgress() {
    const answered = questions.filter(q => selectedOptions[q.questionId]).length;
    const total = questions.length;
    const pct = total > 0 ? Math.round((answered / total) * 100) : 0;

    ($('progress-bar') as HTMLElement).style.width = `${pct}%`;
    ($('progress-label') as HTMLElement).textContent = `Pregunta ${currentIndex + 1} de ${total}`;
    ($('answered-label') as HTMLElement).textContent = `${answered} respondidas`;
  }

  // ── Modal resumen ────────────────────────────────────────
  function showSummaryModal() {
    const answered = questions.filter(q => selectedOptions[q.questionId]).length;
    const total = questions.length;

    $('summary-answered').textContent = String(answered);
    $('summary-pending').textContent  = String(total - answered);
    $('summary-total').textContent    = String(total);

    const modal = $('summary-modal');
    modal.style.display = 'flex';
  }

  function closeSummary() {
    $('summary-modal').style.display = 'none';
  }
  (window as any).closeSummary = closeSummary;

  async function confirmFinish() {
    if (isFinishing) return;
    isFinishing = true;

    const btn = $('btn-confirm-finish') as HTMLButtonElement;
    btn.textContent = 'Finalizando...';
    btn.disabled = true;

    try {
      // Guardar la pregunta actual si tiene selección pendiente
      await saveCurrentAnswer();

      // Finalizar intento
      await triedsApi.finish(triedId);
      clearInterval(timerInterval);
      window.location.replace(`/tests/review/${triedId}`);
    } catch (err: any) {
      toast.error('Error al finalizar', { description: err?.message });
      btn.textContent = 'Finalizar y ver resultados';
      btn.disabled = false;
      isFinishing = false;
    }
  }
  (window as any).confirmFinish = confirmFinish;

  // ── Init ─────────────────────────────────────────────────
  async function init() {
    const params = new URLSearchParams(window.location.search);
    const testId       = params.get('testId');
    const competenceId = params.get('competenceId');

    if (!testId || !competenceId) {
      toast.error('Parámetros inválidos');
      window.location.replace('/tests');
      return;
    }

    try {
      const res = await triedsApi.start(testId, competenceId);
      if (!res.data) throw new Error('No se pudo iniciar el simulacro');

      const data = res.data;
      triedId   = data.triedId;
      questions = (data.questions ?? []).map((q: any) => ({
        ...q,
        options: (q.options ?? []).filter((o: any) => o.optionId !== UNANSWERED_ID),
      }));

      if (questions.length === 0) {
        toast.error('Este test no tiene preguntas activas');
        window.location.replace('/tests');
        return;
      }

      // Mostrar UI
      $('exam-loading').style.display = 'none';
      $('exam-header').style.display  = 'block';
      $('question-card').style.display = 'block';
      $('exam-nav').style.display     = 'flex';

      // Metadata
      $('exam-competence').textContent = data.competenceId ?? '';
      $('exam-title').textContent      = data.testName ?? data.testId ?? '';

      startTimer();
      renderQuestion(0);

    } catch (err: any) {
      $('exam-loading').innerHTML = `
        <div style="text-align:center;padding:2rem">
          <p style="font-size:1rem;font-weight:700;color:var(--ui-text-1);margin:0 0 8px">No se pudo iniciar el simulacro</p>
          <p style="font-size:0.875rem;color:var(--ui-text-3);margin:0 0 16px">${err?.message ?? 'Error desconocido'}</p>
          <a href="/tests" style="color:var(--brand);font-weight:600;text-decoration:none">← Volver a tests</a>
        </div>`;
    }
  }

  init();
</script>