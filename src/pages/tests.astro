      competenceName:'Inglés',
      color:'#D97706', bg:'#FEF3C7', short:'IN',
      testName:'Práctica Inglés — Vocabulario y Estructuras',
      description:'Ejercicios de gramática funcional, conectores en inglés y uso del vocabulario académico.',
      durationSeconds:1200, questionsToPresent:15, testMode:'PRACTICE',
      difficulty:'B', attempts:81, avgScore:65.9, myBest:62,
    },
    {
      id:'TST00011', competenceId:'COM001', competenceKey:'lc',
      competenceName:'Lectura Crítica',
      color:'#D41224', bg:'#FEE2E2', short:'LC',
      testName:'Cronometrado — Lectura Crítica Intensiva',
      description:'Formato exigente con tiempo reducido por pregunta. Ideal para preparación final.',
      durationSeconds:1500, questionsToPresent:20, testMode:'TIMED',
      difficulty:'A', attempts:31, avgScore:69.3, myBest:null,
    },
    {
      id:'TST00012', competenceId:'COM003', competenceKey:'rq',
      competenceName:'Razonamiento Cuantitativo',
      color:'#2563EB', bg:'#DBEAFE', short:'RC',
      testName:'Práctica — Estadística y Probabilidad',
      description:'Ejercicios focalizados en estadística descriptiva, probabilidad y análisis de datos.',
      durationSeconds:1800, questionsToPresent:20, testMode:'PRACTICE',
      difficulty:'M', attempts:48, avgScore:67.1, myBest:null,
    },
  ];

  let currentComp = 'ALL';
  let currentMode = 'ALL';
  let searchTerm  = '';

  // ── Render ────────────────────────────────────────────────────────────────
  function renderTests() {
    const grid  = document.getElementById('tests-grid') as HTMLElement | null;
    const empty = document.getElementById('empty-state') as HTMLElement | null;

    const filtered = TESTS.filter(t => {
      const matchComp   = currentComp === 'ALL' || t.competenceKey === currentComp;
      const matchMode   = currentMode === 'ALL' || t.testMode === currentMode;
      const matchSearch = searchTerm === '' ||
        t.testName.toLowerCase().includes(searchTerm) ||
        t.competenceName.toLowerCase().includes(searchTerm) ||
        t.description.toLowerCase().includes(searchTerm);
      return matchComp && matchMode && matchSearch;
    });

    const countEl = document.getElementById('count-total');
    if (countEl) countEl.textContent = String(filtered.length);

    if (!grid) return;
    grid.innerHTML = '';

    if (filtered.length === 0) {
      if (empty) empty.style.display = 'block';
      return;
    }
    if (empty) empty.style.display = 'none';

    filtered.forEach(t => {
      const durMin     = Math.floor(t.durationSeconds / 60);
      const diffLabels: Record<string, string> = { B: 'Básico', M: 'Medio', A: 'Alto' };
      const modeLabels: Record<string, string> = { PRACTICE: 'Práctica', EXAM: 'Examen', TIMED: 'Cronometrado' };
      const modeIcons:  Record<string, string> = { PRACTICE: 'ti-leaf', EXAM: 'ti-school', TIMED: 'ti-clock' };

      const card = document.createElement('div');
      card.className = 'test-card';
      card.innerHTML = `
        <!-- Card accent bar -->
        <div style="height:4px;background:linear-gradient(to right,${t.color},${t.color}99);"></div>

        <div class="test-card-body">
          <!-- Header -->
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px;">
            <div style="display:flex;align-items:center;gap:10px;min-width:0;">
              <div style="width:40px;height:40px;border-radius:11px;background:${t.bg};display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <span style="font-size:13px;font-weight:900;color:${t.color};">${t.short}</span>
              </div>
              <div style="min-width:0;">
                <p style="font-size:10px;font-weight:700;color:${t.color};text-transform:uppercase;letter-spacing:0.5px;margin:0 0 2px;">${t.competenceName}</p>
                <h3 style="font-size:14px;font-weight:800;color:#1A1A1A;margin:0;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px;" title="${t.testName}">${t.testName}</h3>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;">
              <span class="mode-badge mode-${t.testMode}">
                <span class="ti ${modeIcons[t.testMode] ?? ''}" style="font-size:10px;"></span>
                ${modeLabels[t.testMode] ?? t.testMode}
              </span>
              <span class="mode-badge diff-${t.difficulty}" style="padding:3px 8px;">
                ${diffLabels[t.difficulty] ?? t.difficulty}
              </span>
            </div>
          </div>

          <!-- Description -->
          <p style="font-size:12.5px;color:#6B7280;line-height:1.65;margin:0 0 14px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">${t.description}</p>

          <!-- Meta row -->
          <div style="display:flex;gap:14px;flex-wrap:wrap;">
            <div style="display:flex;align-items:center;gap:5px;font-size:12px;color:#A09990;">
              <span class="ti ti-clock" style="font-size:13px;color:#C0BDB5;"></span>
              <span style="font-weight:600;">${durMin} min</span>
            </div>
            <div style="display:flex;align-items:center;gap:5px;font-size:12px;color:#A09990;">
              <span class="ti ti-help-circle" style="font-size:13px;color:#C0BDB5;"></span>
              <span style="font-weight:600;">${t.questionsToPresent} preguntas</span>
            </div>
            <div style="display:flex;align-items:center;gap:5px;font-size:12px;color:#A09990;">
              <span class="ti ti-users" style="font-size:13px;color:#C0BDB5;"></span>
              <span style="font-weight:600;">${t.attempts} intentos</span>
            </div>
            <div style="display:flex;align-items:center;gap:5px;font-size:12px;color:#A09990;">
              <span class="ti ti-chart-bar" style="font-size:13px;color:#C0BDB5;"></span>
              <span style="font-weight:600;">Prom: ${t.avgScore}</span>
            </div>
          </div>

          ${t.myBest !== null ? `
          <!-- My best score -->
          <div style="margin-top:12px;padding:8px 12px;background:${t.bg};border-radius:9px;display:flex;align-items:center;justify-content:space-between;">
            <span style="font-size:11px;font-weight:600;color:${t.color};display:flex;align-items:center;gap:5px;">
              <span class="ti ti-star" style="font-size:12px;"></span> Mi mejor puntaje
            </span>
            <span style="font-size:16px;font-weight:900;color:${t.color};">${t.myBest}<span style="font-size:11px;font-weight:600;color:${t.color}aa;">/100</span></span>
          </div>` : `
          <!-- No attempts yet -->
          <div style="margin-top:12px;padding:8px 12px;background:#F9F8F5;border-radius:9px;border:1px dashed #E8E5E0;display:flex;align-items:center;gap:6px;">
            <span class="ti ti-flag" style="color:#C0BDB5;font-size:13px;"></span>
            <span style="font-size:11px;font-weight:600;color:#A09990;">Sin intentos aún — ¡sé el primero!</span>
          </div>`}
        </div>

        <div class="test-card-footer">
          <div style="display:flex;align-items:center;gap:6px;">
            <span style="font-size:11px;color:#A09990;">Puntaje promedio global:</span>
            <span style="font-size:13px;font-weight:800;color:${t.color};">${t.avgScore}/100</span>
          </div>
          <button class="btn-start" onclick="startTest('${t.id}','${t.competenceId}')">
            <span class="ti ti-player-play" style="font-size:13px;"></span>
            ${t.myBest !== null ? 'Reintentar' : 'Iniciar test'}
          </button>
        </div>`;

      grid.appendChild(card);
    });
  }

  // ── Start test ────────────────────────────────────────────────────────────
  window.startTest = (_testId: string, _competenceId: string) => {
    const proceed = confirm(`¿Iniciar este test?\n\nSe registrará un nuevo intento en tu historial.`);
    if (proceed) {
      alert('🚧 Módulo de examen en construcción.\nConéctate al backend con POST /api/trieds/start');
    }
  };

  // ── Filters ───────────────────────────────────────────────────────────────
  window.filterComp = (key: string, btn: HTMLElement) => {
    currentComp = key;
    document.querySelectorAll('.filter-pill').forEach(p => {
      if (!p.id.startsWith('mode-')) p.classList.remove('active');
    });
    btn.classList.add('active');
    renderTests();
  };

  window.filterMode = (mode: string, btn: HTMLElement) => {
    currentMode = mode;
    ['mode-all', 'mode-PRACTICE', 'mode-EXAM', 'mode-TIMED'].forEach(id => {
      document.getElementById(id)?.classList.remove('active');
    });
    btn.classList.add('active');
    renderTests();
  };

  // Search
  document.getElementById('search-input')!.addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
    renderTests();
  });

  // ── Read URL param ────────────────────────────────────────────────────────
  const urlParams = new URLSearchParams(window.location.search);
  const cParam    = urlParams.get('c');
  if (cParam) {
    currentComp = cParam;
    // Mark correct pill active
    document.querySelectorAll('.filter-pill').forEach(p => {
      p.classList.remove('active');
      if (p.getAttribute('onclick')?.includes(`'${cParam}'`)) p.classList.add('active');
    });
  }

  // ── Init ──────────────────────────────────────────────────────────────────
  renderTests();
</script>

</BaseLayout>