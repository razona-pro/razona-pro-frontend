    },
    {
      id:'TST00009', competenceId:'COM004', competenceKey:'en',
      competenceName:'Inglés',
      color:'#D97706', bg:'#FEF3C7', short:'IN',
      testName:'Simulacro Inglés — Comprensión Lectora B1',
      description:'Reading comprehension con textos de nivel B1. Vocabulario, gramática y comprensión global.',
      durationSeconds:2700, questionsToPresent:30, testMode:'EXAM',
