---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="Nueva contraseña">
  <div class="reset-bg" aria-hidden="true">
    <div class="reset-orb orb-1"></div>
    <div class="reset-orb orb-2"></div>
    <div class="reset-grid"></div>
  </div>

  <main class="reset-main">
    <div class="reset-card">
      <!-- Top bar brand -->
      <div class="reset-topbar"></div>

      <div class="reset-body">

        <!-- ESTADO: Verificando token -->
        <div id="s-checking" class="reset-state">
          <div class="state-spinner"></div>
          <p class="state-label">Verificando enlace...</p>
        </div>

        <!-- ESTADO: Token inválido / expirado -->
        <div id="s-invalid" class="reset-state" style="display:none">
          <div class="state-icon state-icon-error">
            <svg width="28" height="28" fill="none" stroke="#DC2626" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </div>
          <h1 class="state-title">Enlace inválido</h1>
          <p id="s-invalid-msg" class="state-desc">El enlace expiró o ya fue utilizado. Solicita uno nuevo.</p>
          <div class="state-actions">
            <a href="/auth?tab=forgot" class="reset-btn reset-btn-primary">Solicitar nuevo enlace</a>
            <a href="/auth" class="reset-btn reset-btn-ghost">Ir al login</a>
          </div>
        </div>

        <!-- ESTADO: Formulario activo -->
        <div id="s-form" class="reset-state" style="display:none">
          <a href="/auth" class="reset-logo" aria-label="RazonaPro">
            <div class="reset-logo-icon">
              <Icon name="tabler:brain" size={20} class="text-white"/>
            </div>
            <span>Razona<strong>Pro</strong></span>
          </a>

          <h1 class="reset-title">Nueva contraseña</h1>
          <p class="reset-subtitle">Crea una contraseña segura para tu cuenta</p>

          <!-- Indicador de requisitos -->
          <div class="req-list" id="req-list">
            <div class="req-item" id="req-len">
              <span class="req-dot"></span>
              <span>Mínimo 8 caracteres</span>
            </div>
            <div class="req-item" id="req-upper">
              <span class="req-dot"></span>
              <span>Al menos una mayúscula</span>
            </div>
            <div class="req-item" id="req-lower">
              <span class="req-dot"></span>
              <span>Al menos una minúscula</span>
            </div>
            <div class="req-item" id="req-num">
              <span class="req-dot"></span>
              <span>Al menos un número</span>
            </div>
          </div>

          <form id="reset-form" novalidate>
            <div class="field-group">
              <label for="rs-password">Nueva contraseña</label>
              <div class="field-wrap" id="wrap-password">
                <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="5" y="9" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 9V6.5a3 3 0 016 0V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <input id="rs-password" name="password" type="password" placeholder="Mínimo 8 caracteres" required autocomplete="new-password" />
                <button type="button" class="toggle-pw" data-target="rs-password" aria-label="Mostrar contraseña" tabindex="-1">
                  <svg viewBox="0 0 20 20" fill="none" width="15" height="15"><ellipse cx="10" cy="10" rx="7" ry="4.5" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
                </button>
              </div>
              <!-- Barra de fortaleza -->
              <div class="strength-bar">
                <div class="strength-fill" id="strength-fill"></div>
              </div>
              <span class="strength-label" id="strength-label"></span>
            </div>

            <div class="field-group">
              <label for="rs-confirm">Confirmar contraseña</label>
              <div class="field-wrap" id="wrap-confirm">
                <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="5" y="9" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 9V6.5a3 3 0 016 0V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <input id="rs-confirm" name="confirm" type="password" placeholder="Repetir contraseña" required autocomplete="new-password" />
                <button type="button" class="toggle-pw" data-target="rs-confirm" aria-label="Mostrar contraseña" tabindex="-1">
                  <svg viewBox="0 0 20 20" fill="none" width="15" height="15"><ellipse cx="10" cy="10" rx="7" ry="4.5" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
                </button>
              </div>
              <span class="match-hint" id="match-hint"></span>
            </div>

            <!-- Mensaje inline de error -->
            <div id="form-error" class="form-error" style="display:none"></div>

            <button type="submit" id="reset-btn" class="reset-btn reset-btn-submit" disabled>
              <span id="reset-label">Guardar contraseña</span>
              <div id="reset-spinner" class="btn-spinner" style="display:none"></div>
              <svg id="reset-arrow" viewBox="0 0 16 16" fill="none" width="14" height="14"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </form>
        </div>

        <!-- ESTADO: Éxito -->
        <div id="s-success" class="reset-state" style="display:none">
          <div class="state-icon state-icon-success success-anim">
            <svg width="28" height="28" fill="none" stroke="#059669" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h1 class="state-title">¡Contraseña actualizada!</h1>
          <p class="state-desc">Tu contraseña ha sido cambiada exitosamente. Ya puedes iniciar sesión.</p>
          <div id="redirect-bar" class="redirect-bar">
            <div class="redirect-fill" id="redirect-fill"></div>
          </div>
          <p class="redirect-hint" id="redirect-hint">Redirigiendo en <strong id="countdown">3</strong>s…</p>
          <div class="state-actions">
            <a href="/auth" class="reset-btn reset-btn-primary">Ir al login ahora</a>
          </div>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>

<style>
  :root {
    --auth-red:      #D41224;
    --auth-red-dark: #9B1F24;
  }

  /* ── FONDO ─────────────────────────────────────────────── */
  .reset-bg { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; background: #F5EEEE; }
  .reset-orb { position: absolute; border-radius: 50%; opacity: 0.07; background: var(--auth-red); }
  .reset-orb.orb-1 { width: 550px; height: 550px; top: -150px; left: -160px; }
  .reset-orb.orb-2 { width: 400px; height: 400px; bottom: -120px; right: -120px; }
  .reset-grid {
    position: absolute; inset: 0; opacity: 0.025;
    background-image:
      linear-gradient(rgba(212,18,36,1) 1px, transparent 1px),
      linear-gradient(to right, rgba(212,18,36,1) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  /* ── MAIN ──────────────────────────────────────────────── */
  .reset-main {
    position: relative; z-index: 1;
    min-height: 100dvh; display: flex;
    align-items: center; justify-content: center; padding: 1.5rem;
  }
  .reset-card {
    width: 100%; max-width: 440px;
    background: white; border-radius: 22px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.1), 0 4px 16px rgba(0,0,0,0.06);
    overflow: hidden;
    animation: cardIn 0.5s cubic-bezier(0.34,1.46,0.64,1) both;
  }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(24px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .reset-topbar {
    height: 4px;
    background: linear-gradient(to right, var(--auth-red), #FF4D61, var(--auth-red-dark));
    background-size: 200% 100%;
    animation: shimmer 2.5s linear infinite;
  }
  @keyframes shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .reset-body { padding: 2.5rem 2rem; }

  /* ── ESTADOS ───────────────────────────────────────────── */
  .reset-state { display: flex; flex-direction: column; align-items: center; }
  .reset-state + .reset-state { margin-top: 0; }

  .state-enter {
    animation: stateEnter 0.4s cubic-bezier(0.34,1.46,0.64,1) both;
  }
  @keyframes stateEnter {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── CHECKING ─────────────────────────────────────────── */
  .state-spinner {
    width: 52px; height: 52px; border-radius: 50%;
    border: 3px solid rgba(212,18,36,0.15); border-top-color: var(--auth-red);
    animation: spin 0.85s linear infinite; margin-bottom: 1rem;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .state-label { font-size: 0.875rem; color: #787878; font-weight: 500; }

  /* ── ICONS ─────────────────────────────────────────────── */
  .state-icon {
    width: 72px; height: 72px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1.125rem;
  }
  .state-icon-error   { background: #FEE2E2; }
  .state-icon-success { background: #D1FAE5; }
  .success-anim {
    animation: successBounce 0.6s cubic-bezier(0.34,1.7,0.64,1) 0.1s both;
  }
  @keyframes successBounce {
    from { transform: scale(0.3); opacity: 0; }
    to   { transform: scale(1);   opacity: 1; }
  }

  /* ── TEXTOS DE ESTADO ──────────────────────────────────── */
  .state-title { font-size: 1.25rem; font-weight: 800; color: #1A1A1A; margin: 0 0 0.5rem; text-align: center; font-family: var(--font-sans); }
  .state-desc  { font-size: 0.875rem; color: #6B7280; margin: 0 0 1.5rem; text-align: center; line-height: 1.65; max-width: 320px; }
  .state-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }

  /* ── LOGO ──────────────────────────────────────────────── */
  .reset-logo {
    display: flex; align-items: center; gap: 0.625rem;
    margin-bottom: 1.25rem; font-size: 1.125rem; font-weight: 700;
    color: #1A1A1A; font-family: var(--font-sans);
    text-decoration: none; align-self: flex-start;
  }
  .reset-logo strong { color: var(--auth-red); }
  .reset-logo-icon {
    width: 36px; height: 36px; border-radius: 9px;
    background: linear-gradient(135deg, var(--auth-red), var(--auth-red-dark));
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 12px rgba(212,18,36,0.3); flex-shrink: 0;
  }
  .reset-title    { font-family: var(--font-sans); font-size: 1.5rem; font-weight: 800; color: #1A1A1A; margin: 0 0 0.25rem; letter-spacing: -0.4px; align-self: flex-start; }
  .reset-subtitle { font-size: 0.8125rem; color: #787878; margin: 0 0 1.25rem; align-self: flex-start; }

  /* ── REQUISITOS ────────────────────────────────────────── */
  .req-list {
    display: flex; flex-direction: column; gap: 5px;
    margin-bottom: 1.125rem; align-self: stretch;
    background: #F8F8F8; border-radius: 10px; padding: 0.75rem;
    border: 1px solid #EFEFEF;
  }
  .req-item {
    display: flex; align-items: center; gap: 6px;
    font-size: 0.75rem; color: #9CA3AF;
    transition: color 0.2s;
  }
  .req-item.valid { color: #059669; }
  .req-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #D4D4D4; flex-shrink: 0;
    transition: background 0.2s, transform 0.2s;
  }
  .req-item.valid .req-dot { background: #059669; transform: scale(1.2); }

  /* ── FORMULARIO ────────────────────────────────────────── */
  .field-group { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 1rem; width: 100%; }
  .field-group label { font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #787878; }
  .field-wrap {
    display: flex; align-items: center;
    background: #F5F5F5; border: 1.5px solid transparent; border-radius: 9px;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  .field-wrap:focus-within {
    background: white; border-color: var(--auth-red);
    box-shadow: 0 0 0 3px rgba(212,18,36,0.1);
  }
  .field-wrap.field-ok     { border-color: #059669; box-shadow: 0 0 0 3px rgba(5,150,105,0.1); }
  .field-wrap.field-error  { border-color: #DC2626; box-shadow: 0 0 0 3px rgba(220,38,38,0.1); }
  .field-icon { width: 15px; height: 15px; flex-shrink: 0; margin-left: 11px; color: #A3A3A3; pointer-events: none; }
  .field-wrap input {
    flex: 1; border: none; background: transparent;
    padding: 0.5625rem 0.75rem; font-family: inherit;
    font-size: 0.875rem; color: #1A1A1A; outline: none;
  }
  .field-wrap input::placeholder { color: #C0C0C0; }
  .toggle-pw {
    background: none; border: none; cursor: pointer; padding: 0 10px;
    color: #A3A3A3; display: flex; align-items: center; transition: color 0.2s;
  }
  .toggle-pw:hover { color: var(--auth-red); }

  /* Barra de fortaleza */
  .strength-bar {
    height: 3px; background: #EFEFEF; border-radius: 2px;
    margin-top: 5px; overflow: hidden;
  }
  .strength-fill {
    height: 100%; width: 0%; border-radius: 2px;
    transition: width 0.4s ease, background-color 0.4s ease;
  }
  .strength-label {
    font-size: 0.6875rem; font-weight: 600; margin-top: 3px;
    transition: color 0.3s;
  }

  /* Match hint */
  .match-hint {
    font-size: 0.6875rem; font-weight: 600; margin-top: 3px;
    min-height: 14px;
    transition: color 0.2s;
  }
  .match-hint.ok  { color: #059669; }
  .match-hint.err { color: #DC2626; }

  /* Error inline */
  .form-error {
    background: #FEF2F2; border: 1px solid #FECACA; border-radius: 8px;
    padding: 0.625rem 0.75rem; font-size: 0.8125rem; color: #B91C1C;
    margin-bottom: 0.75rem; width: 100%; text-align: center;
    animation: shakeX 0.4s ease;
  }
  @keyframes shakeX {
    0%,100% { transform: translateX(0); }
    20%     { transform: translateX(-6px); }
    40%     { transform: translateX(6px); }
    60%     { transform: translateX(-4px); }
    80%     { transform: translateX(4px); }
  }

  /* ── BOTONES ───────────────────────────────────────────── */
  .reset-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.6875rem 1.25rem; border-radius: 10px;
    font-family: inherit; font-size: 0.875rem; font-weight: 700;
    cursor: pointer; text-decoration: none; transition: all 0.2s;
    border: none;
  }
  .reset-btn-primary {
    background: linear-gradient(135deg, var(--auth-red), var(--auth-red-dark));
    color: white; box-shadow: 0 4px 14px rgba(212,18,36,0.3);
  }
  .reset-btn-primary:hover { box-shadow: 0 6px 22px rgba(212,18,36,0.44); transform: translateY(-1px); }
  .reset-btn-ghost {
    background: transparent; color: #6B7280;
    border: 1.5px solid #E5E5E5;
  }
  .reset-btn-ghost:hover { border-color: #D4D4D4; color: #1A1A1A; }
  .reset-btn-submit {
    width: 100%; margin-top: 0.5rem;
    background: linear-gradient(135deg, var(--auth-red), var(--auth-red-dark));
    color: white; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.06em;
    box-shadow: 0 4px 16px rgba(212,18,36,0.3);
  }
  .reset-btn-submit:hover:not(:disabled) { box-shadow: 0 6px 24px rgba(212,18,36,0.45); transform: translateY(-1px); }
  .reset-btn-submit:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }

  .btn-spinner {
    width: 16px; height: 16px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.35); border-top-color: white;
    animation: spin 0.75s linear infinite;
  }

  /* ── REDIRECT BAR ──────────────────────────────────────── */
  .redirect-bar {
    width: 100%; height: 4px; background: #E5E5E5; border-radius: 2px;
    overflow: hidden; margin-bottom: 0.5rem; align-self: stretch;
  }
  .redirect-fill {
    height: 100%; width: 100%;
    background: linear-gradient(to right, var(--auth-red), #FF4D61);
    transform-origin: left;
    animation: drainBar 3s linear forwards;
  }
  @keyframes drainBar {
    from { transform: scaleX(1); }
    to   { transform: scaleX(0); }
  }
  .redirect-hint { font-size: 0.75rem; color: #9CA3AF; margin: 0 0 1.25rem; }

  /* ── RESPONSIVE ────────────────────────────────────────── */
  @media (max-width: 480px) {
    .reset-main { padding: 0.75rem; }
    .reset-body { padding: 2rem 1.25rem; }
  }
</style>

<script>
  import { authApi }             from '../lib/api/auth.api';
  import { isAuthenticated }     from '../lib/auth';

  // Si ya está autenticado y no trae token, redirigir al dashboard
  const rawToken = new URLSearchParams(window.location.search).get('token');
  if (!rawToken) {
    if (isAuthenticated()) {
      window.location.replace('/dashboard');
    } else {
      showState('invalid', 'No se encontró el token de restablecimiento. Solicita un nuevo enlace.');
    }
  }

  // ── Helpers de estado ──────────────────────────────────────
  function showState(state: 'checking' | 'invalid' | 'form' | 'success', invalidMsg?: string) {
    const states = ['checking', 'invalid', 'form', 'success'];
    states.forEach(s => {
      const el = document.getElementById(`s-${s}`)!;
      el.style.display = 'none';
    });
    const target = document.getElementById(`s-${state}`)!;
    target.style.display = 'flex';
    target.classList.add('state-enter');
    target.addEventListener('animationend', () => target.classList.remove('state-enter'), { once: true });

    if (state === 'invalid' && invalidMsg) {
      const msgEl = document.getElementById('s-invalid-msg');
      if (msgEl) msgEl.textContent = invalidMsg;
    }
  }

  // ── Verificar token al cargar ──────────────────────────────
  // No hay endpoint dedicado de verificación en el backend, así que
  // simplemente mostramos el formulario si el token tiene formato válido (UUID hex 32 chars).
  // La validación real ocurre al hacer submit y el backend retorna el error correspondiente.
  if (rawToken) {
    if (/^[a-f0-9]{32}$/i.test(rawToken)) {
      // Token tiene formato válido → mostrar formulario
      setTimeout(() => showState('form'), 600);
    } else {
      setTimeout(() => showState('invalid', 'El enlace tiene un formato inválido. Solicita uno nuevo.'), 600);
    }
  }

  // ── Toggle password ────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.toggle-pw').forEach(btn => {
    btn.addEventListener('click', () => {
      const inp = document.getElementById(btn.dataset.target ?? '') as HTMLInputElement | null;
      if (inp) inp.type = inp.type === 'password' ? 'text' : 'password';
    });
  });

  // ── Validación de fortaleza en tiempo real ─────────────────
  const passwordInput = document.getElementById('rs-password') as HTMLInputElement;
  const confirmInput  = document.getElementById('rs-confirm')  as HTMLInputElement;
  const submitBtn     = document.getElementById('reset-btn')   as HTMLButtonElement;

  const STRENGTH_LEVELS = [
    { label: '', color: '', pct: 0 },
    { label: 'Muy débil',  color: '#DC2626', pct: 20 },
    { label: 'Débil',      color: '#D97706', pct: 40 },
    { label: 'Regular',    color: '#EAB308', pct: 60 },
    { label: 'Buena',      color: '#22C55E', pct: 80 },
    { label: 'Excelente',  color: '#059669', pct: 100 },
  ];

  function checkReq(id: string, ok: boolean) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('valid', ok);
  }

  function calcStrength(pw: string): number {
    let score = 0;
    if (pw.length >= 8)  score++;
    if (pw.length >= 12) score++;
    if (/[A-Z]/.test(pw)) score++;
    if (/[a-z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    return Math.min(score, 5);
  }

  function isFormValid(): boolean {
    const pw = passwordInput?.value ?? '';
    const cp = confirmInput?.value ?? '';
    return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/.test(pw) && pw === cp;
  }

  passwordInput?.addEventListener('input', () => {
    const pw = passwordInput.value;

    // Requisitos
    checkReq('req-len',   pw.length >= 8);
    checkReq('req-upper', /[A-Z]/.test(pw));
    checkReq('req-lower', /[a-z]/.test(pw));
    checkReq('req-num',   /[0-9]/.test(pw));

    // Barra de fortaleza
    const lvl = calcStrength(pw);
    const cfg = STRENGTH_LEVELS[lvl];
    const fill  = document.getElementById('strength-fill')!;
    const label = document.getElementById('strength-label')!;
    fill.style.width = `${cfg.pct}%`;
    fill.style.backgroundColor = cfg.color;
    label.textContent = cfg.label;
    label.style.color = cfg.color;

    // Borde del campo
    const wrap = document.getElementById('wrap-password')!;
    wrap.classList.remove('field-ok', 'field-error');
    if (pw.length > 0) wrap.classList.add(lvl >= 3 ? 'field-ok' : 'field-error');

    // Verificar match si ya escribió en confirm
    if (confirmInput?.value) checkMatch();

    submitBtn.disabled = !isFormValid();
  });

  function checkMatch() {
    const pw = passwordInput?.value ?? '';
    const cp = confirmInput?.value  ?? '';
    const hint = document.getElementById('match-hint')!;
    const wrap = document.getElementById('wrap-confirm')!;

    if (!cp) { hint.textContent = ''; wrap.classList.remove('field-ok', 'field-error'); return; }

    if (pw === cp) {
      hint.textContent = '✓ Las contraseñas coinciden';
      hint.className   = 'match-hint ok';
      wrap.classList.remove('field-error');
      wrap.classList.add('field-ok');
    } else {
      hint.textContent = '✗ Las contraseñas no coinciden';
      hint.className   = 'match-hint err';
      wrap.classList.remove('field-ok');
      wrap.classList.add('field-error');
    }
    submitBtn.disabled = !isFormValid();
  }

  confirmInput?.addEventListener('input', checkMatch);

  // ── Submit ─────────────────────────────────────────────────
  document.getElementById('reset-form')?.addEventListener('submit', async e => {
    e.preventDefault();

    const pw = passwordInput?.value ?? '';
    const cp = confirmInput?.value  ?? '';

    const errEl = document.getElementById('form-error')!;
    errEl.style.display = 'none';

    if (pw !== cp) {
      errEl.textContent = 'Las contraseñas no coinciden';
      errEl.style.display = 'block';
      return;
    }

    if (!/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/.test(pw)) {
      errEl.textContent = 'La contraseña no cumple los requisitos mínimos';
      errEl.style.display = 'block';
      return;
    }

    if (!rawToken) return;

    // Loading
    const btn = document.getElementById('reset-btn') as HTMLButtonElement;
    const lbl = document.getElementById('reset-label')!;
    const sp  = document.getElementById('reset-spinner')!;
    const ar  = document.getElementById('reset-arrow')!;
    btn.disabled = true; lbl.textContent = 'Guardando...'; sp.style.display = 'block'; ar.style.display = 'none';

    try {
      await authApi.resetPassword(rawToken, pw);

      showState('success');

      // Cuenta regresiva y redirige
      let secs = 3;
      const cdown = document.getElementById('countdown')!;
      cdown.textContent = String(secs);
      const timer = setInterval(() => {
        secs--;
        cdown.textContent = String(secs);
        if (secs <= 0) {
          clearInterval(timer);
          window.location.replace('/auth');
        }
      }, 1000);

    } catch (err: any) {
      const msg = err?.message ?? 'El enlace es inválido o ya expiró.';
      // Si el error es de token inválido, mostrar estado error
      if (msg.toLowerCase().includes('token') || msg.toLowerCase().includes('inválid') || msg.toLowerCase().includes('expirad')) {
        showState('invalid', msg);
      } else {
        errEl.textContent = msg;
        errEl.style.display = 'block';
        btn.disabled = false; lbl.textContent = 'Guardar contraseña'; sp.style.display = 'none'; ar.style.display = 'block';
      }
    }
  });
</script>