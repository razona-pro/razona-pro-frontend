---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Verificar correo">
  <div style="min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:1.5rem;background:#F5EEEE;">
    <div style="width:100%;max-width:420px;background:white;border-radius:20px;box-shadow:0 16px 48px rgba(0,0,0,0.1);overflow:hidden;">
      <!-- Top bar -->
      <div style="height:4px;background:linear-gradient(to right,#D41224,#FF2D42);"></div>
      <div style="padding:2.5rem 2rem;text-align:center;">

        <!-- Loading -->
        <div id="s-loading" style="display:flex;flex-direction:column;align-items:center;gap:1rem;">
          <div style="width:64px;height:64px;border-radius:50%;border:4px solid rgba(212,18,36,0.15);border-top-color:#D41224;animation:spin 1s linear infinite;"></div>
          <p style="font-family:var(--font-sans);color:#6B7280;font-weight:500;margin:0;">Verificando tu correo...</p>
        </div>

        <!-- Success -->
        <div id="s-success" style="display:none;flex-direction:column;align-items:center;gap:1rem;">
          <div style="width:64px;height:64px;border-radius:50%;background:#D1FAE5;display:flex;align-items:center;justify-content:center;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h1 style="font-family:var(--font-sans);font-size:1.25rem;font-weight:800;color:#1A1A1A;margin:0;">¡Correo verificado!</h1>
          <p style="font-family:var(--font-sans);font-size:0.875rem;color:#6B7280;margin:0;">Tu cuenta está activa. Ya puedes iniciar sesión.</p>
          <a href="/auth" style="margin-top:0.5rem;display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.75rem;border-radius:10px;background:linear-gradient(135deg,#D41224,#9B1F24);color:white;font-family:var(--font-sans);font-weight:700;text-decoration:none;box-shadow:0 4px 14px rgba(212,18,36,0.3);">
            Ir a iniciar sesión
          </a>
        </div>

        <!-- Error -->
        <div id="s-error" style="display:none;flex-direction:column;align-items:center;gap:1rem;">
          <div style="width:64px;height:64px;border-radius:50%;background:#FEE2E2;display:flex;align-items:center;justify-content:center;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </div>
          <h1 style="font-family:var(--font-sans);font-size:1.25rem;font-weight:800;color:#1A1A1A;margin:0;">Enlace inválido</h1>
          <p id="s-error-msg" style="font-family:var(--font-sans);font-size:0.875rem;color:#6B7280;margin:0;">El enlace expiró o ya fue utilizado.</p>

          <!-- Reenvío del enlace de verificación -->
          <div style="width:100%;margin-top:0.5rem;text-align:left">
            <label style="display:block;font-family:var(--font-sans);font-size:0.75rem;font-weight:700;color:#6B7280;margin-bottom:5px">Reenviar enlace de verificación</label>
            <input id="resend-email" type="email" placeholder="tu-correo@ufpso.edu.co"
                   style="width:100%;padding:10px 12px;border:1.5px solid #E5E5E5;border-radius:10px;font-family:var(--font-sans);font-size:0.875rem;outline:none;box-sizing:border-box" />
            <p id="resend-feedback" style="font-family:var(--font-sans);font-size:0.75rem;margin:6px 0 0;display:none"></p>
            <button id="resend-btn" type="button"
                    style="width:100%;margin-top:8px;padding:0.7rem;border:none;border-radius:10px;background:linear-gradient(135deg,#D41224,#9B1F24);color:white;font-family:var(--font-sans);font-weight:700;font-size:0.875rem;cursor:pointer">
              Reenviar correo
            </button>
          </div>
          <a href="/auth?tab=register" style="font-family:var(--font-sans);font-size:0.8125rem;color:#6B7280;text-decoration:underline">
            Volver al registro
          </a>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<style>@keyframes spin { to { transform: rotate(360deg); } }</style>

<script>
  import { authApi } from '../lib/api/auth.api';

  const show = (id: string) => {
    ['s-loading','s-success','s-error'].forEach(s => {
      const el = document.getElementById(s);
      if (el) el.style.display = s === id ? 'flex' : 'none';
    });
  };

  const token = new URLSearchParams(window.location.search).get('token');
  if (!token) {
    show('s-error');
    const msg = document.getElementById('s-error-msg');
    if (msg) msg.textContent = 'No se encontró el token de verificación.';
  } else {
    authApi.verifyEmail(token)
      .then(() => show('s-success'))
      .catch((err: any) => {
        show('s-error');
        const msg = document.getElementById('s-error-msg');
        if (msg) msg.textContent = err?.message ?? 'El enlace es inválido o ya fue utilizado.';
      });
  }

  // ── Reenvío de verificación (cooldown manejado por el backend) ──
  const resendBtn = document.getElementById('resend-btn') as HTMLButtonElement | null;
  const resendEmail = document.getElementById('resend-email') as HTMLInputElement | null;
  const feedback = document.getElementById('resend-feedback');

  function setFeedback(text: string, ok: boolean) {
    if (!feedback) return;
    feedback.textContent = text;
    feedback.style.color = ok ? '#059669' : '#DC2626';
    feedback.style.display = 'block';
  }

  resendBtn?.addEventListener('click', async () => {
    const email = (resendEmail?.value ?? '').trim();
    if (!email || !email.includes('@')) { setFeedback('Ingresa un correo válido.', false); return; }
    resendBtn.disabled = true; resendBtn.textContent = 'Enviando...';
    try {
      const res = await authApi.resendVerification(email);
      setFeedback('Enlace reenviado. Revisa tu bandeja y la carpeta de spam.', true);
      let s = res.data?.cooldownSeconds ?? 60;
      const tick = () => {
        if (s <= 0) { resendBtn.disabled = false; resendBtn.textContent = 'Reenviar correo'; return; }
        resendBtn.textContent = `Reenviar en ${s}s`; s--; setTimeout(tick, 1000);
      };
      tick();
    } catch (err: any) {
      resendBtn.disabled = false; resendBtn.textContent = 'Reenviar correo';
      setFeedback(err?.message ?? 'No se pudo reenviar. Intenta más tarde.', false);
    }
  });
</script>