---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Práctica adaptativa con IA" currentPage="ai-practice" requiredRole="STUDENT">

  <div id="view-setup">
    <div style="margin-bottom:1.25rem">
      <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
        <a href="/dashboard" style="color:var(--ui-text-3);text-decoration:none">Panel de control</a>
        <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Práctica IA</span>
      </div>
      <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 4px;letter-spacing:-0.5px">Práctica adaptativa con IA</h1>
      <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Las preguntas se generan en tiempo real y la dificultad se ajusta según tu desempeño.</p>
    </div>

    <!-- Banner estado IA (simplificado para estudiantes) -->
    <div id="ai-banner" style="border-radius:14px;padding:1rem 1.25rem;margin-bottom:1.25rem;display:flex;align-items:center;gap:12px;border:1px solid var(--ui-border);background:var(--ui-card)">
      <div id="banner-icon" style="width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--ui-surface)">
        <div style="width:18px;height:18px;border-radius:50%;border:2.5px solid rgba(99,102,241,0.2);border-top-color:#6366F1;animation:spin 0.85s linear infinite"></div>
      </div>
      <div style="flex:1">
        <p id="banner-title" style="font-size:0.875rem;font-weight:700;color:var(--ui-text-1);margin:0 0 2px">Verificando disponibilidad...</p>
        <p id="banner-msg" style="font-size:0.8125rem;color:var(--ui-text-2);margin:0"></p>
      </div>
      <span id="banner-badge" style="font-size:0.6875rem;font-weight:700;padding:4px 12px;border-radius:20px;flex-shrink:0"></span>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:1.5rem">
      <!-- Configuración -->
      <div style="background:var(--ui-card);border-radius:16px;padding:1.5rem;border:1px solid var(--ui-border)">
        <h2 style="font-size:0.9375rem;font-weight:800;color:var(--ui-text-1);margin:0 0 1.125rem">Configurar sesión</h2>

        <div class="fg">
          <label class="fl">Competencia a practicar</label>
          <select id="setup-comp" class="fi">
            <option value="">Selecciona una competencia...</option>
          </select>
        </div>

        <div class="fg">
          <label class="fl">Número de preguntas</label>
          <div style="display:flex;gap:6px;flex-wrap:wrap">
            {[5, 8, 10, 15].map(n => (
              <button class="qpill" data-q={n} type="button">{n}</button>
            ))}
          </div>
          <p style="font-size:0.6875rem;color:var(--ui-text-3);margin:6px 0 0">La dificultad se ajusta automáticamente tras cada respuesta.</p>
        </div>

        <div class="fg">
          <label class="fl">Notas de sesión <span style="font-weight:400;opacity:0.6">(opcional)</span></label>
          <input id="setup-desc" type="text" class="fi" placeholder="Ej: Preparación parcial - semana 3" maxlength="200" />
        </div>

        <div id="setup-error" style="display:none;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:8px 12px;font-size:0.8125rem;color:#B91C1C;margin-bottom:0.875rem"></div>

        <button id="start-btn"
          style="width:100%;padding:0.75rem;border-radius:10px;border:none;background:linear-gradient(135deg,#6366F1,#4F46E5);color:white;font-family:inherit;font-weight:700;font-size:0.9375rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 4px 16px rgba(99,102,241,0.35);transition:all 0.2s;opacity:0.5"
          disabled>
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Iniciar sesión adaptativa
        </button>
      </div>

      <!-- Cómo funciona -->
      <div style="display:flex;flex-direction:column;gap:12px">
        <div style="background:linear-gradient(135deg,#1E1B4B,#312E81);border-radius:16px;padding:1.375rem;color:white;flex:1">
          <h3 style="font-size:1rem;font-weight:800;margin:0 0 1rem">Dificultad adaptativa</h3>
          <div style="display:flex;flex-direction:column;gap:10px">
            <div style="display:flex;align-items:flex-start;gap:10px">
              <div style="width:24px;height:24px;border-radius:6px;background:rgba(99,102,241,0.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.75rem;font-weight:800;color:#818CF8">1</div>
              <p style="font-size:0.8125rem;color:rgba(255,255,255,0.75);margin:0;line-height:1.6">La primera pregunta es de dificultad media (nivel 5/10).</p>
            </div>
            <div style="display:flex;align-items:flex-start;gap:10px">
              <div style="width:24px;height:24px;border-radius:6px;background:rgba(99,102,241,0.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.75rem;font-weight:800;color:#818CF8">2</div>
              <p style="font-size:0.8125rem;color:rgba(255,255,255,0.75);margin:0;line-height:1.6">Según tus aciertos y errores, la siguiente pregunta sube o baja de nivel.</p>
            </div>
            <div style="display:flex;align-items:flex-start;gap:10px">
              <div style="width:24px;height:24px;border-radius:6px;background:rgba(99,102,241,0.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.75rem;font-weight:800;color:#818CF8">3</div>
              <p style="font-size:0.8125rem;color:rgba(255,255,255,0.75);margin:0;line-height:1.6">El puntaje final refleja tanto la cantidad correcta como la dificultad alcanzada.</p>
            </div>
          </div>
        </div>
        <div style="background:var(--ui-card);border-radius:14px;padding:1.125rem;border:1px solid var(--ui-border)">
          <p style="font-size:0.75rem;font-weight:700;color:var(--ui-text-1);margin:0 0 6px">Sistema de puntuación</p>
          <p style="font-size:0.8125rem;color:var(--ui-text-2);margin:0;line-height:1.6">Cada pregunta vale tantos puntos como su nivel de dificultad (1 a 10). Una pregunta de nivel 8 aportará hasta 8 puntos si la respondes correctamente.</p>
        </div>
      </div>
    </div>

    <!-- Resumen de sesiones (consumido desde el historial) -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:1.25rem">
      <div class="ai-stat" style="border-left-color:#6366F1"><span class="ai-stat-label">Total</span><p id="ai-stat-total" class="ai-stat-val" style="color:#6366F1">0</p></div>
      <div class="ai-stat" style="border-left-color:#059669"><span class="ai-stat-label">Finalizadas</span><p id="ai-stat-finished" class="ai-stat-val" style="color:#059669">0</p></div>
      <div class="ai-stat" style="border-left-color:#2563EB"><span class="ai-stat-label">En progreso</span><p id="ai-stat-progress" class="ai-stat-val" style="color:#2563EB">0</p></div>
      <div class="ai-stat" style="border-left-color:#DC2626"><span class="ai-stat-label">Abandonadas</span><p id="ai-stat-abandoned" class="ai-stat-val" style="color:#DC2626">0</p></div>
    </div>

    <!-- Historial (tabla) -->
    <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden">
      <div style="padding:1rem 1.25rem;border-bottom:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between">
        <h2 style="font-size:0.9375rem;font-weight:800;color:var(--ui-text-1);margin:0">Historial de sesiones</h2>
        <span id="hist-count" style="font-size:0.75rem;color:var(--ui-text-3)"></span>
      </div>
      <div style="overflow-x:auto">
        <table class="ai-table">
          <thead>
            <tr>
              <th>Sesión</th>
              <th>Estado</th>
              <th class="ai-th-num">Correctas</th>
              <th class="ai-th-num">Generadas</th>
              <th class="ai-th-num">Solicitadas</th>
              <th class="ai-th-num">Puntaje</th>
              <th>Fecha</th>
            </tr>
          </thead>
          <tbody id="hist-tbody">
            <tr><td colspan="7" style="padding:0.75rem"><div class="skel" style="height:40px;border-radius:8px"></div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal pre-inicio (instrucciones) -->
  <div id="prestart-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(6px)">
    <div style="background:var(--ui-card);border-radius:22px;padding:0;max-width:500px;width:calc(100%-2rem);overflow:hidden;animation:modalIn 0.35s cubic-bezier(0.34,1.46,0.64,1) both;box-shadow:0 24px 70px rgba(0,0,0,0.2)">
      <!-- Header -->
      <div style="background:linear-gradient(135deg,#6366F1,#4F46E5);padding:1.75rem 2rem">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:0.75rem">
          <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center">
            <svg width="20" height="20" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
          </div>
          <div>
            <h3 style="font-size:1.0625rem;font-weight:800;color:white;margin:0">Sesión Adaptativa con IA</h3>
            <p style="font-size:0.8125rem;color:rgba(255,255,255,0.7);margin:0" id="ps-subtitle">Preparándote...</p>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
          <div style="background:rgba(255,255,255,0.15);border-radius:10px;padding:10px;text-align:center">
            <p id="ps-q-count" style="font-size:1.5rem;font-weight:900;color:white;margin:0">-</p>
            <p style="font-size:0.625rem;color:rgba(255,255,255,0.65);margin:0;text-transform:uppercase;letter-spacing:0.4px">Preguntas</p>
          </div>
          <div style="background:rgba(255,255,255,0.15);border-radius:10px;padding:10px;text-align:center">
            <p style="font-size:1.5rem;font-weight:900;color:white;margin:0">1–10</p>
            <p style="font-size:0.625rem;color:rgba(255,255,255,0.65);margin:0;text-transform:uppercase;letter-spacing:0.4px">Niveles</p>
          </div>
          <div style="background:rgba(255,255,255,0.15);border-radius:10px;padding:10px;text-align:center">
            <p id="ps-est-time" style="font-size:1.5rem;font-weight:900;color:white;margin:0">-</p>
            <p style="font-size:0.625rem;color:rgba(255,255,255,0.65);margin:0;text-transform:uppercase;letter-spacing:0.4px">Min. aprox.</p>
          </div>
        </div>
      </div>
      <!-- Body -->
      <div style="padding:1.5rem 2rem">
        <p style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--ui-text-3);margin:0 0 10px">Instrucciones</p>
        <ul style="list-style:none;padding:0;margin:0 0 1.25rem;display:flex;flex-direction:column;gap:8px">
          <li style="display:flex;align-items:flex-start;gap:8px;font-size:0.875rem;color:var(--ui-text-2)">
            <span style="width:20px;height:20px;border-radius:5px;background:#EDE9FE;color:#6366F1;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.625rem;font-weight:800;margin-top:1px">1</span>
            Comenzarás en dificultad media. La IA ajustará cada nueva pregunta en función de tu respuesta anterior.
          </li>
          <li style="display:flex;align-items:flex-start;gap:8px;font-size:0.875rem;color:var(--ui-text-2)">
            <span style="width:20px;height:20px;border-radius:5px;background:#EDE9FE;color:#6366F1;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.625rem;font-weight:800;margin-top:1px">2</span>
            Puedes solicitar hasta 3 pistas por pregunta. Úsalas si las necesitas, sin penalización en el puntaje.
          </li>
          <li style="display:flex;align-items:flex-start;gap:8px;font-size:0.875rem;color:var(--ui-text-2)">
            <span style="width:20px;height:20px;border-radius:5px;background:#EDE9FE;color:#6366F1;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.625rem;font-weight:800;margin-top:1px">3</span>
            Al finalizar verás tu puntaje ponderado, cuántos puntos obtuviste del total posible y el análisis de tu sesión.
          </li>
        </ul>
        <div style="display:flex;gap:8px">
          <button id="ps-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
          <button id="ps-confirm" style="flex:2;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,#6366F1,#4F46E5);color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(99,102,241,0.35)">
            Comenzar sesión
          </button>
        </div>
      </div>
    </div>
  </div>

</AppLayout>

<style>
  @keyframes spin    { to { transform: rotate(360deg); } }
  @keyframes shimmer { 0%{background-position:-400px 0}100%{background-position:400px 0} }
  @keyframes modalIn { from{opacity:0;transform:scale(0.92) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)} }

  .fg { display:flex;flex-direction:column;gap:4px;margin-bottom:0.875rem }
  .fl { font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3) }
  .fi {
    padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);
    border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);
    outline:none;transition:border-color 0.2s;width:100%;appearance:none
  }
  .fi:focus { border-color:#6366F1;box-shadow:0 0 0 3px rgba(99,102,241,0.12) }

  .qpill {
    padding:5px 18px;border-radius:20px;font-size:0.8125rem;font-weight:600;
    border:1.5px solid var(--ui-border);background:var(--ui-card);color:var(--ui-text-2);
    cursor:pointer;transition:all 0.15s;font-family:inherit
  }
  .qpill.active { background:#6366F1;color:white;border-color:#6366F1 }

  .skel {
    background:linear-gradient(90deg,var(--ui-surface) 25%,var(--ui-border) 50%,var(--ui-surface) 75%);
    background-size:400px 100%;animation:shimmer 1.5s infinite
  }

  .ai-stat {
    background: var(--ui-card); border-radius: 12px; padding: 12px 14px;
    border: 1px solid var(--ui-border); border-left: 3px solid;
  }
  .ai-stat-label { font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px }
  .ai-stat-val   { font-size:1.5rem;font-weight:900;margin:4px 0 0;line-height:1 }

  .ai-table { width:100%;border-collapse:collapse;font-size:0.8125rem }
  .ai-table thead th {
    text-align:left;font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;
    color:var(--ui-text-3);padding:0.625rem 0.875rem;border-bottom:1px solid var(--ui-border);white-space:nowrap
  }
  .ai-table .ai-th-num { text-align:right }
  .ai-table tbody td { padding:0.6875rem 0.875rem;border-bottom:1px solid var(--ui-border);color:var(--ui-text-2);vertical-align:middle }
  .ai-table tbody tr:last-child td { border-bottom:none }
  .ai-table tbody tr.clickable { cursor:pointer;transition:background 0.12s }
  .ai-table tbody tr.clickable:hover { background:var(--ui-surface) }
  .ai-td-num { text-align:right;font-variant-numeric:tabular-nums;font-weight:700;color:var(--ui-text-1) }

  @media (max-width:768px) {
    #view-setup > div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns:1fr !important }
  }
</style>

<script>
  import { requireAuth } from '../../lib/auth';
  import { competencesApi } from '../../lib/api/competences.api';
  import { aiTriedsApi } from '../../lib/api/ai-trieds.api';
  import type { AiTriedDto } from '../../lib/api/types';
  import { fmtDate, scoreColor } from '../../lib/utils';
  import { toast } from '../../lib/toast';

  try { requireAuth(); } catch { throw new Error('redirect'); }

  let aiEnabled      = false;
  let selectedQ      = 10;
  let selectedCompId = '';
  let selectedCompName = '';

  // ── Estado IA ──────────────────────────────────────────────────────────
  aiTriedsApi.status().then(res => {
    const s = res.data!;
    aiEnabled = s.enabled && s.reachable;

    const icon    = document.getElementById('banner-icon')!;
    const title   = document.getElementById('banner-title')!;
    const msg     = document.getElementById('banner-msg')!;
    const badge   = document.getElementById('banner-badge')!;
    const banner  = document.getElementById('ai-banner')!;
    const startBtn = document.getElementById('start-btn') as HTMLButtonElement;

    if (aiEnabled) {
      icon.innerHTML = `<svg width="18" height="18" fill="none" stroke="#059669" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>`;
      icon.style.background = '#D1FAE5';
      banner.style.cssText += ';background:#F0FDF4;border-color:#A7F3D0';
      title.textContent = 'Módulo de IA activo y disponible';
      title.style.color = '#059669';
      msg.textContent   = 'Puedes iniciar una sesión de práctica adaptativa en cualquier momento.';
      badge.textContent = 'Disponible';
      badge.style.cssText = 'background:#D1FAE5;color:#059669;font-size:0.6875rem;font-weight:700;padding:4px 12px;border-radius:20px;flex-shrink:0';
    } else {
      icon.innerHTML = `<svg width="18" height="18" fill="none" stroke="#DC2626" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;
      icon.style.background = '#FEE2E2';
      banner.style.cssText += ';background:#FEF2F2;border-color:#FECACA';
      title.textContent = 'Módulo de IA no disponible';
      title.style.color = '#DC2626';
      msg.textContent   = 'El servicio no está disponible en este momento. Puedes usar las pruebas del banco de preguntas.';
      badge.textContent = 'No disponible';
      badge.style.cssText = 'background:#FEE2E2;color:#DC2626;font-size:0.6875rem;font-weight:700;padding:4px 12px;border-radius:20px;flex-shrink:0';
      startBtn.style.cursor = 'not-allowed';
    }
  }).catch(() => {
    document.getElementById('banner-title')!.textContent = 'No se pudo verificar el módulo IA';
  });

  // ── Competencias ────────────────────────────────────────────────────────
  competencesApi.findAll(true).then(res => {
    const sel = document.getElementById('setup-comp') as HTMLSelectElement;
    sel.innerHTML = '<option value="">Selecciona una competencia...</option>';
    (res.data ?? []).forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.competenceId;
      opt.textContent = c.competenceName;
      sel.appendChild(opt);
    });
    sel.addEventListener('change', () => {
      selectedCompId   = sel.value;
      const opt = sel.options[sel.selectedIndex];
      selectedCompName = opt ? opt.textContent ?? '' : '';
      validateForm();
    });
  }).catch(() => {});

  // ── Pills cantidad ──────────────────────────────────────────────────────
  document.querySelector<HTMLButtonElement>('.qpill[data-q="10"]')?.classList.add('active');
  document.querySelectorAll<HTMLButtonElement>('.qpill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.qpill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedQ = Number(btn.dataset.q);
      validateForm();
    });
  });

  function validateForm() {
    const btn = document.getElementById('start-btn') as HTMLButtonElement;
    const ok  = aiEnabled && selectedCompId !== '' && selectedQ > 0;
    btn.disabled      = !ok;
    btn.style.opacity = ok ? '1' : '0.5';
    btn.style.cursor  = ok ? 'pointer' : 'not-allowed';
  }

  // ── Abrir modal pre-inicio ──────────────────────────────────────────────
  document.getElementById('start-btn')?.addEventListener('click', () => {
    if (!selectedCompId || !selectedQ || !aiEnabled) return;

    // Llenar datos del modal
    document.getElementById('ps-subtitle')!.textContent  = selectedCompName;
    document.getElementById('ps-q-count')!.textContent   = String(selectedQ);
    document.getElementById('ps-est-time')!.textContent  = String(Math.max(5, Math.round(selectedQ * 1.5)));
    document.getElementById('prestart-modal')!.style.display = 'flex';
  });

  document.getElementById('ps-cancel')?.addEventListener('click', () => {
    document.getElementById('prestart-modal')!.style.display = 'none';
  });

  // ── Confirmar e iniciar ─────────────────────────────────────────────────
  document.getElementById('ps-confirm')?.addEventListener('click', async () => {
    document.getElementById('prestart-modal')!.style.display = 'none';
    const desc = (document.getElementById('setup-desc') as HTMLInputElement).value.trim() || undefined;
    const errEl = document.getElementById('setup-error')!;
    errEl.style.display = 'none';

    window.rpLoader?.show('Generando la primera pregunta con IA...');
    try {
      const res = await aiTriedsApi.start(selectedCompId, selectedQ, desc);
      const triedId = res.data!.tried.aiTriedId;
      window.location.href = `/ai-practice/exam?tried=${triedId}&comp=${selectedCompId}&total=${selectedQ}`;
    } catch (err: any) {
      window.rpLoader?.hide();
      errEl.textContent  = err?.message ?? 'No se pudo iniciar la sesión. Inténtalo de nuevo.';
      errEl.style.display = 'block';
    }
  });

  // ── Historial (tabla) + contadores ───────────────────────────────────────
  const esc = (v: string) => v.replace(/[&<>"]/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c] as string));

  aiTriedsApi.findMy(0, 100).then(res => {
    const tbody   = document.getElementById('hist-tbody')!;
    const countEl = document.getElementById('hist-count')!;
    const items   = res.data?.content ?? [];
    countEl.textContent = `${res.data?.totalElements ?? items.length} sesión(es)`;

    // Contadores por estado (se consumen de verdad).
    const finished  = items.filter(s => s.status === 'FINISHED').length;
    const progress  = items.filter(s => s.status === 'IN_PROGRESS').length;
    const abandoned = items.filter(s => s.status === 'ABANDONED').length;
    document.getElementById('ai-stat-total')!.textContent     = String(items.length);
    document.getElementById('ai-stat-finished')!.textContent  = String(finished);
    document.getElementById('ai-stat-progress')!.textContent  = String(progress);
    document.getElementById('ai-stat-abandoned')!.textContent = String(abandoned);

    tbody.innerHTML = '';
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--ui-text-3)">No tienes sesiones aún. ¡Inicia tu primera práctica!</td></tr>';
      return;
    }

    const STATUS: Record<string, { label: string; color: string; bg: string }> = {
      FINISHED:    { label: 'Finalizada',  color: '#059669', bg: '#D1FAE5' },
      IN_PROGRESS: { label: 'En progreso', color: '#6366F1', bg: '#EDE9FE' },
      ABANDONED:   { label: 'Abandonada',  color: '#DC2626', bg: '#FEE2E2' },
      ANULADO:     { label: 'Anulada',     color: '#991B1B', bg: '#FEE2E2' },
    };

    items.forEach((s: AiTriedDto) => {
      const st        = STATUS[s.status] ?? { label: s.status, color: '#6B7280', bg: '#F3F4F6' };
      const generated = s.questionsGenerated ?? s.totalQuestions;
      const correct   = s.correctAnswers ?? 0;
      // El puntaje es sobre el total posible de las preguntas generadas (no /100).
      const maxPts    = s.maxPossibleScore ?? 0;
      const sc        = scoreColor(maxPts > 0 ? ((s.score ?? 0) / maxPts) * 100 : 0);
      const resumable = s.status === 'IN_PROGRESS';

      const tr = document.createElement('tr');
      if (resumable) {
        tr.className = 'clickable';
        tr.onclick = () => { window.location.href = `/ai-practice/exam?tried=${s.aiTriedId}&resume=1`; };
      }
      const scoreCell = s.score != null
        ? `<span style="color:${sc};font-weight:900">${s.score.toFixed(0)}</span><span style="color:var(--ui-text-3);font-weight:600"> / ${maxPts || '–'}</span>`
        : '<span style="color:var(--ui-text-3)">–</span>';

      tr.innerHTML = `
        <td>
          <div style="font-weight:700;color:var(--ui-text-1);max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(s.description ?? 'Sesión de práctica')}</div>
          ${resumable ? '<span style="font-size:0.625rem;background:#EDE9FE;color:#6366F1;padding:1px 7px;border-radius:8px;font-weight:700">Reanudar →</span>' : ''}
        </td>
        <td><span style="font-size:0.6875rem;font-weight:700;padding:3px 9px;border-radius:12px;background:${st.bg};color:${st.color}">${st.label}</span></td>
        <td class="ai-td-num">${correct}<span style="color:var(--ui-text-3);font-weight:500"> / ${s.answeredQuestions ?? generated}</span></td>
        <td class="ai-td-num">${generated}</td>
        <td class="ai-td-num">${s.totalQuestions}</td>
        <td class="ai-td-num">${scoreCell}</td>
        <td style="white-space:nowrap;color:var(--ui-text-3);font-size:0.75rem">${fmtDate(s.finishedAt ?? s.attemptTimestamp)}</td>`;
      tbody.appendChild(tr);
    });
  }).catch(() => {
    document.getElementById('hist-tbody')!.innerHTML =
      '<tr><td colspan="7" style="text-align:center;padding:1.5rem;color:var(--ui-text-3)">Error al cargar el historial</td></tr>';
  });
</script>