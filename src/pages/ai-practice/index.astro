---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Práctica con IA" currentPage="ai-practice">

  <!-- Setup view -->
  <div id="view-setup">
    <div style="margin-bottom:1.25rem">
      <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
        <a href="/dashboard" style="color:var(--ui-text-3);text-decoration:none">Dashboard</a>
        <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Práctica con IA</span>
      </div>
      <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 4px;letter-spacing:-0.5px">Práctica adaptativa con IA</h1>
      <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">La IA genera preguntas únicas y adapta la dificultad a tu nivel en tiempo real.</p>
    </div>

    <!-- Banner estado IA -->
    <div id="ai-banner" style="border-radius:14px;padding:1rem 1.25rem;margin-bottom:1.25rem;display:flex;align-items:flex-start;gap:10px;border:1px solid var(--ui-border);background:var(--ui-card)">
      <div id="banner-icon" style="width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--ui-surface)">
        <div style="width:18px;height:18px;border-radius:50%;border:2.5px solid rgba(99,102,241,0.2);border-top-color:#6366F1;animation:spin 0.85s linear infinite"></div>
      </div>
      <div style="flex:1">
        <p id="banner-title" style="font-size:0.875rem;font-weight:700;color:var(--ui-text-1);margin:0 0 2px">Verificando módulo IA...</p>
        <p id="banner-msg" style="font-size:0.8125rem;color:var(--ui-text-2);margin:0;line-height:1.5"></p>
      </div>
    </div>

    <!-- Grid: form + info -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:1.5rem">
      <!-- Formulario -->
      <div style="background:var(--ui-card);border-radius:16px;padding:1.5rem;border:1px solid var(--ui-border)">
        <h2 style="font-size:0.9375rem;font-weight:800;color:var(--ui-text-1);margin:0 0 1.125rem">Configurar sesión</h2>

        <div class="fg">
          <label class="fl">Competencia *</label>
          <select id="setup-comp" class="fi">
            <option value="">Cargando...</option>
          </select>
        </div>

        <div class="fg">
          <label class="fl">Número de preguntas</label>
          <div style="display:flex;gap:6px;flex-wrap:wrap">
            {[5, 10, 15, 20].map(n => (
              <button class="qpill" data-q={n} type="button">{n}</button>
            ))}
          </div>
        </div>

        <div class="fg">
          <label class="fl">Descripción <span style="font-weight:400;opacity:0.6">(opcional)</span></label>
          <input id="setup-desc" type="text" class="fi" placeholder="Ej: Repaso para el examen" maxlength="200" />
        </div>

        <div id="setup-error" style="display:none;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:8px 12px;font-size:0.8125rem;color:#B91C1C;margin-bottom:0.875rem"></div>

        <button id="start-btn"
          style="width:100%;padding:0.75rem;border-radius:10px;border:none;background:linear-gradient(135deg,#6366F1,#4F46E5);color:white;font-family:inherit;font-weight:700;font-size:0.9375rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 4px 16px rgba(99,102,241,0.35);transition:all 0.2s;opacity:0.5"
          disabled>
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span id="start-label">Iniciar práctica</span>
        </button>
      </div>

      <!-- Info -->
      <div style="display:flex;flex-direction:column;gap:12px">
        <div style="background:linear-gradient(135deg,#1E1B4B,#312E81);border-radius:16px;padding:1.375rem;color:white">
          <div style="width:44px;height:44px;border-radius:12px;background:rgba(99,102,241,0.3);display:flex;align-items:center;justify-content:center;margin-bottom:1rem">
            <svg width="22" height="22" fill="none" stroke="#818CF8" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
          </div>
          <h3 style="font-size:1rem;font-weight:800;margin:0 0 0.5rem">¿Cómo funciona?</h3>
          <ul style="font-size:0.8125rem;color:rgba(255,255,255,0.75);line-height:1.7;padding-left:1rem;margin:0">
            <li>La IA genera preguntas únicas en tiempo real</li>
            <li>Feedback inmediato con explicación tras cada respuesta</li>
            <li>Pistas progresivas en 3 niveles de ayuda</li>
            <li>Dificultad adaptativa según tu desempeño</li>
          </ul>
        </div>
        <div style="background:var(--ui-card);border-radius:14px;padding:1.125rem;border:1px solid var(--ui-border)">
          <p style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--ui-text-3);margin:0 0 6px">Nota técnica</p>
          <p style="font-size:0.8125rem;color:var(--ui-text-2);margin:0;line-height:1.6">Todas las preguntas se generan al inicio (batch). La pantalla de carga puede tardar 10-30 segundos dependiendo del modelo configurado.</p>
        </div>
      </div>
    </div>

    <!-- Historial -->
    <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden">
      <div style="padding:1rem 1.25rem;border-bottom:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between">
        <h2 style="font-size:0.9375rem;font-weight:800;color:var(--ui-text-1);margin:0">Sesiones recientes</h2>
        <span id="hist-count" style="font-size:0.75rem;color:var(--ui-text-3)"></span>
      </div>
      <div id="hist-list" style="padding:0.75rem">
        <div class="skel" style="height:52px;border-radius:10px;margin-bottom:6px"></div>
        <div class="skel" style="height:52px;border-radius:10px;margin-bottom:6px;width:85%"></div>
        <div class="skel" style="height:52px;border-radius:10px;width:90%"></div>
      </div>
    </div>
  </div>

  <!-- Loading overlay al iniciar -->
  <div id="view-starting" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(8px)">
    <div style="background:var(--ui-card);border-radius:20px;padding:2.5rem 2rem;max-width:380px;width:calc(100%-2rem);text-align:center">
      <div style="width:64px;height:64px;border-radius:50%;border:4px solid rgba(99,102,241,0.2);border-top-color:#6366F1;animation:spin 0.85s linear infinite;margin:0 auto 1.25rem"></div>
      <h3 style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem">Generando preguntas con IA...</h3>
      <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0;line-height:1.6">El modelo está pensando. Esto puede tardar entre 10 y 30 segundos. No cierres esta ventana.</p>
      <div style="margin-top:1rem;height:3px;background:var(--ui-surface);border-radius:2px;overflow:hidden">
        <div style="height:100%;background:#6366F1;border-radius:2px;animation:loadBar 2s ease-in-out infinite"></div>
      </div>
    </div>
  </div>
</AppLayout>

<style>
  @keyframes spin    { to { transform: rotate(360deg); } }
  @keyframes shimmer { 0%{background-position:-400px 0}100%{background-position:400px 0} }
  @keyframes loadBar { 0%{width:0%;margin-left:0}50%{width:60%;margin-left:20%}100%{width:0%;margin-left:100%} }

  .fg { display:flex;flex-direction:column;gap:4px;margin-bottom:0.875rem }
  .fl { font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3) }
  .fi {
    padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);
    border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);
    outline:none;transition:border-color 0.2s;width:100%;appearance:none
  }
  .fi:focus { border-color:#6366F1;box-shadow:0 0 0 3px rgba(99,102,241,0.12) }

  .qpill {
    padding:5px 14px;border-radius:20px;font-size:0.8125rem;font-weight:600;
    border:1.5px solid var(--ui-border);background:var(--ui-card);color:var(--ui-text-2);
    cursor:pointer;transition:all 0.15s;font-family:inherit
  }
  .qpill.active { background:#6366F1;color:white;border-color:#6366F1 }

  .skel {
    background:linear-gradient(90deg,var(--ui-surface) 25%,var(--ui-border) 50%,var(--ui-surface) 75%);
    background-size:400px 100%;animation:shimmer 1.5s infinite
  }

  .hist-item {
    display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;
    border:1px solid var(--ui-border);background:var(--ui-surface);margin-bottom:6px;
    cursor:pointer;transition:all 0.15s
  }
  .hist-item:hover { border-color:var(--ui-border-2);background:var(--ui-card) }

  @media (max-width:768px) {
    #view-setup > div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns:1fr !important }
  }
</style>

<script>
  import { requireAuth } from '../../lib/auth';
  import { competencesApi } from '../../lib/api/competences.api';
  import { aiTriedsApi } from '../../lib/api/ai-trieds.api';
  import type { AiTriedDto } from '../../lib/api/types';
  import { fmtDate, scoreColor } from '../../lib/utils';
  import { toast } from '../../lib/toast';

  try { requireAuth(); } catch { throw new Error('redirect'); }

  let aiEnabled = false;
  let selectedQ = 10;
  let selectedCompId = '';

  // Verificar estado IA
  aiTriedsApi.status().then(res => {
    const s = res.data!;
    aiEnabled = s.enabled && s.reachable;

    const icon    = document.getElementById('banner-icon')!;
    const title   = document.getElementById('banner-title')!;
    const msg     = document.getElementById('banner-msg')!;
    const banner  = document.getElementById('ai-banner')!;
    const startBtn = document.getElementById('start-btn') as HTMLButtonElement;

    if (aiEnabled) {
      icon.innerHTML = `<svg width="18" height="18" fill="none" stroke="#059669" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>`;
      icon.style.background = '#D1FAE5';
      banner.style.cssText += ';background:#F0FDF4;border-color:#A7F3D0';
      title.textContent = `IA activa — ${s.model}`;
      title.style.color = '#059669';
      msg.textContent   = s.message;
    } else {
      icon.innerHTML = `<svg width="18" height="18" fill="none" stroke="#DC2626" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;
      icon.style.background = '#FEE2E2';
      banner.style.cssText += ';background:#FEF2F2;border-color:#FECACA';
      title.textContent = 'Módulo IA no disponible';
      title.style.color = '#DC2626';
      msg.textContent   = s.message;
      startBtn.style.cursor = 'not-allowed';
    }
  }).catch(() => {
    document.getElementById('banner-title')!.textContent = 'No se pudo verificar el módulo IA';
  });

  // Cargar competencias
  competencesApi.findAll(true).then(res => {
    const sel = document.getElementById('setup-comp') as HTMLSelectElement;
    sel.innerHTML = '<option value="">— Selecciona una competencia —</option>';
    (res.data ?? []).forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.competenceId;
      opt.textContent = c.competenceName;
      sel.appendChild(opt);
    });
    sel.addEventListener('change', () => {
      selectedCompId = sel.value;
      validateForm();
    });
  }).catch(() => {});

  // Pills de cantidad
  document.querySelector<HTMLButtonElement>('.qpill[data-q="10"]')?.classList.add('active');
  document.querySelectorAll<HTMLButtonElement>('.qpill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.qpill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedQ = Number(btn.dataset.q);
      validateForm();
    });
  });

  function validateForm() {
    const btn = document.getElementById('start-btn') as HTMLButtonElement;
    const ok  = aiEnabled && selectedCompId !== '' && selectedQ > 0;
    btn.disabled = !ok;
    btn.style.opacity = ok ? '1' : '0.5';
    btn.style.cursor  = ok ? 'pointer' : 'not-allowed';
  }

  // Iniciar sesión
  document.getElementById('start-btn')?.addEventListener('click', async () => {
    if (!selectedCompId || !selectedQ) return;
    const desc = (document.getElementById('setup-desc') as HTMLInputElement).value.trim() || undefined;
    const errEl = document.getElementById('setup-error')!;
    errEl.style.display = 'none';

    // Mostrar loading overlay
    document.getElementById('view-starting')!.style.display = 'flex';
    const lbl = document.getElementById('start-label')!;
    lbl.textContent = 'Generando...';

    try {
      const res = await aiTriedsApi.start(selectedCompId, selectedQ, desc);
      const triedId = res.data!.tried.aiTriedId;
      window.location.href = `/ai-practice/exam?tried=${triedId}&comp=${selectedCompId}`;
    } catch (err: any) {
      document.getElementById('view-starting')!.style.display = 'none';
      lbl.textContent = 'Iniciar práctica';
      errEl.textContent  = err?.message ?? 'Error al iniciar la sesión IA.';
      errEl.style.display = 'block';
    }
  });

  // Historial
  aiTriedsApi.findMy(0, 8).then(res => {
    const list    = document.getElementById('hist-list')!;
    const countEl = document.getElementById('hist-count')!;
    const items   = res.data?.content ?? [];
    countEl.textContent = `${res.data?.totalElements ?? 0} sesión(es)`;

    list.innerHTML = '';
    if (!items.length) {
      list.innerHTML = '<p style="font-size:0.875rem;color:var(--ui-text-3);text-align:center;padding:1rem">Sin sesiones. ¡Empieza ahora!</p>';
      return;
    }

    const STATUS: Record<string, { label: string; color: string }> = {
      FINISHED:    { label: 'Finalizada', color: '#059669' },
      IN_PROGRESS: { label: 'En progreso', color: '#6366F1' },
      ABANDONED:   { label: 'Abandonada', color: '#DC2626' },
    };

    items.forEach((s: AiTriedDto) => {
      const sc  = scoreColor(s.score ?? 0);
      const st  = STATUS[s.status] ?? { label: s.status, color: '#6B7280' };
      const div = document.createElement('div');
      div.className = 'hist-item';
      div.onclick = () => {
        if (s.status === 'IN_PROGRESS') {
          window.location.href = `/ai-practice/exam?tried=${s.aiTriedId}`;
        }
      };
      div.innerHTML = `
        <div style="width:36px;height:36px;border-radius:9px;background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.25);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#818CF8">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
        </div>
        <div style="flex:1;min-width:0">
          <p style="font-size:0.8125rem;font-weight:700;color:var(--ui-text-1);margin:0 0 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
            ${s.description ?? 'Sesión de práctica'}
            ${s.status === 'IN_PROGRESS' ? '<span style="font-size:0.625rem;background:#EDE9FE;color:#6366F1;padding:1px 6px;border-radius:8px;margin-left:5px;font-weight:700">Reanudar</span>' : ''}
          </p>
          <div style="display:flex;gap:6px;align-items:center">
            <span style="font-size:0.6875rem;font-weight:700;padding:1px 7px;border-radius:12px;background:${st.color}18;color:${st.color}">${st.label}</span>
            <span style="font-size:0.6875rem;color:var(--ui-text-3)">${fmtDate(s.attemptTimestamp)}</span>
            <span style="font-size:0.6875rem;color:var(--ui-text-3)">${s.totalQuestions} preg.</span>
          </div>
        </div>
        <div style="text-align:right;flex-shrink:0">
          ${s.score != null
            ? `<p style="font-size:1rem;font-weight:900;color:${sc};margin:0">${s.score.toFixed(0)}</p><p style="font-size:0.625rem;color:var(--ui-text-3);margin:0">/100</p>`
            : `<p style="font-size:0.75rem;color:var(--ui-text-3);margin:0">${s.correctAnswers ?? 0}/${s.totalQuestions}</p>`}
        </div>`;
      list.appendChild(div);
    });
  }).catch(() => {
    document.getElementById('hist-list')!.innerHTML =
      '<p style="font-size:0.875rem;color:var(--ui-text-3);text-align:center;padding:1rem">Error al cargar historial</p>';
  });
</script>