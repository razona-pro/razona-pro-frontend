---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="Práctica adaptativa con IA">
  <div class="exam-shell">

    <!-- HEADER -->
    <header class="exam-header">
      <div style="display:flex;align-items:center;gap:8px;flex-shrink:0">
        <div style="width:28px;height:28px;border-radius:7px;background:linear-gradient(135deg,#7C3AED,#5B21B6);display:flex;align-items:center;justify-content:center;color:white">
          <Icon name="tabler:robot" size={16} />
        </div>
        <span style="font-size:0.875rem;font-weight:700;color:var(--ui-text-1)">Práctica <strong style="color:#7C3AED">Adaptativa IA</strong></span>
      </div>

      <div style="flex:1;display:flex;align-items:center;gap:8px;min-width:0;overflow:hidden;padding:0 0.75rem">
        <span id="ai-comp-badge" style="padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;flex-shrink:0;background:#EDE9FE;color:#7C3AED">...</span>
        <span id="ai-session-label" style="font-size:0.8125rem;font-weight:600;color:var(--ui-text-1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Sesión adaptativa</span>
      </div>

      <div style="display:flex;align-items:center;gap:8px;flex-shrink:0">
        <div style="display:flex;align-items:center;gap:5px;padding:5px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:10px;font-size:0.8125rem;color:var(--ui-text-2)">
          <Icon name="tabler:brain" size={13} />
          <span id="q-count-label">0 / ?</span>
        </div>
        <button id="finish-btn-header" title="Finalizar sesión"
          style="width:34px;height:34px;border-radius:8px;background:transparent;border:1.5px solid var(--ui-border);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--ui-text-3);transition:all 0.2s"
          onmouseover="this.style.borderColor='#7C3AED';this.style.color='#7C3AED';this.style.background='#EDE9FE'"
          onmouseout="this.style.borderColor='var(--ui-border)';this.style.color='var(--ui-text-3)';this.style.background='transparent'">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
      </div>
    </header>

    <!-- BODY -->
    <div class="exam-body">
      <!-- Sidebar -->
      <aside class="exam-sidebar">
        <div style="padding:1rem 0.875rem;display:flex;flex-direction:column;gap:1rem;height:100%">
          <p style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--ui-text-3);margin:0">Progreso IRT</p>

          <div style="background:var(--ui-surface);border-radius:12px;padding:12px;border:1px solid var(--ui-border)">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
              <span style="font-size:0.625rem;color:var(--ui-text-3);font-weight:600">Nivel estimado (θ)</span>
              <span id="theta-val" style="font-size:0.75rem;font-weight:800;color:#7C3AED">-</span>
            </div>
            <div style="height:6px;background:var(--ui-border);border-radius:3px;overflow:hidden">
              <div id="theta-bar" style="height:100%;background:linear-gradient(to right,#7C3AED,#A78BFA);border-radius:3px;width:50%;transition:width 0.8s ease"></div>
            </div>
            <div style="display:flex;justify-content:space-between;margin-top:4px">
              <span style="font-size:0.5rem;color:var(--ui-text-3)">Básico</span>
              <span style="font-size:0.5rem;color:var(--ui-text-3)">Avanzado</span>
            </div>
          </div>

          <div style="display:flex;flex-direction:column;gap:6px">
            <div style="display:flex;justify-content:space-between;font-size:0.75rem">
              <span style="color:var(--ui-text-3)">Correctas</span>
              <span id="stat-correct" style="font-weight:700;color:#059669">0</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:0.75rem">
              <span style="color:var(--ui-text-3)">Incorrectas</span>
              <span id="stat-wrong" style="font-weight:700;color:#DC2626">0</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:0.75rem">
              <span style="color:var(--ui-text-3)">Respondidas</span>
              <span id="stat-answered" style="font-weight:700;color:var(--ui-text-1)">0 / ?</span>
            </div>
          </div>

          <div style="background:linear-gradient(135deg,#EDE9FE,#DDD6FE);border-radius:10px;padding:10px 12px;border:1px solid #C4B5FD;margin-top:auto">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px">
              <span style="font-size:0.625rem;font-weight:700;color:#6D28D9;text-transform:uppercase;letter-spacing:0.05em">Adaptativo IRT</span>
            </div>
            <p style="font-size:0.6875rem;color:#5B21B6;margin:0;line-height:1.4">La dificultad se ajusta según tu desempeño en tiempo real.</p>
          </div>

          <button id="finish-btn-sidebar"
            style="width:100%;padding:0.5625rem;border-radius:9px;background:linear-gradient(135deg,#7C3AED,#5B21B6);color:white;font-family:inherit;font-weight:700;font-size:0.75rem;cursor:pointer;border:none;box-shadow:0 3px 10px rgba(124,58,237,0.28);display:flex;align-items:center;justify-content:center;gap:5px">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
            Finalizar sesión
          </button>
        </div>
      </aside>

      <!-- Main -->
      <main class="exam-main">
        <!-- Loading -->
        <div id="ai-loading" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:300px;gap:1rem">
          <div style="width:52px;height:52px;border-radius:50%;border:3px solid rgba(124,58,237,0.15);border-top-color:#7C3AED;animation:spin 0.85s linear infinite"></div>
          <p style="font-size:0.875rem;color:var(--ui-text-3)">Cargando sesión adaptativa...</p>
        </div>

        <!-- Error IA -->
        <div id="ai-unavailable" style="display:none;text-align:center;padding:4rem 2rem">
          <div style="width:64px;height:64px;border-radius:16px;background:#FEE2E2;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
            <svg width="28" height="28" fill="none" stroke="#DC2626" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h2 style="font-size:1.125rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem">Error al cargar la sesión</h2>
          <p id="error-msg" style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.5rem;line-height:1.6">No se pudo cargar la sesión de práctica.</p>
          <a href="/ai-practice" style="padding:0.6875rem 1.5rem;border-radius:10px;background:linear-gradient(135deg,#7C3AED,#5B21B6);color:white;text-decoration:none;font-weight:700;font-size:0.875rem">Volver</a>
        </div>

        <!-- Carta de pregunta -->
        <div id="question-card" style="display:none;max-width:760px;margin:0 auto;width:100%">

          <!-- Progreso -->
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:1.25rem">
            <div style="flex:1;height:5px;background:var(--ui-surface);border-radius:3px;overflow:hidden;border:1px solid var(--ui-border)">
              <div id="q-progress-fill" style="height:100%;border-radius:3px;background:linear-gradient(to right,#7C3AED,#A78BFA);width:0%;transition:width 0.5s ease"></div>
            </div>
            <span id="q-progress-label" style="font-size:0.75rem;font-weight:600;color:var(--ui-text-3);white-space:nowrap;flex-shrink:0">Pregunta 1</span>
          </div>

          <!-- Cabecera -->
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:1rem">
            <span id="q-number-badge" style="font-size:0.6875rem;font-weight:800;color:#7C3AED;background:#EDE9FE;border:1.5px solid #C4B5FD;padding:3px 10px;border-radius:20px">P1</span>
            <span id="q-comp-chip" style="display:none;padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;background:#EEF2FF;color:#4F46E5"></span>
            <span id="q-diff-badge" style="padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700"></span>
            <span id="q-answered-badge" style="display:none;padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;background:#D1FAE5;color:#059669">✓ Respondida</span>
            <button id="ai-doubt-btn"
              style="display:none;margin-left:auto;padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;border:1.5px solid #FDE68A;background:#FEF3C7;color:#92400E;cursor:pointer;font-family:inherit">
              ⚠ Reportar duda
            </button>
          </div>

          <!-- Enunciado -->
          <div style="background:var(--ui-card);border-radius:14px;padding:1.5rem 1.625rem;border:1px solid var(--ui-border);margin-bottom:1rem">
            <div id="q-statement" style="font-size:1rem;font-weight:500;color:var(--ui-text-1);line-height:1.85;margin:0"></div>
          </div>

          <!-- Opciones -->
          <div id="q-options" style="display:flex;flex-direction:column;gap:9px;margin-bottom:1.25rem"></div>

          <!-- Asistente IA (chat-style) -->
          <div id="hint-section" style="margin-bottom:1.125rem;border:1.5px solid #C4B5FD;border-radius:14px;overflow:hidden;background:var(--ui-card)">
            <!-- Header del asistente -->
            <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:linear-gradient(135deg,#EDE9FE,#DDD6FE);border-bottom:1px solid #C4B5FD">
              <div style="width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,#7C3AED,#5B21B6);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <svg width="14" height="14" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
              </div>
              <div style="flex:1">
                <p style="font-size:0.8125rem;font-weight:700;color:#4C1D95;margin:0">Asistente IA</p>
                <p style="font-size:0.625rem;color:#7C3AED;margin:0">Pide una pista si la necesitas - no penaliza el puntaje</p>
              </div>
              <div style="display:flex;gap:6px">
                <button class="hbtn" data-level="1" type="button">Pista 1</button>
                <button class="hbtn" data-level="2" type="button" disabled>Pista 2</button>
                <button class="hbtn" data-level="3" type="button" disabled>Pista 3</button>
              </div>
            </div>
            <!-- Área de chat -->
            <div id="hint-box" style="display:none;padding:12px 14px">
              <div style="display:flex;align-items:flex-start;gap:10px">
                <div style="width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,#7C3AED,#5B21B6);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px">
                  <svg width="12" height="12" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
                </div>
                <div style="flex:1;background:#EDE9FE;border-radius:0 12px 12px 12px;padding:10px 12px">
                  <div id="hint-loading" style="display:none;align-items:center;gap:6px;font-size:0.8125rem;color:#7C3AED">
                    <span style="display:inline-flex;gap:3px">
                      <span style="width:5px;height:5px;border-radius:50%;background:#7C3AED;animation:typingDot 1.2s 0s infinite"></span>
                      <span style="width:5px;height:5px;border-radius:50%;background:#7C3AED;animation:typingDot 1.2s 0.2s infinite"></span>
                      <span style="width:5px;height:5px;border-radius:50%;background:#7C3AED;animation:typingDot 1.2s 0.4s infinite"></span>
                    </span>
                    Generando orientación...
                  </div>
                  <p id="hint-text" style="font-size:0.875rem;color:#4C1D95;margin:0;line-height:1.7"></p>
                  <p style="font-size:0.5625rem;color:#7C3AED;margin:5px 0 0;font-weight:600;text-transform:uppercase;letter-spacing:0.05em">No revela la respuesta directa</p>
                </div>
              </div>
            </div>
            <!-- Estado inicial -->
            <div id="hint-idle" style="padding:12px 14px;font-size:0.8125rem;color:#7C3AED;text-align:center;opacity:0.7">
              Pide la Pista 1 para recibir orientación sobre esta pregunta
            </div>
          </div>

          <!-- Botón Verificar (procesa la respuesta seleccionada) -->
          <button id="btn-verify" disabled
            style="width:100%;padding:0.75rem;border-radius:12px;border:none;background:var(--ui-surface);color:var(--ui-text-3);font-family:inherit;font-weight:700;font-size:0.9375rem;cursor:not-allowed;margin-bottom:1rem;display:flex;align-items:center;justify-content:center;gap:8px;transition:all 0.18s">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <span id="btn-verify-label">Verificar respuesta</span>
          </button>

          <!-- Resultado de respuesta -->
          <div id="answer-result" style="display:none;border-radius:12px;padding:14px 16px;margin-bottom:1rem;border:1px solid">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
              <span id="result-icon" style="font-size:1.125rem"></span>
              <span id="result-label" style="font-size:0.875rem;font-weight:700"></span>
            </div>
            <div id="result-explanation" style="display:none;font-size:0.8125rem;line-height:1.6;margin-top:6px"></div>
          </div>

          <!-- Navegación -->
          <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-top:0.25rem">
            <div style="font-size:0.8125rem;font-weight:600;color:var(--ui-text-3)">
              <span id="answered-count">0</span> respondidas
            </div>
            <button id="btn-next"
              style="display:inline-flex;align-items:center;gap:6px;padding:0.5rem 1.375rem;border-radius:9px;background:linear-gradient(135deg,#7C3AED,#5B21B6);color:white;border:none;font-family:inherit;font-size:0.8125rem;font-weight:700;cursor:pointer;box-shadow:0 3px 10px rgba(124,58,237,0.28);transition:all 0.15s;opacity:0.4"
              disabled>
              Siguiente <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Modal reportar duda -->
  <div id="ai-doubt-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:350;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
    <div style="background:var(--ui-card);border-radius:18px;padding:2rem;max-width:440px;width:calc(100%-2rem);animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
      <h3 style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem">Reportar duda sobre esta pregunta</h3>
      <p style="font-size:0.8125rem;color:var(--ui-text-2);margin:0 0 1rem;line-height:1.5">Un administrador revisará tu reporte. Puedes continuar con la práctica.</p>
      <div id="ai-doubt-preview" style="background:var(--ui-surface);border-radius:8px;padding:10px 12px;margin-bottom:1rem;font-size:0.8125rem;color:var(--ui-text-2);border:1px solid var(--ui-border);max-height:80px;overflow:hidden;line-height:1.5"></div>
      <textarea id="ai-doubt-message" placeholder="Describe tu duda (opcional)..."
        style="width:100%;padding:10px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);resize:vertical;min-height:80px;outline:none;transition:border-color 0.2s"
        onfocus="this.style.borderColor='#7C3AED'" onblur="this.style.borderColor='var(--ui-border)'"></textarea>
      <div id="ai-doubt-error" style="display:none;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:8px 12px;font-size:0.8125rem;color:#B91C1C;margin-top:0.75rem"></div>
      <div style="display:flex;gap:8px;margin-top:1rem">
        <button id="ai-doubt-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
        <button id="ai-doubt-submit" style="flex:1;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,#D97706,#B45309);color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Enviar reporte</button>
      </div>
    </div>
  </div>

  <!-- Modal finalizar -->
  <div id="finish-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:300;align-items:center;justify-content:center;backdrop-filter:blur(6px)">
    <div style="background:var(--ui-card);border-radius:20px;padding:0;max-width:440px;width:calc(100%-2rem);max-height:90vh;overflow-y:auto;animation:modalIn 0.35s cubic-bezier(0.34,1.46,0.64,1) both;box-shadow:0 20px 60px rgba(0,0,0,0.25)">
      <div style="padding:1.5rem 1.75rem 1.25rem;border-bottom:1px solid var(--ui-border)">
        <h3 style="font-size:1.0625rem;font-weight:800;color:var(--ui-text-1);margin:0 0 4px">Finalizar práctica</h3>
        <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">¿Deseas terminar la sesión adaptativa?</p>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:1.25rem 1.75rem">
        <div style="text-align:center;background:#D1FAE5;border-radius:10px;padding:12px 8px"><p id="finish-modal-correct" style="font-size:1.5rem;font-weight:900;color:#059669;margin:0">0</p><p style="font-size:0.625rem;color:#059669;margin:0;text-transform:uppercase">Correctas</p></div>
        <div style="text-align:center;background:#FEE2E2;border-radius:10px;padding:12px 8px"><p id="finish-modal-wrong" style="font-size:1.5rem;font-weight:900;color:#DC2626;margin:0">0</p><p style="font-size:0.625rem;color:#DC2626;margin:0;text-transform:uppercase">Incorrectas</p></div>
      </div>
      <div style="padding:0 1.75rem 1.5rem;display:flex;gap:10px">
        <button id="finish-modal-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Continuar</button>
        <button id="finish-modal-confirm" style="flex:2;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,#7C3AED,#5B21B6);color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Finalizar sesión</button>
      </div>
    </div>
  </div>

  <!-- Resultados finales -->
  <div id="results-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:400;align-items:center;justify-content:center;backdrop-filter:blur(8px)">
    <div style="background:var(--ui-card);border-radius:24px;padding:2.5rem 2rem;max-width:440px;width:calc(100%-2rem);text-align:center;animation:modalIn 0.4s cubic-bezier(0.34,1.46,0.64,1) both;box-shadow:0 24px 70px rgba(0,0,0,0.25)">
      <div style="width:80px;height:80px;border-radius:50%;margin:0 auto 1.25rem;display:flex;align-items:center;justify-content:center;background:#EDE9FE">
        <svg width="38" height="38" fill="none" stroke="#7C3AED" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      </div>
      <p style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--ui-text-3);margin:0 0 0.25rem">Puntaje final</p>
      <p id="result-score" style="font-size:3.5rem;font-weight:900;margin:0;line-height:1;letter-spacing:-2px;color:#7C3AED">0</p>
      <p id="result-max" style="font-size:0.875rem;color:var(--ui-text-3);margin:0 0 1.5rem">puntos</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:1.25rem">
        <div style="background:var(--ui-surface);border-radius:12px;padding:14px 8px;border:1px solid var(--ui-border)"><p id="res-correct" style="font-size:1.625rem;font-weight:900;color:#059669;margin:0 0 2px">0</p><p style="font-size:0.625rem;color:var(--ui-text-3);margin:0;text-transform:uppercase">Correctas</p></div>
        <div style="background:var(--ui-surface);border-radius:12px;padding:14px 8px;border:1px solid var(--ui-border)"><p id="res-wrong" style="font-size:1.625rem;font-weight:900;color:#DC2626;margin:0 0 2px">0</p><p style="font-size:0.625rem;color:var(--ui-text-3);margin:0;text-transform:uppercase">Incorrectas</p></div>
        <div style="background:var(--ui-surface);border-radius:12px;padding:14px 8px;border:1px solid var(--ui-border)"><p id="res-total" style="font-size:1.625rem;font-weight:900;color:#7C3AED;margin:0 0 2px">0</p><p style="font-size:0.625rem;color:var(--ui-text-3);margin:0;text-transform:uppercase">Total</p></div>
      </div>
      <p id="result-msg" style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.5rem;line-height:1.65"></p>
      <div style="display:flex;gap:8px">
        <a href="/ai-practice" style="flex:1;display:flex;align-items:center;justify-content:center;padding:0.75rem;border-radius:11px;border:1.5px solid var(--ui-border);color:var(--ui-text-1);text-decoration:none;font-weight:600;font-size:0.875rem">Nueva sesión</a>
        <a href="/dashboard" style="flex:1;display:flex;align-items:center;justify-content:center;padding:0.75rem;border-radius:11px;background:linear-gradient(135deg,#7C3AED,#5B21B6);color:white;text-decoration:none;font-weight:700;font-size:0.875rem">Panel de control</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  @keyframes spin    { to { transform: rotate(360deg); } }
  @keyframes modalIn { from{opacity:0;transform:scale(0.9) translateY(12px)}to{opacity:1;transform:scale(1) translateY(0)} }
  @keyframes optSlide { from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:translateX(0)} }
  @keyframes selectPop { 0%{transform:scale(1)}40%{transform:scale(0.97)}100%{transform:scale(1)} }
  @keyframes resultSlide { from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)} }

  .exam-shell { display:flex;flex-direction:column;height:100dvh;overflow:hidden;background:var(--ui-bg-alt);font-family:var(--font-sans); }
  .exam-header { display:flex;align-items:center;padding:0 1.25rem;height:56px;background:var(--ui-card);border-bottom:1px solid var(--ui-border);flex-shrink:0;gap:0.5rem;z-index:20; }
  .exam-body { display:flex;flex:1;overflow:hidden; }
  .exam-sidebar { width:200px;min-width:200px;background:var(--ui-card);border-right:1px solid var(--ui-border);overflow-y:auto;flex-shrink:0; }
  .exam-main { flex:1;overflow-y:auto;padding:1.5rem 1.25rem; }

  .exam-option { display:flex;align-items:stretch;width:100%;background:var(--ui-card);border:1.5px solid var(--ui-border);border-radius:12px;cursor:pointer;transition:border-color 0.18s,background 0.18s,transform 0.18s,box-shadow 0.18s;text-align:left;font-family:inherit;overflow:hidden;animation:optSlide 0.25s ease both; }
  .exam-option:hover:not(.selected):not(.locked) { border-color:#7C3AED;background:rgba(124,58,237,0.03);transform:translateX(3px);box-shadow:0 3px 12px rgba(124,58,237,0.08); }
  .exam-option.selected { border-color:#7C3AED;background:rgba(124,58,237,0.05);animation:selectPop 0.25s ease; }
  .exam-option.selected .opt-letter-col { background:#7C3AED;border-right-color:rgba(124,58,237,0.3); }
  .exam-option.selected .opt-letter-badge { background:rgba(255,255,255,0.25);border-color:transparent;color:white;font-weight:900; }
  .exam-option.selected .opt-body-text { color:var(--ui-text-1);font-weight:600; }
  .exam-option.locked { cursor:default; }
  .exam-option.correct-answer { border-color:#059669!important;background:#F0FDF4!important; }
  .exam-option.correct-answer .opt-letter-col { background:#059669!important; }
  .exam-option.wrong-answer { border-color:#DC2626!important;background:#FEF2F2!important; }
  .exam-option.wrong-answer .opt-letter-col { background:#DC2626!important; }
  .opt-letter-col { width:52px;min-width:52px;display:flex;align-items:center;justify-content:center;background:var(--ui-surface);border-right:1.5px solid var(--ui-border);transition:background 0.18s,border-color 0.18s;flex-shrink:0; }
  .opt-letter-badge { width:28px;height:28px;border-radius:7px;border:1.5px solid var(--ui-border-2);display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:800;color:var(--ui-text-2);background:var(--ui-card);transition:all 0.18s; }
  .opt-body { flex:1;padding:0.9375rem 1rem;display:flex;align-items:center; }
  .opt-body-text { font-size:0.9375rem;color:var(--ui-text-2);line-height:1.65;margin:0;transition:color 0.18s; }

  .hbtn { padding:4px 12px;border-radius:20px;font-size:0.75rem;font-weight:600;border:1.5px solid #C4B5FD;background:#EDE9FE;color:#6D28D9;cursor:pointer;transition:all 0.15s;font-family:inherit; }
  .hbtn:hover:not(:disabled) { background:#7C3AED;color:white;border-color:#7C3AED; }
  .hbtn:disabled { opacity:0.35;cursor:not-allowed; }

  @keyframes typingDot {
    0%,80%,100% { transform: scale(0.6); opacity: 0.4; }
    40% { transform: scale(1.0); opacity: 1; }
  }

  @media(max-width:768px) { .exam-sidebar{display:none;} .exam-main{padding:1rem;} }
</style>

<script>
  import { requireRole, isStudent } from '../../lib/auth';
  import { aiTriedsApi }           from '../../lib/api/ai-trieds.api';
  import { competencesApi }        from '../../lib/api/competences.api';
  import { apiFetch }              from '../../lib/api/client';
  import { getCompStyle }          from '../../lib/utils';
  import { toast }                 from '../../lib/toast';
  import type { AiQuestionDto }    from '../../lib/api/types';

  try { requireRole('STUDENT'); } catch { throw new Error('redirect'); }

  // ── Leer parámetros de URL ────────────────────────────────────────
  const params       = new URLSearchParams(window.location.search);
  const aiTriedId    = params.get('tried') ?? '';   // ← corregido: era 'session'
  const competenceId = params.get('comp')  ?? '';
  const totalQParam  = Number(params.get('total') ?? '10');

  if (!aiTriedId) {
    window.location.replace('/ai-practice');
    throw new Error('Missing params');
  }

  // ── Estado ───────────────────────────────────────────────────────
  let allQuestions:   AiQuestionDto[] = [];   // preguntas generadas hasta ahora
  const compNameById: Record<string, string> = {};   // competenceId → nombre (multi-competencia)
  let currentQ:       AiQuestionDto | null = null;
  let totalQuestions  = totalQParam;
  let answeredCount   = 0;
  let correctCount    = 0;
  let wrongCount      = 0;
  let currentTheta    = 0;
  let sessionFinished = false;
  let answerLocked    = false;
  let pendingIndex: number | null = null;   // opción seleccionada pero aún NO verificada

  // Caché de pistas por pregunta
  const hintCache = new Map<string, Map<number, string>>();

  const DIFF_LABEL: Record<number, string> = {
    1:'Nivel 1', 2:'Nivel 2', 3:'Nivel 3', 4:'Nivel 4', 5:'Nivel 5',
    6:'Nivel 6', 7:'Nivel 7', 8:'Nivel 8', 9:'Nivel 9', 10:'Nivel 10'
  };
  const DIFF_COLOR: Record<string, string> = {};
  const diffColor = (d: number) => d <= 3 ? '#059669' : d <= 6 ? '#D97706' : '#DC2626';
  const diffBg    = (d: number) => d <= 3 ? '#D1FAE5' : d <= 6 ? '#FEF3C7' : '#FEE2E2';
  const LETTERS = ['A','B','C','D','E','F'];

  // ── Utils ────────────────────────────────────────────────────────
  function renderText(el: HTMLElement, raw: string) {
    el.innerHTML = '';
    (raw ?? '').split('\n').forEach((line, i) => {
      if (i > 0) el.appendChild(document.createElement('br'));
      if (line.trim()) el.appendChild(document.createTextNode(line));
    });
  }

  function updateSidebar() {
    const answered = allQuestions.filter(q => q.selectedIndex !== null).length;
    const correct  = allQuestions.filter(q => q.isCorrect === true).length;
    const wrong    = allQuestions.filter(q => q.selectedIndex !== null && q.isCorrect === false).length;

    answeredCount = answered;
    correctCount  = correct;
    wrongCount    = wrong;

    (document.getElementById('stat-correct')  as HTMLElement).textContent = String(correct);
    (document.getElementById('stat-wrong')    as HTMLElement).textContent = String(wrong);
    (document.getElementById('stat-answered') as HTMLElement).textContent = `${answered} / ${totalQuestions}`;
    (document.getElementById('answered-count') as HTMLElement).textContent = String(answered);
    (document.getElementById('q-count-label') as HTMLElement).textContent = `${answered} / ${totalQuestions}`;

    const pct = totalQuestions > 0 ? Math.min(100, (answered / totalQuestions) * 100) : 0;
    (document.getElementById('q-progress-fill') as HTMLElement).style.width = `${pct}%`;

    // Theta visual (0-100 range mappado de -3..+3)
    const thetaPct = Math.min(100, Math.max(0, ((currentTheta + 3) / 6) * 100));
    (document.getElementById('theta-bar') as HTMLElement).style.width = `${thetaPct}%`;
    (document.getElementById('theta-val') as HTMLElement).textContent = currentTheta.toFixed(2);
  }

  // ── Renderizar pregunta ─────────────────────────────────────────
  function renderQuestion(q: AiQuestionDto) {
    currentQ     = q;
    answerLocked = false;
    pendingIndex = null;

    const qNum = (allQuestions.indexOf(q)) + 1;
    (document.getElementById('q-number-badge') as HTMLElement).textContent   = `P${qNum}`;
    (document.getElementById('q-progress-label') as HTMLElement).textContent = `Pregunta ${qNum} de ${totalQuestions}`;

    // Competencia de esta pregunta (multi-competencia)
    const compChip = document.getElementById('q-comp-chip') as HTMLElement;
    if (q.competenceId) {
      compChip.textContent = compNameById[q.competenceId] ?? q.competenceId;
      compChip.style.display = 'inline';
    } else {
      compChip.style.display = 'none';
    }

    // Dificultad
    const diff   = q.difficultyLevel ?? 5;
    const diffEl = document.getElementById('q-diff-badge')!;
    diffEl.textContent = `Dif. ${diff}/10`;
    diffEl.style.cssText = `background:${diffBg(diff)};color:${diffColor(diff)};padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700`;

    // Respondida badge
    const answeredBadge = document.getElementById('q-answered-badge')!;
    answeredBadge.style.display = q.selectedIndex !== null ? 'inline' : 'none';

    // Botón duda
    const doubtBtn = document.getElementById('ai-doubt-btn')!;
    doubtBtn.style.display = isStudent() ? 'inline' : 'none';

    // Enunciado
    const stmtEl = document.getElementById('q-statement')!;
    renderText(stmtEl, q.statement);

    // Opciones - se muestran en orden original (IA ya las varía)
    const optsEl = document.getElementById('q-options')!;
    optsEl.innerHTML = '';
    (q.options ?? []).forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.className = 'exam-option';
      btn.style.animationDelay = `${i * 0.045}s`;
      btn.dataset.index = String(i);  // índice original para submitAnswer

      // Si ya fue respondida, marcar la seleccionada
      const isSelected = q.selectedIndex === i;
      if (isSelected) btn.classList.add('selected');
      if (q.selectedIndex !== null) {
        btn.classList.add('locked');
        // Marcar correcta e incorrecta
        if (i === q.selectedIndex && q.isCorrect === false) btn.classList.add('wrong-answer');
        // La correcta no la conocemos del lado cliente antes de responder
      }

      const letterCol = document.createElement('div');
      letterCol.className = 'opt-letter-col';
      const letterBadge = document.createElement('span');
      letterBadge.className = 'opt-letter-badge';
      letterBadge.textContent = LETTERS[i] ?? String(i + 1);
      letterCol.appendChild(letterBadge);

      const body = document.createElement('div');
      body.className = 'opt-body';
      const textP = document.createElement('p');
      textP.className = 'opt-body-text';
      renderText(textP, opt.text ?? '');
      body.appendChild(textP);

      btn.appendChild(letterCol);
      btn.appendChild(body);

      if (q.selectedIndex === null) {
        btn.addEventListener('click', () => pickOption(i, btn));
      }
      optsEl.appendChild(btn);
    });

    // Pistas
    resetHints(q);

    // Resultado previo si ya respondida
    if (q.selectedIndex !== null) {
      // Ya respondida, mostrar estado
      const resultEl = document.getElementById('answer-result')!;
      if (q.isCorrect === true) {
        resultEl.style.cssText = 'display:block;border-radius:12px;padding:14px 16px;margin-bottom:1rem;border:1.5px solid #059669;background:#F0FDF4';
        document.getElementById('result-icon')!.textContent = '✓';
        const lbl = document.getElementById('result-label')!;
        lbl.textContent = '¡Correcta!'; lbl.style.color = '#059669';
      } else if (q.isCorrect === false) {
        resultEl.style.cssText = 'display:block;border-radius:12px;padding:14px 16px;margin-bottom:1rem;border:1.5px solid #DC2626;background:#FEF2F2';
        document.getElementById('result-icon')!.textContent = '✗';
        const lbl = document.getElementById('result-label')!;
        lbl.textContent = 'Incorrecta'; lbl.style.color = '#DC2626';
      } else {
        resultEl.style.display = 'none';
      }
      document.getElementById('result-explanation')!.style.display = 'none';
    } else {
      (document.getElementById('answer-result') as HTMLElement).style.display = 'none';
    }

    // Botón Verificar: visible solo si la pregunta aún no fue respondida
    if (q.selectedIndex === null) {
      setVerifyVisible(true);
      setVerifyEnabled(false);
      const vl = document.getElementById('btn-verify-label');
      if (vl) vl.textContent = 'Verificar respuesta';
    } else {
      setVerifyVisible(false);
    }

    // Botón siguiente: habilitado solo cuando la pregunta ya está verificada/respondida
    enableNextBtn(q.selectedIndex !== null);

    // Mostrar card
    (document.getElementById('ai-loading') as HTMLElement).style.display  = 'none';
    (document.getElementById('question-card') as HTMLElement).style.display = 'block';

    updateSidebar();
  }

  function enableNextBtn(enabled: boolean) {
    const btn = document.getElementById('btn-next') as HTMLButtonElement;
    btn.disabled = !enabled;
    btn.style.opacity = enabled ? '1' : '0.4';
  }

  // ── Helpers del botón Verificar ─────────────────────────────────
  function setVerifyEnabled(enabled: boolean) {
    const btn = document.getElementById('btn-verify') as HTMLButtonElement;
    if (!btn) return;
    btn.disabled = !enabled;
    btn.style.cursor     = enabled ? 'pointer' : 'not-allowed';
    btn.style.background = enabled ? 'linear-gradient(135deg,#7C3AED,#5B21B6)' : 'var(--ui-surface)';
    btn.style.color      = enabled ? 'white' : 'var(--ui-text-3)';
  }
  function setVerifyVisible(visible: boolean) {
    const btn = document.getElementById('btn-verify') as HTMLElement;
    if (btn) btn.style.display = visible ? 'flex' : 'none';
  }

  // ── Seleccionar opción (solo marca; NO procesa hasta Verificar) ──
  function pickOption(index: number, btn: HTMLButtonElement) {
    if (answerLocked || !currentQ) return;
    pendingIndex = index;
    document.querySelectorAll<HTMLElement>('.exam-option').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    setVerifyEnabled(true);
  }

  // ── Verificar la respuesta seleccionada ─────────────────────────
  async function verifyAnswer() {
    if (answerLocked || !currentQ || pendingIndex === null) return;
    const selectedIndex = pendingIndex;
    answerLocked = true;
    setVerifyEnabled(false);
    const verifyLabel = document.getElementById('btn-verify-label');
    if (verifyLabel) verifyLabel.textContent = 'Verificando...';

    const clickedBtn = document.querySelector<HTMLButtonElement>(`.exam-option[data-index="${selectedIndex}"]`)!;
    // Bloquear todos los botones de opción
    document.querySelectorAll<HTMLElement>('.exam-option').forEach(b => b.classList.add('locked'));

    try {
      // submitAnswer con selectedIndex (número), no optionId
      const res  = await aiTriedsApi.submitAnswer(aiTriedId, currentQ.aiQuestionId, selectedIndex);
      const data = res.data!;

      const isCorrect = data.isCorrect;

      // Actualizar pregunta actual en memoria
      currentQ.selectedIndex = selectedIndex;
      currentQ.isCorrect     = isCorrect;

      // Marcar opciones visualmente
      if (isCorrect) {
        clickedBtn.classList.add('correct-answer');
      } else {
        clickedBtn.classList.add('wrong-answer');
        // Marcar la correcta
        const correctIdx = data.correctIndex;
        document.querySelectorAll<HTMLElement>('.exam-option').forEach((b, i) => {
          if (i === correctIdx) b.classList.add('correct-answer');
        });
      }

      // Mostrar resultado
      const resultEl  = document.getElementById('answer-result')!;
      const resultIcon = document.getElementById('result-icon')!;
      const resultLbl  = document.getElementById('result-label')!;
      const resultExp  = document.getElementById('result-explanation')!;

      if (isCorrect) {
        resultEl.style.cssText = 'display:block;border-radius:12px;padding:14px 16px;margin-bottom:1rem;border:1.5px solid #059669;background:#F0FDF4;animation:resultSlide 0.3s ease';
        resultIcon.textContent = '✓';
        resultLbl.textContent  = '¡Correcta!'; resultLbl.style.color = '#059669';
      } else {
        resultEl.style.cssText = 'display:block;border-radius:12px;padding:14px 16px;margin-bottom:1rem;border:1.5px solid #DC2626;background:#FEF2F2;animation:resultSlide 0.3s ease';
        resultIcon.textContent = '✗';
        resultLbl.textContent  = 'Incorrecta'; resultLbl.style.color = '#DC2626';
      }

      if (data.explanation) {
        resultExp.style.display = 'block';
        resultExp.style.color   = isCorrect ? '#065F46' : '#7F1D1D';
        renderText(resultExp, data.explanation);
      } else {
        resultExp.style.display = 'none';
      }

      updateSidebar();

      // Respuesta verificada: ocultar Verificar (Siguiente ya queda habilitado)
      setVerifyVisible(false);

      // ¿Finalizó automáticamente?
      if (data.finished) {
        sessionFinished = true;
        const nextBtn = document.getElementById('btn-next') as HTMLButtonElement;
        nextBtn.innerHTML = `Ver resultados`;
        nextBtn.style.background = 'linear-gradient(135deg,#059669,#047857)';
        nextBtn.disabled     = false;
        nextBtn.style.opacity = '1';
        nextBtn.onclick = () => showResults(data.finalScore ?? 0, data.correctAnswers, data.totalAnswered);
      } else {
        enableNextBtn(true);
      }

    } catch (err: any) {
      toast.error('Error al verificar respuesta', { description: err?.message });
      // Permitir reintentar: se mantiene la selección y se reactiva Verificar
      answerLocked = false;
      document.querySelectorAll<HTMLElement>('.exam-option').forEach(b => b.classList.remove('locked'));
      setVerifyEnabled(true);
      const vl = document.getElementById('btn-verify-label');
      if (vl) vl.textContent = 'Verificar respuesta';
    }
  }
  document.getElementById('btn-verify')?.addEventListener('click', verifyAnswer);

  // ── Siguiente pregunta ──────────────────────────────────────────
  async function loadNextQuestion() {
    (document.getElementById('question-card') as HTMLElement).style.display = 'none';
    (document.getElementById('ai-loading') as HTMLElement).style.display    = 'flex';

    try {
      const res = await aiTriedsApi.nextQuestion(aiTriedId);
      if (!res.data) throw new Error('Sin pregunta disponible');
      allQuestions.push(res.data);
      renderQuestion(res.data);
    } catch {
      // Mensaje genérico: no exponer el error técnico/IA en la tarjeta.
      toast.error('Error al cargar la siguiente pregunta. Intenta de nuevo.');
      (document.getElementById('ai-loading') as HTMLElement).style.display  = 'none';
      (document.getElementById('question-card') as HTMLElement).style.display = 'block';
    }
  }

  document.getElementById('btn-next')?.addEventListener('click', async () => {
    if (sessionFinished) return;
    // Ver si hay más preguntas por generar
    const answered = allQuestions.filter(q => q.selectedIndex !== null).length;
    if (answered < totalQuestions) {
      await loadNextQuestion();
    }
    // Si ya se generaron todas, el botón ya habrá cambiado a "Ver resultados"
  });

  // ── Pistas ──────────────────────────────────────────────────────
  function setHintIdle(show: boolean) {
    const idle = document.getElementById('hint-idle');
    const box  = document.getElementById('hint-box');
    if (idle) idle.style.display = show ? 'block' : 'none';
    if (box  && show) box.style.display = 'none';
  }

  function resetHints(q: AiQuestionDto) {
    const usedHints = q.hintsUsed ?? 0;
    document.querySelectorAll<HTMLButtonElement>('.hbtn').forEach(btn => {
      const lvl = Number(btn.dataset.level);
      btn.disabled = lvl > usedHints + 1;
    });
    const hintBox = document.getElementById('hint-box')!;
    const qHints  = hintCache.get(q.aiQuestionId) ?? new Map<number, string>();
    if (qHints.size > 0) {
      const latestLvl = Math.max(...qHints.keys());
      hintBox.style.display = 'block';
      setHintIdle(false);
      (document.getElementById('hint-text') as HTMLElement).textContent = qHints.get(latestLvl)!;
    } else {
      hintBox.style.display = 'none';
      setHintIdle(true);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.hbtn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!currentQ || currentQ.selectedIndex !== null) return;
      const level  = Number(btn.dataset.level);
      const qKey   = currentQ.aiQuestionId;
      const qHints = hintCache.get(qKey) ?? new Map<number, string>();

      if (qHints.has(level)) {
        (document.getElementById('hint-box') as HTMLElement).style.display = 'block';
        setHintIdle(false);
        (document.getElementById('hint-text') as HTMLElement).textContent  = qHints.get(level)!;
        return;
      }

      const hintBox   = document.getElementById('hint-box')!;
      const hintText  = document.getElementById('hint-text')!;
      const loading   = document.getElementById('hint-loading')!;
      hintBox.style.display  = 'block';
      setHintIdle(false);
      hintText.textContent   = '';
      loading.style.display  = 'flex';
      btn.disabled = true;

      try {
        // ← CORRECTO: usa aiTriedsApi.getHint (endpoint de IA), no aiHintApi
        const res  = await aiTriedsApi.getHint(aiTriedId, qKey, level);
        const text = res.data!.hint;
        qHints.set(level, text);
        hintCache.set(qKey, qHints);
        hintText.textContent = text;

        // Actualizar hintsUsed en la pregunta local
        if (currentQ) currentQ.hintsUsed = Math.max(currentQ.hintsUsed ?? 0, level);

        // Habilitar siguiente nivel
        const nextBtn = document.querySelector<HTMLButtonElement>(`.hbtn[data-level="${level + 1}"]`);
        if (nextBtn && level < 3) nextBtn.disabled = false;
      } catch (err: any) {
        hintText.textContent = 'No se pudo obtener la pista.';
      } finally {
        loading.style.display = 'none';
        btn.disabled = false;
      }
    });
  });

  // ── Reportar duda ───────────────────────────────────────────────
  document.getElementById('ai-doubt-btn')?.addEventListener('click', () => {
    if (!currentQ) return;
    const preview = document.getElementById('ai-doubt-preview')!;
    preview.textContent = currentQ.statement.substring(0, 120) + (currentQ.statement.length > 120 ? '...' : '');
    (document.getElementById('ai-doubt-message') as HTMLTextAreaElement).value = '';
    (document.getElementById('ai-doubt-error') as HTMLElement).style.display = 'none';
    (document.getElementById('ai-doubt-modal') as HTMLElement).style.display = 'flex';
  });

  document.getElementById('ai-doubt-cancel')?.addEventListener('click', () => {
    (document.getElementById('ai-doubt-modal') as HTMLElement).style.display = 'none';
  });
  document.getElementById('ai-doubt-modal')?.addEventListener('click', e => {
    if (e.target === document.getElementById('ai-doubt-modal'))
      (document.getElementById('ai-doubt-modal') as HTMLElement).style.display = 'none';
  });

  document.getElementById('ai-doubt-submit')?.addEventListener('click', async () => {
    if (!currentQ) return;
    const message = (document.getElementById('ai-doubt-message') as HTMLTextAreaElement).value.trim();
    const errEl   = document.getElementById('ai-doubt-error')!;
    const btn     = document.getElementById('ai-doubt-submit') as HTMLButtonElement;
    errEl.style.display = 'none';
    btn.disabled = true; btn.textContent = 'Enviando...';
    try {
      await apiFetch('/api/doubts', {
        method: 'POST',
        body: JSON.stringify({
          source:       'AI',
          aiQuestionId: currentQ.aiQuestionId,
          message:      message || undefined,
        }),
      });
      toast.success('Duda reportada', { description: 'Un administrador la revisará.' });
      (document.getElementById('ai-doubt-modal') as HTMLElement).style.display = 'none';
    } catch (err: any) {
      errEl.textContent = err?.message ?? 'Error al enviar';
      errEl.style.display = 'block';
    } finally {
      btn.disabled = false; btn.textContent = 'Enviar reporte';
    }
  });

  // ── Finalizar sesión ────────────────────────────────────────────
  function openFinishModal() {
    const answered = allQuestions.filter(q => q.selectedIndex !== null).length;
    const correct  = allQuestions.filter(q => q.isCorrect === true).length;
    const wrong    = answered - correct;
    (document.getElementById('finish-modal-correct') as HTMLElement).textContent = String(correct);
    (document.getElementById('finish-modal-wrong')   as HTMLElement).textContent = String(wrong);
    (document.getElementById('finish-modal') as HTMLElement).style.display = 'flex';
  }

  document.getElementById('finish-btn-header')?.addEventListener('click', openFinishModal);
  document.getElementById('finish-btn-sidebar')?.addEventListener('click', openFinishModal);
  document.getElementById('finish-modal-cancel')?.addEventListener('click', () => {
    (document.getElementById('finish-modal') as HTMLElement).style.display = 'none';
  });
  document.getElementById('finish-modal-confirm')?.addEventListener('click', async () => {
    (document.getElementById('finish-modal') as HTMLElement).style.display = 'none';
    await finishSession();
  });

  async function finishSession() {
    if (sessionFinished) return;
    sessionFinished = true;
    window.rpLoader?.show('Calculando resultados...');
    try {
      const res = await aiTriedsApi.finish(aiTriedId);
      const d   = res.data;
      showResults(d?.score ?? 0, d?.correctAnswers ?? correctCount, d?.totalQuestions ?? allQuestions.length);
    } catch {
      const total   = allQuestions.length;
      const correct = allQuestions.filter(q => q.isCorrect === true).length;
      const score   = total > 0 ? Math.round((correct / total) * 100) : 0;
      showResults(score, correct, total);
    } finally {
      window.rpLoader?.hide();
    }
  }

  function showResults(score: number, correct: number, total: number) {
    // score = puntos crudos ponderados por nivel. Máximo = suma de niveles de las preguntas generadas.
    const safeScore = Math.round(score);
    const wrong     = total - correct;
    const maxPoints = allQuestions.reduce((acc, q) => acc + (q.difficultyLevel ?? 5), 0);
    const pct = maxPoints > 0 ? (safeScore / maxPoints) * 100 : 0;

    // Animar score
    const scoreEl = document.getElementById('result-score')!;
    scoreEl.style.color = pct >= 70 ? '#059669' : pct >= 50 ? '#D97706' : '#DC2626';
    let n = 0;
    const step = Math.max(1, Math.floor(safeScore / 60));
    const intv = setInterval(() => {
      n = Math.min(n + step, safeScore);
      scoreEl.textContent = String(n);
      if (n >= safeScore) clearInterval(intv);
    }, 20);

    const maxEl = document.getElementById('result-max');
    if (maxEl) maxEl.textContent = maxPoints > 0 ? `de ${maxPoints} puntos` : 'puntos';
    (document.getElementById('res-correct') as HTMLElement).textContent = String(correct);
    (document.getElementById('res-wrong')   as HTMLElement).textContent = String(wrong);
    (document.getElementById('res-total')   as HTMLElement).textContent = String(total);
    (document.getElementById('result-msg')  as HTMLElement).textContent = pct >= 75
      ? '¡Excelente! Tu nivel es muy alto en esta competencia.'
      : pct >= 50
      ? '¡Buen trabajo! Sigue practicando para mejorar.'
      : 'Ánimo, la práctica constante es la clave del éxito.';

    (document.getElementById('results-overlay') as HTMLElement).style.display = 'flex';
  }

  // ── Init ────────────────────────────────────────────────────────
  async function init() {
    // Color base de la cabecera (competencia principal de la URL).
    const s = getCompStyle(competenceId, '');
    const badgeEl = document.getElementById('ai-comp-badge')!;
    badgeEl.style.cssText = `padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;flex-shrink:0;background:${s.bg || '#EDE9FE'};color:${s.color || '#7C3AED'}`;
    badgeEl.textContent = 'Práctica IA';

    try {
      // Cargar preguntas ya generadas de la sesión (creada en index.astro)
      const questRes = await aiTriedsApi.listQuestions(aiTriedId);
      allQuestions   = questRes.data ?? [];

      // Obtener info de la sesión para saber totalQuestions y competencias
      const triedRes  = await aiTriedsApi.findById(aiTriedId);
      const triedData = triedRes.data;
      if (triedData?.totalQuestions) totalQuestions = triedData.totalQuestions;

      // Mostrar las competencias de la sesión en la cabecera (multi-competencia).
      try {
        const compsRes = await competencesApi.findAll(false);
        (compsRes.data ?? []).forEach(c => { compNameById[c.competenceId] = c.competenceName; });
        const ids = (triedData?.competenceIds && triedData.competenceIds.length)
          ? triedData.competenceIds
          : (triedData?.competenceId ? [triedData.competenceId] : []);
        if (ids.length) badgeEl.textContent = ids.map(id => compNameById[id] ?? id).join(' + ');
      } catch {}

      if (triedData?.status === 'FINISHED') {
        showResults(triedData.score ?? 0, triedData.correctAnswers ?? 0, triedData.totalQuestions);
        return;
      }

      // Encontrar primera pregunta no respondida
      const unanswered = allQuestions.filter(q => q.selectedIndex === null);
      if (unanswered.length > 0) {
        renderQuestion(unanswered[0]);
      } else if (allQuestions.length < totalQuestions) {
        // Todas respondidas pero hay más por generar
        await loadNextQuestion();
      } else {
        // Todo respondido
        await finishSession();
      }

    } catch (err: any) {
      (document.getElementById('ai-loading') as HTMLElement).style.display     = 'none';
      (document.getElementById('ai-unavailable') as HTMLElement).style.display = 'block';
      (document.getElementById('error-msg') as HTMLElement).textContent =
        err?.message ?? 'No se pudo cargar la sesión.';
    }
  }

  init();
</script>