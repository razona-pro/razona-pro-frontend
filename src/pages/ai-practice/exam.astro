---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="Práctica IA adaptativa">
<div class="exam-shell">

  <!-- HEADER -->
  <header class="exam-header">
    <div style="display:flex;align-items:center;gap:8px;flex-shrink:0">
      <div style="width:28px;height:28px;border-radius:7px;background:linear-gradient(135deg,#6366F1,#4F46E5);display:flex;align-items:center;justify-content:center;color:white">
        <Icon name="tabler:brain" size={16} />
      </div>
      <span style="font-size:0.875rem;font-weight:700;color:var(--ui-text-1)">Razona<strong style="color:#6366F1">Pro</strong> IA</span>
    </div>

    <div style="flex:1;padding:0 0.75rem;display:flex;align-items:center;gap:10px;min-width:0;overflow:hidden">
      <span id="hdr-comp" style="padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;flex-shrink:0;background:#EDE9FE;color:#6366F1">Cargando...</span>
      <div style="flex:1;height:5px;background:var(--ui-surface);border-radius:3px;overflow:hidden;border:1px solid var(--ui-border)">
        <div id="hdr-progress-bar" style="height:100%;background:linear-gradient(to right,#6366F1,#818CF8);border-radius:3px;width:0%;transition:width 0.5s ease"></div>
      </div>
      <span id="hdr-progress" style="font-size:0.75rem;font-weight:600;color:var(--ui-text-3);white-space:nowrap;flex-shrink:0">0 / 0</span>
    </div>

    <div style="display:flex;align-items:center;gap:8px;flex-shrink:0">
      <div style="text-align:right">
        <p id="hdr-pts" style="font-size:0.75rem;font-weight:800;color:#6366F1;margin:0;line-height:1">0 pts</p>
        <p id="hdr-max-pts" style="font-size:0.5625rem;color:var(--ui-text-3);margin:0">de 0 posibles</p>
      </div>
      <button id="abandon-btn" style="padding:5px 12px;border-radius:8px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-3);font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit;transition:all 0.15s" onmouseover="this.style.borderColor='#DC2626';this.style.color='#DC2626'" onmouseout="this.style.borderColor='var(--ui-border)';this.style.color='var(--ui-text-3)'">
        Abandonar
      </button>
    </div>
  </header>

  <div class="exam-body">

    <!-- SIDEBAR -->
    <aside class="exam-sidebar">
      <div style="padding:1rem 0.875rem;display:flex;flex-direction:column;gap:1rem;height:100%">
        <p style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--ui-text-3);margin:0">Progreso</p>
        <div id="q-nav" style="display:grid;grid-template-columns:repeat(5,1fr);gap:4px"></div>

        <!-- Leyenda -->
        <div style="display:flex;flex-direction:column;gap:5px">
          <div style="display:flex;align-items:center;gap:6px;font-size:0.6875rem;color:var(--ui-text-3)"><span style="width:9px;height:9px;border-radius:2px;background:#D1FAE5;border:1.5px solid #059669;flex-shrink:0"></span>Correcta</div>
          <div style="display:flex;align-items:center;gap:6px;font-size:0.6875rem;color:var(--ui-text-3)"><span style="width:9px;height:9px;border-radius:2px;background:#FEE2E2;border:1.5px solid #DC2626;flex-shrink:0"></span>Incorrecta</div>
          <div style="display:flex;align-items:center;gap:6px;font-size:0.6875rem;color:var(--ui-text-3)"><span style="width:9px;height:9px;border-radius:2px;background:#6366F1;flex-shrink:0"></span>Actual</div>
          <div style="display:flex;align-items:center;gap:6px;font-size:0.6875rem;color:var(--ui-text-3)"><span style="width:9px;height:9px;border-radius:2px;background:var(--ui-surface);border:1.5px solid var(--ui-border);flex-shrink:0"></span>Pendiente</div>
        </div>

        <!-- Nivel de habilidad estimado -->
        <div style="background:var(--ui-surface);border-radius:10px;padding:10px 12px;border:1px solid var(--ui-border)">
          <p style="font-size:0.5625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--ui-text-3);margin:0 0 6px">Nivel estimado</p>
          <div style="height:6px;background:var(--ui-border);border-radius:3px;overflow:hidden;margin-bottom:5px">
            <div id="theta-bar" style="height:100%;background:linear-gradient(to right,#6366F1,#818CF8);width:50%;border-radius:3px;transition:width 0.7s ease"></div>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:0.5625rem;color:var(--ui-text-3)">
            <span>Básico</span><span id="theta-label" style="font-weight:700;color:#6366F1">Medio</span><span>Avanzado</span>
          </div>
        </div>

        <div style="margin-top:auto">
          <button id="finish-btn" style="width:100%;padding:0.5625rem;border-radius:9px;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.75rem;cursor:pointer;border:none;box-shadow:0 3px 10px rgba(212,18,36,0.28);display:flex;align-items:center;justify-content:center;gap:5px">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
            Finalizar práctica
          </button>
        </div>
      </div>
    </aside>

    <!-- MAIN -->
    <main class="exam-main">

      <!-- Generando pregunta -->
      <div id="exam-loading" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:300px;gap:1rem">
        <div style="width:52px;height:52px;border-radius:50%;border:3.5px solid rgba(99,102,241,0.15);border-top-color:#6366F1;animation:spin 0.85s linear infinite"></div>
        <div style="text-align:center">
          <p style="font-size:0.9375rem;font-weight:600;color:var(--ui-text-1);margin:0 0 4px" id="loading-msg">Iniciando sesión...</p>
          <p style="font-size:0.8125rem;color:var(--ui-text-3);margin:0">La IA está preparando tu siguiente pregunta</p>
        </div>
      </div>

      <!-- Carta de pregunta -->
      <div id="question-card" style="display:none;max-width:760px;margin:0 auto;width:100%">

        <!-- Cabecera -->
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:1rem">
          <span id="q-num-badge" style="font-size:0.6875rem;font-weight:800;color:#6366F1;background:#EDE9FE;border:1.5px solid rgba(99,102,241,0.2);padding:3px 10px;border-radius:20px">P1</span>
          <span id="q-diff-badge" style="padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700"></span>
          <span id="q-pts-badge" style="padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;background:rgba(99,102,241,0.1);color:#6366F1"></span>
          <span id="q-adapt-badge" style="display:none;padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;background:#FEF3C7;color:#92400E"></span>
        </div>

        <!-- Enunciado -->
        <div style="background:var(--ui-card);border-radius:14px;padding:1.5rem 1.625rem;border:1px solid var(--ui-border);margin-bottom:1rem">
          <p id="q-statement" style="font-size:1rem;font-weight:500;color:var(--ui-text-1);line-height:1.85;margin:0"></p>
        </div>

        <!-- Opciones -->
        <div id="q-options" style="display:flex;flex-direction:column;gap:9px;margin-bottom:1.125rem"></div>

        <!-- Pistas -->
        <div id="hint-section" style="margin-bottom:1.125rem">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px">
            <span style="font-size:0.75rem;color:var(--ui-text-3);font-weight:600">¿Necesitas una pista?</span>
            <button class="hbtn" data-level="1" type="button">Pista 1</button>
            <button class="hbtn" data-level="2" type="button" disabled>Pista 2</button>
            <button class="hbtn" data-level="3" type="button" disabled>Pista 3</button>
          </div>
          <div id="hint-box" style="display:none;background:#F0F9FF;border:1px solid #BAE6FD;border-radius:10px;padding:12px 14px">
            <p style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#0369A1;margin:0 0 5px">Pista de orientación</p>
            <p id="hint-text" style="font-size:0.875rem;color:#0C4A6E;margin:0;line-height:1.65"></p>
            <div id="hint-loading" style="display:none;font-size:0.8125rem;color:#0369A1">Generando pista...</div>
          </div>
        </div>

        <!-- Feedback tras responder -->
        <div id="feedback-box" style="display:none;border-radius:12px;padding:1.125rem 1.25rem;margin-bottom:1.125rem">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
            <span id="fb-icon" style="font-size:1.375rem"></span>
            <span id="fb-title" style="font-size:0.9375rem;font-weight:800;color:var(--ui-text-1)"></span>
            <span id="fb-pts" style="font-size:0.75rem;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(99,102,241,0.1);color:#6366F1;margin-left:auto"></span>
          </div>
          <p id="fb-explanation" style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 12px;line-height:1.65"></p>
          <!-- Botón siguiente -->
          <button id="btn-next-question" style="width:100%;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,#6366F1,#4F46E5);color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(99,102,241,0.28);display:flex;align-items:center;justify-content:center;gap:8px">
            <span id="btn-next-label">Siguiente pregunta</span>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" id="btn-next-arrow"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>

      </div>
    </main>
  </div>
</div>

<!-- Resultados finales -->
<div id="results-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:400;align-items:center;justify-content:center;backdrop-filter:blur(8px)">
  <div style="background:var(--ui-card);border-radius:24px;padding:2.5rem 2rem;max-width:460px;width:calc(100%-2rem);text-align:center;animation:modalIn 0.4s cubic-bezier(0.34,1.46,0.64,1) both;box-shadow:0 24px 70px rgba(0,0,0,0.25)">
    <div id="result-icon" style="width:80px;height:80px;border-radius:50%;margin:0 auto 1.25rem;display:flex;align-items:center;justify-content:center;font-size:2.5rem"></div>
    <p style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--ui-text-3);margin:0 0 0.25rem">Puntuación final</p>
    <p id="result-score" style="font-size:4.5rem;font-weight:900;margin:0;line-height:1;letter-spacing:-3px;color:#6366F1">0</p>
    <p style="font-size:0.875rem;color:var(--ui-text-3);margin:0 0 0.5rem">/ 100 puntos</p>
    <p id="result-pts-detail" style="font-size:0.8125rem;font-weight:600;color:#6366F1;margin:0 0 1.5rem;background:#EDE9FE;padding:6px 14px;border-radius:20px;display:inline-block"></p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:1.25rem">
      <div style="background:var(--ui-surface);border-radius:12px;padding:14px 8px;border:1px solid var(--ui-border)">
        <p id="res-correct" style="font-size:1.625rem;font-weight:900;color:#059669;margin:0 0 2px">0</p>
        <p style="font-size:0.625rem;color:var(--ui-text-3);margin:0;text-transform:uppercase;letter-spacing:0.4px">Correctas</p>
      </div>
      <div style="background:var(--ui-surface);border-radius:12px;padding:14px 8px;border:1px solid var(--ui-border)">
        <p id="res-wrong" style="font-size:1.625rem;font-weight:900;color:#DC2626;margin:0 0 2px">0</p>
        <p style="font-size:0.625rem;color:var(--ui-text-3);margin:0;text-transform:uppercase;letter-spacing:0.4px">Incorrectas</p>
      </div>
      <div style="background:var(--ui-surface);border-radius:12px;padding:14px 8px;border:1px solid var(--ui-border)">
        <p id="res-max-diff" style="font-size:1.625rem;font-weight:900;color:#6366F1;margin:0 0 2px">—</p>
        <p style="font-size:0.625rem;color:var(--ui-text-3);margin:0;text-transform:uppercase;letter-spacing:0.4px">Nivel máx.</p>
      </div>
    </div>
    <p id="result-msg" style="font-size:0.9375rem;color:var(--ui-text-2);margin:0 0 1.75rem;line-height:1.65"></p>
    <div style="display:flex;gap:8px">
      <button id="result-new" style="flex:1;padding:0.75rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;cursor:pointer">Nueva sesión</button>
      <a href="/dashboard" style="flex:1;display:flex;align-items:center;justify-content:center;padding:0.75rem;border-radius:10px;background:linear-gradient(135deg,#6366F1,#4F46E5);color:white;text-decoration:none;font-weight:700">Ir al panel</a>
    </div>
  </div>
</div>

</BaseLayout>

<style is:global>
  @keyframes spin    { to { transform: rotate(360deg); } }
  @keyframes modalIn { from{opacity:0;transform:scale(0.9) translateY(12px)}to{opacity:1;transform:scale(1) translateY(0)} }
  @keyframes optIn   { from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)} }

  .exam-shell {
    display:flex; flex-direction:column;
    height:100dvh; overflow:hidden;
    background:var(--ui-bg-alt); font-family:'Poppins',sans-serif;
  }
  .exam-header {
    display:flex; align-items:center;
    padding:0 1.25rem; height:56px;
    background:var(--ui-card); border-bottom:1px solid var(--ui-border);
    flex-shrink:0; gap:0.75rem; z-index:20;
  }
  .exam-body { display:flex; flex:1; overflow:hidden; }
  .exam-sidebar {
    width:204px; min-width:204px;
    background:var(--ui-card); border-right:1px solid var(--ui-border);
    overflow-y:auto; flex-shrink:0;
  }
  .exam-main { flex:1; overflow-y:auto; padding:1.5rem 1.25rem; }

  .qnav-item {
    width:100%; aspect-ratio:1/1; border-radius:6px;
    border:1.5px solid var(--ui-border);
    background:var(--ui-surface); color:var(--ui-text-3);
    font-size:0.625rem; font-weight:700; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    font-family:inherit; transition:all 0.15s;
  }
  .qnav-item.current  { background:#6366F1; border-color:#6366F1; color:white; }
  .qnav-item.correct  { background:#D1FAE5; border-color:#059669; color:#059669; }
  .qnav-item.wrong    { background:#FEE2E2; border-color:#DC2626; color:#DC2626; }
  .qnav-item.pending  { background:var(--ui-surface); border-color:var(--ui-border); color:var(--ui-text-3); cursor:default; }

  .ai-opt {
    display:flex; align-items:stretch; width:100%;
    background:var(--ui-card); border:1.5px solid var(--ui-border);
    border-radius:12px; cursor:pointer;
    transition:border-color 0.18s, background 0.18s, transform 0.18s;
    text-align:left; font-family:inherit; overflow:hidden;
    animation:optIn 0.2s ease both;
  }
  .ai-opt:hover:not(:disabled):not(.correct):not(.wrong) {
    border-color:#6366F1; background:rgba(99,102,241,0.03); transform:translateX(3px);
  }
  .ai-opt:disabled { cursor:not-allowed; }
  .ai-opt.correct  { border-color:#059669 !important; background:#F0FDF4 !important; }
  .ai-opt.wrong    { border-color:#DC2626 !important; background:#FEF2F2 !important; }

  .opt-letter {
    width:52px; min-width:52px;
    display:flex; align-items:center; justify-content:center;
    background:var(--ui-surface); border-right:1.5px solid var(--ui-border);
    flex-shrink:0; transition:all 0.18s;
  }
  .ai-opt.correct .opt-letter { background:#059669; border-color:#059669; }
  .ai-opt.wrong   .opt-letter { background:#DC2626; border-color:#DC2626; }

  .opt-badge {
    width:28px; height:28px; border-radius:7px;
    border:1.5px solid var(--ui-border-2);
    display:flex; align-items:center; justify-content:center;
    font-size:0.75rem; font-weight:800; color:var(--ui-text-2);
    background:var(--ui-card); transition:all 0.18s;
  }
  .ai-opt.correct .opt-badge,
  .ai-opt.wrong   .opt-badge { background:rgba(255,255,255,0.25); border-color:transparent; color:white; }

  .opt-body { flex:1; padding:0.9375rem 1rem; display:flex; align-items:center; }
  .opt-text { font-size:0.9375rem; color:var(--ui-text-2); line-height:1.65; margin:0; }

  .hbtn {
    padding:4px 12px; border-radius:20px; font-size:0.75rem; font-weight:600;
    border:1.5px solid #BAE6FD; background:#F0F9FF; color:#0369A1;
    cursor:pointer; transition:all 0.15s; font-family:inherit;
  }
  .hbtn:hover:not(:disabled) { background:#0369A1; color:white; border-color:#0369A1; }
  .hbtn:disabled { opacity:0.35; cursor:not-allowed; }

  @media (max-width:768px) {
    .exam-sidebar { display:none; }
    .exam-main    { padding:1rem; }
  }
</style>
<script>
  import { requireAuth }    from '../../lib/auth';
  import { aiTriedsApi }    from '../../lib/api/ai-trieds.api';
  import { competencesApi } from '../../lib/api/competences.api';
  import type { AiQuestionDto, AiAnswerResultDto } from '../../lib/api/types';
  import { scoreColor } from '../../lib/utils';
  import { toast }      from '../../lib/toast';

  try { requireAuth(); } catch { throw new Error('redirect'); }

  const params    = new URLSearchParams(window.location.search);
  const aiTriedId = params.get('tried') ?? '';
  const compId    = params.get('comp')  ?? '';
  const totalQ    = parseInt(params.get('total') ?? '0') || 0;
  const isResume  = params.get('resume') === '1';
  const testMode  = params.get('mode') ?? '';   // ← modo obtenido desde la URL

  if (!aiTriedId) { window.location.replace('/ai-practice'); throw new Error(); }

  const LETTERS = ['A','B','C','D','E','F'];

  function diffColor(d: number) {
    if (d <= 3)  return { bg:'#D1FAE5', color:'#059669' };
    if (d <= 6)  return { bg:'#FEF3C7', color:'#D97706' };
    if (d <= 8)  return { bg:'#FEE2E2', color:'#DC2626' };
    return { bg:'#F3E8FF', color:'#7C3AED' };
  }

  // ── Estado ────────────────────────────────────────────────────────────
  let currentQuestion: AiQuestionDto | null = null;
  let questionIndex   = 0;
  let totalAnswered   = 0;
  let earnedPoints    = 0;
  let maxPoints       = 0;
  let maxDiffReached  = 0;
  let examFinished    = false;
  let generatingNext  = false;
  const startTime     = Date.now();

  // Caché de pistas: questionId → Map<level, text>
  const hintCache = new Map<string, Map<number, string>>();

  // ── Sidebar nav ───────────────────────────────────────────────────────
  type NavState = 'pending' | 'current' | 'correct' | 'wrong';
  const navStates: NavState[] = [];

  function buildNav(total: number) {
    const nav = document.getElementById('q-nav')!;
    nav.innerHTML = '';
    for (let i = 0; i < total; i++) {
      navStates.push('pending');
      const btn = document.createElement('button');
      btn.className   = 'qnav-item pending';
      btn.textContent = String(i + 1);
      btn.disabled    = true;
      nav.appendChild(btn);
    }
  }

  function updateNav(idx: number, state: NavState) {
    if (idx >= navStates.length) return;
    navStates[idx] = state;
    document.querySelectorAll<HTMLButtonElement>('.qnav-item').forEach((item, i) => {
      item.className = 'qnav-item ' + navStates[i];
    });
  }

  function updateHeader() {
    const n = totalQ || navStates.length || 10;
    const prog = document.getElementById('hdr-progress');
    const bar  = document.getElementById('hdr-progress-bar');
    const pts  = document.getElementById('hdr-pts');
    const maxP = document.getElementById('hdr-max-pts');
    if (prog) prog.textContent = `${totalAnswered} / ${n}`;
    if (bar)  bar.style.width  = `${(totalAnswered / n) * 100}%`;
    if (pts)  pts.textContent  = `${earnedPoints} pts`;
    if (maxP) maxP.textContent = `de ${maxPoints} posibles`;
  }

  function updateThetaBar(diff: number) {
    const bar   = document.getElementById('theta-bar');
    const label = document.getElementById('theta-label');
    const pct   = ((diff - 1) / 9) * 100;
    if (bar)   bar.style.width  = `${pct}%`;
    if (label) {
      if      (diff <= 3) label.textContent = `Básico (Nv.${diff})`;
      else if (diff <= 6) label.textContent = `Medio (Nv.${diff})`;
      else if (diff <= 8) label.textContent = `Alto (Nv.${diff})`;
      else                label.textContent = `Experto (Nv.${diff})`;
    }
  }

  // ── Renderizar pregunta ───────────────────────────────────────────────
  function renderQuestion(q: AiQuestionDto, isFirst = false) {
    currentQuestion = q;
    questionIndex   = (q.questionNumber ?? 1) - 1;

    document.getElementById('exam-loading')!.style.display  = 'none';
    document.getElementById('question-card')!.style.display = 'block';
    document.getElementById('feedback-box')!.style.display  = 'none';
    document.getElementById('hint-section')!.style.display  = 'block';

    const numBadge   = document.getElementById('q-num-badge')!;
    const diffBadge  = document.getElementById('q-diff-badge')!;
    const ptsBadge   = document.getElementById('q-pts-badge')!;
    const adaptBadge = document.getElementById('q-adapt-badge')!;

    numBadge.textContent = `Pregunta ${q.questionNumber}`;
    const dc = diffColor(q.difficultyLevel);
    diffBadge.textContent = `Nivel ${q.difficultyLevel}/10`;
    diffBadge.style.cssText = `background:${dc.bg};color:${dc.color};padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700`;
    ptsBadge.textContent  = `+${q.difficultyLevel} pts posibles`;

    if (!isFirst && q.questionNumber > 1) {
      adaptBadge.style.display = 'inline';
      adaptBadge.textContent   = q.difficultyLevel > 5 ? 'Nivel subió' : q.difficultyLevel < 5 ? 'Nivel bajó' : 'Nivel estable';
    } else {
      adaptBadge.style.display = 'none';
    }

    document.getElementById('q-statement')!.textContent = q.statement;

    renderOptions(q);

    // Restaurar pistas desde caché
    const qHints = hintCache.get(q.aiQuestionId) ?? new Map<number, string>();
    const maxUsed = q.hintsUsed ?? 0;
    document.querySelectorAll<HTMLButtonElement>('.hbtn').forEach(btn => {
      const lvl    = Number(btn.dataset.level);
      btn.disabled = lvl > maxUsed + 1;
    });
    const hintBox  = document.getElementById('hint-box')!;
    const hintText = document.getElementById('hint-text')!;
    if (qHints.size > 0) {
      const latestLevel = Math.max(...qHints.keys());
      hintBox.style.display = 'block';
      hintText.textContent  = qHints.get(latestLevel) ?? '';
    } else {
      hintBox.style.display = 'none';
      hintText.textContent  = '';
    }

    updateNav(questionIndex, 'current');
    updateThetaBar(q.difficultyLevel);
  }

  function renderOptions(q: AiQuestionDto) {
    const optsEl = document.getElementById('q-options')!;
    optsEl.innerHTML = '';
    q.options.forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.className = 'ai-opt';
      btn.style.animationDelay = `${i * 0.05}s`;
      btn.innerHTML = `
        <div class="opt-letter"><span class="opt-badge">${LETTERS[i]}</span></div>
        <div class="opt-body"><p class="opt-text">${opt.text}</p></div>`;
      btn.addEventListener('click', () => submitAnswer(q, i));
      optsEl.appendChild(btn);
    });
  }

  // ── Responder ─────────────────────────────────────────────────────────
  async function submitAnswer(q: AiQuestionDto, selectedIndex: number) {
    document.querySelectorAll<HTMLButtonElement>('.ai-opt').forEach((b, i) => {
      b.disabled = true;
      if (i === selectedIndex) b.style.borderColor = '#6366F1';
    });
    document.getElementById('hint-section')!.style.display = 'none';

    try {
      const res = await aiTriedsApi.submitAnswer(aiTriedId, q.aiQuestionId, selectedIndex);
      const fb  = res.data!;

      totalAnswered = fb.totalAnswered;
      if (fb.earnedPoints != null) earnedPoints = fb.earnedPoints;
      if (fb.maxPoints    != null) maxPoints    = fb.maxPoints;
      if (q.difficultyLevel > maxDiffReached)  maxDiffReached = q.difficultyLevel;

      document.querySelectorAll<HTMLButtonElement>('.ai-opt').forEach((btn, i) => {
        if (i === fb.correctIndex)                    btn.classList.add('correct');
        else if (i === fb.selectedIndex && !fb.isCorrect) btn.classList.add('wrong');
      });

      showFeedback(fb, q.difficultyLevel);
      updateNav(questionIndex, fb.isCorrect ? 'correct' : 'wrong');
      updateHeader();
      if (fb.nextDifficulty) updateThetaBar(fb.nextDifficulty);

      if (fb.finished) {
        examFinished = true;
        const nextBtn   = document.getElementById('btn-next-question') as HTMLButtonElement;
        const nextLabel = document.getElementById('btn-next-label')!;
        nextLabel.textContent    = 'Ver resultados';
        nextBtn.style.background = 'linear-gradient(135deg,var(--brand),var(--brand-dark))';
        nextBtn.onclick = () =>
          showResults(fb.finalScore ?? 0, fb.correctAnswers, fb.totalAnswered, maxDiffReached,
                      earnedPoints, maxPoints);
      }
    } catch (err: any) {
      document.querySelectorAll<HTMLButtonElement>('.ai-opt').forEach(b => {
        b.disabled = false; b.style.borderColor = '';
      });
      document.getElementById('hint-section')!.style.display = 'block';
      toast.error('Error al enviar respuesta', { description: err?.message });
    }
  }

  // ── Feedback ──────────────────────────────────────────────────────────
  function showFeedback(fb: AiAnswerResultDto, diff: number) {
    const box     = document.getElementById('feedback-box')!;
    const icon    = document.getElementById('fb-icon')!;
    const title   = document.getElementById('fb-title')!;
    const expEl   = document.getElementById('fb-explanation')!;
    const ptsEl   = document.getElementById('fb-pts')!;
    const nextBtn = document.getElementById('btn-next-question') as HTMLButtonElement;
    const nextLbl = document.getElementById('btn-next-label')!;

    box.style.display    = 'block';
    box.style.background = fb.isCorrect ? '#F0FDF4' : '#FEF2F2';
    box.style.border     = `1px solid ${fb.isCorrect ? '#A7F3D0' : '#FECACA'}`;

    icon.style.cssText = `font-size:1rem;width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;background:${fb.isCorrect ? '#059669' : '#DC2626'};color:white;font-weight:900;flex-shrink:0`;
    icon.innerHTML     = fb.isCorrect
      ? `<svg width="14" height="14" fill="none" stroke="white" stroke-width="3" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>`
      : `<svg width="14" height="14" fill="none" stroke="white" stroke-width="3" viewBox="0 0 24 24" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;

    title.textContent = fb.isCorrect ? 'Respuesta correcta' : 'Respuesta incorrecta';
    ptsEl.textContent = fb.isCorrect ? `+${diff} puntos` : '0 puntos';
    expEl.textContent = fb.explanation
      || (fb.isCorrect
          ? 'Bien razonado. Seleccionaste la opción correcta.'
          : 'Revisa el concepto. La siguiente pregunta ajustará la dificultad.');

    if (!fb.finished) {
      nextLbl.textContent    = `Siguiente pregunta (Nv. ${fb.nextDifficulty ?? '—'})`;
      nextBtn.style.background = 'linear-gradient(135deg,#6366F1,#4F46E5)';
      nextBtn.onclick          = loadNextQuestion;
    }
  }

  // ── Siguiente pregunta ────────────────────────────────────────────────
  async function loadNextQuestion() {
    if (generatingNext || examFinished) return;
    generatingNext = true;

    document.getElementById('question-card')!.style.display = 'none';
    document.getElementById('exam-loading')!.style.display  = 'flex';
    document.getElementById('loading-msg')!.textContent =
      'La IA está ajustando la dificultad para ti...';

    try {
      const res = await aiTriedsApi.nextQuestion(aiTriedId);
      renderQuestion(res.data!, false);
    } catch (err: any) {
      document.getElementById('exam-loading')!.style.display  = 'none';
      document.getElementById('question-card')!.style.display = 'block';
      toast.error('Error al cargar pregunta', { description: err?.message });
    } finally {
      generatingNext = false;
    }
  }

  // ── Pistas ────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.hbtn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const q = currentQuestion;
      if (!q) return;
      const level = Number(btn.dataset.level);

      const qHints   = hintCache.get(q.aiQuestionId) ?? new Map<number, string>();
      const hintBox  = document.getElementById('hint-box')!;
      const hintText = document.getElementById('hint-text')!;
      const loading  = document.getElementById('hint-loading')!;

      // Usar caché si ya existe
      if (qHints.has(level)) {
        hintBox.style.display = 'block';
        hintText.textContent  = qHints.get(level)!;
        return;
      }

      hintBox.style.display  = 'block';
      hintText.textContent   = '';
      loading.style.display  = 'block';
      btn.disabled           = true;

      try {
        const res   = await aiTriedsApi.getHint(aiTriedId, q.aiQuestionId, level);
        const text  = res.data!.hint;
        qHints.set(level, text);
        hintCache.set(q.aiQuestionId, qHints);
        hintText.textContent = text;

        // Habilitar siguiente nivel de pista
        const nextHintBtn = document.querySelector<HTMLButtonElement>(`.hbtn[data-level="${level + 1}"]`);
        if (nextHintBtn && level < 3) nextHintBtn.disabled = false;
      } catch (err: any) {
        hintText.textContent = 'No se pudo obtener la pista en este momento.';
        toast.error('Error de pista', { description: err?.message });
      } finally {
        loading.style.display = 'none';
        btn.disabled = false;
      }
    });
  });

  // ── Finalizar ─────────────────────────────────────────────────────────
  document.getElementById('finish-btn')?.addEventListener('click', async () => {
    if (examFinished) return;
    const ok = confirm('¿Deseas finalizar la sesión con las preguntas respondidas hasta ahora?');
    if (!ok) return;

    window.rpLoader?.show('Finalizando sesión...');
    try {
      const elapsed = Math.round((Date.now() - startTime) / 1000);
      const res = await aiTriedsApi.finish(aiTriedId, elapsed);
      const tried = res.data!;
      examFinished = true;
      window.rpLoader?.hide();
      showResults(
        tried.score ?? 0, tried.correctAnswers ?? 0,
        tried.totalAnswered ?? totalAnswered,
        maxDiffReached, earnedPoints, maxPoints
      );
    } catch (err: any) {
      window.rpLoader?.hide();
      toast.error('Error al finalizar', { description: err?.message });
    }
  });

  // ── Abandonar ─────────────────────────────────────────────────────────
  document.getElementById('abandon-btn')?.addEventListener('click', () => {
    if (examFinished) { window.location.href = '/ai-practice'; return; }
    const ok = confirm('¿Abandonar la sesión? El progreso actual no se guardará como sesión completada.');
    if (ok) window.location.href = '/ai-practice';
  });

  // ── Resultados ────────────────────────────────────────────────────────
  function showResults(
    score: number, correct: number, answered: number,
    maxDiff: number, earned = 0, maxPts = 0
  ) {
    examFinished = true;
    document.getElementById('results-overlay')!.style.display = 'flex';

    const pct = Math.round(score);
    const sc  = scoreColor(pct);

    const icon = document.getElementById('result-icon')!;
    if (pct >= 80) {
      icon.style.background = '#D1FAE5';
      icon.innerHTML = `<svg width="36" height="36" fill="none" stroke="#059669" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>`;
    } else if (pct >= 50) {
      icon.style.background = '#FEF3C7';
      icon.innerHTML = `<svg width="36" height="36" fill="none" stroke="#D97706" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><path d="M12 9v4"/><circle cx="12" cy="16" r="1" fill="#D97706"/><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>`;
    } else {
      icon.style.background = '#FEE2E2';
      icon.innerHTML = `<svg width="36" height="36" fill="none" stroke="#DC2626" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;
    }

    const scoreEl = document.getElementById('result-score')!;
    scoreEl.textContent = String(pct);
    scoreEl.style.color = sc;

    const detail = document.getElementById('result-pts-detail')!;
    detail.textContent = maxPts > 0
      ? `${earned} de ${maxPts} puntos posibles`
      : `${correct} respuestas correctas de ${answered}`;

    (document.getElementById('res-correct')  as HTMLElement).textContent = String(correct);
    (document.getElementById('res-wrong')    as HTMLElement).textContent = String(answered - correct);
    (document.getElementById('res-max-diff') as HTMLElement).textContent = maxDiff ? `${maxDiff}/10` : '—';

    const msgs: Record<string, string> = {
      high:   'Excelente desempeño. Tu dominio del tema es sólido. Continúa practicando para mantener y superar este nivel.',
      medium: 'Buen esfuerzo. Hay aspectos por reforzar. Revisa las preguntas incorrectas y vuelve a practicar.',
      low:    'Sigue adelante. Con práctica constante mejorarás. Estudia los temas base de esta competencia.',
    };
    const key = pct >= 75 ? 'high' : pct >= 45 ? 'medium' : 'low';
    (document.getElementById('result-msg') as HTMLElement).textContent = msgs[key];

    document.getElementById('result-new')?.addEventListener('click', () => {
      window.location.href = '/ai-practice';
    });
  }

  // ── Nueva sesión ──────────────────────────────────────────────────────
  document.getElementById('result-new')?.addEventListener('click', () => {
    window.location.href = '/ai-practice';
  });

  // ── Inicialización ────────────────────────────────────────────────────
  async function init() {
    const n = totalQ || 10;
    buildNav(n);
    updateHeader();

    // Cargar nombre de competencia en badge del header
    if (compId) {
      competencesApi.findAll(true).then(res => {
        const comp = (res.data ?? []).find((c: any) => c.competenceId === compId);
        const badge = document.getElementById('hdr-comp');
        if (badge && comp) badge.textContent = comp.competenceName;
      }).catch(() => {});
    }

    // Cargar preguntas existentes (sesión nueva o reanudada)
    try {
      const res       = await aiTriedsApi.listQuestions(aiTriedId);
      const questions = res.data ?? [];

      if (!questions.length) {
        // No debería pasar (start() siempre genera la primera), pero por si acaso
        document.getElementById('loading-msg')!.textContent = 'Cargando primera pregunta...';
        return;
      }

      // Reconstruir estado desde preguntas ya respondidas
      questions.forEach((q: AiQuestionDto) => {
        const idx = (q.questionNumber ?? 1) - 1;
        if (q.selectedIndex != null) {
          totalAnswered++;
          const pts = q.difficultyLevel ?? 5;
          maxPoints += pts;
          if (q.isCorrect) earnedPoints += pts;
          if ((q.difficultyLevel ?? 0) > maxDiffReached) maxDiffReached = q.difficultyLevel ?? 0;
          updateNav(idx, q.isCorrect ? 'correct' : 'wrong');
        }
      });
      updateHeader();

      // Buscar la primera pregunta sin responder
      const unanswered = questions.find((q: AiQuestionDto) => q.selectedIndex == null);
      if (unanswered) {
        renderQuestion(unanswered, questions.length === 1);
      } else {
        // Todas respondidas → mostrar resultados (sesión finalizada reanudada)
        try {
          const tried = await aiTriedsApi.findById(aiTriedId);
          const t     = tried.data!;
          examFinished = true;
          showResults(t.score ?? 0, t.correctAnswers ?? 0,
                      t.totalAnswered ?? questions.length,
                      maxDiffReached, earnedPoints, maxPoints);
        } catch {
          window.location.href = '/ai-practice';
        }
      }
    } catch (err: any) {
      document.getElementById('loading-msg')!.textContent =
        'Error al cargar la sesión. Redirigiendo...';
      setTimeout(() => window.location.href = '/ai-practice', 2000);
    }

    // ── Anti‑fraude (ubicado al nivel superior de init, después de renderizar la primera pregunta) ──
    const isAntifraud = testMode === 'EXAM' || testMode === 'TIMED';

    if (isAntifraud && !examFinished) {
      // Añadir clase CSS que bloquea selección de texto e imágenes
      document.body.classList.add('exam-antifraud');

      // Bloquear menú contextual
      document.addEventListener('contextmenu', e => e.preventDefault());

      // Bloquear Ctrl+C / Ctrl+A / F12 / Ctrl+U / Ctrl+S
      document.addEventListener('keydown', e => {
        const blocked = (e.ctrlKey && ['c','a','u','s'].includes(e.key.toLowerCase()))
                        || e.key === 'F12';
        if (blocked) e.preventDefault();
      });

      let tabWarnings = 0;
      const MAX_WARNINGS = 3;

      const showTabWarning = (count: number) => {
        document.querySelector('.tab-warning-banner')?.remove();
        const banner = document.createElement('div');
        banner.className = 'tab-warning-banner';
        if (count >= MAX_WARNINGS) {
          banner.textContent = `Aviso ${count}: Salir de la pantalla del examen puede invalidar tu intento. Esta es tu última advertencia.`;
          banner.style.background = '#DC2626';
        } else {
          banner.textContent = `Advertencia ${count}/${MAX_WARNINGS}: No debes salir de la ventana del examen.`;
          banner.style.background = '#D97706';
        }
        document.body.prepend(banner);
        setTimeout(() => banner.remove(), 5000);
      };

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') return;
        tabWarnings++;
        showTabWarning(tabWarnings);
      });

      window.addEventListener('blur', () => {
        tabWarnings++;
        showTabWarning(tabWarnings);
      });
    }
  }

  init();
</script>