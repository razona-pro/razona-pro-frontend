---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Iniciar sesión · RazonaPro">
  <main class="min-h-screen flex flex-col items-center justify-center px-4 py-12 bg-gray-50 relative overflow-hidden">

    <!-- Fondo decorativo -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full opacity-10"
           style="background: radial-gradient(circle, #D41224 0%, transparent 70%)"></div>
      <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full opacity-10"
           style="background: radial-gradient(circle, #9B1F24 0%, transparent 70%)"></div>
    </div>

    <!-- Card -->
    <div class="relative z-10 w-full max-w-md">

      <!-- Logo / Header -->
      <div class="text-center mb-8">
        <a href="/" class="inline-block">
          <span class="text-3xl font-black tracking-tight text-ufpso">Razona<span class="text-gray-800">Pro</span></span>
        </a>
        <p class="mt-2 text-sm text-gray-500">Plataforma de razonamiento lógico · UFPSO</p>
      </div>

      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">

        <!-- Tabs -->
        <div class="flex border-b border-gray-100">
          <button
            id="tab-student"
            class="flex-1 py-4 text-sm font-semibold transition-all tab-btn tab-active"
            data-tab="student"
          >
            Estudiante
          </button>
          <button
            id="tab-admin"
            class="flex-1 py-4 text-sm font-semibold transition-all tab-btn"
            data-tab="admin"
          >
            Administrador
          </button>
        </div>

        <!-- Formulario -->
        <div class="p-8">

          <!-- Error global -->
          <div id="error-box" class="hidden mb-5 p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm"></div>

          <form id="login-form" novalidate>

            <!-- Email -->
            <div class="mb-5">
              <label for="email" class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1.5">
                Correo electrónico
              </label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="tu@correo.com"
                autocomplete="email"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-800
                       placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-ufpso/40
                       focus:border-ufpso transition-all"
              />
            </div>

            <!-- Password -->
            <div class="mb-6">
              <label for="password" class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1.5">
                Contraseña
              </label>
              <div class="relative">
                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="••••••••"
                  autocomplete="current-password"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-800
                         placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-ufpso/40
                         focus:border-ufpso transition-all pr-11"
                />
                <button
                  type="button"
                  id="toggle-password"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors"
                  aria-label="Ver contraseña"
                >
                  <span class="ti ti-eye text-lg"></span>
                </button>
              </div>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full py-3.5 rounded-xl bg-ufpso text-white font-semibold text-sm
                     hover:bg-ufpso-dark active:scale-[.98] transition-all
                     disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2"
            >
              <span id="btn-label">Iniciar sesión</span>
              <span id="btn-spinner" class="hidden ti ti-loader-2 animate-spin text-base"></span>
            </button>

          </form>

          <!-- Footer del card -->
          <div id="student-footer" class="mt-6 text-center text-sm text-gray-500">
            ¿No tienes cuenta?
            <a href="/registro" class="text-ufpso font-semibold hover:underline ml-1">Regístrate</a>
          </div>
          <div id="admin-footer" class="hidden mt-6 text-center text-sm text-gray-400">
            Acceso restringido al personal autorizado de la UFPSO.
          </div>

        </div>
      </div>

      <p class="text-center mt-6 text-xs text-gray-400">
        <a href="/" class="hover:text-ufpso transition-colors">← Volver al inicio</a>
      </p>

    </div>
  </main>
</BaseLayout>

<style>
  .tab-btn {
    color: #6b7280;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .tab-active {
    color: #D41224;
    border-bottom-color: #D41224;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .animate-spin { animation: spin 0.8s linear infinite; }
</style>

<script>
  import { authApi } from '../lib/api';
  import { saveSession, redirectIfAuthenticated } from '../lib/auth';

  // Redirigir si ya está autenticado
  redirectIfAuthenticated('/dashboard');

  // ── Estado ──────────────────────────────────────────────────
  let currentTab: 'student' | 'admin' = 'student';

  // ── Tabs ────────────────────────────────────────────────────
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const studentFooter = document.getElementById('student-footer')!;
  const adminFooter   = document.getElementById('admin-footer')!;

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentTab = btn.dataset.tab as 'student' | 'admin';
      tabBtns.forEach(b => b.classList.remove('tab-active'));
      btn.classList.add('tab-active');

      if (currentTab === 'student') {
        studentFooter.classList.remove('hidden');
        adminFooter.classList.add('hidden');
      } else {
        studentFooter.classList.add('hidden');
        adminFooter.classList.remove('hidden');
      }

      clearError();
    });
  });

  // ── Toggle password ─────────────────────────────────────────
  const toggleBtn = document.getElementById('toggle-password')!;
  const passwordInput = document.getElementById('password') as HTMLInputElement;

  toggleBtn.addEventListener('click', () => {
    const isHidden = passwordInput.type === 'password';
    passwordInput.type = isHidden ? 'text' : 'password';
    toggleBtn.querySelector('span')!.className = isHidden
      ? 'ti ti-eye-off text-lg'
      : 'ti ti-eye text-lg';
  });

  // ── Form submit ─────────────────────────────────────────────
  const form       = document.getElementById('login-form') as HTMLFormElement;
  const submitBtn  = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnLabel   = document.getElementById('btn-label')!;
  const btnSpinner = document.getElementById('btn-spinner')!;
  const errorBox   = document.getElementById('error-box')!;

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnLabel.textContent = loading ? 'Ingresando...' : 'Iniciar sesión';
    btnSpinner.classList.toggle('hidden', !loading);
  }

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  }

  function clearError() {
    errorBox.classList.add('hidden');
    errorBox.textContent = '';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();

    const email    = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;

    if (!email || !password) {
      showError('Por favor completa todos los campos.');
      return;
    }

    setLoading(true);

    try {
      const fn = currentTab === 'admin'
        ? authApi.adminLogin(email, password)
        : authApi.studentLogin(email, password);

      const res = await fn;

      if (res.success && res.data) {
        saveSession(res.data);
        window.location.href = '/dashboard';
      } else {
        showError(res.message ?? 'Error al iniciar sesión.');
      }
    } catch (err: any) {
      const msg = err?.message ?? 'No se pudo conectar con el servidor. Verifica tu conexión.';
      showError(msg);
    } finally {
      setLoading(false);
    }
  });
</script>
