---
// RazonaPro — Dashboard (actualizado con conexiones a /tests y /perfil)
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard · RazonaPro">

<style is:global>
  /*
   * Dashboard styles — Usa variables CSS de global.css.
   * NO importar fuentes aquí (Poppins está en global.css).
   * UFPSO brand colors se usan directamente donde corresponde.
   * Los tokens --ui-* y --sidebar-* responden al tema activo.
   */

  body {
    height: 100vh;
    overflow: hidden;
    background: var(--ui-bg-alt);
    /* font-family heredado de global.css body rule */
  }

  /* ════ ROOT ════ */
  .db-root { flex: 1; display: flex; height: 100vh; overflow: hidden; }

  /* ════ SIDEBAR — Siempre oscuro, no cambia con temas ════ */
  #sidebar {
    width: 242px; min-width: 242px;
    background:   var(--sidebar-bg);
    display: flex; flex-direction: column;
    overflow-y: auto; overflow-x: hidden;
    border-right: 1px solid var(--sidebar-border);
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
    z-index: 100;
  }

  /* ════ OVERLAY ════ */
  #overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.55); z-index: 99;
    backdrop-filter: blur(2px);
    animation: fadeOv 0.2s ease;
  }
  #overlay.open { display: block; }
  @keyframes fadeOv { from{opacity:0} to{opacity:1} }

  /* ════ NAV SIDEBAR — Siempre oscuro ════ */
  .nav-item {
    display: flex; align-items: center; gap: 9px;
    padding: 9px 10px;
    color: var(--sidebar-text);
    font-size: 0.9375rem; font-weight: 500; border-radius: 9px;
    text-decoration: none; transition: all 0.15s; cursor: pointer;
    margin-bottom: 1px; border: none; background: none; width: 100%;
    text-align: left; font-family: inherit;
  }
  .nav-item:hover  { background: var(--sidebar-hover-bg); color: var(--sidebar-hover-txt); }
  .nav-item.active { background: var(--sidebar-active-bg); color: var(--sidebar-active-txt); }
  .nav-item .ti    { font-size: 1rem; flex-shrink: 0; }
  .nav-section {
    color: rgba(255,255,255,0.22); font-size: 0.625rem; font-weight: 700;
    letter-spacing: 0.9px; text-transform: uppercase;
    padding: 0 10px; margin: 14px 0 5px; display: block;
  }

  /* ════ CARDS — Responden al tema ════ */
  .card {
    background:    var(--ui-card);
    border-radius: 16px;
    padding:       20px 22px;
    border:        1px solid var(--ui-border);
    transition:    background 0.25s, border-color 0.25s;
  }
  .stat-card {
    background:    var(--ui-card);
    border-radius: 14px;
    padding:       16px 18px;
    border:        1px solid var(--ui-border);
    transition:    background 0.25s, border-color 0.25s;
  }
  .stat-num { font-size: 1.75rem; font-weight: 900; letter-spacing: -0.8px; margin: 0; line-height: 1; }

  /* ════ QUICK ACTIONS ════ */
  .qa-row { display: flex; gap: 8px; margin-bottom: 22px; flex-wrap: wrap; }
  .qa-btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 16px; border-radius: 10px; font-size: 0.9375rem;
    font-weight: 700; text-decoration: none; transition: all 0.15s;
    white-space: nowrap; border: none; cursor: pointer; font-family: inherit;
  }
  .qa-btn:hover { transform: translateY(-1px); filter: brightness(0.93); }

  /* ════ PROGRESS BARS ════ */
  .bar-wrap { height: 6px; background: var(--ui-surface); border-radius: 3px; overflow: hidden; margin: 6px 0 3px; }
  .bar-fill { height: 100%; border-radius: 3px; transition: width 1.3s cubic-bezier(0.4,0,0.2,1); width: 0%; }

  /* ════ RANK ════ */
  .rank-row { display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:10px; margin-bottom:3px; transition:background 0.15s; }
  .rank-row:hover { background: var(--ui-surface); }
  .r-pill {
    padding: 5px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;
    border: 1.5px solid var(--ui-border); background: transparent; color: var(--ui-text-2);
    cursor: pointer; transition: all 0.15s; font-family: inherit;
  }
  .r-pill:hover { border-color: var(--brand); color: var(--brand); }
  .r-pill.active { background: var(--brand); color: white; border-color: var(--brand); }

  /* ════ CHANGELOG ════ */
  .cl-item { position:relative; padding-left:22px; margin-bottom:20px; }
  .cl-item::before { content:''; position:absolute; left:5px; top:18px; bottom:-20px; width:1px; background: var(--ui-border); }
  .cl-item:last-child::before { display:none; }
  .cl-dot { position:absolute; left:0; top:2px; width:12px; height:12px; border-radius:50%; border:2px solid var(--brand); background: var(--ui-card); }
  .cl-dot.now { background: var(--brand); }

  /* ════ TEST/TREND ROWS ════ */
  .test-row  { display:flex; align-items:center; padding:10px 12px; border-radius:10px; margin-bottom:6px; border:1px solid var(--ui-border); background: var(--ui-surface); transition:all 0.15s; cursor:pointer; }
  .test-row:hover { border-color: var(--ui-border-2); background: var(--ui-card); transform:translateX(2px); }
  .trend-item { display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:10px; border:1px solid var(--ui-border); margin-bottom:8px; cursor:pointer; transition:all 0.15s; }
  .trend-item:hover { border-color: var(--ui-border-2); background: var(--ui-surface); }

  /* ════ ANIMATIONS ════ */
  @keyframes fadeUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
  .anim    { animation: fadeUp 0.45s ease both; }
  .anim-d1 { animation-delay:.05s; }
  .anim-d2 { animation-delay:.12s; }
  .anim-d3 { animation-delay:.18s; }
  .anim-d4 { animation-delay:.24s; }

  /* ════ INPUTS / TOPBAR ════ */
  #search-input {
    background:   var(--ui-card);
    border-color: var(--ui-border);
    color:        var(--ui-text-1);
    transition:   border-color 0.2s, background 0.25s;
  }
  #search-input::placeholder { color: var(--ui-text-3); }
  #search-input:focus  { border-color: var(--brand) !important; outline: none; box-shadow: 0 0 0 3px var(--brand-muted); }
  #tb-user:hover       { border-color: var(--brand) !important; }
  #notif-btn:hover     { border-color: var(--brand) !important; }

  /* Topbar card elements */
  #tb-user, #notif-btn, #hamburger {
    background:   var(--ui-card);
    border-color: var(--ui-border);
    transition:   background 0.25s, border-color 0.2s;
  }
  #tb-name { color: var(--ui-text-1); }

  /* Texto en tarjetas */
  .card-title  { color: var(--ui-text-1); }
  .card-text   { color: var(--ui-text-2); }
  .card-muted  { color: var(--ui-text-3); }

  /* ══════════════════════════════════════════════════════
     TABLET  ≤ 1023 px
  ══════════════════════════════════════════════════════ */
  @media (max-width: 1023px) {
    body { overflow: auto; }
    .db-root { overflow: visible; height: auto; min-height: 100vh; }

    /* El sidebar fijo no afecta el scroll del cuerpo */
    #sidebar {
      position: fixed; top:0; left:0; bottom:0;
      transform: translateX(-260px);
      box-shadow: none;
    }
    #sidebar.open {
      transform: translateX(0);
      box-shadow: 8px 0 32px rgba(0,0,0,0.28);
    }
    /* Main area scrollable en móvil */
    #main-area   { width: 100%; overflow: visible !important; height: auto !important; }
    #main-scroll { overflow: visible !important; height: auto !important; padding-bottom: 2rem !important; }

    #hamburger   { display: flex !important; }
    #right-panel { display: none !important; }

    #stats-student,
    #stats-admin  { grid-template-columns: repeat(2,1fr) !important; }

    #student-content,
    #admin-content { grid-template-columns: 1fr !important; }
  }

  /* ══════════════════════════════════════════════════════
     MOBILE  ≤ 639 px
  ══════════════════════════════════════════════════════ */
  @media (max-width: 639px) {
    #main-scroll { padding: 12px 12px 2rem !important; }
    #search-wrap { display: none !important; }
    #mobile-logo { display: flex !important; }
    #tb-name     { display: none; }
    #tb-badge    { display: none; }

    .qa-row {
      flex-wrap: nowrap; overflow-x: auto; padding-bottom: 6px;
      -webkit-overflow-scrolling: touch; scrollbar-width: none;
    }
    .qa-row::-webkit-scrollbar { display: none; }

    #stats-student,
    #stats-admin  { grid-template-columns: repeat(2,1fr) !important; gap: 8px !important; }
    .stat-num     { font-size: 1.375rem !important; }
    .stat-card    { padding: 12px 13px !important; }
    .card         { padding: 14px 14px !important; border-radius: 12px !important; }
    #welcome-h1   { font-size: 1.375rem !important; }
    #topbar       { gap: 8px !important; margin-bottom: 14px !important; }
    #lt-score     { font-size: 1.375rem !important; }
    #admin-content { grid-template-columns: 1fr !important; }
  }

  /* ══════════════════════════════════════════════════════
     MUY PEQUEÑO  ≤ 360 px
  ══════════════════════════════════════════════════════ */
  @media (max-width: 360px) {
    #main-scroll  { padding: 8px 8px 2rem !important; }
    #stats-student,
    #stats-admin  { grid-template-columns: 1fr !important; gap: 6px !important; }
    .stat-num     { font-size: 1.125rem !important; }
    .stat-card    { padding: 10px 12px !important; border-radius: 10px !important; }
    .card         { padding: 12px 12px !important; border-radius: 10px !important; }
    #welcome-h1   { font-size: 1.125rem !important; }
    #topbar       { gap: 6px !important; }
    .qa-btn       { padding: 8px 12px !important; font-size: 0.8rem !important; }
    .rank-row     { padding: 6px 8px !important; }
  }
</style>


<div id="overlay" onclick="closeSidebar()"></div>

<div class="db-root">

  <!-- ══════════ SIDEBAR ══════════ -->
  <aside id="sidebar">

    <!-- Logo -->
    <div style="padding:20px 16px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:5px;">
        <div style="width:35px;height:35px;background:linear-gradient(135deg,#D41224,#9B1F24);border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 12px rgba(212,18,36,0.35);">
          <span class="ti ti-brain" style="color:white;font-size:18px;"></span>
        </div>
        <div>
          <p style="color:white;font-weight:900;font-size:16px;letter-spacing:-0.4px;margin:0;line-height:1.1;">Razona<span style="color:#D41224;">Pro</span></p>
          <p style="color:rgba(255,255,255,0.28);font-size:9px;margin:0;letter-spacing:0.9px;text-transform:uppercase;">Plataforma Saber Pro · UFPSO</p>
        </div>
      </div>
    </div>

    <!-- User -->
    <div style="padding:14px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
      <div style="display:flex;align-items:center;gap:10px;">
        <div id="sb-avatar" style="width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#D41224,#9B1F24);display:flex;align-items:center;justify-content:center;color:white;font-weight:900;font-size:14px;flex-shrink:0;"></div>
        <div style="min-width:0;flex:1;">
          <p id="sb-name" style="color:white;font-weight:700;font-size:13px;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></p>
          <p id="sb-sub"  style="color:rgba(255,255,255,0.32);font-size:11px;margin:0;"></p>
        </div>
        <a href="/perfil" style="color:rgba(255,255,255,0.22);text-decoration:none;padding:4px;flex-shrink:0;transition:color 0.15s;" onmouseover="this.style.color='rgba(255, 0, 0, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
          <span class="ti ti-settings" style="font-size:15px;"></span>
        </a>
      </div>
    </div>

    <!-- Nav -->
    <nav style="padding:10px 10px;flex:1;">
      <span class="nav-section">Principal</span>
      <a href="/dashboard"        class="nav-item active" onclick="closeSidebar()"><span class="ti ti-home"></span> Inicio</a>
      <a href="/tests"            class="nav-item"        onclick="closeSidebar()"><span class="ti ti-clipboard-list"></span> Tests disponibles</a>
      <a href="/ai-practice"      class="nav-item"        onclick="closeSidebar()"><span class="ti ti-robot"></span> Práctica con IA</a>

      <span class="nav-section">Competencias Saber Pro</span>
      <a href="/tests?c=lc" class="nav-item" style="padding-left:10px;" onclick="closeSidebar()"><span style="width:7px;height:7px;border-radius:50%;background:#D41224;flex-shrink:0;"></span> Lectura Crítica</a>
      <a href="/tests?c=rq" class="nav-item" style="padding-left:10px;" onclick="closeSidebar()"><span style="width:7px;height:7px;border-radius:50%;background:#2563EB;flex-shrink:0;"></span> Razonamiento Cuantit.</a>
      <a href="/tests?c=cc" class="nav-item" style="padding-left:10px;" onclick="closeSidebar()"><span style="width:7px;height:7px;border-radius:50%;background:#059669;flex-shrink:0;"></span> Comp. Ciudadanas</a>
      <a href="/tests?c=ce" class="nav-item" style="padding-left:10px;" onclick="closeSidebar()"><span style="width:7px;height:7px;border-radius:50%;background:#7C3AED;flex-shrink:0;"></span> Comunicación Escrita</a>
      <a href="/tests?c=en" class="nav-item" style="padding-left:10px;" onclick="closeSidebar()"><span style="width:7px;height:7px;border-radius:50%;background:#D97706;flex-shrink:0;"></span> Inglés</a>

      <span class="nav-section">Mi cuenta</span>
      <a href="/rankings"     class="nav-item" onclick="closeSidebar()"><span class="ti ti-trophy"></span> Rankings</a>
      <a href="/mis-intentos" class="nav-item" onclick="closeSidebar()"><span class="ti ti-history"></span> Mi historial</a>
      <a href="/perfil"       class="nav-item" onclick="closeSidebar()"><span class="ti ti-user-circle"></span> Mi perfil</a>

      <div id="admin-nav" style="display:none;">
        <span class="nav-section" style="color:rgba(212,18,36,0.55);">Administración</span>
        <a href="/admin/estudiantes" class="nav-item" onclick="closeSidebar()"><span class="ti ti-users"></span> Estudiantes</a>
        <a href="/admin/tests"       class="nav-item" onclick="closeSidebar()"><span class="ti ti-file-description"></span> Gestión Tests</a>
        <a href="/admin/preguntas"   class="nav-item" onclick="closeSidebar()"><span class="ti ti-list-check"></span> Banco Preguntas</a>
        <a href="/admin/programas"   class="nav-item" onclick="closeSidebar()"><span class="ti ti-school"></span> Programas</a>
      </div>
    </nav>

    <!-- Logout -->
    <div style="padding:10px 10px;border-top:1px solid rgba(255,255,255,0.06);">
      <button id="logout-btn" class="nav-item" style="color:rgba(255,100,100,0.55);"
        onmouseover="this.style.background='rgba(212,18,36,0.09)';this.style.color='rgba(255,100,100,0.85)';"
        onmouseout="this.style.background='';this.style.color='rgba(255,100,100,0.55)';">
        <span class="ti ti-logout"></span> Cerrar sesión
      </button>
    </div>
  </aside>


  <!-- ══════════ MAIN AREA ══════════ -->
  <div id="main-area" style="flex:1;display:flex;overflow:hidden;background:var(--ui-bg-alt);">

    <main id="main-scroll" style="flex:1;overflow-y:auto;padding:22px 24px 0;">

      <!-- ── TOPBAR ── -->
      <div id="topbar" class="anim" style="display:flex;align-items:center;gap:12px;margin-bottom:22px;">

        <button id="hamburger" onclick="openSidebar()"
          style="display:none;width:38px;height:38px;background:white;border:1.5px solid #E8E5E0;
                 border-radius:10px;align-items:center;justify-content:center;cursor:pointer;
                 flex-shrink:0;transition:border-color 0.2s;"
          onmouseover="this.style.borderColor='#D41224'" onmouseout="this.style.borderColor='#E8E5E0'">
          <span class="ti ti-menu-2" style="font-size:18px;color:#374151;"></span>
        </button>

        <div id="mobile-logo" style="display:none;align-items:center;gap:8px;flex-shrink:0;">
          <div style="width:30px;height:30px;background:linear-gradient(135deg,#D41224,#9B1F24);border-radius:8px;display:flex;align-items:center;justify-content:center;">
            <span class="ti ti-brain" style="color:white;font-size:16px;"></span>
          </div>
          <span style="font-weight:900;font-size:15px;letter-spacing:-0.3px;color:#111;">Razona<span style="color:#D41224;">Pro</span></span>
        </div>

        <div id="search-wrap" style="flex:1;max-width:450px;position:relative;">
          <span class="ti ti-search" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#B0ADA6;font-size:15px;pointer-events:none;"></span>
          <input id="search-input" type="text" placeholder="Buscar competencias, tests..."
            style="width:100%;padding:10px 16px 10px 38px;background:white;border:1.5px solid #E8E5E0;
                   border-radius:12px;font-size:13.5px;color:#374151;font-family:inherit;
                   box-sizing:border-box;transition:border-color 0.2s;">
        </div>

        <div style="margin-left:auto;display:flex;align-items:center;gap:8px;">
          <button id="notif-btn" title="Notificaciones"
            style="width:38px;height:38px;background:white;border:1.5px solid #E8E5E0;border-radius:10px;
                   display:flex;align-items:center;justify-content:center;cursor:pointer;
                   position:relative;flex-shrink:0;transition:border-color 0.2s;">
            <span class="ti ti-bell" style="font-size:17px;color:#6B7280;"></span>
            <span style="position:absolute;top:7px;right:7px;width:7px;height:7px;background:#D41224;border-radius:50%;border:1.5px solid white;"></span>
          </button>

          <!-- Topbar user — clic va a /perfil -->
          <div id="tb-user" onclick="window.location='/perfil'"
            style="display:flex;align-items:center;gap:8px;padding:5px 12px 5px 5px;background:white;
                   border:1.5px solid #E8E5E0;border-radius:10px;cursor:pointer;transition:border-color 0.2s;">
            <div id="tb-avatar" style="width:28px;height:28px;border-radius:7px;background:linear-gradient(135deg,#D41224,#9B1F24);display:flex;align-items:center;justify-content:center;color:white;font-weight:900;font-size:11px;"></div>
            <span id="tb-name"  style="font-size:13px;font-weight:700;color:#374151;"></span>
            <span id="tb-badge" style="font-size:10px;padding:2px 8px;border-radius:20px;font-weight:700;"></span>
          </div>
        </div>
      </div>

      <!-- ── WELCOME ── -->
      <div class="anim anim-d1" style="margin-bottom:18px;">
        <h1 id="welcome-h1" style="font-size:27px;font-weight:900;color:#111111;margin:0 0 3px;letter-spacing:-0.6px;">Hogar</h1>
        <p id="welcome-msg" style="color:#857F77;font-size:15px;margin:0;"></p>
      </div>

      <!-- ── QUICK ACTIONS (student) ── -->
      <div id="qa-student" class="qa-row anim anim-d2">
        <!-- Todos los botones redirigen a /tests -->
        <a href="/tests"             class="qa-btn" style="background:#D41224;color:white;box-shadow:0 4px 14px rgba(212,18,36,0.28);"><span class="ti ti-clipboard-list"></span> Tests disponibles</a>
        <a href="/ai-practice"       class="qa-btn" style="background:white;color:#374151;border:1.5px solid #E8E5E0;"><span class="ti ti-robot"            style="color:#7C3AED;"></span> Práctica con IA</a>
        <a href="/rankings"          class="qa-btn" style="background:white;color:#374151;border:1.5px solid #E8E5E0;"><span class="ti ti-trophy"           style="color:#D97706;"></span> Rankings</a>
        <a href="/mis-intentos"      class="qa-btn" style="background:white;color:#374151;border:1.5px solid #E8E5E0;"><span class="ti ti-history"          style="color:#059669;"></span> Mi historial</a>
        <a href="/tests?mode=TIMED"  class="qa-btn" style="background:white;color:#374151;border:1.5px solid #E8E5E0;"><span class="ti ti-clock"            style="color:#2563EB;"></span> Simulacros</a>
      </div>

      <!-- ── QUICK ACTIONS (admin) ── -->
      <div id="qa-admin" class="qa-row anim anim-d2" style="display:none;">
        <a href="/admin/estudiantes" class="qa-btn" style="background:#D41224;color:white;box-shadow:0 4px 14px rgba(212,18,36,0.28);"><span class="ti ti-users"></span> Estudiantes</a>
        <a href="/admin/tests"       class="qa-btn" style="background:white;color:#374151;border:1.5px solid #E8E5E0;"><span class="ti ti-file-description" style="color:#2563EB;"></span> Gestionar Tests</a>
        <a href="/admin/preguntas"   class="qa-btn" style="background:white;color:#374151;border:1.5px solid #E8E5E0;"><span class="ti ti-list-check"       style="color:#059669;"></span> Preguntas</a>
        <a href="/admin/rankings"    class="qa-btn" style="background:white;color:#374151;border:1.5px solid #E8E5E0;"><span class="ti ti-award"            style="color:#D97706;"></span> Rankings</a>
        <a href="/admin/programas"   class="qa-btn" style="background:white;color:#374151;border:1.5px solid #E8E5E0;"><span class="ti ti-school"           style="color:#7C3AED;"></span> Programas</a>
      </div>

      <!-- ── STATS (student) ── -->
      <div id="stats-student" class="anim anim-d3" style="display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:22px;">
        <div class="stat-card" style="border-left:3px solid #D41224;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:9px;">
            <span style="font-size:10px;font-weight:700;color:#A09990;text-transform:uppercase;letter-spacing:0.5px;">Tests realizados</span>
            <div style="width:29px;height:29px;background:#FEE2E2;border-radius:7px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <span class="ti ti-clipboard-check" style="color:#D41224;font-size:14px;"></span>
            </div>
          </div>
          <p id="st-tests"  class="stat-num" style="color:#D41224;">—</p>
