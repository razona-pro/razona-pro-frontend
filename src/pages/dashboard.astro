        <div style="display:flex;justify-content:space-between;margin-top:3px;gap:4px;flex-wrap:wrap;">
          <span style="font-size:11px;color:#A09990;">${c.tests} tests realizados</span>
          <span style="font-size:11px;color:#A09990;">Último: ${c.lastDate}</span>
        </div>`;
      compList.appendChild(div);
      setTimeout(() => { document.getElementById(`bar-${i}`).style.width=`${c.score}%`; }, 280+i*90);
    });

    // Last test
    const lt = d.recentTests[0];
    document.getElementById('lt-comp').textContent  = lt.comp;
    document.getElementById('lt-info').textContent  = `${lt.date} · ${lt.type} · ${lt.dur}`;
    document.getElementById('lt-score').textContent = lt.score;

    // Recent list
    const recentList = document.getElementById('recent-list');
    d.recentTests.slice(1).forEach(t => {
      const div = document.createElement('div');
      div.className = 'test-row';
      div.innerHTML = `
        <div style="width:34px;height:34px;border-radius:8px;background:${t.bg};display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-right:10px;">
          <span class="ti ti-clipboard" style="color:${t.color};font-size:16px;"></span>
        </div>
        <div style="flex:1;min-width:0;">
          <p style="font-size:13px;font-weight:700;color:#374151;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${t.comp}</p>
          <p style="font-size:11px;color:#A09990;margin:0;">${t.date} · ${t.type}</p>
        </div>
        <div style="text-align:right;flex-shrink:0;margin-left:10px;">
          <p style="font-size:16px;font-weight:900;color:${t.color};margin:0;">${t.score}</p>
          <p style="font-size:10px;color:#A09990;margin:0;">${t.dur}</p>
        </div>`;
      recentList.appendChild(div);
    });

    // Rankings
    const rankList = document.getElementById('rank-list');
    const medals   = ['🥇','🥈','🥉'];
    d.rankings.forEach(r => {
      const div = document.createElement('div');
      div.className = 'rank-row';
      div.innerHTML = `
        <span style="font-size:15px;min-width:26px;text-align:center;">${medals[r.pos-1]||r.pos}</span>
        <div style="flex:1;min-width:0;">
          <p style="font-size:13px;font-weight:700;color:#374151;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${r.name}</p>
          <p style="font-size:11px;color:#A09990;margin:0;">${r.prog}</p>
        </div>
        <span style="font-size:15px;font-weight:900;color:#D41224;flex-shrink:0;">${r.score}</span>`;
      rankList.appendChild(div);
    });
    document.getElementById('my-rank-num').textContent   = d.stats.rank;
    document.getElementById('my-rank-name').textContent  = fullName;
    document.getElementById('my-rank-score').textContent = d.stats.avg;

    // Trending
    const trendList = document.getElementById('trend-list');
    d.trending.forEach(t => {
      const div = document.createElement('div');
      div.className = 'trend-item';
      div.innerHTML = `
        <div style="width:36px;height:36px;background:${t.bg};border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <span class="ti ti-file-text" style="color:${t.color};font-size:18px;"></span>
        </div>
        <div style="flex:1;min-width:0;">
          <p style="font-size:13px;font-weight:700;color:#374151;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${t.title}</p>
          <p style="font-size:11px;color:#A09990;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${t.sub}</p>
        </div>
        <div style="text-align:right;flex-shrink:0;margin-left:8px;">
          <span style="font-size:10px;padding:3px 8px;border-radius:12px;font-weight:800;background:${t.bg};color:${t.color};">${t.lang}</span>
          <p style="font-size:11px;color:#A09990;margin:4px 0 0;display:flex;align-items:center;gap:3px;justify-content:flex-end;"><span class="ti ti-star" style="font-size:11px;"></span>${t.stars}</p>
        </div>`;
      trendList.appendChild(div);
    });
  }

  // ── ADMIN content ───────────────────────────────────────────
  if (admin) {
    const actList = document.getElementById('admin-activity');
    MOCK.admin.activity.forEach(a => {
      const div = document.createElement('div');
      div.style.cssText = 'display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #F3F1EE;';
      div.innerHTML = `
        <div style="width:36px;height:36px;border-radius:9px;background:#FEE2E2;display:flex;align-items:center;justify-content:center;color:#D41224;font-weight:900;font-size:12px;flex-shrink:0;">${a.av}</div>
        <div style="flex:1;min-width:0;">
          <p style="font-size:13px;font-weight:700;color:#374151;margin:0;">${a.name}</p>
          <p style="font-size:11px;color:#A09990;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${a.action}</p>
        </div>
        <div style="text-align:right;flex-shrink:0;">
          ${a.score!==null?`<p style="font-size:16px;font-weight:900;color:#D41224;margin:0;">${a.score}</p>`:''}
          <p style="font-size:11px;color:#A09990;margin:0;">${a.time}</p>
        </div>`;
      actList.appendChild(div);
    });

    const progList = document.getElementById('admin-programs');
    MOCK.admin.programs.forEach(p => {
      const div = document.createElement('div');
      div.style.marginBottom = '14px';
      div.innerHTML = `
        <div style="display:flex;justify-content:space-between;margin-bottom:5px;">
          <span style="font-size:13px;font-weight:600;color:#374151;">${p.name}</span>
          <span style="font-size:13px;font-weight:800;color:${p.color};">${p.students}</span>
        </div>
        <div style="height:6px;background:#F3F1EE;border-radius:3px;overflow:hidden;">
          <div style="height:100%;background:${p.color};border-radius:3px;width:0%;transition:width 1.2s ease;" data-pct="${p.pct}"></div>
        </div>`;
      progList.appendChild(div);
    });
    setTimeout(() => { progList.querySelectorAll('[data-pct]').forEach(el => el.style.width=el.dataset.pct+'%'); }, 300);
  }

  // ── Changelog ───────────────────────────────────────────────
  const clList = document.getElementById('changelog-list');
  MOCK.changelog.forEach(item => {
    const div = document.createElement('div');
    div.className = 'cl-item';
    div.innerHTML = `
      <div class="cl-dot${item.now?' now':''}"></div>
      <p style="font-size:10px;font-weight:700;color:#A09990;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 3px;">${item.time}</p>
      <p style="font-size:13px;font-weight:700;color:#111111;margin:0 0 4px;line-height:1.35;">${item.title}</p>
      <p style="font-size:12px;color:#A09990;margin:0;line-height:1.55;">${item.desc}</p>`;
    clList.appendChild(div);
  });

  // ── Events ──────────────────────────────────────────────────
  document.getElementById('logout-btn').addEventListener('click', logout);
  window.switchRank = btn => {
    document.querySelectorAll('.r-pill').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
  };
</script>

</BaseLayout>