<script>
  import { requireAuth, isAdmin, logout, getUser, updateStoredUser } from '../lib/auth';
import { studentsApi, triedsApi, testsApi, competencesApi, rankingsApi } from '../lib/api';
import { getCompStyle, animCount, fmtDate, fmtDur } from '../lib/utils';

let user;
try { user = requireAuth(); } catch { throw new Error('redir'); }
const admin = isAdmin();

// ── Sidebar ────────────────────────────────────────────────────
(window as any).openSidebar = () => {
  document.getElementById('sidebar')!.classList.add('open');
  document.getElementById('overlay')!.classList.add('open');
  document.body.style.overflow = 'hidden';
};
(window as any).closeSidebar = () => {
  document.getElementById('sidebar')!.classList.remove('open');
  document.getElementById('overlay')!.classList.remove('open');
  document.body.style.overflow = '';
};
document.addEventListener('keydown', e => { if (e.key === 'Escape') (window as any).closeSidebar(); });

// ── Render inicial con datos del token ────────────────────────
function paintUser(firstName: string, firstSurname: string, programId?: string) {
  const full     = firstSurname ? `${firstName} ${firstSurname}` : firstName;
  const initials = (firstName[0] + (firstSurname?.[0] ?? firstName[1] ?? '')).toUpperCase();

  document.getElementById('sb-avatar')!.textContent = initials;
  document.getElementById('sb-name')!.textContent   = full;
  document.getElementById('sb-sub')!.textContent    = admin ? 'Administrador · UFPSO' : (programId ?? 'Estudiante · UFPSO');
  document.getElementById('tb-avatar')!.textContent = initials;
  document.getElementById('tb-name')!.textContent   = firstName;

  const badge = document.getElementById('tb-badge') as HTMLElement;
  if (admin) { badge.textContent = 'Admin'; badge.style.background = '#1C1917'; badge.style.color = '#F87171'; }
  else       { badge.textContent = 'Estudiante'; badge.style.background = '#FEE2E2'; badge.style.color = '#D41224'; }
}

const stored = getUser()!;
paintUser(stored.firstName || stored.id, stored.firstSurname, stored.programId);

const h = new Date().getHours();
const greet = h < 12 ? '¡Buenos días' : h < 18 ? '¡Buenas tardes' : '¡Buenas noches';
document.getElementById('welcome-msg')!.textContent = `${greet}, ${stored.firstName || stored.id}!`;

// ── Visibilidad por rol ────────────────────────────────────────
if (admin) {
  ['qa-student','stats-student','student-content'].forEach(id => (document.getElementById(id) as HTMLElement).style.display = 'none');
  (document.getElementById('qa-admin') as HTMLElement).style.display = 'flex';
  (document.getElementById('stats-admin') as HTMLElement).style.display = 'grid';
  (document.getElementById('admin-content') as HTMLElement).style.display = 'grid';
  (document.getElementById('admin-nav') as HTMLElement).style.display = 'block';
}

// ── Datos de estudiante ────────────────────────────────────────
if (!admin) {
  Promise.allSettled([
    studentsApi.me(),
    triedsApi.findMy(0, 200),
    testsApi.findAll(0, 20),
    competencesApi.findAll(true),
    rankingsApi.findAll(true),
  ]).then(([profileR, triedsR, testsR, compsR, rankingsR]) => {

    // Perfil
    if (profileR.status === 'fulfilled' && profileR.value.data) {
      const p = profileR.value.data;
      updateStoredUser({ firstName: p.firstName, firstSurname: p.firstSurname, email: p.email });
      paintUser(p.firstName, p.firstSurname, p.programId);

      document.getElementById('welcome-msg')!.textContent =
        `${greet}, ${p.firstName}! Continúa preparándote para el Saber Pro.`;

      const initials = (p.firstName[0] + p.firstSurname[0]).toUpperCase();
      const full     = `${p.firstName} ${p.firstSurname}`;
      document.getElementById('pc-avatar')!.textContent  = initials;
      document.getElementById('pc-name')!.textContent    = full;
      document.getElementById('pc-program')!.textContent = p.programId ?? 'UFPSO';
      document.getElementById('pc-badge')!.innerHTML     = '<span class="ti ti-school" style="font-size:13px;"></span> Estudiante';
    }

    // Intentos
    if (triedsR.status === 'fulfilled' && triedsR.value.data) {
      const trieds   = triedsR.value.data.content;
      const finished = trieds.filter(t => t.status === 'FINISHED' && t.score != null);
      const avgScore = finished.length
        ? finished.reduce((s, t) => s + (t.score ?? 0), 0) / finished.length
        : 0;

      animCount(document.getElementById('st-tests'), finished.length);
      animCount(document.getElementById('st-avg'),   avgScore, 1);
      animCount(document.getElementById('st-streak'), 0);

      // Último test
      const sorted = [...finished].sort((a, b) =>
        new Date(b.finishedAt ?? b.attemptTimestamp).getTime() -
        new Date(a.finishedAt ?? a.attemptTimestamp).getTime()
      );

      if (sorted.length > 0) {
        const lt = sorted[0];
        document.getElementById('lt-comp')!.textContent  = lt.testName ?? lt.competenceId;
        document.getElementById('lt-info')!.textContent  = `${fmtDate(lt.finishedAt ?? lt.attemptTimestamp)} · ${lt.totalQuestions} preguntas`;
        document.getElementById('lt-score')!.textContent = lt.score?.toFixed(0) ?? '—';
      } else {
        document.getElementById('lt-comp')!.textContent  = 'Sin intentos aún';
        document.getElementById('lt-info')!.textContent  = 'Realiza tu primer simulacro';
        document.getElementById('lt-score')!.textContent = '—';
      }

      // Lista reciente
      const recentList = document.getElementById('recent-list')!;
      const recent = sorted.slice(1, 5);
      if (recent.length > 0) {
        recent.forEach(t => {
          const s   = getCompStyle(t.competenceId, t.testName ?? '');
          const div = document.createElement('div');
          div.className = 'test-row';
          div.onclick   = () => window.location.href = '/mis-intentos';
          div.innerHTML = `
            <div style="width:34px;height:34px;border-radius:8px;background:${s.bg};display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-right:10px;">
              <span class="ti ti-clipboard" style="color:${s.color};font-size:16px;"></span>
            </div>
            <div style="flex:1;min-width:0;">
              <p style="font-size:13px;font-weight:700;color:#374151;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${t.testName ?? t.competenceId}</p>
              <p style="font-size:11px;color:#A09990;margin:0;">${fmtDate(t.finishedAt ?? t.attemptTimestamp)} · ${t.totalQuestions} preguntas</p>
            </div>
            <div style="text-align:right;flex-shrink:0;margin-left:10px;">
              <p style="font-size:16px;font-weight:900;color:${s.color};margin:0;">${t.score?.toFixed(0) ?? '—'}</p>
              <p style="font-size:10px;color:#A09990;margin:0;">${fmtDur(t.timeSpentSeconds)}</p>
            </div>`;
          recentList.appendChild(div);
        });
      } else {
        recentList.innerHTML = '<p style="font-size:13px;color:#A09990;text-align:center;padding:12px 0;">Sin intentos aún.</p>';
      }

      // Barras por competencia (se rellenan cuando lleguen las competencias)
      if (compsR.status === 'fulfilled' && compsR.value.data) {
        const byComp: Record<string, number[]> = {};
        finished.forEach(t => {
          if (!byComp[t.competenceId]) byComp[t.competenceId] = [];
          if (t.score != null) byComp[t.competenceId].push(t.score);
        });

        const compList = document.getElementById('comp-list')!;
        compsR.value.data.forEach((c, i) => {
          const s      = getCompStyle(c.competenceId, c.competenceName);
          const scores = byComp[c.competenceId] ?? [];
          const score  = scores.length
            ? Math.round(scores.reduce((a, b) => a + b, 0) / scores.length)
            : 0;

          const div = document.createElement('div');
          div.style.cursor = 'pointer';
          div.onclick      = () => window.location.href = `/tests?c=${s.key}`;
          div.innerHTML    = `
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;gap:8px;flex-wrap:wrap;">
              <div style="display:flex;align-items:center;gap:8px;min-width:0;">
                <div style="width:27px;height:27px;border-radius:7px;background:${s.bg};display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <span style="font-size:9px;font-weight:900;color:${s.color};">${s.short}</span>
                </div>
                <span style="font-size:13px;font-weight:600;color:#374151;">${c.competenceName}</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
                <span style="font-size:16px;font-weight:900;color:${s.color};">${score > 0 ? score : '—'}</span>
                <span style="font-size:11px;color:#A09990;">/100</span>
              </div>
            </div>
            <div class="bar-wrap"><div class="bar-fill" id="cbar-${i}" style="background:${s.color};"></div></div>
            <div style="display:flex;justify-content:space-between;margin-top:3px;gap:4px;flex-wrap:wrap;">
              <span style="font-size:11px;color:#A09990;">${scores.length} tests realizados</span>
              <span style="font-size:11px;color:${s.color};font-weight:600;">Practicar →</span>
            </div>`;
          compList.appendChild(div);
          setTimeout(() => {
            const bar = document.getElementById(`cbar-${i}`);
            if (bar) bar.style.width = `${score}%`;
          }, 300 + i * 80);
        });
      }
    }

    // Tests trending
    if (testsR.status === 'fulfilled' && testsR.value.data) {
      const tests     = testsR.value.data.content.slice(0, 3);
      const trendList = document.getElementById('trend-list')!;
      const modeLabel: Record<string, string> = { PRACTICE: 'PRÁCTICA', EXAM: 'EXAMEN', TIMED: 'TIMED' };

      if (tests.length === 0) {
        trendList.innerHTML = '<p style="font-size:13px;color:#A09990;text-align:center;padding:12px 0;">Sin tests disponibles.</p>';
      } else {
        tests.forEach(t => {
          const s   = getCompStyle(t.competenceId, t.competenceName ?? '');
          const div = document.createElement('div');
          div.className = 'trend-item';
          div.onclick   = () => window.location.href = `/tests?c=${s.key}`;
          div.innerHTML = `
            <div style="width:36px;height:36px;background:${s.bg};border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <span class="ti ti-file-text" style="color:${s.color};font-size:18px;"></span>
            </div>
            <div style="flex:1;min-width:0;">
              <p style="font-size:13px;font-weight:700;color:#374151;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${t.testName}</p>
              <p style="font-size:11px;color:#A09990;margin:0;">${t.competenceName ?? ''} · ${t.questionsToPresent ?? '?'} preguntas · ${Math.floor(t.durationSeconds / 60)} min</p>
            </div>
            <div style="text-align:right;flex-shrink:0;margin-left:8px;">
              <span style="font-size:10px;padding:3px 8px;border-radius:12px;font-weight:800;background:${s.bg};color:${s.color};">${modeLabel[t.testMode] ?? t.testMode}</span>
            </div>`;
          trendList.appendChild(div);
        });
      }
    }

    // Rankings
    if (rankingsR.status === 'fulfilled' && rankingsR.value.data && rankingsR.value.data.length > 0) {
      const generalRanking = rankingsR.value.data.find(r => r.periodType === 'GENERAL') ?? rankingsR.value.data[0];

      rankingsApi.getLeaderboard(generalRanking.rankingId, 0, 10).then(lbRes => {
        if (!lbRes.data) return;
        const items    = lbRes.data.content;
        const rankList = document.getElementById('rank-list')!;
        const medals   = ['🥇','🥈','🥉'];
        const su       = getUser();

        items.slice(0, 5).forEach((r, i) => {
          const div = document.createElement('div');
          div.className = 'rank-row';
          div.innerHTML = `
            <span style="font-size:15px;min-width:26px;text-align:center;">${medals[i] ?? (i + 1)}</span>
            <div style="flex:1;min-width:0;">
              <p style="font-size:13px;font-weight:700;color:#374151;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${r.studentName ?? r.studentId}</p>
              <p style="font-size:11px;color:#A09990;margin:0;">Programa ${r.programId}</p>
            </div>
            <span style="font-size:15px;font-weight:900;color:#D41224;flex-shrink:0;">${Number(r.totalScore).toFixed(1)}</span>`;
          rankList.appendChild(div);
        });

        // Mi posición
        const myIdx = su ? items.findIndex(r => r.studentId === su.id) : -1;
        if (myIdx >= 0) {
          const me = items[myIdx];
          document.getElementById('my-rank-num')!.textContent   = String(myIdx + 1);
          document.getElementById('my-rank-name')!.textContent  = me.studentName ?? su!.id;
          document.getElementById('my-rank-score')!.textContent = Number(me.totalScore).toFixed(1);
          (document.getElementById('st-rank') as HTMLElement).textContent    = `#${myIdx + 1}`;
          (document.getElementById('st-rank-of') as HTMLElement).textContent = `de ${lbRes.data.totalElements}`;
        } else {
          document.getElementById('my-rank-num')!.textContent   = '—';
          document.getElementById('my-rank-name')!.textContent  = 'Sin posición aún';
          document.getElementById('my-rank-score')!.textContent = '0';
          (document.getElementById('st-rank') as HTMLElement).textContent    = '—';
          (document.getElementById('st-rank-of') as HTMLElement).textContent = `de ${lbRes.data.totalElements}`;
        }
      }).catch(() => {});
    }
  });
}

document.getElementById('logout-btn')!.addEventListener('click', logout);
(window as any).switchRank = (btn: HTMLElement) => {
  document.querySelectorAll('.r-pill').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
};
</script>

</BaseLayout>