  const initials = (user.firstName[0] + user.firstSurname[0]).toUpperCase();
  const fullName  = `${user.firstName} ${user.firstSurname}`;

  function animCount(el, target, dec = 0) {
    let start; const dur = 900;
    const run = ts => {
      if (!start) start = ts;
      const p = Math.min((ts - start) / dur, 1);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = dec ? (e * target).toFixed(dec) : Math.floor(e * target);
      if (p < 1) requestAnimationFrame(run);
    };
    requestAnimationFrame(run);
  }

