---
// RazonaPro — Recuperar contraseña
// src/pages/recuperar-contrasena.astro
import '../styles/global.css';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';
---

<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="description" content="Recupera el acceso a tu cuenta RazonaPro · UFPSO" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <script is:inline>
      (function () {
        try {
          var p = JSON.parse(localStorage.getItem('rp-a11y') || '{}');
          var h = document.documentElement;
          if (p.fs) h.setAttribute('data-fs', p.fs);
          if (p.mode === 'dark')           h.classList.add('dark');
          if (p.mode === 'high-contrast')  h.classList.add('high-contrast');
          if (p.mode === 'inverted')       h.classList.add('contrast-inverted');
          if (p.mode === 'contrast-light') h.classList.add('contrast-light');
          if (p.mode === 'contrast-dark')  h.classList.add('contrast-dark');
          if (p.ls && p.ls !== 'normal')  h.setAttribute('data-ls', p.ls);
          if (p.lh)  h.setAttribute('data-lh', p.lh);
          if (p.font && p.font !== 'default') h.setAttribute('data-font', p.font);
          if (p.align && p.align !== 'left') h.setAttribute('data-align', p.align);
          if (p.cursor === 'large') h.classList.add('cursor-large');
          if (p.links) h.classList.add('highlight-links');
        } catch (e) {}
      })();
    </script>
    <title>RazonaPro | Recuperar contraseña</title>

<style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --red:        #D41224;
        --red-dark:   #A50D1B;
        --red-deep:   #7C0913;
        --red-light:  #F8D0D4;
        --text-main:  #1a1a1a;
        --text-muted: #6b6b6b;
        --bg-input:   #f5f5f5;
        --white:      #ffffff;
        --dur: 0.5s;
        --ease: cubic-bezier(0.65, 0, 0.35, 1);
    }

    body {
        font-family: 'Poppins', sans-serif;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5eeee;
        padding: 1rem;
    }

    /* ── Fondo decorativo ── */
    .page-bg { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
    .bg-circle { position: absolute; border-radius: 50%; opacity: 0.07; background: var(--red); }
    .bg-circle-1 { width: 600px; height: 600px; top: -160px; left: -180px; }
    .bg-circle-2 { width: 450px; height: 450px; bottom: -130px; right: -130px; }
    .bg-circle-3 { width: 260px; height: 260px; top: 50%; right: 8%; opacity: 0.045; }

    /* ── Wrapper ── */
    .main-wrapper {
        position: relative; z-index: 1;
        width: 100%; display: flex;
        justify-content: center;
        padding: 0 1.1rem;
    }

    /* ── Card contenedor (misma sombra que el login) ── */
    .card {
        width: min(900px, 100%);
        background: var(--white);
        border-radius: 22px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.13), 0 4px 16px rgba(0,0,0,0.06);
        overflow: hidden;
        display: grid;
        grid-template-columns: 1fr var(--panel-right, 340px);
        min-height: 560px;
    }

    /* ── Panel izquierdo: formulario ── */
    .form-panel {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 2.5rem;
        position: relative;
    }

    .form-inner { width: 100%; max-width: 320px; }

    /* ── Panel derecho: decorativo rojo ── */
    .deco-panel {
        background: linear-gradient(150deg, var(--red) 0%, var(--red-deep) 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 2rem;
        text-align: center;
        gap: 1.2rem;
        position: relative;
        overflow: hidden;
    }

    /* Círculos decorativos dentro del panel rojo */
    .deco-panel::before,
    .deco-panel::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }
    .deco-panel::before { width: 280px; height: 280px; top: -80px; right: -80px; }
    .deco-panel::after  { width: 200px; height: 200px; bottom: -60px; left: -60px; }

    .deco-icon-wrap {
        position: relative; z-index: 1;
        width: 72px; height: 72px;
        border-radius: 50%;
        background: rgba(255,255,255,0.12);
        border: 1.5px solid rgba(255,255,255,0.25);
        display: flex; align-items: center; justify-content: center;
    }

    .deco-panel h2 {
        position: relative; z-index: 1;
        font-family: 'Poppins', sans-serif;
        font-size: 1.7rem; font-weight: 600;
        color: var(--white); line-height: 1.25;
    }

    .deco-panel p {
        position: relative; z-index: 1;
        font-size: 0.82rem; line-height: 1.7;
        color: rgba(255,255,255,0.78);
        max-width: 200px;
    }

    .deco-steps {
        position: relative; z-index: 1;
        display: flex; flex-direction: column; gap: 0.75rem;
        margin-top: 0.5rem; width: 100%;
    }

    .deco-step {
        display: flex; align-items: center; gap: 0.75rem;
        background: rgba(255,255,255,0.09);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 10px;
        padding: 0.65rem 0.9rem;
        text-align: left;
    }

    .deco-step-num {
        width: 22px; height: 22px; border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex; align-items: center; justify-content: center;
        font-size: 10px; font-weight: 800; color: var(--white);
        flex-shrink: 0;
    }

    .deco-step span:last-child {
        font-size: 0.75rem; color: rgba(255,255,255,0.8);
        font-weight: 500; line-height: 1.4;
    }

    /* ── Cabecera del formulario ── */
    .form-header { text-align: center; margin-bottom: 1.8rem; }

    .logo-mark { display: inline-flex; margin-bottom: 0.75rem; }

    .form-title {
        font-family: 'Poppins', sans-serif;
        font-size: 1.65rem; color: var(--text-main); line-height: 1.2;
    }
    .form-subtitle {
        font-size: 0.79rem; color: var(--text-muted);
        margin-top: 0.35rem; letter-spacing: 0.02em; line-height: 1.55;
    }

    /* ── Campos ── */
    .field-group { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.9rem; }

    .field-group label {
        font-size: 0.67rem; font-weight: 700;
        letter-spacing: 0.07em; text-transform: uppercase;
        color: var(--text-muted);
    }

    .input-wrap {
        position: relative; display: flex; align-items: center;
        background: var(--bg-input);
        border: 1.5px solid transparent;
        border-radius: 9px;
        transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    .input-wrap:focus-within {
        background: var(--white);
        border-color: var(--red);
        box-shadow: 0 0 0 3px rgba(212,18,36,0.1);
    }

    .input-icon {
        width: 15px; height: 15px; flex-shrink: 0;
        margin-left: 11px; color: var(--text-muted); pointer-events: none;
    }

    .input-wrap input {
        flex: 1; border: none; background: transparent;
        padding: 0.6rem 0.75rem;
        font-family: inherit; font-size: 0.84rem;
        color: var(--text-main); outline: none; min-width: 0;
    }
    .input-wrap input::placeholder { color: #c0c0c0; }

    /* ── Toggle visibilidad contraseña ── */
    .toggle-pw {
        background: none; border: none; cursor: pointer;
        padding: 0 10px; color: var(--text-muted);
        display: flex; align-items: center;
        transition: color 0.2s; flex-shrink: 0;
    }
    .toggle-pw:hover { color: var(--red); }

    /* ── Mensajes ── */
    .msg-box {
        display: none; padding: 0.65rem 0.9rem;
        border-radius: 8px; font-size: 0.8rem;
        margin-bottom: 0.9rem; line-height: 1.5;
    }
    .msg-box.visible { display: block; }
    .msg-box.error   { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }
    .msg-box.success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }

    /* ── Botón principal ── */
    .btn-primary {
        display: flex; align-items: center; justify-content: center;
        gap: 0.5rem;
        width: 100%;
        font-family: inherit; font-size: 0.79rem;
        font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase;
        background: var(--red); color: var(--white);
        border: none; border-radius: 10px;
        padding: 0.78rem 1.5rem;
        cursor: pointer;
        box-shadow: 0 4px 18px rgba(212,18,36,0.32);
        transition: transform 0.15s, box-shadow 0.15s, background 0.2s;
        margin-top: 0.3rem;
    }
    .btn-primary:hover:not(:disabled) {
        background: var(--red-dark);
        box-shadow: 0 6px 24px rgba(212,18,36,0.42);
        transform: translateY(-1px);
    }
    .btn-primary:active { transform: scale(0.97); }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    /* ── Links secundarios ── */
    .link-back {
        display: block; text-align: center;
        font-size: 0.77rem; color: var(--text-muted); text-decoration: none;
        margin-top: 1rem; font-weight: 500;
        transition: color 0.2s; letter-spacing: 0.02em;
    }
    .link-back:hover { color: var(--red); }

    /* ── Indicador de pasos ── */
    .steps-indicator {
        display: flex; align-items: center; justify-content: center;
        gap: 0.4rem; margin-bottom: 1.6rem;
    }
    .step-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: #e0d5d5; transition: background 0.3s, width 0.3s;
    }
    .step-dot.active { background: var(--red); width: 22px; border-radius: 4px; }
    .step-dot.done   { background: var(--red); opacity: 0.4; }

    /* ── Separador ── */
    .divider {
        display: flex; align-items: center; gap: 0.75rem;
        margin: 1.1rem 0;
    }
    .divider::before,
    .divider::after {
        content: ''; flex: 1; height: 1px; background: #ede5e5;
    }
    .divider span { font-size: 0.7rem; color: #c0b8b8; text-transform: uppercase; letter-spacing: 0.1em; }

    /* ── Pantallas (views) ── */
    .view { display: none; }
    .view.active { display: block; }

    /* ── Pantalla éxito especial ── */
    .success-screen {
        text-align: center; padding: 0.5rem 0;
    }
    .success-icon-wrap {
        width: 68px; height: 68px; border-radius: 50%;
        background: #f0fdf4; border: 2px solid #bbf7d0;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.2rem;
        animation: pop-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @keyframes pop-in {
        from { transform: scale(0.5); opacity: 0; }
        to   { transform: scale(1);   opacity: 1; }
    }

    .success-screen h3 {
        font-family: 'Poppins', sans-serif;
        font-size: 1.35rem; color: var(--text-main);
        margin-bottom: 0.6rem;
    }
    .success-screen p {
        font-size: 0.82rem; color: var(--text-muted);
        line-height: 1.65; margin-bottom: 1.4rem;
    }
    .success-screen .email-highlight {
        display: inline-block;
        background: #fef2f2; border: 1px solid var(--red-light);
        color: var(--red-dark); border-radius: 6px;
        padding: 0.2rem 0.6rem; font-weight: 600;
        font-size: 0.83rem; margin: 0 0.1rem;
        word-break: break-all;
    }

    /* ── Requisitos de contraseña ── */
    .pw-reqs {
        display: flex; flex-direction: column; gap: 0.3rem;
        margin: 0.6rem 0 0.9rem;
        padding: 0.75rem 0.9rem;
        background: #fdf8f8; border-radius: 8px;
        border: 1px solid #f2e0e0;
    }
    .pw-req {
        display: flex; align-items: center; gap: 0.5rem;
        font-size: 0.73rem; color: #b0a0a0;
        transition: color 0.2s;
    }
    .pw-req.met { color: #15803d; }
    .pw-req-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: #ddd; flex-shrink: 0;
        transition: background 0.2s;
    }
    .pw-req.met .pw-req-dot { background: #22c55e; }

    /* ── Scrollbar ── */
    ::-webkit-scrollbar { width: 3px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--red-light); border-radius: 3px; }

    /* ════════════════════════════════════════
       RESPONSIVE
    ════════════════════════════════════════ */
    @media (max-width: 700px) {
        .card {
            grid-template-columns: 1fr;
            min-height: unset;
        }
        .deco-panel { display: none; }
        .form-panel { padding: 2.5rem 1.75rem; }
        .form-inner { max-width: 100%; }
    }

    @media (max-width: 440px) {
        body { padding: 0.75rem; }
        .form-panel { padding: 2rem 1.25rem; }
    }
</style>
</head>
<body>

    <div class="page-bg" aria-hidden="true">
        <div class="bg-circle bg-circle-1"></div>
        <div class="bg-circle bg-circle-2"></div>
        <div class="bg-circle bg-circle-3"></div>
    </div>

    <main class="main-wrapper">
        <div class="card">

            <!-- ══════════════════════════════════════
                 PANEL IZQUIERDO: FORMULARIOS
            ══════════════════════════════════════ -->
            <div class="form-panel">
                <div class="form-inner">

                    <!-- Cabecera común -->
                    <div class="form-header">
                        <div class="logo-mark" aria-hidden="true">
                            <svg width="38" height="38" viewBox="0 0 38 38" fill="none">
                                <circle cx="19" cy="19" r="19" fill="#D41224"/>
                                <path d="M12 26 L19 12 L26 26" stroke="white" stroke-width="2.2"
                                      stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                <line x1="14.5" y1="22" x2="23.5" y2="22"
                                      stroke="white" stroke-width="2.2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <h1 class="form-title" id="page-title">Recuperar contraseña</h1>
                        <p class="form-subtitle" id="page-sub">
                            Ingresa tu correo y te enviaremos un enlace para restablecer tu acceso.
                        </p>
                    </div>

                    <!-- Indicador de pasos -->
                    <div class="steps-indicator" id="steps-indicator">
                        <div class="step-dot active" id="dot-1"></div>
                        <div class="step-dot"        id="dot-2"></div>
                        <div class="step-dot"        id="dot-3"></div>
                    </div>

                    <!-- ─── VISTA 1: Ingresar correo ─── -->
                    <div class="view active" id="view-email">

                        <div id="email-error" class="msg-box error"></div>

                        <div class="field-group">
                            <label for="recovery-email">Correo electrónico</label>
                            <div class="input-wrap">
                                <svg class="input-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                    <rect x="3" y="5" width="14" height="10" rx="1.5"
                                          stroke="currentColor" stroke-width="1.5"/>
                                    <path d="M3 5l7 6 7-6" stroke="currentColor"
                                          stroke-width="1.5" stroke-linejoin="round"/>
                                </svg>
                                <input
                                    id="recovery-email"
                                    type="email"
                                    placeholder="tu@correo.edu.co"
                                    autocomplete="email"
                                    required
                                />
                            </div>
                        </div>

                        <button class="btn-primary" id="btn-send-email">
                            <span id="send-label">Enviar enlace</span>
                            <svg viewBox="0 0 16 16" fill="none" width="15" height="15" aria-hidden="true">
                                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor"
                                      stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>

                        <div class="divider"><span>o</span></div>

                        <a href="/login" class="link-back">← Volver al inicio de sesión</a>
                    </div>

                    <!-- ─── VISTA 2: Correo enviado ─── -->
                    <div class="view" id="view-sent">
                        <div class="success-screen">
                            <div class="success-icon-wrap">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                                    <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                          stroke="#15803d" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <h3>¡Correo enviado!</h3>
                            <p>
                                Hemos enviado un enlace de recuperación a<br/>
                                <span class="email-highlight" id="sent-email-display"></span><br/>
                                Revisa tu bandeja de entrada y sigue las instrucciones.
                            </p>
                            <p style="font-size: 0.75rem; color: #b0a0a0; margin-bottom: 1.2rem;">
                                ¿No lo ves? Revisa tu carpeta de spam o correo no deseado.
                            </p>
                            <button class="btn-primary" id="btn-resend"
                                style="margin-top: 0;">
                                Reenviar correo
                            </button>
                            <a href="/login" class="link-back">← Volver al inicio de sesión</a>
                        </div>
                    </div>

                    <!-- ─── VISTA 3: Nueva contraseña (desde el enlace del correo) ─── -->
                    <div class="view" id="view-new-password">

                        <div id="pw-error"   class="msg-box error"></div>
                        <div id="pw-success" class="msg-box success"></div>

                        <div class="field-group">
                            <label for="new-password">Nueva contraseña</label>
                            <div class="input-wrap">
                                <svg class="input-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                    <rect x="5" y="9" width="10" height="8" rx="1.5"
                                          stroke="currentColor" stroke-width="1.5"/>
                                    <path d="M7 9V6.5a3 3 0 016 0V9"
                                          stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                </svg>
                                <input id="new-password" type="password"
                                       placeholder="Mín. 8 caracteres"
                                       autocomplete="new-password" required />
                                <button type="button" class="toggle-pw"
                                        aria-label="Mostrar contraseña" data-target="new-password">
                                    <svg viewBox="0 0 20 20" fill="none" width="16" height="16" aria-hidden="true">
                                        <ellipse cx="10" cy="10" rx="7" ry="4.5"
                                                 stroke="currentColor" stroke-width="1.5"/>
                                        <circle cx="10" cy="10" r="2"
                                                stroke="currentColor" stroke-width="1.5"/>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Requisitos de contraseña -->
                        <div class="pw-reqs" id="pw-requirements">
                            <div class="pw-req" id="req-length">
                                <div class="pw-req-dot"></div>
                                Mínimo 8 caracteres
                            </div>
                            <div class="pw-req" id="req-upper">
                                <div class="pw-req-dot"></div>
                                Al menos una mayúscula
                            </div>
                            <div class="pw-req" id="req-lower">
                                <div class="pw-req-dot"></div>
                                Al menos una minúscula
                            </div>
                            <div class="pw-req" id="req-number">
                                <div class="pw-req-dot"></div>
                                Al menos un número
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="confirm-password">Confirmar contraseña</label>
                            <div class="input-wrap">
                                <svg class="input-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                    <rect x="5" y="9" width="10" height="8" rx="1.5"
                                          stroke="currentColor" stroke-width="1.5"/>
                                    <path d="M7 9V6.5a3 3 0 016 0V9"
                                          stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                </svg>
                                <input id="confirm-password" type="password"
                                       placeholder="Repite tu contraseña"
                                       autocomplete="new-password" required />
                                <button type="button" class="toggle-pw"
                                        aria-label="Mostrar contraseña" data-target="confirm-password">
                                    <svg viewBox="0 0 20 20" fill="none" width="16" height="16" aria-hidden="true">
                                        <ellipse cx="10" cy="10" rx="7" ry="4.5"
                                                 stroke="currentColor" stroke-width="1.5"/>
                                        <circle cx="10" cy="10" r="2"
                                                stroke="currentColor" stroke-width="1.5"/>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <button class="btn-primary" id="btn-set-password">
                            <span id="set-pw-label">Cambiar contraseña</span>
                            <svg viewBox="0 0 16 16" fill="none" width="15" height="15" aria-hidden="true">
                                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor"
                                      stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>

                        <a href="/login" class="link-back">← Volver al inicio de sesión</a>
                    </div>

                    <!-- ─── VISTA 4: Contraseña cambiada exitosamente ─── -->
                    <div class="view" id="view-done">
                        <div class="success-screen">
                            <div class="success-icon-wrap">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                          stroke="#15803d" stroke-width="1.8"
                                          stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <h3>¡Contraseña actualizada!</h3>
                            <p>
                                Tu contraseña ha sido cambiada exitosamente.<br/>
                                Ya puedes iniciar sesión con tus nuevas credenciales.
                            </p>
                            <a href="/login" class="btn-primary" style="text-decoration: none; margin-top: 0;">
                                Ir a iniciar sesión
                                <svg viewBox="0 0 16 16" fill="none" width="15" height="15" aria-hidden="true">
                                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor"
                                          stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </a>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ══════════════════════════════════════
                 PANEL DERECHO: DECORATIVO
            ══════════════════════════════════════ -->
            <div class="deco-panel" aria-hidden="true">

                <div class="deco-icon-wrap">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
                        <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                              stroke="rgba(255,255,255,0.9)" stroke-width="1.8"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>

                <h2>Recupera tu acceso</h2>

                <p>Sigue estos sencillos pasos para volver a tu portal RazonaPro de forma segura.</p>

                <div class="deco-steps">
                    <div class="deco-step">
                        <div class="deco-step-num">1</div>
                        <span>Ingresa tu correo institucional registrado</span>
                    </div>
                    <div class="deco-step">
                        <div class="deco-step-num">2</div>
                        <span>Abre el enlace que te enviaremos al correo</span>
                    </div>
                    <div class="deco-step">
                        <div class="deco-step-num">3</div>
                        <span>Crea una nueva contraseña segura</span>
                    </div>
                </div>

            </div>

        </div>
    </main>

<script>
// @ts-nocheck

/* ════════════════════════════════════════════════════
   API
════════════════════════════════════════════════════ */
const BASE_URL = (typeof import.meta !== 'undefined' && import.meta.env?.PUBLIC_API_URL)
    ? import.meta.env.PUBLIC_API_URL
    : 'http://localhost:8080';

async function apiRequest(path, options = {}) {
    const url = `${BASE_URL}${path}`;
    const headers = { 'Content-Type': 'application/json', ...(options.headers ?? {}) };
    const res = await fetch(url, { ...options, headers });
    const json = await res.json();
    if (!res.ok && !json.success) throw json;
    return json;
}

/* ════════════════════════════════════════════════════
   ELEMENTOS
════════════════════════════════════════════════════ */
const dot1    = document.getElementById('dot-1');
const dot2    = document.getElementById('dot-2');
const dot3    = document.getElementById('dot-3');
const pageTitle = document.getElementById('page-title');
const pageSub   = document.getElementById('page-sub');
const stepsInd  = document.getElementById('steps-indicator');

/* ════════════════════════════════════════════════════
   NAVEGACIÓN ENTRE VISTAS
════════════════════════════════════════════════════ */
function showView(id) {
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    document.getElementById(id).classList.add('active');
}

function setStep(n) {
    const dots = [dot1, dot2, dot3];
    dots.forEach((d, i) => {
        d.classList.remove('active', 'done');
        if (i + 1 < n) d.classList.add('done');
        if (i + 1 === n) d.classList.add('active');
    });
}

/* ════════════════════════════════════════════════════
   DETECCIÓN DE TOKEN EN URL
   Si viene con ?token=xxx mostramos el formulario
   de nueva contraseña directamente (vista 3)
════════════════════════════════════════════════════ */
const urlParams   = new URLSearchParams(window.location.search);
const resetToken  = urlParams.get('token');

if (resetToken) {
    showView('view-new-password');
    setStep(2);
    pageTitle.textContent = 'Nueva contraseña';
    pageSub.textContent   = 'Crea una contraseña segura para tu cuenta.';
}

/* ════════════════════════════════════════════════════
   HELPERS
════════════════════════════════════════════════════ */
function showMsg(boxId, text, type = 'error') {
    const el = document.getElementById(boxId);
    if (!el) return;
    el.textContent = text;
    el.className = `msg-box ${type} visible`;
}
function hideMsg(boxId) {
    const el = document.getElementById(boxId);
    if (el) el.classList.remove('visible');
}

/* ════════════════════════════════════════════════════
   PASO 1: ENVIAR CORREO DE RECUPERACIÓN
════════════════════════════════════════════════════ */
const btnSendEmail = document.getElementById('btn-send-email');
const sendLabel    = document.getElementById('send-label');

btnSendEmail.addEventListener('click', async () => {
    hideMsg('email-error');
    const email = document.getElementById('recovery-email').value.trim();

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showMsg('email-error', 'Por favor ingresa un correo electrónico válido.');
        return;
    }

    btnSendEmail.disabled = true;
    sendLabel.textContent = 'Enviando...';

    try {
        /* Ajusta el endpoint según tu backend */
        await apiRequest('/api/auth/forgot-password', {
            method: 'POST',
            body: JSON.stringify({ email }),
        });
    } catch {
        /* Siempre mostramos éxito por seguridad (no revelar si el email existe) */
    } finally {
        btnSendEmail.disabled = false;
        sendLabel.textContent = 'Enviar enlace';
    }

    /* Mostrar pantalla de éxito */
    document.getElementById('sent-email-display').textContent = email;
    showView('view-sent');
    setStep(2);
    pageTitle.textContent = 'Revisa tu correo';
    pageSub.textContent   = 'El enlace estará disponible por 30 minutos.';
});

/* ════════════════════════════════════════════════════
   REENVIAR CORREO
════════════════════════════════════════════════════ */
document.getElementById('btn-resend').addEventListener('click', () => {
    showView('view-email');
    setStep(1);
    pageTitle.textContent = 'Recuperar contraseña';
    pageSub.textContent   = 'Ingresa tu correo y te enviaremos un enlace para restablecer tu acceso.';
    document.getElementById('recovery-email').focus();
});

/* ════════════════════════════════════════════════════
   VALIDACIÓN EN TIEMPO REAL DE CONTRASEÑA
════════════════════════════════════════════════════ */
const newPasswordInput = document.getElementById('new-password');

const REQS = {
    'req-length': v => v.length >= 8,
    'req-upper':  v => /[A-Z]/.test(v),
    'req-lower':  v => /[a-z]/.test(v),
    'req-number': v => /\d/.test(v),
};

newPasswordInput.addEventListener('input', () => {
    const val = newPasswordInput.value;
    Object.entries(REQS).forEach(([id, fn]) => {
        document.getElementById(id).classList.toggle('met', fn(val));
    });
});

/* ════════════════════════════════════════════════════
   PASO 2 (desde enlace): CAMBIAR CONTRASEÑA
════════════════════════════════════════════════════ */
const btnSetPw  = document.getElementById('btn-set-password');
const setPwLbl  = document.getElementById('set-pw-label');

btnSetPw.addEventListener('click', async () => {
    hideMsg('pw-error');
    hideMsg('pw-success');

    const newPw  = document.getElementById('new-password').value;
    const confPw = document.getElementById('confirm-password').value;

    /* Validar requisitos */
    const allMet = Object.values(REQS).every(fn => fn(newPw));
    if (!allMet) {
        showMsg('pw-error', 'La contraseña no cumple todos los requisitos de seguridad.');
        return;
    }
    if (newPw !== confPw) {
        showMsg('pw-error', 'Las contraseñas no coinciden.');
        return;
    }
    if (!resetToken) {
        showMsg('pw-error', 'Token de recuperación no encontrado. Solicita un nuevo enlace.');
        return;
    }

    btnSetPw.disabled = true;
    setPwLbl.textContent = 'Cambiando...';

    try {
        /* Ajusta el endpoint según tu backend */
        await apiRequest('/api/auth/reset-password', {
            method: 'POST',
            body: JSON.stringify({ token: resetToken, newPassword: newPw }),
        });

        /* Éxito */
        showView('view-done');
        setStep(3);
        stepsInd.style.display = 'none';
        pageTitle.textContent  = '¡Listo!';
        pageSub.textContent    = 'Tu contraseña ha sido actualizada.';

    } catch (err) {
        showMsg('pw-error', err?.message ?? 'El enlace expiró o es inválido. Solicita uno nuevo.');
        btnSetPw.disabled = false;
        setPwLbl.textContent = 'Cambiar contraseña';
    }
});

/* ════════════════════════════════════════════════════
   TOGGLE VISIBILIDAD CONTRASEÑAS
════════════════════════════════════════════════════ */
document.querySelectorAll('.toggle-pw').forEach(btn => {
    btn.addEventListener('click', () => {
        const input = document.getElementById(btn.dataset.target);
        if (!input) return;
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        btn.setAttribute('aria-label', isHidden ? 'Ocultar contraseña' : 'Mostrar contraseña');
    });
});

/* ════════════════════════════════════════════════════
   ENTER para enviar en el campo de correo
════════════════════════════════════════════════════ */
document.getElementById('recovery-email').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') btnSendEmail.click();
});
</script>
<AccessibilityWidget />
</body>
</html>