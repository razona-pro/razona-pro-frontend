---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Banco de Preguntas" currentPage="admin-questions">
  <div style="margin-bottom:1.25rem">
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
      <a href="/admin/stats" style="color:var(--ui-text-3);text-decoration:none" onmouseover="this.style.color='var(--brand)'" onmouseout="this.style.color='var(--ui-text-3)'">Panel admin</a>
      <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Preguntas</span>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
      <div>
        <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Banco de preguntas</h1>
        <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Gestiona el banco de preguntas por competencia.</p>
      </div>
      <button id="btn-new-q" style="display:inline-flex;align-items:center;gap:7px;padding:0.625rem 1.125rem;border-radius:10px;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-size:0.875rem;font-weight:700;border:none;cursor:pointer;font-family:inherit;box-shadow:0 3px 12px rgba(212,18,36,0.28)">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nueva pregunta
      </button>
    </div>
  </div>

  <!-- Selector de competencia y filtros -->
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:1rem;align-items:center">
    <select id="filter-comp" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none;min-width:220px">
      <option value="">Todas las competencias</option>
    </select>
    <select id="filter-diff" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none">
      <option value="ALL">Todas las dificultades</option>
      <option value="B">Básico</option>
      <option value="M">Medio</option>
      <option value="A">Alto</option>
      <option value="NONE">Sin dificultad / No aplica</option>
    </select>
    <select id="filter-status" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none">
      <option value="ALL">Todos los estados</option>
      <option value="active">Activas</option>
      <option value="inactive">Inactivas</option>
    </select>
    <span id="count-label" style="font-size:0.8125rem;color:var(--ui-text-3);margin-left:auto"></span>
  </div>

  <!-- Tabla -->
  <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden">
    <div id="table-wrap" style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse">
        <thead>
          <tr style="border-bottom:1px solid var(--ui-border)">
            <th class="th sort-th" data-col="id">Ítem <span class="sort-ind" data-col="id"></span></th>
            <th class="th sort-th" data-col="stmt">Enunciado <span class="sort-ind" data-col="stmt"></span></th>
            <th class="th sort-th" data-col="diff">Dificultad <span class="sort-ind" data-col="diff"></span></th>
            <th class="th">Fuente</th>
            <th class="th sort-th" data-col="opts">Opciones <span class="sort-ind" data-col="opts"></span></th>
            <th class="th sort-th" data-col="status">Estado <span class="sort-ind" data-col="status"></span></th>
            <th class="th">Acciones</th>
          </tr>
        </thead>
        <tbody id="questions-tbody">
          <tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Cargando preguntas...</td></tr>
        </tbody>
      </table>
    </div>
    <div style="padding:0.875rem 1.25rem;border-top:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
      <span id="page-info" style="font-size:0.8125rem;color:var(--ui-text-3)"></span>
      <div style="display:flex;gap:6px">
        <button id="btn-prev" class="page-btn" disabled>← Anterior</button>
        <button id="btn-next" class="page-btn">Siguiente →</button>
      </div>
    </div>
  </div>
</AdminLayout>

<!-- Modal editar pregunta -->
<div id="edit-q-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:20px;padding:2rem;max-width:560px;width:calc(100% - 2rem);max-height:90vh;overflow-y:auto;animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
      <h2 style="font-size:1.0625rem;font-weight:800;color:var(--ui-text-1);margin:0">Editar pregunta</h2>
      <button id="eq-close" style="background:none;border:none;cursor:pointer;color:var(--ui-text-3);font-size:1.25rem;line-height:1;font-family:inherit">×</button>
    </div>
    <div id="eq-error" style="display:none;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:10px 12px;font-size:0.8125rem;color:#B91C1C;margin-bottom:1rem"></div>
    <input type="hidden" id="eq-comp" /><input type="hidden" id="eq-qid" />
    <form id="eq-form" novalidate>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:1rem">
        <div class="field-grp">
          <label class="field-lbl">Enunciado *</label>
          <textarea id="eq-stmt" class="field-inp" rows="4" maxlength="2000" required style="resize:vertical"></textarea>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="field-grp">
            <label class="field-lbl">Dificultad (opcional)</label>
            <select id="eq-diff" class="field-inp">
              <option value="">No aplica</option>
              <option value="B">Básico</option>
              <option value="M">Medio</option>
              <option value="A">Alto</option>
            </select>
          </div>
          <div class="field-grp">
            <label class="field-lbl">Fuente</label>
            <input id="eq-src" type="text" class="field-inp" placeholder="Ej: ICFES 2024" maxlength="50" />
          </div>
        </div>
        <div class="field-grp">
          <label class="field-lbl">Explicación / Retroalimentación</label>
          <textarea id="eq-exp" class="field-inp" rows="2" maxlength="2000" style="resize:vertical"></textarea>
        </div>
        <!-- Opciones -->
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
            <label class="field-lbl" style="margin:0">Opciones de respuesta * (marca la correcta)</label>
            <button type="button" id="eq-add-option" style="font-size:0.75rem;padding:3px 10px;border-radius:7px;border:1.5px solid var(--brand);background:transparent;color:var(--brand);font-weight:600;cursor:pointer;font-family:inherit">+ Añadir</button>
          </div>
          <div id="eq-options-container" style="display:flex;flex-direction:column;gap:6px"></div>
        </div>
      </div>
      <div style="display:flex;gap:8px;margin-top:0.25rem">
        <button type="button" id="eq-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
        <button type="submit" id="eq-submit" style="flex:2;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(212,18,36,0.28)">
          <span id="eq-label">Guardar cambios</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal crear pregunta -->
<div id="create-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:500;align-items:center;justify-content:flex-start;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:20px;padding:2rem;max-width:600px;width:calc(100%-2rem);max-height:90vh;overflow-y:auto;animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
      <h2 style="font-size:1.0625rem;font-weight:800;color:var(--ui-text-1);margin:0">Nueva pregunta</h2>
      <button id="modal-close" style="background:none;border:none;cursor:pointer;color:var(--ui-text-3);font-size:1.25rem;line-height:1">×</button>
    </div>

    <div id="create-error" style="display:none;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:10px 12px;font-size:0.8125rem;color:#B91C1C;margin-bottom:1rem"></div>

    <form id="create-form" novalidate>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:1rem">
        <div class="field-grp">
          <label class="field-lbl">Competencia *</label>
          <select id="c-comp" class="field-inp">
            <option value="">- Selecciona -</option>
          </select>
        </div>
        <div class="field-grp">
          <label class="field-lbl">Enunciado *</label>
          <textarea id="c-statement" class="field-inp" rows="4" placeholder="Texto completo de la pregunta..." maxlength="2000" required style="resize:vertical"></textarea>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="field-grp">
            <label class="field-lbl">Dificultad (opcional)</label>
            <select id="c-diff" class="field-inp">
              <option value="" selected>No aplica</option>
              <option value="B">Básico</option>
              <option value="M">Medio</option>
              <option value="A">Alto</option>
            </select>
          </div>
          <div class="field-grp">
            <label class="field-lbl">Fuente</label>
            <input id="c-source" type="text" class="field-inp" placeholder="Ej: ICFES 2024" maxlength="50" />
          </div>
        </div>
        <div class="field-grp">
          <label class="field-lbl">Explicación / Retroalimentación</label>
          <textarea id="c-explanation" class="field-inp" rows="2" placeholder="Explica por qué la respuesta correcta es correcta..." maxlength="2000" style="resize:vertical"></textarea>
        </div>

        <!-- Opciones -->
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
            <label class="field-lbl" style="margin:0">Opciones de respuesta * (mín. 2, marca la correcta)</label>
            <button type="button" id="add-option" style="font-size:0.75rem;padding:3px 10px;border-radius:7px;border:1.5px solid var(--brand);background:transparent;color:var(--brand);font-weight:600;cursor:pointer;font-family:inherit">+ Añadir</button>
          </div>
          <div id="options-container" style="display:flex;flex-direction:column;gap:6px"></div>
        </div>
      </div>
      <div style="display:flex;gap:8px">
        <button type="button" id="create-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
        <button type="submit" id="create-submit" style="flex:2;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(212,18,36,0.28)">
          <span id="create-label">Crear pregunta</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal desactivar pregunta -->
<div id="deact-q-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:600;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:18px;padding:2rem;max-width:360px;width:calc(100%-2rem);text-align:center;animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="width:52px;height:52px;border-radius:14px;background:#FEE2E2;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
      <svg width="24" height="24" fill="none" stroke="#DC2626" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
    </div>
    <h3 style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem">¿Desactivar pregunta?</h3>
    <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.25rem;line-height:1.55">La pregunta dejará de aparecer en nuevos tests. Los intentos existentes no se verán afectados.</p>
    <div style="display:flex;gap:8px">
      <button id="deact-q-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
      <button id="deact-q-confirm" style="flex:1;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,#DC2626,#991B1B);color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Desactivar</button>
    </div>
  </div>
</div>

<style>
  @keyframes modalIn { from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)} }
  @keyframes spin    { to{transform:rotate(360deg)} }
  .page-btn { padding:6px 14px;border-radius:8px;border:1.5px solid var(--ui-border);background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;font-weight:600;cursor:pointer;transition:all 0.15s }
  .page-btn:hover:not(:disabled) { border-color:var(--brand);color:var(--brand) }
  .page-btn:disabled { opacity:0.4;cursor:not-allowed }
  .field-grp { display:flex;flex-direction:column;gap:4px }
  .field-lbl { font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3) }
  .field-inp { padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);outline:none;transition:border-color 0.2s;width:100%;appearance:none }
  .field-inp:focus { border-color:var(--brand);box-shadow:0 0 0 3px rgba(212,18,36,0.1) }
  .sort-th { cursor:pointer;user-select:none }
  .sort-th:hover { background:var(--ui-hover) }
  .sort-ind::after { content:''; font-size:0.625rem;margin-left:4px;opacity:0.4 }
  .sort-ind.asc::after  { content:'▲'; opacity:1;color:var(--brand) }
  .sort-ind.desc::after { content:'▼'; opacity:1;color:var(--brand) }
</style>

<script>
  import { requireAuth, isAdmin } from '../../lib/auth';
  import { competencesApi }  from '../../lib/api/competences.api';
  import { apiFetch }        from '../../lib/api/client';
  import { toast }           from '../../lib/toast';
  import type { QuestionDto } from '../../lib/api/types';

  try {
    requireAuth();
    if (!isAdmin()) { window.location.replace('/dashboard'); throw new Error(); }
  } catch { throw new Error('redirect'); }

  const DIFF_LABEL: Record<string, string> = { B:'Básico', M:'Medio', A:'Alto' };
  const DIFF_COLOR: Record<string, string> = { B:'#059669', M:'#D97706', A:'#DC2626' };
  const DIFF_BG:    Record<string, string> = { B:'#D1FAE5', M:'#FEF3C7', A:'#FEE2E2' };

  let page       = 0;
  const SIZE     = 20;
  let totalPages = 1;
  let currentComp  = '';
  let currentDiff  = 'ALL';
  let currentStatus = 'ALL';
  let debounce: ReturnType<typeof setTimeout>;
  let pendingDeactComp = '';
  let pendingDeactQ    = '';
  let sortCol: string | null = 'id';  // orden por defecto: ítem ascendente
  let sortAsc = true;
  let cachedRows: any[] = [];         // copia local para ordenar sin volver a pedir al API

  const questionMap = new Map<string, QuestionDto>();

  // Cargar competencias para ambos selectores
  competencesApi.findAll(false).then(res => {
    if (!res.data) return;
    const filterSel = document.getElementById('filter-comp') as HTMLSelectElement;
    const formSel   = document.getElementById('c-comp')      as HTMLSelectElement;
    res.data.forEach(c => {
      [filterSel, formSel].forEach(sel => {
        const opt = document.createElement('option');
        opt.value = c.competenceId;
        opt.textContent = c.competenceName;
        sel.appendChild(opt);
      });
    });
    // Cargar todas las preguntas al iniciar
    loadQuestions();
  }).catch(() => { loadQuestions(); });

  async function loadQuestions() {
    const tbody = document.getElementById('questions-tbody')!;
    tbody.innerHTML = `<tr><td colspan="7" style="padding:1.5rem;text-align:center;color:var(--ui-text-3)">
      <div style="display:inline-flex;align-items:center;gap:8px"><div style="width:14px;height:14px;border:2px solid var(--brand);border-top-color:transparent;border-radius:50%;animation:spin 0.7s linear infinite"></div> Cargando...</div>
    </td></tr>`;

    try {
      let url: string;
      if (currentComp) {
        // Endpoint correcto para preguntas de una competencia
        let q = `page=${page}&size=${SIZE}`;
        if (currentDiff !== 'ALL')   q += currentDiff === 'NONE' ? `&difficultyLevel=` : `&difficultyLevel=${currentDiff}`;
        if (currentStatus !== 'ALL') q += `&isActive=${currentStatus === 'active'}`;
        url = `/api/competences/${currentComp}/questions?${q}`;
      } else {
        // Endpoint global
        let q = `page=${page}&size=${SIZE}`;
        if (currentDiff !== 'ALL')   q += currentDiff === 'NONE' ? `&difficultyLevel=` : `&difficultyLevel=${currentDiff}`;
        if (currentStatus !== 'ALL') q += `&isActive=${currentStatus === 'active'}`;
        url = `/api/questions?${q}`;
      }

      const res = await apiFetch<any>(url);
      if (!res.data) { renderTable([]); return; }
      const { content, totalPages: tp, totalElements: te } = res.data;
      totalPages = tp;
      (document.getElementById('page-info') as HTMLElement).textContent =
        `Pág. ${page + 1} de ${tp || 1} · ${te} pregunta(s)`;
      (document.getElementById('count-label') as HTMLElement).textContent = `${te} resultado(s)`;
      (document.getElementById('btn-prev') as HTMLButtonElement).disabled = page === 0;
      (document.getElementById('btn-next') as HTMLButtonElement).disabled = page >= tp - 1;
      renderTable(content);
      updateSortIndicators();
    } catch (err: any) {
      const tb = document.getElementById('questions-tbody')!;
      tb.innerHTML = `<tr><td colspan="7" style="padding:2rem;text-align:center;color:#DC2626">
        <p style="margin:0;font-weight:700">Error al cargar</p>
        <p style="margin:4px 0 0;font-size:0.8125rem">${err?.message ?? 'Verifica la conexión con el servidor.'}</p>
      </td></tr>`;
    }
  }

  const DIFF_ORDER: Record<string, number> = { B:1, M:2, A:3 };

  function sortRows(rows: QuestionDto[]): QuestionDto[] {
    if (!sortCol) return rows;
    return [...rows].sort((a, b) => {
      let av: any, bv: any;
      if (sortCol === 'id')     { av = parseInt(a.questionId.replace(/\D/g,''),10); bv = parseInt(b.questionId.replace(/\D/g,''),10); }
      if (sortCol === 'stmt')   { av = a.statement.toLowerCase(); bv = b.statement.toLowerCase(); }
      if (sortCol === 'diff')   { av = DIFF_ORDER[a.difficultyLevel??''] ?? 0; bv = DIFF_ORDER[b.difficultyLevel??''] ?? 0; }
      if (sortCol === 'opts')   { av = a.options?.length ?? 0; bv = b.options?.length ?? 0; }
      if (sortCol === 'status') { av = a.isActive ? 1 : 0; bv = b.isActive ? 1 : 0; }
      if (av < bv) return sortAsc ? -1 : 1;
      if (av > bv) return sortAsc ?  1 : -1;
      return 0;
    });
  }

  function updateSortIndicators() {
    document.querySelectorAll<HTMLElement>('.sort-ind').forEach(el => {
      el.className = 'sort-ind' + (el.dataset.col === sortCol ? (sortAsc ? ' asc' : ' desc') : '');
    });
  }

  function renderTable(questions: QuestionDto[]) {
    cachedRows = questions;
    const sorted = sortRows(questions);
    const tbody = document.getElementById('questions-tbody')!;
    tbody.innerHTML = '';
    if (!sorted.length) {
      tbody.innerHTML = `<tr><td colspan="7" style="padding:2.5rem;text-align:center">
        <p style="font-weight:700;color:var(--ui-text-1);margin:0 0 4px">Sin preguntas</p>
        <p style="font-size:0.8125rem;color:var(--ui-text-3);margin:0">Prueba cambiando los filtros o selecciona otra competencia.</p>
      </td></tr>`;
      return;
    }
    sorted.forEach((q: QuestionDto, rowIdx: number) => {
      questionMap.set(q.questionId, q);
      const rowNum = page * SIZE + rowIdx + 1;   // número secuencial global
      const stmt = q.statement.length > 90 ? q.statement.substring(0, 90) + '…' : q.statement;
      const opts = q.options?.length ?? '-';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="td">
          <span style="display:inline-block;background:var(--brand-muted);padding:2px 9px;border-radius:12px;font-size:0.75rem;font-weight:700;color:var(--brand);width:fit-content">${rowNum}</span>
        </td>
        <td class="td" style="max-width:300px;font-size:0.8125rem;line-height:1.45;color:var(--ui-text-1)" title="${q.statement.replace(/"/g,'&quot;')}">${stmt}</td>
        <td class="td"><span style="padding:3px 9px;border-radius:12px;font-size:0.6875rem;font-weight:700;background:${q.difficultyLevel?(DIFF_BG[q.difficultyLevel]??'#F3F4F6'):'#F3F4F6'};color:${q.difficultyLevel?(DIFF_COLOR[q.difficultyLevel]??'#6B7280'):'#9CA3AF'}">${q.difficultyLevel?(DIFF_LABEL[q.difficultyLevel]??q.difficultyLevel):'No aplica'}</span></td>
        <td class="td" style="font-size:0.8125rem;color:var(--ui-text-3)">${q.source ?? '-'}</td>
        <td class="td" style="text-align:center;font-weight:700">${opts}</td>
        <td class="td"><span style="padding:3px 9px;border-radius:12px;font-size:0.6875rem;font-weight:700;background:${q.isActive?'#D1FAE5':'#FEE2E2'};color:${q.isActive?'#059669':'#DC2626'}">${q.isActive?'Activa':'Inactiva'}</span></td>
        <td class="td" style="white-space:nowrap">
          <div style="display:flex;gap:5px;flex-wrap:nowrap">
            <button class="btn-edit" data-comp="${q.competenceId}" data-q="${q.questionId}"
              data-stmt="${q.statement.replace(/"/g,'&quot;').replace(/'/g,'&#39;')}"
              data-diff="${q.difficultyLevel??''}" data-src="${q.source??''}"
              data-exp="${(q.explanation??'').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}"
              style="padding:4px 10px;border-radius:7px;border:1.5px solid var(--ui-border-2);background:var(--ui-surface);color:var(--ui-text-1);font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit">Editar</button>
            ${q.isActive
              ? `<button class="btn-deact" data-comp="${q.competenceId}" data-q="${q.questionId}" style="padding:4px 10px;border-radius:7px;border:1.5px solid #FECACA;background:#FEF2F2;color:#DC2626;font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit">Desactivar</button>`
              : `<button class="btn-act"  data-comp="${q.competenceId}" data-q="${q.questionId}" style="padding:4px 10px;border-radius:7px;border:1.5px solid #A7F3D0;background:#D1FAE5;color:#059669;font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit">Activar</button>`
            }
          </div>
        </td>`;
      tbody.appendChild(tr);
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-deact').forEach(btn => {
      btn.addEventListener('click', () => {
        pendingDeactComp = btn.dataset.comp!;
        pendingDeactQ    = btn.dataset.q!;
        const modal = document.getElementById('deact-q-modal')!;
        modal.style.display = 'flex';
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-act').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Activar esta pregunta?')) return;
        btn.disabled = true; btn.textContent = '...';
        try {
          await competencesApi.activateQuestion(btn.dataset.comp!, btn.dataset.q!);
          toast.success('Pregunta activada');
          loadQuestions();
        } catch (err: any) {
          toast.error('Error', { description: err?.message });
          btn.disabled = false; btn.textContent = 'Activar';
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-edit').forEach(btn => {
      btn.addEventListener('click', () => {
        const qId    = btn.dataset.q!;
        const compId = btn.dataset.comp!;
        const q      = questionMap.get(qId);

        (document.getElementById('eq-comp') as HTMLInputElement).value      = compId;
        (document.getElementById('eq-qid')  as HTMLInputElement).value      = qId;
        (document.getElementById('eq-stmt') as HTMLTextAreaElement).value   = q?.statement        ?? btn.dataset.stmt ?? '';
        (document.getElementById('eq-diff') as HTMLSelectElement).value     = q?.difficultyLevel  ?? btn.dataset.diff ?? '';
        (document.getElementById('eq-src')  as HTMLInputElement).value      = q?.source           ?? btn.dataset.src  ?? '';
        (document.getElementById('eq-exp')  as HTMLTextAreaElement).value   = q?.explanation      ?? btn.dataset.exp  ?? '';

        // Poblar opciones
        const optCont = document.getElementById('eq-options-container')!;
        optCont.innerHTML = '';
        editOptionCount = 0;
        if (q?.options && q.options.length > 0) {
          q.options.forEach(opt => addEditOption(opt.optionText, !!opt.isCorrect));
        } else {
          for (let i = 0; i < 4; i++) addEditOption('', i === 0);
        }

        (document.getElementById('eq-error') as HTMLElement).style.display = 'none';
        (document.getElementById('edit-q-modal') as HTMLElement).style.display = 'flex';
      });
    });
  }

  function triggerLoad() { page = 0; clearTimeout(debounce); debounce = setTimeout(loadQuestions, 280); }

  // Ordenamiento por columna (client-side sobre la página actual)
  document.querySelectorAll<HTMLElement>('.sort-th').forEach(th => {
    th.addEventListener('click', () => {
      const col = th.dataset.col!;
      if (sortCol === col) sortAsc = !sortAsc;
      else { sortCol = col; sortAsc = true; }
      updateSortIndicators();
      if (cachedRows.length) renderTable(cachedRows);
    });
  });

  document.getElementById('filter-comp')?.addEventListener('change', (e) => {
    currentComp = (e.target as HTMLSelectElement).value; triggerLoad();
  });
  document.getElementById('filter-diff')?.addEventListener('change', (e) => {
    currentDiff = (e.target as HTMLSelectElement).value; triggerLoad();
  });
  document.getElementById('filter-status')?.addEventListener('change', (e) => {
    currentStatus = (e.target as HTMLSelectElement).value; triggerLoad();
  });
  document.getElementById('btn-prev')?.addEventListener('click', () => { if (page > 0) { page--; loadQuestions(); } });
  document.getElementById('btn-next')?.addEventListener('click', () => { if (page < totalPages - 1) { page++; loadQuestions(); } });

  // Modal desactivar pregunta
  const deactQModal = document.getElementById('deact-q-modal')!;
  document.getElementById('deact-q-cancel')?.addEventListener('click', () => { deactQModal.style.display = 'none'; });
  deactQModal.addEventListener('click', e => { if (e.target === deactQModal) deactQModal.style.display = 'none'; });
  document.getElementById('deact-q-confirm')?.addEventListener('click', async () => {
    const btn = document.getElementById('deact-q-confirm') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Desactivando...';
    try {
      await competencesApi.deactivateQuestion(pendingDeactComp, pendingDeactQ);
      toast.success('Pregunta desactivada');
      deactQModal.style.display = 'none';
      loadQuestions();
    } catch (err: any) {
      toast.error('Error al desactivar', { description: err?.message });
      deactQModal.style.display = 'none';
    } finally {
      btn.disabled = false; btn.textContent = 'Desactivar';
    }
  });

  // ── Edit modal: opciones (createElement para evitar inyección HTML) ──
  let editOptionCount = 0;

  function makeOptRow(
    nameGroup: string,
    idx: number,
    text: string,
    correct: boolean,
    container: HTMLElement
  ): HTMLDivElement {
    const row = document.createElement('div');
    row.dataset.idx = String(idx);
    row.style.cssText = 'display:flex;align-items:center;gap:8px';

    const radio = document.createElement('input');
    radio.type = 'radio'; radio.name = nameGroup;
    radio.value = String(idx); radio.checked = correct;
    radio.style.cssText = 'flex-shrink:0;accent-color:var(--brand);width:16px;height:16px;cursor:pointer';
    radio.title = 'Marcar como correcta';

    const input = document.createElement('input');
    input.type = 'text'; input.className = 'field-inp';
    input.dataset.optGroup = nameGroup;
    input.dataset.opt = String(idx);
    input.placeholder = 'Texto de la opción…';
    input.maxLength = 300;
    input.value = text;                   // .value asigna texto directamente, sin riesgo de inyección
    input.style.flex = '1';

    const del = document.createElement('button');
    del.type = 'button';
    del.style.cssText = 'flex-shrink:0;background:none;border:none;cursor:pointer;color:var(--ui-text-3);font-size:1.25rem;line-height:1;padding:2px 6px;border-radius:5px;transition:color 0.15s';
    del.title = 'Eliminar opción';
    del.textContent = '×';
    del.addEventListener('mouseenter', () => { del.style.color = '#DC2626'; del.style.background = '#FEF2F2'; });
    del.addEventListener('mouseleave', () => { del.style.color = 'var(--ui-text-3)'; del.style.background = 'none'; });
    del.addEventListener('click', () => {
      if (container.children.length <= 2) { toast.warning('Mínimo 2 opciones'); return; }
      row.remove();
    });

    row.appendChild(radio);
    row.appendChild(input);
    row.appendChild(del);
    return row;
  }

  function addEditOption(text = '', correct = false) {
    editOptionCount++;
    const container = document.getElementById('eq-options-container')!;
    container.appendChild(makeOptRow('eq-correct-opt', editOptionCount, text, correct, container));
  }

  document.getElementById('eq-add-option')?.addEventListener('click', () => {
    const container = document.getElementById('eq-options-container')!;
    if (container.children.length >= 6) { toast.warning('Máximo 6 opciones'); return; }
    addEditOption();
  });

  // Cerrar modal edición
  const closeEditModal = () => { (document.getElementById('edit-q-modal') as HTMLElement).style.display = 'none'; };
  document.getElementById('eq-close')?.addEventListener('click', closeEditModal);
  document.getElementById('eq-cancel')?.addEventListener('click', closeEditModal);
  document.getElementById('edit-q-modal')?.addEventListener('click', e => {
    if (e.target === document.getElementById('edit-q-modal')) closeEditModal();
  });

  // Submit editar pregunta
  document.getElementById('eq-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl  = document.getElementById('eq-error')!;
    const lblEl  = document.getElementById('eq-label')!;
    const submit = document.getElementById('eq-submit') as HTMLButtonElement;
    errEl.style.display = 'none';

    const compId          = (document.getElementById('eq-comp') as HTMLInputElement).value;
    const qId             = (document.getElementById('eq-qid')  as HTMLInputElement).value;
    const statement       = (document.getElementById('eq-stmt') as HTMLTextAreaElement).value.trim();
    const difficultyLevel = (document.getElementById('eq-diff') as HTMLSelectElement).value;
    const source          = (document.getElementById('eq-src')  as HTMLInputElement).value.trim() || undefined;
    const explanation     = (document.getElementById('eq-exp')  as HTMLTextAreaElement).value.trim() || undefined;

    if (!statement) {
      errEl.textContent = 'El enunciado es obligatorio.'; errEl.style.display = 'block'; return;
    }

    const optEls     = document.querySelectorAll<HTMLInputElement>('#eq-options-container input[data-opt-group="eq-correct-opt"]');
    const correctRad = document.querySelector<HTMLInputElement>('input[name="eq-correct-opt"]:checked');
    const correctIdx = correctRad ? Number(correctRad.value) : -1;
    const options: { optionText: string; isCorrect: boolean }[] = [];
    optEls.forEach(inp => {
      const text = inp.value.trim();
      if (text) options.push({ optionText: text, isCorrect: Number(inp.dataset.opt) === correctIdx });
    });

    if (options.length < 2) {
      errEl.textContent = 'Debes tener al menos 2 opciones con texto.'; errEl.style.display = 'block'; return;
    }
    if (!options.some(o => o.isCorrect)) {
      errEl.textContent = 'Marca una opción como correcta.'; errEl.style.display = 'block'; return;
    }

    submit.disabled = true; lblEl.textContent = 'Guardando...';
    try {
      await competencesApi.updateQuestion(compId, qId, { statement, explanation, source, difficultyLevel, options });
      toast.success('Pregunta actualizada correctamente');
      closeEditModal();
      loadQuestions(); // mantiene page actual para no perder posición
    } catch (err: any) {
      const msgs = err?.errors ? Object.values(err.errors as Record<string, string>).join(' ') : err?.message;
      errEl.textContent = msgs ?? 'Error al actualizar la pregunta.';
      errEl.style.display = 'block';
    } finally {
      submit.disabled = false; lblEl.textContent = 'Guardar cambios';
    }
  });

  // ── Options builder ───────────────────────────────────────────────
  let optionCount = 0;

  function addOption(text = '', correct = false) {
    optionCount++;
    const container = document.getElementById('options-container')!;
    container.appendChild(makeOptRow('correct-opt', optionCount, text, correct, container));
  }

  // Init con 4 opciones vacías
  for (let i = 0; i < 4; i++) addOption('', i === 0);

  document.getElementById('add-option')?.addEventListener('click', () => {
    const container = document.getElementById('options-container')!;
    if (container.children.length >= 6) { toast.warning('Máximo 6 opciones'); return; }
    addOption();
  });

  // ── Create modal ──────────────────────────────────────────────────
  const createModal = document.getElementById('create-modal')!;

  const openModal = () => {
    // Pre-seleccionar competencia actual si hay una
    if (currentComp) (document.getElementById('c-comp') as HTMLSelectElement).value = currentComp;
    createModal.style.display = 'flex';
  };
  const closeModal = () => { createModal.style.display = 'none'; };

  document.getElementById('btn-new-q')?.addEventListener('click', openModal);
  document.getElementById('modal-close')?.addEventListener('click', closeModal);
  document.getElementById('create-cancel')?.addEventListener('click', closeModal);
  createModal.addEventListener('click', e => { if (e.target === createModal) closeModal(); });

  document.getElementById('create-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl  = document.getElementById('create-error')!;
    const lblEl  = document.getElementById('create-label')!;
    const submit = document.getElementById('create-submit') as HTMLButtonElement;
    errEl.style.display = 'none';

    const competenceId  = (document.getElementById('c-comp') as HTMLSelectElement).value;
    const statement     = (document.getElementById('c-statement') as HTMLTextAreaElement).value.trim();
    const difficultyLevel = (document.getElementById('c-diff') as HTMLSelectElement).value;
    const source        = (document.getElementById('c-source') as HTMLInputElement).value.trim() || undefined;
    const explanation   = (document.getElementById('c-explanation') as HTMLTextAreaElement).value.trim() || undefined;

    if (!competenceId || !statement) {
      errEl.textContent = 'Completa la competencia y el enunciado.';
      errEl.style.display = 'block'; return;
    }

    // Recoger opciones (usar selector por data-opt-group para no confundir con edit modal)
    const optEls    = document.querySelectorAll<HTMLInputElement>('#options-container input[data-opt-group="correct-opt"]');
    const correctRd = document.querySelector<HTMLInputElement>('input[name="correct-opt"]:checked');
    const options: { optionText: string; isCorrect: boolean }[] = [];
    const correctIdx = correctRd ? Number(correctRd.value) : -1;
    optEls.forEach(inp => {
      const text = inp.value.trim();
      if (text) options.push({ optionText: text, isCorrect: Number(inp.dataset.opt) === correctIdx });
    });

    if (options.length < 2) {
      errEl.textContent = 'Debes agregar al menos 2 opciones con texto.';
      errEl.style.display = 'block'; return;
    }
    if (!options.some(o => o.isCorrect)) {
      errEl.textContent = 'Marca una opción como correcta.';
      errEl.style.display = 'block'; return;
    }

    submit.disabled = true; lblEl.textContent = 'Creando...';
    try {
      await competencesApi.createQuestion(competenceId, { statement, explanation, source, difficultyLevel, options });
      toast.success('Pregunta creada correctamente');
      closeModal();
      (document.getElementById('create-form') as HTMLFormElement).reset();
      // Resetear opciones
      document.getElementById('options-container')!.innerHTML = '';
      optionCount = 0;
      for (let i = 0; i < 4; i++) addOption('', i === 0);
      // Recargar si estamos viendo esa competencia
      if (currentComp === competenceId || !currentComp) {
        currentComp = competenceId;
        (document.getElementById('filter-comp') as HTMLSelectElement).value = competenceId;
        page = 0; loadQuestions();
      }
    } catch (err: any) {
      const msgs = err?.errors ? Object.values(err.errors as Record<string, string>).join(' ') : err?.message;
      errEl.textContent = msgs ?? 'Error al crear pregunta.';
      errEl.style.display = 'block';
    } finally {
      submit.disabled = false; lblEl.textContent = 'Crear pregunta';
    }
  });
</script>