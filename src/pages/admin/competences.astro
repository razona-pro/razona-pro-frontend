---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Competencias" currentPage="admin-competences">
  <div style="margin-bottom:1.25rem">
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
      <a href="/admin/stats" style="color:var(--ui-text-3);text-decoration:none" onmouseover="this.style.color='var(--brand)'" onmouseout="this.style.color='var(--ui-text-3)'">Panel admin</a>
      <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Competencias</span>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
      <div>
        <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Competencias</h1>
        <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Gestiona las competencias disponibles en la plataforma.</p>
      </div>
      <button id="btn-new-comp" style="display:inline-flex;align-items:center;gap:7px;padding:0.625rem 1.125rem;border-radius:10px;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-size:0.875rem;font-weight:700;border:none;cursor:pointer;font-family:inherit;box-shadow:0 3px 12px rgba(212,18,36,0.28)">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nueva competencia
      </button>
    </div>
  </div>

  <!-- Stats -->
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:1.25rem">
    <div style="background:var(--ui-card);border-radius:13px;padding:12px 16px;border:1px solid var(--ui-border);border-left:3px solid #D41224">
      <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">Total</p>
      <p id="stat-total" style="font-size:1.75rem;font-weight:900;color:#D41224;margin:0;line-height:1">-</p>
    </div>
    <div style="background:var(--ui-card);border-radius:13px;padding:12px 16px;border:1px solid var(--ui-border);border-left:3px solid #059669">
      <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">Activas</p>
      <p id="stat-active" style="font-size:1.75rem;font-weight:900;color:#059669;margin:0;line-height:1">-</p>
    </div>
    <div style="background:var(--ui-card);border-radius:13px;padding:12px 16px;border:1px solid var(--ui-border);border-left:3px solid #D97706">
      <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">Inactivas</p>
      <p id="stat-inactive" style="font-size:1.75rem;font-weight:900;color:#D97706;margin:0;line-height:1">-</p>
    </div>
  </div>

  <!-- Búsqueda -->
  <div style="display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap;align-items:center">
    <div style="position:relative;flex:1;min-width:200px;max-width:360px">
      <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ui-text-3);pointer-events:none" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="search-comp" type="text" placeholder="Buscar por nombre o ID..."
        style="width:100%;padding:9px 14px 9px 34px;background:var(--ui-card);border:1.5px solid var(--ui-border);border-radius:11px;font-size:0.8125rem;color:var(--ui-text-1);font-family:inherit;outline:none;transition:all 0.2s"
        onfocus="this.style.borderColor='var(--brand)';this.style.boxShadow='0 0 0 3px rgba(212,18,36,0.1)'"
        onblur="this.style.borderColor='var(--ui-border)';this.style.boxShadow='none'">
    </div>
    <select id="filter-status-comp" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none">
      <option value="ALL">Todos los estados</option>
      <option value="active">Activas</option>
      <option value="inactive">Inactivas</option>
    </select>
    <span id="count-comp-label" style="font-size:0.8125rem;color:var(--ui-text-3);margin-left:auto"></span>
  </div>

  <!-- Tabla -->
  <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden">
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse">
        <thead>
          <tr style="border-bottom:1px solid var(--ui-border)">
            <th class="th">ID</th>
            <th class="th">Nombre de la competencia</th>
            <th class="th">Descripción</th>
            <th class="th">Estado</th>
            <th class="th">Acciones</th>
          </tr>
        </thead>
        <tbody id="comp-tbody">
          <tr><td colspan="5" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<!-- Modal crear/editar -->
<div id="form-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:20px;padding:2rem;max-width:460px;width:calc(100%-2rem);animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
      <h2 id="modal-title" style="font-size:1.0625rem;font-weight:800;color:var(--ui-text-1);margin:0">Nueva competencia</h2>
      <button id="modal-close" style="background:none;border:none;cursor:pointer;color:var(--ui-text-3);font-size:1.25rem;line-height:1;padding:4px">×</button>
    </div>
    <div id="form-error" style="display:none;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:10px 12px;font-size:0.8125rem;color:#B91C1C;margin-bottom:1rem"></div>
    <form id="comp-form" novalidate>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:1.25rem">
        <div class="field-grp">
          <label class="field-lbl">Nombre de la competencia *</label>
          <input id="f-name" type="text" class="field-inp" placeholder="Ej: Lectura Crítica" maxlength="30" required />
        </div>
        <div class="field-grp">
          <label class="field-lbl">Descripción</label>
          <textarea id="f-desc" class="field-inp" rows="3" placeholder="Descripción breve (opcional)" maxlength="100" style="resize:vertical"></textarea>
        </div>
      </div>
      <div style="display:flex;gap:8px">
        <button type="button" id="form-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
        <button type="submit" id="form-submit" style="flex:2;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(212,18,36,0.28)">
          <span id="form-label">Crear competencia</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal confirmar cambio de estado -->
<div id="status-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:18px;padding:2rem;max-width:360px;width:calc(100%-2rem);text-align:center;animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div id="status-modal-icon" style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" id="status-modal-svg"></svg>
    </div>
    <h3 id="status-modal-title" style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem"></h3>
    <p id="status-modal-desc" style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.25rem;line-height:1.55"></p>
    <div style="display:flex;gap:8px">
      <button id="status-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
      <button id="status-confirm" style="flex:1;padding:0.6875rem;border-radius:10px;border:none;color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Confirmar</button>
    </div>
  </div>
</div>

<style>
  @keyframes modalIn { from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)} }
  @keyframes cardIn  { from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)} }
  .field-grp { display:flex;flex-direction:column;gap:4px }
  .field-lbl { font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3) }
  .field-inp { padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);outline:none;transition:border-color 0.2s;width:100%;appearance:none }
  .field-inp:focus { border-color:var(--brand);box-shadow:0 0 0 3px rgba(212,18,36,0.1) }
</style>

<script>
  import { requireAuth, isAdmin } from '../../lib/auth';
  import { competencesApi } from '../../lib/api/competences.api';
  import { toast } from '../../lib/toast';
  import type { CompetenceDto } from '../../lib/api/types';

  try {
    requireAuth();
    if (!isAdmin()) { window.location.replace('/dashboard'); throw new Error(); }
  } catch { throw new Error('redirect'); }

  const COMP_COLORS: [string, string, string][] = [
    ['#D41224','#FEE2E2','lectur'],
    ['#2563EB','#DBEAFE','cuantit'],
    ['#2563EB','#DBEAFE','razon'],
    ['#059669','#D1FAE5','ciudadan'],
    ['#7C3AED','#EDE9FE','escrit'],
    ['#7C3AED','#EDE9FE','comunicac'],
    ['#D97706','#FEF3C7','ingl'],
  ];

  function getColor(name: string): [string, string] {
    const n = name.toLowerCase();
    for (const [color, bg, kw] of COMP_COLORS) {
      if (n.includes(kw)) return [color, bg];
    }
    return ['#6B7280','#F3F4F6'];
  }

  let allComps: CompetenceDto[] = [];
  let editingId = '';
  let pendingStatusId = '';
  let pendingActivate = false;

  async function load() {
    try {
      const res = await competencesApi.findAll(false);
      allComps = res.data ?? [];
      const active   = allComps.filter(c => c.isActive).length;
      const inactive = allComps.filter(c => !c.isActive).length;
      (document.getElementById('stat-total') as HTMLElement).textContent   = String(allComps.length);
      (document.getElementById('stat-active') as HTMLElement).textContent  = String(active);
      (document.getElementById('stat-inactive') as HTMLElement).textContent = String(inactive);
      applyFilters();
    } catch (err: any) {
      toast.error('Error al cargar competencias', { description: err?.message });
    }
  }

  function applyFilters() {
    const search = (document.getElementById('search-comp') as HTMLInputElement)?.value.toLowerCase().trim() ?? '';
    const status = (document.getElementById('filter-status-comp') as HTMLSelectElement)?.value ?? 'ALL';
    const filtered = allComps.filter(c => {
      const matchSearch = !search || c.competenceName.toLowerCase().includes(search) || c.competenceId.toLowerCase().includes(search);
      const matchStatus = status === 'ALL' || (status === 'active' && c.isActive) || (status === 'inactive' && !c.isActive);
      return matchSearch && matchStatus;
    });
    (document.getElementById('count-comp-label') as HTMLElement).textContent = `${filtered.length} competencia(s)`;
    renderTable(filtered);
  }

  function renderTable(comps: CompetenceDto[]) {
    const tbody = document.getElementById('comp-tbody')!;
    tbody.innerHTML = '';
    if (!comps.length) {
      tbody.innerHTML = '<tr><td colspan="5" style="padding:2.5rem;text-align:center;color:var(--ui-text-3)">Sin resultados.</td></tr>';
      return;
    }
    comps.forEach(c => {
      const [color, bg] = getColor(c.competenceName);
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="td">
          <div style="display:flex;align-items:center;gap:8px">
            <div style="width:28px;height:28px;border-radius:7px;background:${bg};display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <div style="width:10px;height:10px;border-radius:50%;background:${color}"></div>
            </div>
            <code style="background:var(--ui-surface);padding:2px 8px;border-radius:6px;font-size:0.8125rem;font-weight:700;color:${color};border:1px solid var(--ui-border)">${c.competenceId}</code>
          </div>
        </td>
        <td class="td" style="font-weight:700">${c.competenceName}</td>
        <td class="td" style="font-size:0.8125rem;color:var(--ui-text-2);max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${c.description ?? ''}">${c.description ?? '—'}</td>
        <td class="td">
          <span style="padding:3px 9px;border-radius:12px;font-size:0.6875rem;font-weight:700;background:${c.isActive?'#D1FAE5':'#FEE2E2'};color:${c.isActive?'#059669':'#DC2626'}">
            ${c.isActive ? 'Activa' : 'Inactiva'}
          </span>
        </td>
        <td class="td">
          <div style="display:flex;gap:5px;flex-wrap:wrap">
            <button class="comp-edit" data-id="${c.competenceId}"
              style="padding:4px 10px;border-radius:7px;border:1.5px solid var(--ui-border-2);background:var(--ui-surface);color:var(--ui-text-1);font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit;transition:all 0.15s">
              Editar
            </button>
            ${c.isActive
              ? `<button class="comp-deact" data-id="${c.competenceId}" data-name="${c.competenceName}"
                  style="padding:4px 10px;border-radius:7px;border:1.5px solid #FDE68A;background:#FEF3C7;color:#92400E;font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit;transition:all 0.15s">
                  Desactivar
                </button>`
              : `<button class="comp-react" data-id="${c.competenceId}" data-name="${c.competenceName}"
                  style="padding:4px 10px;border-radius:7px;border:1.5px solid #A7F3D0;background:#D1FAE5;color:#065F46;font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit;transition:all 0.15s">
                  Activar
                </button>`
            }
          </div>
        </td>`;
      tbody.appendChild(tr);
    });

    document.querySelectorAll<HTMLButtonElement>('.comp-edit').forEach(btn => {
      btn.addEventListener('click', () => {
        const comp = allComps.find(c => c.competenceId === btn.dataset.id);
        if (comp) openModal(comp);
      });
    });
    document.querySelectorAll<HTMLButtonElement>('.comp-deact').forEach(btn => {
      btn.addEventListener('click', () => openStatusModal(btn.dataset.id!, btn.dataset.name!, false));
    });
    document.querySelectorAll<HTMLButtonElement>('.comp-react').forEach(btn => {
      btn.addEventListener('click', () => openStatusModal(btn.dataset.id!, btn.dataset.name!, true));
    });
  }

  // Modal crear/editar
  const formModal = document.getElementById('form-modal')!;
  function openModal(comp?: CompetenceDto) {
    editingId = comp?.competenceId ?? '';
    (document.getElementById('modal-title') as HTMLElement).textContent = comp ? 'Editar competencia' : 'Nueva competencia';
    (document.getElementById('form-label') as HTMLElement).textContent  = comp ? 'Guardar cambios' : 'Crear competencia';
    (document.getElementById('f-name') as HTMLInputElement).value       = comp?.competenceName ?? '';
    (document.getElementById('f-desc') as HTMLTextAreaElement).value    = comp?.description ?? '';
    (document.getElementById('form-error') as HTMLElement).style.display = 'none';
    formModal.style.display = 'flex';
  }
  const closeModal = () => { formModal.style.display = 'none'; editingId = ''; };
  document.getElementById('btn-new-comp')?.addEventListener('click', () => openModal());
  document.getElementById('modal-close')?.addEventListener('click', closeModal);
  document.getElementById('form-cancel')?.addEventListener('click', closeModal);
  formModal.addEventListener('click', e => { if (e.target === formModal) closeModal(); });

  document.getElementById('comp-form')?.addEventListener('submit', async e => {
    e.preventDefault();
    const errEl  = document.getElementById('form-error')!;
    const lblEl  = document.getElementById('form-label')!;
    const submit = document.getElementById('form-submit') as HTMLButtonElement;
    errEl.style.display = 'none';
    const name = (document.getElementById('f-name') as HTMLInputElement).value.trim();
    const desc = (document.getElementById('f-desc') as HTMLTextAreaElement).value.trim() || undefined;
    if (!name) { errEl.textContent = 'El nombre es obligatorio.'; errEl.style.display = 'block'; return; }
    submit.disabled = true; lblEl.textContent = editingId ? 'Guardando...' : 'Creando...';
    try {
      if (editingId) {
        await competencesApi.update(editingId, { competenceName: name, description: desc });
        toast.success('Competencia actualizada');
      } else {
        await competencesApi.create({ competenceName: name, description: desc });
        toast.success('Competencia creada');
      }
      closeModal(); load();
    } catch (err: any) {
      errEl.textContent = err?.message ?? 'Error al guardar.';
      errEl.style.display = 'block';
    } finally {
      submit.disabled = false;
      lblEl.textContent = editingId ? 'Guardar cambios' : 'Crear competencia';
    }
  });

  // Modal de estado
  const statusModal = document.getElementById('status-modal')!;
  function openStatusModal(id: string, name: string, activate: boolean) {
    pendingStatusId = id; pendingActivate = activate;
    const iconEl   = document.getElementById('status-modal-icon')!;
    const svgEl    = document.getElementById('status-modal-svg')!;
    const titleEl  = document.getElementById('status-modal-title')!;
    const descEl   = document.getElementById('status-modal-desc')!;
    const confirmBtn = document.getElementById('status-confirm') as HTMLButtonElement;
    if (activate) {
      iconEl.style.background = '#D1FAE5';
      svgEl.setAttribute('stroke','#059669');
      svgEl.innerHTML = '<polyline points="20 6 9 17 4 12"/>';
      titleEl.textContent = '¿Activar competencia?';
      descEl.textContent  = `Se activará "${name}" y estará disponible para tests y práctica.`;
      confirmBtn.style.background = 'linear-gradient(135deg,#059669,#047857)';
      confirmBtn.style.boxShadow  = '0 3px 12px rgba(5,150,105,0.28)';
    } else {
      iconEl.style.background = '#FEF3C7';
      svgEl.setAttribute('stroke','#D97706');
      svgEl.innerHTML = '<path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>';
      titleEl.textContent = '¿Desactivar competencia?';
      descEl.textContent  = `Se desactivará "${name}". No aparecerá en tests nuevos pero los existentes quedan intactos.`;
      confirmBtn.style.background = 'linear-gradient(135deg,#D97706,#B45309)';
      confirmBtn.style.boxShadow  = '0 3px 12px rgba(217,119,6,0.28)';
    }
    statusModal.style.display = 'flex';
  }
  document.getElementById('status-cancel')?.addEventListener('click', () => { statusModal.style.display = 'none'; });
  statusModal.addEventListener('click', e => { if (e.target === statusModal) statusModal.style.display = 'none'; });
  document.getElementById('status-confirm')?.addEventListener('click', async () => {
    try {
      if (pendingActivate) {
        
    await competencesApi.activate(pendingStatusId);
  toast.success('Competencia activada');
    } else {
        await competencesApi.deactivate(pendingStatusId);
        toast.success('Competencia desactivada');
      }
      statusModal.style.display = 'none'; load();
    } catch (err: any) {
      toast.error('Error', { description: err?.message });
      statusModal.style.display = 'none';
    }
  });

  let debounce: ReturnType<typeof setTimeout>;
  document.getElementById('search-comp')?.addEventListener('input', () => {
    clearTimeout(debounce); debounce = setTimeout(applyFilters, 250);
  });
  document.getElementById('filter-status-comp')?.addEventListener('change', applyFilters);

  load();
</script>