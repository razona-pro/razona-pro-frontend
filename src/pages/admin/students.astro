---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Gestión de Estudiantes" currentPage="admin-students">
  <div style="margin-bottom:1.25rem">
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
      <a href="/admin/stats" style="color:var(--ui-text-3);text-decoration:none" onmouseover="this.style.color='var(--brand)'" onmouseout="this.style.color='var(--ui-text-3)'">Panel de control</a>
      <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Estudiantes</span>
    </div>
    <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Estudiantes</h1>
    <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Gestión de estudiantes registrados en la plataforma.</p>
  </div>

  <!-- Stats -->
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:1.25rem">
    <div style="background:var(--ui-card);border-radius:13px;padding:12px 16px;border:1px solid var(--ui-border);border-left:3px solid #D41224">
      <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">Total</p>
      <p id="stat-total" style="font-size:1.75rem;font-weight:900;color:#D41224;margin:0;line-height:1">-</p>
    </div>
    <div style="background:var(--ui-card);border-radius:13px;padding:12px 16px;border:1px solid var(--ui-border);border-left:3px solid #059669">
      <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">Activos</p>
      <p id="stat-active" style="font-size:1.75rem;font-weight:900;color:#059669;margin:0;line-height:1">-</p>
    </div>
    <div style="background:var(--ui-card);border-radius:13px;padding:12px 16px;border:1px solid var(--ui-border);border-left:3px solid #2563EB">
      <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">Email verificado</p>
      <p id="stat-verified" style="font-size:1.75rem;font-weight:900;color:#2563EB;margin:0;line-height:1">-</p>
    </div>
    <div style="background:var(--ui-card);border-radius:13px;padding:12px 16px;border:1px solid var(--ui-border);border-left:3px solid #D97706">
      <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">Pendientes</p>
      <p id="stat-pending" style="font-size:1.75rem;font-weight:900;color:#D97706;margin:0;line-height:1">-</p>
    </div>
  </div>

  <!-- Búsqueda y filtros -->
  <div style="display:flex;gap:8px;margin-bottom:1.125rem;flex-wrap:wrap;align-items:center">
    <div style="position:relative;flex:1;min-width:200px;max-width:380px">
      <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ui-text-3);pointer-events:none" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="student-search" type="text" placeholder="Buscar por nombre, código, correo..."
        style="width:100%;padding:9px 14px 9px 34px;background:var(--ui-card);border:1.5px solid var(--ui-border);border-radius:11px;font-size:0.8125rem;color:var(--ui-text-1);font-family:inherit;outline:none;transition:border-color 0.2s"
        onfocus="this.style.borderColor='var(--brand)';this.style.boxShadow='0 0 0 3px rgba(212,18,36,0.1)'"
        onblur="this.style.borderColor='var(--ui-border)';this.style.boxShadow='none'">
    </div>
    <select id="filter-program" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none">
      <option value="ALL">Todos los programas</option>
    </select>
    <select id="filter-status" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none">
      <option value="ALL">Todos los estados</option>
      <option value="active">Activos</option>
      <option value="inactive">Inactivos</option>
      <option value="verified">Email verificado</option>
      <option value="pending">Email pendiente</option>
    </select>
    <span id="total-label" style="font-size:0.8125rem;color:var(--ui-text-3);margin-left:auto;white-space:nowrap"></span>
  </div>

  <!-- Tabla -->
  <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden">
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse">
        <thead>
          <tr style="border-bottom:1px solid var(--ui-border)">
            <th class="th">Código</th>
            <th class="th">Nombre completo</th>
            <th class="th">Correo electrónico</th>
            <th class="th">Programa</th>
            <th class="th">Email</th>
            <th class="th">Estado</th>
            <th class="th">Acciones</th>
          </tr>
        </thead>
        <tbody id="students-tbody">
          <tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
    <div style="padding:0.875rem 1.25rem;border-top:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
      <span id="page-info" style="font-size:0.8125rem;color:var(--ui-text-3)"></span>
      <div style="display:flex;gap:6px">
        <button id="btn-prev" class="page-btn" disabled>← Anterior</button>
        <button id="btn-next" class="page-btn">Siguiente →</button>
      </div>
    </div>
  </div>
</AdminLayout>

<!-- Modal editar estudiante -->
<div id="sedit-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:20px;padding:2rem;max-width:480px;width:calc(100%-2rem);max-height:90vh;overflow-y:auto;animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
      <h2 style="font-size:1.0625rem;font-weight:800;color:var(--ui-text-1);margin:0">Editar estudiante</h2>
      <button id="sedit-close" style="background:none;border:none;cursor:pointer;color:var(--ui-text-3);padding:4px;font-size:1.25rem;line-height:1">×</button>
    </div>
    <div id="sedit-error" style="display:none;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:10px 12px;font-size:0.8125rem;color:#B91C1C;margin-bottom:1rem"></div>
    <form id="sedit-form" novalidate>
      <input type="hidden" id="se-id" />
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1rem">
        <div style="display:flex;flex-direction:column;gap:4px"><label style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3)">Primer nombre *</label><input id="se-fname" type="text" maxlength="15" required style="padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);outline:none" /></div>
        <div style="display:flex;flex-direction:column;gap:4px"><label style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3)">Segundo nombre</label><input id="se-mname" type="text" maxlength="15" style="padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);outline:none" /></div>
        <div style="display:flex;flex-direction:column;gap:4px"><label style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3)">Primer apellido *</label><input id="se-lname1" type="text" maxlength="15" required style="padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);outline:none" /></div>
        <div style="display:flex;flex-direction:column;gap:4px"><label style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3)">Segundo apellido</label><input id="se-lname2" type="text" maxlength="15" style="padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);outline:none" /></div>
        <div style="display:flex;flex-direction:column;gap:4px;grid-column:1/-1"><label style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3)">Correo electrónico</label><input id="se-email" type="email" maxlength="50" style="padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);outline:none" /></div>
        <div style="display:flex;flex-direction:column;gap:4px;grid-column:1/-1"><label style="font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3)">Teléfono</label><input id="se-phone" type="tel" placeholder="+573001234567" style="padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);outline:none" /></div>
      </div>
      <div style="display:flex;gap:8px">
        <button type="button" id="sedit-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
        <button type="submit" id="sedit-submit" style="flex:2;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(212,18,36,0.28)"><span id="sedit-label">Guardar cambios</span></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal desactivar -->
<div id="deactivate-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:18px;padding:2rem;max-width:360px;width:calc(100%-2rem);text-align:center;animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="width:52px;height:52px;border-radius:14px;background:#FEE2E2;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
      <svg width="24" height="24" fill="none" stroke="#DC2626" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
    </div>
    <h3 style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem">¿Desactivar estudiante?</h3>
    <p id="deactivate-desc" style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.25rem;line-height:1.55"></p>
    <div style="display:flex;gap:8px">
      <button id="deactivate-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
      <button id="deactivate-confirm" style="flex:1;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,#DC2626,#991B1B);color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Desactivar</button>
    </div>
  </div>
</div>

<style>
  @keyframes modalIn { from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)} }
  @keyframes spin    { to{transform:rotate(360deg)} }
  .page-btn { padding:6px 14px;border-radius:8px;border:1.5px solid var(--ui-border);background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;font-weight:600;cursor:pointer;transition:all 0.15s }
  .page-btn:hover:not(:disabled) { border-color:var(--brand);color:var(--brand) }
  .page-btn:disabled { opacity:0.4;cursor:not-allowed }
</style>

<script>
  import { requireAuth, isAdmin } from '../../lib/auth';
  import { studentsApi }  from '../../lib/api/students.api';
  import { programsApi }  from '../../lib/api/programs.api';
  import { toast }        from '../../lib/toast';
  import type { StudentDto } from '../../lib/api/types';

  try {
    requireAuth();
    if (!isAdmin()) { window.location.replace('/dashboard'); throw new Error(); }
  } catch { throw new Error('redirect'); }

  let page             = 0;
  const SIZE           = 20;
  let totalPages       = 1;
  let totalElements    = 0;
  let searchStr        = '';
  let filterProg       = '';
  let filterStatus     = '';
  let debounce: ReturnType<typeof setTimeout>;
  let pendingDeactivateId = '';
  let programMap: Record<string, string> = {};

  // Cargar programas para el filtro
  programsApi.findAll().then(res => {
    if (!res.data?.length) return;
    const sel = document.getElementById('filter-program') as HTMLSelectElement;
    res.data.forEach(p => {
      programMap[p.programId] = p.programName;
      programMap[p.programId.toLowerCase()] = p.programName;
      const opt = document.createElement('option');
      opt.value = p.programId;
      opt.textContent = `${p.programName} (${p.programId})`;
      sel.appendChild(opt);
    });
  }).catch(() => {
    const sel = document.getElementById('filter-program') as HTMLSelectElement;
    const opt = document.createElement('option');
    opt.value = ''; opt.disabled = true;
    opt.textContent = 'Error al cargar programas';
    sel.appendChild(opt);
  });

  function renderRows(students: StudentDto[]) {
    const tbody = document.getElementById('students-tbody')!;
    tbody.innerHTML = '';
    if (!students.length) {
      tbody.innerHTML = `<tr><td colspan="7" style="padding:2.5rem;text-align:center">
        <p style="font-weight:700;color:var(--ui-text-1);margin:0 0 4px">Sin resultados</p>
        <p style="font-size:0.8125rem;color:var(--ui-text-3);margin:0">Prueba con otros filtros o búsqueda.</p>
      </td></tr>`;
      return;
    }
    students.forEach(s => {
      const fullName = [s.firstName, s.secondName, s.firstSurname, s.secondSurname].filter(Boolean).join(' ');
      const progName = programMap[s.programId] ? `${programMap[s.programId]} (${s.programId})` : s.programId;
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="td">
          <code style="background:var(--ui-surface);padding:3px 8px;border-radius:6px;font-size:0.8125rem;font-weight:700;color:var(--brand);border:1px solid var(--ui-border)">${s.studentId}</code>
        </td>
        <td class="td" style="font-weight:600;max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${fullName}">${fullName || '-'}</td>
        <td class="td" style="font-size:0.8125rem;color:var(--ui-text-2);max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${(s.email ?? '').toLowerCase()}</td>
        <td class="td" style="font-size:0.8125rem">${progName}</td>
        <td class="td">
          <span style="padding:3px 9px;border-radius:12px;font-size:0.6875rem;font-weight:700;background:${s.emailVerified?'#D1FAE5':'#FEF3C7'};color:${s.emailVerified?'#059669':'#D97706'}">
            ${s.emailVerified ? 'Verificado' : 'Pendiente'}
          </span>
        </td>
        <td class="td">
          <span style="padding:3px 9px;border-radius:12px;font-size:0.6875rem;font-weight:700;background:${s.isActive?'#D1FAE5':'#FEE2E2'};color:${s.isActive?'#059669':'#DC2626'}">
            ${s.isActive ? 'Activo' : 'Inactivo'}
          </span>
        </td>
        <td class="td">
          <div style="display:flex;gap:5px;flex-wrap:wrap">
            <button class="btn-edit act-btn" data-id="${s.studentId}"
              data-fname="${(s.firstName??'').replace(/"/g,'&quot;')}" data-mname="${(s.secondName??'').replace(/"/g,'&quot;')}"
              data-lname1="${(s.firstSurname??'').replace(/"/g,'&quot;')}" data-lname2="${(s.secondSurname??'').replace(/"/g,'&quot;')}"
              data-email="${(s.email??'').replace(/"/g,'&quot;')}" data-phone="${(s.phone??'').replace(/"/g,'&quot;')}">Editar</button>
            <button class="btn-toggle act-btn ${s.isActive ? 'act-btn-danger' : 'act-btn-success'}" data-id="${s.studentId}" data-name="${fullName}" data-active="${s.isActive}">
              ${s.isActive ? 'Desactivar' : 'Activar'}
            </button>
          </div>
        </td>`;
      tbody.appendChild(tr);
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-toggle').forEach(btn => {
      btn.addEventListener('click', async () => {
        const active = btn.dataset.active === 'true';
        const name   = btn.dataset.name!;
        const id     = btn.dataset.id!;
        if (active) {
          pendingDeactivateId = id;
          (document.getElementById('deactivate-desc') as HTMLElement).textContent =
            `Se desactivará la cuenta de "${name}" (${id}). No podrá iniciar sesión hasta ser reactivado.`;
          (document.getElementById('deactivate-modal') as HTMLElement).style.display = 'flex';
        } else {
          btn.disabled = true; btn.textContent = '...';
          try {
            await studentsApi.activate(id);
            toast.success('Estudiante activado');
            loadPage();
          } catch (err: any) {
            toast.error('Error al activar', { description: err?.message });
            btn.disabled = false; btn.textContent = 'Activar';
          }
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-edit').forEach(btn => {
      btn.addEventListener('click', () => {
        (document.getElementById('se-id')     as HTMLInputElement).value = btn.dataset.id!;
        (document.getElementById('se-fname')  as HTMLInputElement).value = btn.dataset.fname  ?? '';
        (document.getElementById('se-mname')  as HTMLInputElement).value = btn.dataset.mname  ?? '';
        (document.getElementById('se-lname1') as HTMLInputElement).value = btn.dataset.lname1 ?? '';
        (document.getElementById('se-lname2') as HTMLInputElement).value = btn.dataset.lname2 ?? '';
        (document.getElementById('se-email')  as HTMLInputElement).value = btn.dataset.email  ?? '';
        (document.getElementById('se-phone')  as HTMLInputElement).value = btn.dataset.phone  ?? '';
        (document.getElementById('sedit-error') as HTMLElement).style.display = 'none';
        (document.getElementById('sedit-modal') as HTMLElement).style.display = 'flex';
      });
    });
  }

  async function loadPage() {
    const tbody = document.getElementById('students-tbody')!;
    tbody.innerHTML = `<tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--ui-text-3)">
      <div style="display:inline-flex;align-items:center;gap:8px"><div style="width:16px;height:16px;border:2px solid var(--brand);border-top-color:transparent;border-radius:50%;animation:spin 0.7s linear infinite"></div> Cargando...</div>
    </td></tr>`;
    try {
      const search    = searchStr || undefined;
      const programId = filterProg  || undefined;
      const status    = filterStatus || undefined;
      const res = await studentsApi.findAll(page, SIZE, search, programId, status);
      if (!res.data) return;
      const { content, totalPages: tp, totalElements: te } = res.data;
      totalPages    = tp;
      totalElements = te;

      (document.getElementById('stat-total') as HTMLElement).textContent    = String(te);
      (document.getElementById('page-info') as HTMLElement).textContent =
        `Pág. ${page + 1} de ${tp || 1} · ${te} estudiante(s)`;
      (document.getElementById('total-label') as HTMLElement).textContent = `${te} resultado(s)`;
      (document.getElementById('btn-prev') as HTMLButtonElement).disabled = page === 0;
      (document.getElementById('btn-next') as HTMLButtonElement).disabled = page >= tp - 1;

      // Stats: siempre actualizar con los datos de la página actual
      const active   = content.filter(s => s.isActive).length;
      const verified = content.filter(s => s.emailVerified).length;
      const pending  = content.filter(s => !s.emailVerified).length;
      // Si hay filtros o más de una página, mostramos totales de la página actual con prefijo ~
      const hasFilter = !!(search || programId || status);
      const multiPage = te > SIZE;
      const prefix = (hasFilter && multiPage) ? '~' : '';
      (document.getElementById('stat-active') as HTMLElement).textContent   = prefix + String(active);
      (document.getElementById('stat-verified') as HTMLElement).textContent = prefix + String(verified);
      (document.getElementById('stat-pending') as HTMLElement).textContent  = prefix + String(pending);

      renderRows(content);
    } catch (err: any) {
      toast.error('Error al cargar estudiantes', { description: err?.message });
      tbody.innerHTML = `<tr><td colspan="7" style="padding:2rem;text-align:center;color:#DC2626">Error al cargar. ${err?.message ?? ''}</td></tr>`;
    }
  }

  function triggerLoad() { page = 0; clearTimeout(debounce); debounce = setTimeout(loadPage, 320); }

  document.getElementById('btn-prev')?.addEventListener('click', () => { if (page > 0) { page--; loadPage(); } });
  document.getElementById('btn-next')?.addEventListener('click', () => { if (page < totalPages - 1) { page++; loadPage(); } });

  document.getElementById('student-search')?.addEventListener('input', (e) => {
    searchStr = (e.target as HTMLInputElement).value.trim();
    triggerLoad();
  });
  document.getElementById('filter-program')?.addEventListener('change', (e) => {
    filterProg = (e.target as HTMLSelectElement).value === 'ALL' ? '' : (e.target as HTMLSelectElement).value;
    triggerLoad();
  });
  document.getElementById('filter-status')?.addEventListener('change', (e) => {
    filterStatus = (e.target as HTMLSelectElement).value === 'ALL' ? '' : (e.target as HTMLSelectElement).value;
    triggerLoad();
  });

  // Deactivate modal
  const deactivateModal = document.getElementById('deactivate-modal')!;
  document.getElementById('deactivate-cancel')?.addEventListener('click', () => { deactivateModal.style.display = 'none'; });
  deactivateModal.addEventListener('click', e => { if (e.target === deactivateModal) deactivateModal.style.display = 'none'; });
  document.getElementById('deactivate-confirm')?.addEventListener('click', async () => {
    const confirmBtn = document.getElementById('deactivate-confirm') as HTMLButtonElement;
    confirmBtn.disabled = true; confirmBtn.textContent = '...';
    try {
      await studentsApi.deactivate(pendingDeactivateId);
      toast.success('Estudiante desactivado');
      deactivateModal.style.display = 'none';
      loadPage();
    } catch (err: any) {
      toast.error('Error', { description: err?.message });
      deactivateModal.style.display = 'none';
    } finally {
      confirmBtn.disabled = false; confirmBtn.textContent = 'Desactivar';
    }
  });

  // ── Editar estudiante ───────────────────────────────────────────────
  const seditModal = document.getElementById('sedit-modal')!;
  const closeSedit = () => { seditModal.style.display = 'none'; };
  document.getElementById('sedit-close')?.addEventListener('click', closeSedit);
  document.getElementById('sedit-cancel')?.addEventListener('click', closeSedit);
  seditModal.addEventListener('click', e => { if (e.target === seditModal) closeSedit(); });
  document.getElementById('sedit-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl  = document.getElementById('sedit-error')!;
    const lblEl  = document.getElementById('sedit-label')!;
    const submit = document.getElementById('sedit-submit') as HTMLButtonElement;
    errEl.style.display = 'none';
    const id            = (document.getElementById('se-id')     as HTMLInputElement).value;
    const firstName     = (document.getElementById('se-fname')  as HTMLInputElement).value.trim();
    // Segundo nombre/apellido: enviar '' (no undefined) para poder BORRARLOS en el backend.
    const secondName    = (document.getElementById('se-mname')  as HTMLInputElement).value.trim();
    const firstSurname  = (document.getElementById('se-lname1') as HTMLInputElement).value.trim();
    const secondSurname = (document.getElementById('se-lname2') as HTMLInputElement).value.trim();
    const email         = (document.getElementById('se-email')  as HTMLInputElement).value.trim() || undefined;
    const phone         = (document.getElementById('se-phone')  as HTMLInputElement).value.trim() || undefined;
    if (!firstName || !firstSurname) {
      errEl.textContent = 'Nombre y apellido son obligatorios.'; errEl.style.display = 'block'; return;
    }
    submit.disabled = true; lblEl.textContent = 'Guardando...';
    try {
      await studentsApi.update(id, { firstName, secondName, firstSurname, secondSurname, email, phone });
      toast.success('Estudiante actualizado');
      closeSedit(); loadPage();
    } catch (err: any) {
      errEl.textContent = err?.message ?? 'Error al actualizar.'; errEl.style.display = 'block';
    } finally {
      submit.disabled = false; lblEl.textContent = 'Guardar cambios';
    }
  });

  loadPage();
</script>