---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Mi perfil" currentPage="profile">
  <div style="margin-bottom:1.25rem">
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
      <a href="/admin/home" style="color:var(--ui-text-3);text-decoration:none"
        onmouseover="this.style.color='var(--brand)'" onmouseout="this.style.color='var(--ui-text-3)'">Panel</a>
      <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Mi perfil</span>
    </div>
    <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Mi perfil</h1>
    <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Información de tu cuenta de administrador.</p>
  </div>

  <!-- Hero -->
  <div style="background:var(--ui-card);border-radius:20px;border:1px solid var(--ui-border);overflow:hidden;margin-bottom:1.25rem">
    <div style="height:80px;background:linear-gradient(135deg,#D41224 0%,#9B1F24 60%,#6B1318 100%);position:relative;overflow:hidden">
      <div style="position:absolute;right:-60px;top:-60px;width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,0.07)"></div>
    </div>
    <div style="padding:0 1.5rem 1.5rem;display:flex;align-items:flex-end;gap:1rem;flex-wrap:wrap">
      <div style="margin-top:-30px;position:relative;flex-shrink:0">
        <div id="profile-avatar" style="width:60px;height:60px;border-radius:14px;background:linear-gradient(135deg,#D41224,#9B1F24);border:3px solid var(--ui-card);display:flex;align-items:center;justify-content:center;color:white;font-weight:900;font-size:1.25rem;font-family:var(--font-ui);box-shadow:0 4px 14px rgba(0,0,0,0.15)">?</div>
      </div>
      <div style="flex:1;min-width:160px;padding-top:0.5rem">
        <h2 id="profile-name" style="font-size:1.125rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.3px">Cargando...</h2>
        <span style="display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:0.6875rem;font-weight:700;background:rgba(212,18,36,0.1);color:#D41224">
          <svg width="10" height="10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
          Administrador
        </span>
      </div>
    </div>
  </div>

  <!-- Datos -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
    <div style="background:var(--ui-card);border-radius:16px;padding:1.25rem;border:1px solid var(--ui-border)">
      <h3 style="font-size:0.8125rem;font-weight:800;color:var(--ui-text-1);margin:0 0 1rem;display:flex;align-items:center;gap:7px">
        <svg width="13" height="13" fill="none" stroke="var(--brand)" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-8 8-8s8 4 8 8"/></svg>
        Datos personales
      </h3>
      <div style="display:flex;flex-direction:column;gap:12px">
        <div>
          <p class="data-lbl">ID de administrador</p>
          <p id="info-adminid" class="data-val" style="font-family:monospace">-</p>
        </div>
        <div>
          <p class="data-lbl">Nombre completo</p>
          <p id="info-fullname" class="data-val">-</p>
        </div>
        <div>
          <p class="data-lbl">Correo electrónico</p>
          <p id="info-email" class="data-val">-</p>
        </div>
        <div>
          <p class="data-lbl">Teléfono</p>
          <p id="info-phone" class="data-val">-</p>
        </div>
      </div>
    </div>

    <div style="background:var(--ui-card);border-radius:16px;padding:1.25rem;border:1px solid var(--ui-border)">
      <h3 style="font-size:0.8125rem;font-weight:800;color:var(--ui-text-1);margin:0 0 1rem;display:flex;align-items:center;gap:7px">
        <svg width="13" height="13" fill="none" stroke="var(--brand)" stroke-width="2" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        Acceso
      </h3>
      <div style="display:flex;flex-direction:column;gap:12px">
        <div>
          <p class="data-lbl">Último acceso</p>
          <p id="info-lastlogin" class="data-val">-</p>
        </div>
        <div>
          <p class="data-lbl">Cuenta creada</p>
          <p id="info-createdat" class="data-val">-</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Cambiar contraseña ── -->
  <div style="max-width:640px;margin:1.25rem auto 0;background:var(--ui-card);border:1px solid var(--ui-border);border-radius:16px;padding:1.5rem">
    <div style="display:flex;align-items:center;gap:10px">
      <div style="width:36px;height:36px;border-radius:9px;background:var(--brand-pale);display:flex;align-items:center;justify-content:center;flex-shrink:0">
        <svg width="18" height="18" fill="none" stroke="var(--brand)" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <div style="flex:1;min-width:0">
        <h2 style="font-size:0.9375rem;font-weight:800;color:var(--ui-text-1);margin:0">Cambiar contraseña</h2>
        <p style="font-size:0.75rem;color:var(--ui-text-3);margin:0">Por seguridad, te enviaremos un código a tu correo.</p>
      </div>
      <button id="cp-toggle" type="button" class="acc-btn">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Cambiar
      </button>
    </div>
    <div id="cp-body" style="display:none;margin-top:16px">
    <div id="cp-msg" style="display:none;margin:0 0 12px;padding:10px 12px;border-radius:9px;font-size:0.8125rem"></div>
    <div id="cp-step1">
      <button id="cp-request" type="button" style="padding:0.625rem 1.125rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Enviar código de verificación</button>
    </div>
    <div id="cp-step2" style="display:none;margin-top:14px;flex-direction:column;gap:10px">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Código de verificación (correo)</label>
        <input id="cp-code" type="text" inputmode="numeric" maxlength="6" placeholder="6 dígitos" style="width:100%;padding:10px 12px;border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.9375rem;letter-spacing:3px;background:var(--ui-surface);color:var(--ui-text-1);box-sizing:border-box;outline:none"/>
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Contraseña actual</label>
        <input id="cp-current" type="password" style="width:100%;padding:10px 12px;border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;background:var(--ui-surface);color:var(--ui-text-1);box-sizing:border-box;outline:none"/>
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Nueva contraseña (mín. 8)</label>
        <input id="cp-new" type="password" style="width:100%;padding:10px 12px;border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;background:var(--ui-surface);color:var(--ui-text-1);box-sizing:border-box;outline:none"/>
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Confirmar nueva contraseña</label>
        <input id="cp-confirm" type="password" style="width:100%;padding:10px 12px;border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;background:var(--ui-surface);color:var(--ui-text-1);box-sizing:border-box;outline:none"/>
      </div>
      <button id="cp-submit" type="button" style="margin-top:4px;padding:0.625rem 1.125rem;border-radius:10px;border:none;background:linear-gradient(135deg,#059669,#047857);color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Actualizar contraseña</button>
    </div>
    </div><!-- /cp-body -->
  </div>

<!-- Modal de éxito -->
<div id="ok-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:600;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:18px;padding:2rem;max-width:400px;width:calc(100%-2rem);text-align:center;box-shadow:0 24px 60px rgba(0,0,0,0.3);animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="width:64px;height:64px;border-radius:50%;margin:0 auto 1rem;display:flex;align-items:center;justify-content:center;background:#D1FAE5">
      <svg width="32" height="32" fill="none" stroke="#059669" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <h3 id="ok-modal-title" style="font-size:1.125rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem">Listo</h3>
    <p id="ok-modal-msg" style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.5rem;line-height:1.6"></p>
    <button id="ok-modal-btn" type="button" style="width:100%;padding:0.75rem;border-radius:11px;border:none;background:linear-gradient(135deg,#059669,#047857);color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Entendido</button>
  </div>
</div>
<style is:global>@keyframes modalIn { from{opacity:0;transform:scale(0.9) translateY(12px)}to{opacity:1;transform:scale(1) translateY(0)} }</style>
</AdminLayout>

<style>
  .data-lbl { font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 3px }
  .data-val  { font-size:0.875rem;color:var(--ui-text-1);margin:0;font-weight:500 }
  .acc-btn { display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:10px;border:1.5px solid var(--ui-border);background:var(--ui-surface);color:var(--ui-text-1);font-family:inherit;font-weight:700;font-size:0.8125rem;cursor:pointer;transition:all 0.15s;flex-shrink:0;white-space:nowrap }
  .acc-btn:hover { border-color:var(--brand);color:var(--brand) }
  .acc-btn.open { background:var(--brand);color:#fff;border-color:var(--brand) }
  @media(max-width:640px) { div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns:1fr!important } }
</style>

<script>
  import { requireAuth, isAdmin } from '../../lib/auth';
  import { adminsApi }            from '../../lib/api/admins.api';

  try {
    requireAuth();
    if (!isAdmin()) { window.location.replace('/dashboard/profile'); throw new Error(); }
  } catch { throw new Error('redirect'); }

  // Botón explícito para abrir/cerrar "Cambiar contraseña".
  {
    const btn = document.getElementById('cp-toggle');
    const body = document.getElementById('cp-body');
    if (btn && body) btn.addEventListener('click', () => {
      const open = body.style.display !== 'none';
      body.style.display = open ? 'none' : 'block';
      btn.classList.toggle('open', !open);
      const svg = btn.querySelector('svg')?.outerHTML ?? '';
      btn.innerHTML = `${svg} ${open ? 'Cambiar' : 'Cancelar'}`;
    });
  }

  function fmt(d?: string) {
    if (!d) return '-';
    return new Date(d).toLocaleString('es-CO', {
      day: '2-digit', month: 'short', year: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit',
    });
  }

  async function load() {
    try {
      const res = await adminsApi.me();
      const a   = res.data;
      if (!a) return;

      const fullName = [a.firstName, a.secondName, a.firstSurname, a.secondSurname].filter(Boolean).join(' ');
      const initials = [a.firstName?.[0], a.firstSurname?.[0]].filter(Boolean).join('').toUpperCase() || '?';

      (document.getElementById('profile-avatar') as HTMLElement).textContent = initials;
      (document.getElementById('profile-name')   as HTMLElement).textContent = fullName;
      (document.getElementById('info-adminid')   as HTMLElement).textContent = a.adminId;
      (document.getElementById('info-fullname')  as HTMLElement).textContent = fullName || '-';
      (document.getElementById('info-email')     as HTMLElement).textContent = a.email?.toLowerCase() ?? '-';
      (document.getElementById('info-phone')     as HTMLElement).textContent = a.phone || '-';
      (document.getElementById('info-lastlogin') as HTMLElement).textContent = fmt(a.lastLoginAt);
      (document.getElementById('info-createdat') as HTMLElement).textContent = fmt(a.createdAt);
    } catch {}
  }

  load();

  // ── Cambiar contraseña (código por correo) ───────────────────────────────
  {
    const cpMsg = (t: string, ok: boolean) => {
      const el = document.getElementById('cp-msg')!;
      el.textContent = t; el.style.display = 'block';
      el.style.background = ok ? '#D1FAE5' : '#FEF2F2';
      el.style.color = ok ? '#065F46' : '#B91C1C';
      el.style.border = `1px solid ${ok ? '#A7F3D0' : '#FECACA'}`;
    };
    document.getElementById('cp-request')?.addEventListener('click', async () => {
      const btn = document.getElementById('cp-request') as HTMLButtonElement;
      btn.disabled = true; const prev = btn.textContent; btn.textContent = 'Enviando...';
      try {
        const { authApi } = await import('../../lib/api/auth.api');
        await authApi.requestPasswordCode();
        cpMsg('Te enviamos un código a tu correo. Revisa tu bandeja (vence en 10 min).', true);
        (document.getElementById('cp-step1') as HTMLElement).style.display = 'none';
        (document.getElementById('cp-step2') as HTMLElement).style.display = 'flex';
      } catch (e: any) {
        cpMsg(e?.message ?? 'No se pudo enviar el código.', false);
        btn.disabled = false; btn.textContent = prev ?? 'Enviar código de verificación';
      }
    });
    document.getElementById('cp-submit')?.addEventListener('click', async () => {
      const code = (document.getElementById('cp-code') as HTMLInputElement).value.trim();
      const cur  = (document.getElementById('cp-current') as HTMLInputElement).value;
      const nw   = (document.getElementById('cp-new') as HTMLInputElement).value;
      const cf   = (document.getElementById('cp-confirm') as HTMLInputElement).value;
      if (code.length !== 6) return cpMsg('Ingresa el código de 6 dígitos.', false);
      if (nw.length < 8)     return cpMsg('La nueva contraseña debe tener al menos 8 caracteres.', false);
      if (nw !== cf)         return cpMsg('Las contraseñas nuevas no coinciden.', false);
      const btn = document.getElementById('cp-submit') as HTMLButtonElement;
      btn.disabled = true; const prev = btn.textContent; btn.textContent = 'Actualizando...';
      try {
        const { authApi } = await import('../../lib/api/auth.api');
        await authApi.changePassword(code, cur, nw);
        // Reset + cierre de la sección "Cambiar contraseña".
        (document.getElementById('cp-step2') as HTMLElement).style.display = 'none';
        (document.getElementById('cp-step1') as HTMLElement).style.display = 'flex';
        ['cp-code','cp-current','cp-new','cp-confirm'].forEach(elId => {
          const el = document.getElementById(elId) as HTMLInputElement | null; if (el) el.value = '';
        });
        (document.getElementById('cp-msg') as HTMLElement).style.display = 'none';
        const cpBody = document.getElementById('cp-body'); if (cpBody) cpBody.style.display = 'none';
        const cpToggle = document.getElementById('cp-toggle');
        if (cpToggle) { cpToggle.classList.remove('open');
          const svg = cpToggle.querySelector('svg')?.outerHTML ?? '';
          cpToggle.innerHTML = `${svg} Cambiar`; }
        (document.getElementById('ok-modal-title') as HTMLElement).textContent = 'Contraseña actualizada';
        (document.getElementById('ok-modal-msg')   as HTMLElement).textContent = 'Tu contraseña se cambió correctamente. Úsala en tu próximo inicio de sesión.';
        (document.getElementById('ok-modal') as HTMLElement).style.display = 'flex';
      } catch (e: any) {
        cpMsg(e?.message ?? 'No se pudo cambiar la contraseña.', false);
      } finally {
        btn.disabled = false; btn.textContent = prev ?? 'Actualizar contraseña';
      }
    });
  }

  // Cierre del modal de éxito.
  document.getElementById('ok-modal-btn')?.addEventListener('click', () => {
    (document.getElementById('ok-modal') as HTMLElement).style.display = 'none';
  });
  document.getElementById('ok-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('ok-modal'))
      (document.getElementById('ok-modal') as HTMLElement).style.display = 'none';
  });
</script>
