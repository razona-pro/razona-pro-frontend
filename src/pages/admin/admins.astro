---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Administradores" currentPage="admin-admins">
  <div style="margin-bottom:1.25rem">
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
      <a href="/admin/stats" style="color:var(--ui-text-3);text-decoration:none" onmouseover="this.style.color='var(--brand)'" onmouseout="this.style.color='var(--ui-text-3)'">Panel admin</a>
      <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Administradores</span>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
      <div>
        <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Administradores</h1>
        <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Gestión de cuentas de administrador del sistema.</p>
      </div>
      <button id="btn-new-admin" style="display:inline-flex;align-items:center;gap:7px;padding:0.625rem 1.125rem;border-radius:10px;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-size:0.875rem;font-weight:700;border:none;cursor:pointer;font-family:inherit;box-shadow:0 3px 12px rgba(212,18,36,0.28)">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nuevo admin
      </button>
    </div>
  </div>

  <!-- Stats -->
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:1.25rem">
    <div style="background:var(--ui-card);border-radius:13px;padding:12px 16px;border:1px solid var(--ui-border);border-left:3px solid #D41224">
      <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">Total admins</p>
      <p id="stat-total" style="font-size:1.75rem;font-weight:900;color:#D41224;margin:0;line-height:1">-</p>
    </div>
    <div style="background:var(--ui-card);border-radius:13px;padding:12px 16px;border:1px solid var(--ui-border);border-left:3px solid #059669">
      <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">Activos</p>
      <p id="stat-active" style="font-size:1.75rem;font-weight:900;color:#059669;margin:0;line-height:1">-</p>
    </div>
    <div style="background:var(--ui-card);border-radius:13px;padding:12px 16px;border:1px solid var(--ui-border);border-left:3px solid #D97706">
      <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">Inactivos</p>
      <p id="stat-inactive" style="font-size:1.75rem;font-weight:900;color:#D97706;margin:0;line-height:1">-</p>
    </div>
  </div>

  <!-- Filtros -->
  <div style="display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap;align-items:center">
    <div style="position:relative;flex:1;min-width:200px;max-width:340px">
      <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ui-text-3);pointer-events:none" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="search-admin" type="text" placeholder="Buscar por nombre, ID, correo..."
        style="width:100%;padding:9px 14px 9px 34px;background:var(--ui-card);border:1.5px solid var(--ui-border);border-radius:11px;font-size:0.8125rem;color:var(--ui-text-1);font-family:inherit;outline:none"
        onfocus="this.style.borderColor='var(--brand)'" onblur="this.style.borderColor='var(--ui-border)'">
    </div>
    <select id="filter-status" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none">
      <option value="">Todos los estados</option>
      <option value="active">Activos</option>
      <option value="inactive">Inactivos</option>
    </select>
    <span id="count-label" style="font-size:0.8125rem;color:var(--ui-text-3);margin-left:auto"></span>
  </div>

  <!-- Tabla -->
  <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden">
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse">
        <thead>
          <tr style="border-bottom:1px solid var(--ui-border)">
            <th class="th">ID</th>
            <th class="th">Nombre completo</th>
            <th class="th">Correo electrónico</th>
            <th class="th">Teléfono</th>
            <th class="th">Último acceso</th>
            <th class="th">Estado</th>
            <th class="th">Acciones</th>
          </tr>
        </thead>
        <tbody id="admins-tbody">
          <tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
    <div style="padding:0.875rem 1.25rem;border-top:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
      <span id="page-info" style="font-size:0.8125rem;color:var(--ui-text-3)"></span>
      <div style="display:flex;gap:6px">
        <button id="btn-prev" class="page-btn" disabled>← Anterior</button>
        <button id="btn-next" class="page-btn">Siguiente →</button>
      </div>
    </div>
  </div>
</AdminLayout>

<!-- Modal crear admin -->
<div id="create-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:20px;padding:2rem;max-width:480px;width:calc(100%-2rem);max-height:90vh;overflow-y:auto;animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
      <h2 style="font-size:1.0625rem;font-weight:800;color:var(--ui-text-1);margin:0">Nuevo administrador</h2>
      <button id="modal-close" style="background:none;border:none;cursor:pointer;color:var(--ui-text-3);padding:4px;font-size:1.25rem;line-height:1">×</button>
    </div>
    <div id="create-error" style="display:none;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:10px 12px;font-size:0.8125rem;color:#B91C1C;margin-bottom:1rem"></div>
    <form id="create-form" novalidate>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">
        <div class="field-grp"><label class="field-lbl">Primer nombre *</label><input id="c-fname" type="text" class="field-inp" placeholder="Ej: Juan" maxlength="15" required /></div>
        <div class="field-grp"><label class="field-lbl">Segundo nombre</label><input id="c-mname" type="text" class="field-inp" placeholder="Opcional" maxlength="15" /></div>
        <div class="field-grp"><label class="field-lbl">Primer apellido *</label><input id="c-lname1" type="text" class="field-inp" placeholder="Ej: Pérez" maxlength="15" required /></div>
        <div class="field-grp"><label class="field-lbl">Segundo apellido</label><input id="c-lname2" type="text" class="field-inp" placeholder="Opcional" maxlength="15" /></div>
        <div class="field-grp" style="grid-column:1/-1"><label class="field-lbl">Correo electrónico *</label><input id="c-email" type="email" class="field-inp" placeholder="correo@dominio.com" maxlength="50" required /></div>
        <div class="field-grp"><label class="field-lbl">Teléfono *</label><input id="c-phone" type="tel" class="field-inp" placeholder="+573001234567" required /></div>
        <div class="field-grp"><label class="field-lbl">Contraseña *</label><input id="c-password" type="password" class="field-inp" placeholder="Mín. 8 caracteres" required /></div>
      </div>
      <p style="font-size:0.6875rem;color:var(--ui-text-3);margin:0 0 1rem">* La contraseña debe tener mayúscula, minúscula y número.</p>
      <div style="display:flex;gap:8px">
        <button type="button" id="create-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
        <button type="submit" id="create-submit" style="flex:2;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(212,18,36,0.28)">
          <span id="create-label">Crear administrador</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal toggle estado admin -->
<div id="toggle-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:18px;padding:2rem;max-width:360px;width:calc(100%-2rem);text-align:center;animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div id="toggle-icon-wrap" style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem"></div>
    <h3 id="toggle-title" style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem"></h3>
    <p id="toggle-desc" style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.25rem;line-height:1.55"></p>
    <div style="display:flex;gap:8px">
      <button id="toggle-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
      <button id="toggle-confirm" style="flex:1;padding:0.6875rem;border-radius:10px;border:none;color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Confirmar</button>
    </div>
  </div>
</div>

<!-- Modal: no puede desactivarse a sí mismo -->
<div id="self-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:18px;padding:2rem;max-width:360px;width:calc(100%-2rem);text-align:center;animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="width:52px;height:52px;border-radius:14px;background:#FEF3C7;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
      <svg width="24" height="24" fill="none" stroke="#D97706" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <h3 style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem">Acción no permitida</h3>
    <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.25rem;line-height:1.55">No puedes desactivar tu propia cuenta de administrador.</p>
    <button id="self-ok" style="width:100%;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Entendido</button>
  </div>
</div>

<style>
  @keyframes modalIn { from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)} }
  .page-btn { padding:6px 14px;border-radius:8px;border:1.5px solid var(--ui-border);background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;font-weight:600;cursor:pointer;transition:all 0.15s }
  .page-btn:hover:not(:disabled) { border-color:var(--brand);color:var(--brand) }
  .page-btn:disabled { opacity:0.4;cursor:not-allowed }
  .field-grp { display:flex;flex-direction:column;gap:4px }
  .field-lbl { font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3) }
  .field-inp { padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);outline:none;transition:border-color 0.2s;width:100% }
  .field-inp:focus { border-color:var(--brand);box-shadow:0 0 0 3px rgba(212,18,36,0.1) }
  .action-btn { padding:4px 10px;border-radius:7px;border:1.5px solid;font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit;transition:all 0.15s }
</style>

<script>
  import { requireAuth, isAdmin, getUser } from '../../lib/auth';
  import { adminsApi } from '../../lib/api/admins.api';
  import { toast } from '../../lib/toast';
  import type { AdminDto } from '../../lib/api/types';

  declare global {
  interface Window {
    rpLoader?: {
      show: (message?: string) => void;
      hide: () => void;
    };
  }
}

  try {
    requireAuth();
    if (!isAdmin()) { window.location.replace('/dashboard'); throw new Error(); }
  } catch { throw new Error('redirect'); }

  const currentUser = getUser();
  let page        = 0;
  const SIZE      = 20;
  let totalPages  = 1;
  let searchStr   = '';
  let filterStatus = '';
  let debounce: ReturnType<typeof setTimeout>;
  let pendingToggleId  = '';
  let pendingActivate  = false;
  let allAdmins: AdminDto[] = [];

  function fmtDate(iso?: string) {
    if (!iso) return '-';
    return new Date(iso).toLocaleString('es-CO', { dateStyle: 'short', timeStyle: 'short' });
  }

  async function loadPage() {
    try {
      const res = await adminsApi.findAll(page, SIZE, searchStr || undefined, filterStatus || undefined);
      if (!res.data) return;
      allAdmins  = res.data.content;
      totalPages = res.data.totalPages;
      const total    = res.data.totalElements;
      const active   = allAdmins.filter(a => a.isActive).length;
      const inactive = allAdmins.filter(a => !a.isActive).length;

      (document.getElementById('stat-total') as HTMLElement).textContent    = String(total);
      (document.getElementById('stat-active') as HTMLElement).textContent   = String(active);
      (document.getElementById('stat-inactive') as HTMLElement).textContent = String(inactive);
      (document.getElementById('count-label') as HTMLElement).textContent   = `${total} admin(s)`;
      (document.getElementById('page-info') as HTMLElement).textContent     = `Pág. ${page + 1} de ${totalPages || 1} · ${total}`;
      (document.getElementById('btn-prev') as HTMLButtonElement).disabled   = page === 0;
      (document.getElementById('btn-next') as HTMLButtonElement).disabled   = page >= totalPages - 1;

      renderTable();
    } catch (err: any) {
      toast.error('Error al cargar admins', { description: err?.message });
    }
  }

  function triggerLoad() { page = 0; clearTimeout(debounce); debounce = setTimeout(loadPage, 300); }

  function renderTable() {
    const tbody = document.getElementById('admins-tbody')!;
    tbody.innerHTML = '';
    if (!allAdmins.length) {
      tbody.innerHTML = '<tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Sin administradores</td></tr>';
      return;
    }
    allAdmins.forEach(a => {
      const fullName = [a.firstName, a.secondName, a.firstSurname, a.secondSurname].filter(Boolean).join(' ');
      const isMe     = currentUser?.id === a.adminId;
      const tr       = document.createElement('tr');
      tr.innerHTML = `
        <td class="td"><code style="background:var(--ui-surface);padding:2px 7px;border-radius:5px;font-size:0.8125rem;font-family:monospace">${a.adminId}</code></td>
        <td class="td" style="font-weight:600">${fullName}${isMe ? ' <span style="font-size:0.625rem;background:#EDE9FE;color:#6366F1;padding:2px 7px;border-radius:10px;font-weight:700">Tú</span>' : ''}</td>
        <td class="td" style="font-size:0.8125rem;color:var(--ui-text-2)">${(a.email ?? '').toLowerCase()}</td>
        <td class="td" style="font-size:0.8125rem;font-family:monospace">${a.phone ?? '-'}</td>
        <td class="td" style="font-size:0.8125rem;color:var(--ui-text-3)">${fmtDate(a.lastLoginAt)}</td>
        <td class="td">
          <span style="padding:3px 9px;border-radius:12px;font-size:0.6875rem;font-weight:700;background:${a.isActive?'#D1FAE5':'#FEE2E2'};color:${a.isActive?'#059669':'#DC2626'}">
            ${a.isActive ? 'Activo' : 'Inactivo'}
          </span>
        </td>
        <td class="td">
          <div style="display:flex;gap:5px">
            ${isMe
              ? `<span style="font-size:0.75rem;color:var(--ui-text-3);padding:4px 10px;background:var(--ui-surface);border-radius:7px;border:1.5px solid var(--ui-border)">Mi cuenta</span>`
              : `<button class="action-btn btn-toggle"
                  data-id="${a.adminId}" data-name="${fullName}" data-active="${a.isActive}"
                  style="border-color:${a.isActive?'#FECACA':'#A7F3D0'};background:${a.isActive?'#FEF2F2':'#D1FAE5'};color:${a.isActive?'#DC2626':'#059669'}">
                  ${a.isActive ? 'Desactivar' : 'Activar'}
                </button>`
            }
          </div>
        </td>`;
      tbody.appendChild(tr);
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const isActive = btn.dataset.active === 'true';
        const name     = btn.dataset.name!;
        const id       = btn.dataset.id!;

        // Doble check: no desactivarse a sí mismo
        if (!isActive === false && currentUser?.id === id) {
          (document.getElementById('self-modal') as HTMLElement).style.display = 'flex';
          return;
        }

        pendingToggleId  = id;
        pendingActivate  = !isActive;

        const iconWrap = document.getElementById('toggle-icon-wrap')!;
        const title    = document.getElementById('toggle-title')!;
        const desc     = document.getElementById('toggle-desc')!;
        const confirm  = document.getElementById('toggle-confirm') as HTMLButtonElement;

        if (isActive) {
          iconWrap.style.background = '#FEE2E2';
          iconWrap.innerHTML = '<svg width="24" height="24" fill="none" stroke="#DC2626" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
          title.textContent = '¿Desactivar administrador?';
          desc.textContent  = `Se desactivará la cuenta de "${name}". No podrá iniciar sesión hasta que sea reactivada.`;
          confirm.style.background = 'linear-gradient(135deg,#DC2626,#991B1B)';
          confirm.style.boxShadow  = '0 3px 12px rgba(220,38,38,0.3)';
        } else {
          iconWrap.style.background = '#D1FAE5';
          iconWrap.innerHTML = '<svg width="24" height="24" fill="none" stroke="#059669" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>';
          title.textContent = '¿Activar administrador?';
          desc.textContent  = `Se reactivará la cuenta de "${name}". Podrá volver a iniciar sesión.`;
          confirm.style.background = 'linear-gradient(135deg,#059669,#047857)';
          confirm.style.boxShadow  = '0 3px 12px rgba(5,150,105,0.3)';
        }
        (document.getElementById('toggle-modal') as HTMLElement).style.display = 'flex';
      });
    });
  }

  document.getElementById('search-admin')?.addEventListener('input', e => {
    searchStr = (e.target as HTMLInputElement).value.trim();
    triggerLoad();
  });
  document.getElementById('filter-status')?.addEventListener('change', e => {
    filterStatus = (e.target as HTMLSelectElement).value;
    triggerLoad();
  });

  document.getElementById('btn-prev')?.addEventListener('click', () => { if (page > 0) { page--; loadPage(); } });
  document.getElementById('btn-next')?.addEventListener('click', () => { if (page < totalPages - 1) { page++; loadPage(); } });

  // Self modal
  document.getElementById('self-ok')?.addEventListener('click', () => {
    (document.getElementById('self-modal') as HTMLElement).style.display = 'none';
  });

  // Toggle modal
  const toggleModal = document.getElementById('toggle-modal')!;
  document.getElementById('toggle-cancel')?.addEventListener('click', () => { toggleModal.style.display = 'none'; });
  toggleModal.addEventListener('click', e => { if (e.target === toggleModal) toggleModal.style.display = 'none'; });

  document.getElementById('toggle-confirm')?.addEventListener('click', async () => {
    toggleModal.style.display = 'none';
    window.rpLoader?.show(pendingActivate ? 'Activando administrador...' : 'Desactivando administrador...');
    try {
      if (pendingActivate) {
        await adminsApi.update(pendingToggleId, { isActive: true });
        toast.success('Administrador activado');
      } else {
        await adminsApi.deactivate(pendingToggleId);
        toast.success('Administrador desactivado');
      }
      loadPage();
    } catch (err: any) {
      toast.error('Error', { description: err?.message });
    } finally {
      window.rpLoader?.hide();
    }
  });

  // ── Create modal ──────────────────────────────────────────────────────
  const createModal = document.getElementById('create-modal')!;
  const openCreate  = () => { createModal.style.display = 'flex'; };
  const closeCreate = () => { createModal.style.display = 'none'; };

  document.getElementById('btn-new-admin')?.addEventListener('click', openCreate);
  document.getElementById('modal-close')?.addEventListener('click', closeCreate);
  document.getElementById('create-cancel')?.addEventListener('click', closeCreate);
  createModal.addEventListener('click', e => { if (e.target === createModal) closeCreate(); });

  document.getElementById('create-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl  = document.getElementById('create-error')!;
    const lblEl  = document.getElementById('create-label')!;
    const submit = document.getElementById('create-submit') as HTMLButtonElement;
    errEl.style.display = 'none';

    const firstName     = (document.getElementById('c-fname')    as HTMLInputElement).value.trim();
    const secondName    = (document.getElementById('c-mname')    as HTMLInputElement).value.trim() || undefined;
    const firstSurname  = (document.getElementById('c-lname1')   as HTMLInputElement).value.trim();
    const secondSurname = (document.getElementById('c-lname2')   as HTMLInputElement).value.trim() || undefined;
    const email         = (document.getElementById('c-email')    as HTMLInputElement).value.trim();
    const phone         = (document.getElementById('c-phone')    as HTMLInputElement).value.trim();
    const password      = (document.getElementById('c-password') as HTMLInputElement).value;

    if (!firstName || !firstSurname || !email || !phone || !password) {
      errEl.textContent   = 'Completa todos los campos obligatorios.';
      errEl.style.display = 'block'; return;
    }

    submit.disabled = true; lblEl.textContent = 'Creando...';
    window.rpLoader?.show('Creando administrador...');
    try {
      await adminsApi.create({ firstName, secondName, firstSurname, secondSurname, email, phone, password });
      toast.success('Administrador creado correctamente');
      closeCreate();
      (document.getElementById('create-form') as HTMLFormElement).reset();
      page = 0; loadPage();
    } catch (err: any) {
      const msgs = err?.errors ? Object.values(err.errors as Record<string, string>).join(' ') : err?.message;
      errEl.textContent   = msgs ?? 'Error al crear administrador.';
      errEl.style.display = 'block';
    } finally {
      submit.disabled = false; lblEl.textContent = 'Crear administrador';
      window.rpLoader?.hide();
    }
  });

  loadPage();
</script>