---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Estadísticas Admin" currentPage="admin-stats">
  <div style="margin-bottom:1.25rem">
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
      <a href="/dashboard" style="color:var(--ui-text-3);text-decoration:none" onmouseover="this.style.color='var(--brand)'" onmouseout="this.style.color='var(--ui-text-3)'">Dashboard</a>
      <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Estadísticas</span>
    </div>
    <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Estadísticas generales</h1>
    <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Rendimiento de la plataforma, estudiantes y preguntas.</p>
  </div>

  <!-- Overview cards -->
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;margin-bottom:1.5rem" id="overview-grid">
    <div class="ov-card skel-card"></div>
    <div class="ov-card skel-card"></div>
    <div class="ov-card skel-card"></div>
    <div class="ov-card skel-card"></div>
    <div class="ov-card skel-card"></div>
    <div class="ov-card skel-card"></div>
  </div>

  <!-- Tabs -->
  <div style="display:flex;gap:6px;margin-bottom:1rem;flex-wrap:wrap">
    <button class="tab-btn active" data-tab="performance">Rendimiento de estudiantes</button>
    <button class="tab-btn" data-tab="trends">Tendencias de preguntas</button>
  </div>

  <!-- Rendimiento de estudiantes -->
  <div id="tab-performance">
    <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden">
      <div style="padding:14px 18px;border-bottom:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
        <div>
          <p style="font-size:0.875rem;font-weight:800;color:var(--ui-text-1);margin:0">Rendimiento por estudiante</p>
          <p style="font-size:0.75rem;color:var(--ui-text-3);margin:2px 0 0">Basado en intentos finalizados (tests estáticos)</p>
        </div>
        <input id="search-student" type="text" placeholder="Buscar por ID..."
          style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-surface);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none;width:200px"
          onfocus="this.style.borderColor='var(--brand)'" onblur="this.style.borderColor='var(--ui-border)'">
      </div>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse">
          <thead>
            <tr style="border-bottom:1px solid var(--ui-border)">
              <th class="th">#</th>
              <th class="th">Estudiante</th>
              <th class="th">Intentos</th>
              <th class="th">Puntaje promedio</th>
              <th class="th">Precisión</th>
              <th class="th">Correctas / Total</th>
              <th class="th">Tendencia</th>
            </tr>
          </thead>
          <tbody id="perf-tbody">
            <tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Tendencias de preguntas -->
  <div id="tab-trends" style="display:none">
    <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden">
      <div style="padding:14px 18px;border-bottom:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
        <div>
          <p style="font-size:0.875rem;font-weight:800;color:var(--ui-text-1);margin:0">Preguntas más difíciles</p>
          <p style="font-size:0.75rem;color:var(--ui-text-3);margin:2px 0 0">Ordenadas por mayor tasa de error</p>
        </div>
        <select id="filter-competence" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-surface);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none;min-width:200px">
          <option value="">Todas las competencias</option>
        </select>
      </div>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse">
          <thead>
            <tr style="border-bottom:1px solid var(--ui-border)">
              <th class="th">Pregunta</th>
              <th class="th">Enunciado</th>
              <th class="th">Respuestas</th>
              <th class="th">Correctas</th>
              <th class="th">Tasa de error</th>
              <th class="th">Dificultad real</th>
            </tr>
          </thead>
          <tbody id="trends-tbody">
            <tr><td colspan="6" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Selecciona una competencia o carga todas.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div style="margin-top:10px;text-align:right">
      <button id="btn-load-trends" style="padding:8px 18px;border-radius:9px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-size:0.8125rem;font-weight:700;cursor:pointer;box-shadow:0 3px 10px rgba(212,18,36,0.25)">Cargar tendencias</button>
    </div>
  </div>
</AdminLayout>

<style>
  @keyframes shimmer { 0%{background-position:-400px 0}100%{background-position:400px 0} }
  @keyframes modalIn { from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)} }

  .skel-card {
    height:90px;
    background:linear-gradient(90deg,var(--ui-surface) 25%,var(--ui-border) 50%,var(--ui-surface) 75%);
    background-size:400px 100%;animation:shimmer 1.5s infinite;
  }
  .ov-card { background:var(--ui-card);border-radius:14px;padding:14px 16px;border:1px solid var(--ui-border); }

  .tab-btn {
    padding:7px 18px;border-radius:20px;font-size:0.8125rem;font-weight:600;
    border:1.5px solid var(--ui-border);background:var(--ui-card);color:var(--ui-text-2);
    cursor:pointer;font-family:inherit;transition:all 0.15s;
  }
  .tab-btn:hover  { border-color:var(--brand);color:var(--brand); }
  .tab-btn.active { background:var(--brand);color:white;border-color:var(--brand); }


  .score-bar-wrap { width:80px;height:6px;background:var(--ui-border);border-radius:3px;overflow:hidden;display:inline-block;vertical-align:middle;margin-right:6px }
  .score-bar      { height:100%;border-radius:3px;transition:width 0.4s }
</style>

<script>
  import { requireAuth, isAdmin } from '../../lib/auth';
  import { apiFetch }             from '../../lib/api/client';
  import { competencesApi }       from '../../lib/api/competences.api';
  import { toast }                from '../../lib/toast';


  // ── Tipos ────────────────────────────────────────────────────
  interface AdminOverview {
    totalStudents: number; activeStudents: number; inactiveStudents: number;
    totalQuestions: number; activeQuestions: number;
    totalCompetences: number; activeCompetences: number;
    totalTests: number; finishedTrieds: number; inProgressTrieds: number;
    openDoubts: number; totalAiSessions: number; avgScore: number; satisfactionRate: number;
  }
  interface StudentPerf {
    studentId: string; totalTrieds: number; avgScore: number;
    totalCorrect: number; totalQuestions: number; accuracyRate: number;
  }
  interface QuestionTrend {
    questionId: string; competenceId: string; statement?: string;
    totalAnswers: number; correctAnswers: number; errorRate: number;
  }

  // ── Overview ─────────────────────────────────────────────────
  async function loadOverview() {
    try {
      const res = await apiFetch<AdminOverview>('/api/stats/admin/overview');
      const d   = res.data!;
      const grid = document.getElementById('overview-grid')!;
      grid.innerHTML = '';

      const cards: { label: string; value: string | number; color: string; sub?: string }[] = [
        { label:'Estudiantes activos',   value: d.activeStudents,    color:'#059669', sub: `${d.inactiveStudents} inactivos` },
        { label:'Preguntas activas',     value: d.activeQuestions,   color:'#2563EB', sub: `${d.totalQuestions} total` },
        { label:'Competencias activas',  value: d.activeCompetences, color:'#7C3AED', sub: `${d.totalCompetences} total` },
        { label:'Tests disponibles',     value: d.totalTests,        color:'#D97706' },
        { label:'Intentos finalizados',  value: d.finishedTrieds,    color:'#D41224', sub: `${d.inProgressTrieds} en progreso` },
        { label:'Dudas abiertas',        value: d.openDoubts,        color: d.openDoubts > 0 ? '#D97706' : '#059669' },
        { label:'Sesiones IA',           value: d.totalAiSessions,   color:'#6366F1' },
        { label:'Puntaje promedio',      value: `${d.avgScore.toFixed(1)}%`, color: d.avgScore >= 60 ? '#059669' : '#DC2626' },
        { label:'Satisfacción',          value: `${d.satisfactionRate.toFixed(1)}%`, color:'#D41224' },
      ];

      cards.forEach(c => {
        const div = document.createElement('div');
        div.className = 'ov-card';
        div.style.borderLeft = `3px solid ${c.color}`;
        div.innerHTML = `
          <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px">${c.label}</p>
          <p style="font-size:1.625rem;font-weight:900;color:${c.color};margin:0;line-height:1">${c.value}</p>
          ${c.sub ? `<p style="font-size:0.6875rem;color:var(--ui-text-3);margin:4px 0 0">${c.sub}</p>` : ''}
        `;
        grid.appendChild(div);
      });
    } catch (err: any) {
      toast.error('Error al cargar estadísticas', { description: err?.message });
    }
  }

  // ── Rendimiento de estudiantes ───────────────────────────────
  let allPerf: StudentPerf[] = [];

  async function loadPerformance() {
    try {
      const res = await apiFetch<StudentPerf[]>('/api/stats/admin/student-performance');
      allPerf = res.data ?? [];
      renderPerf(allPerf);
    } catch (err: any) {
      document.getElementById('perf-tbody')!.innerHTML =
        `<tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Error: ${err?.message}</td></tr>`;
    }
  }

  function renderPerf(data: StudentPerf[]) {
    const tbody = document.getElementById('perf-tbody')!;
    tbody.innerHTML = '';
    if (!data.length) {
      tbody.innerHTML = '<tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Sin datos de rendimiento aún.</td></tr>';
      return;
    }
    data.forEach((s, idx) => {
      const score    = s.avgScore ?? 0;
      const accuracy = s.accuracyRate ?? 0;
      const barColor = score >= 70 ? '#059669' : score >= 50 ? '#D97706' : '#DC2626';
      const rank     = idx + 1;
      const medal    = rank === 1 ? '🥇' : rank === 2 ? '🥈' : rank === 3 ? '🥉' : `#${rank}`;
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="td" style="font-weight:700;color:var(--ui-text-3);font-size:0.8125rem">${medal}</td>
        <td class="td">
          <code style="background:var(--ui-surface);padding:2px 8px;border-radius:6px;font-size:0.8125rem;font-weight:700;color:var(--brand);border:1px solid var(--ui-border)">${s.studentId}</code>
        </td>
        <td class="td" style="text-align:center;font-weight:700">${s.totalTrieds}</td>
        <td class="td">
          <div style="display:flex;align-items:center;gap:8px">
            <div class="score-bar-wrap"><div class="score-bar" style="width:${Math.min(score,100)}%;background:${barColor}"></div></div>
            <span style="font-weight:800;color:${barColor}">${score.toFixed(1)}%</span>
          </div>
        </td>
        <td class="td">
          <span style="padding:3px 9px;border-radius:12px;font-size:0.6875rem;font-weight:700;background:${accuracy>=70?'#D1FAE5':accuracy>=50?'#FEF3C7':'#FEE2E2'};color:${accuracy>=70?'#059669':accuracy>=50?'#D97706':'#DC2626'}">
            ${accuracy.toFixed(1)}%
          </span>
        </td>
        <td class="td" style="font-size:0.8125rem;color:var(--ui-text-3)">${s.totalCorrect} / ${s.totalQuestions}</td>
        <td class="td">
          <div style="display:flex;gap:2px">
            ${Array.from({length:5}, (_,i) => `<div style="width:6px;height:${10+(i*4)}px;border-radius:2px;background:${i < Math.round(score/20) ? barColor : 'var(--ui-border)'}"></div>`).join('')}
          </div>
        </td>`;
      tbody.appendChild(tr);
    });
  }

  document.getElementById('search-student')?.addEventListener('input', e => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    renderPerf(allPerf.filter(s => s.studentId.toLowerCase().includes(q)));
  });

  // ── Tendencias de preguntas ──────────────────────────────────
  async function loadTrends(competenceId?: string) {
    const tbody = document.getElementById('trends-tbody')!;
    tbody.innerHTML = '<tr><td colspan="6" style="padding:1.5rem;text-align:center;color:var(--ui-text-3)">Cargando...</td></tr>';
    try {
      const qs  = competenceId ? `?competenceId=${competenceId}` : '';
      const res = await apiFetch<QuestionTrend[]>(`/api/stats/admin/question-trends${qs}`);
      const data = res.data ?? [];
      tbody.innerHTML = '';
      if (!data.length) {
        tbody.innerHTML = '<tr><td colspan="6" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Sin datos de respuestas aún.</td></tr>';
        return;
      }
      data.slice(0, 50).forEach(q => {
        const er    = q.errorRate ?? 0;
        const color = er >= 70 ? '#DC2626' : er >= 40 ? '#D97706' : '#059669';
        const label = er >= 70 ? 'Alta' : er >= 40 ? 'Media' : 'Baja';
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="td">
            <code style="background:var(--ui-surface);padding:2px 8px;border-radius:6px;font-size:0.75rem;font-weight:700;color:var(--brand);border:1px solid var(--ui-border)">${q.questionId}</code>
          </td>
          <td class="td" style="max-width:260px;font-size:0.8125rem;color:var(--ui-text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${q.statement ?? ''}">${q.statement ?? '—'}</td>
          <td class="td" style="text-align:center;font-weight:700">${q.totalAnswers}</td>
          <td class="td" style="text-align:center;color:#059669;font-weight:700">${q.correctAnswers}</td>
          <td class="td">
            <div style="display:flex;align-items:center;gap:8px">
              <div class="score-bar-wrap"><div class="score-bar" style="width:${Math.min(er,100)}%;background:${color}"></div></div>
              <span style="font-weight:800;color:${color}">${er.toFixed(1)}%</span>
            </div>
          </td>
          <td class="td">
            <span style="padding:3px 9px;border-radius:12px;font-size:0.6875rem;font-weight:700;background:${er>=70?'#FEE2E2':er>=40?'#FEF3C7':'#D1FAE5'};color:${color}">
              ${label}
            </span>
          </td>`;
        tbody.appendChild(tr);
      });
    } catch (err: any) {
      tbody.innerHTML = `<tr><td colspan="6" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Error: ${err?.message}</td></tr>`;
    }
  }

  // Cargar competencias en el selector
  competencesApi.findAll(false).then(res => {
    const sel = document.getElementById('filter-competence') as HTMLSelectElement;
    (res.data ?? []).forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.competenceId;
      opt.textContent = c.competenceName;
      sel.appendChild(opt);
    });
  }).catch(() => {});

  document.getElementById('btn-load-trends')?.addEventListener('click', () => {
    const sel = document.getElementById('filter-competence') as HTMLSelectElement;
    loadTrends(sel.value || undefined);
  });

  // ── Tabs ─────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tab = btn.dataset.tab!;
      document.getElementById('tab-performance')!.style.display = tab === 'performance' ? 'block' : 'none';
      document.getElementById('tab-trends')!.style.display       = tab === 'trends'      ? 'block' : 'none';
    });
  });

  // ── Init ─────────────────────────────────────────────────────
  loadOverview();
  loadPerformance();
</script>
