---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Estadísticas Admin" currentPage="admin-stats">
  <!-- Page header -->
  <div style="margin-bottom:1.5rem">
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
      <a href="/admin/stats" style="color:var(--ui-text-3);text-decoration:none"
        onmouseover="this.style.color='var(--brand)'" onmouseout="this.style.color='var(--ui-text-3)'">Panel admin</a>
      <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Estadísticas</span>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
      <div>
        <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Estadísticas generales</h1>
        <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Resumen de actividad, rendimiento estudiantil y análisis de preguntas.</p>
      </div>
      <button id="btn-refresh" style="display:inline-flex;align-items:center;gap:7px;padding:0.5625rem 1rem;border-radius:10px;background:var(--ui-card);border:1.5px solid var(--ui-border);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;font-weight:600;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--brand)';this.style.color='var(--brand)'" onmouseout="this.style.borderColor='var(--ui-border)';this.style.color='var(--ui-text-1)'">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        Actualizar
      </button>
    </div>
  </div>

  <!-- ── SECCIÓN 1: Resumen general ── -->
  <div style="margin-bottom:0.625rem;display:flex;align-items:center;gap:8px">
    <svg width="14" height="14" fill="none" stroke="var(--brand)" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
    <span style="font-size:0.6875rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.6px">Resumen general</span>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;margin-bottom:1.5rem" id="overview-grid">
    <div class="ov-card skel-card"></div>
    <div class="ov-card skel-card"></div>
    <div class="ov-card skel-card"></div>
    <div class="ov-card skel-card"></div>
    <div class="ov-card skel-card"></div>
    <div class="ov-card skel-card"></div>
  </div>

  <!-- ── SECCIÓN 2: Gráficas ── -->
  <div style="margin-bottom:0.625rem;display:flex;align-items:center;gap:8px">
    <svg width="14" height="14" fill="none" stroke="var(--brand)" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
    <span style="font-size:0.6875rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.6px">Visualización de datos</span>
  </div>
  <div id="charts-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-bottom:1.75rem"></div>

  <!-- ── SECCIÓN 3: Análisis detallado ── -->
  <div style="margin-bottom:0.75rem;display:flex;align-items:center;gap:8px">
    <svg width="14" height="14" fill="none" stroke="var(--brand)" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
    <span style="font-size:0.6875rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.6px">Análisis detallado</span>
  </div>
  <div style="display:flex;gap:6px;margin-bottom:1rem;flex-wrap:wrap">
    <button class="tab-btn active" data-tab="performance">
      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      Rendimiento de estudiantes
    </button>
    <button class="tab-btn" data-tab="trends">
      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      Análisis de preguntas
    </button>
  </div>

  <!-- Tab: Rendimiento de estudiantes -->
  <div id="tab-performance">
    <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden;box-shadow:0 1px 4px var(--ui-shadow)">
      <div style="padding:14px 18px;border-bottom:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
        <div>
          <p style="font-size:0.875rem;font-weight:800;color:var(--ui-text-1);margin:0">Tabla de rendimiento</p>
          <p style="font-size:0.75rem;color:var(--ui-text-3);margin:2px 0 0">Puntaje promedio y precisión por estudiante (basado en tests estáticos finalizados)</p>
        </div>
        <div style="position:relative">
          <svg style="position:absolute;left:10px;top:50%;transform:translateY(-50%);pointer-events:none" width="12" height="12" fill="none" stroke="var(--ui-text-3)" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input id="search-student" type="text" placeholder="Buscar por código..."
            style="padding:7px 12px 7px 30px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-surface);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none;width:220px"
            onfocus="this.style.borderColor='var(--brand)';this.style.boxShadow='0 0 0 3px rgba(212,18,36,0.1)'"
            onblur="this.style.borderColor='var(--ui-border)';this.style.boxShadow='none'">
        </div>
      </div>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse">
          <thead>
            <tr style="border-bottom:1px solid var(--ui-border)">
              <th class="th">Pos.</th>
              <th class="th">Código</th>
              <th class="th">Intentos</th>
              <th class="th">Puntaje promedio</th>
              <th class="th">Precisión</th>
              <th class="th">Correctas / Total</th>
              <th class="th">Nivel</th>
            </tr>
          </thead>
          <tbody id="perf-tbody">
            <tr><td colspan="7" style="padding:2.5rem;text-align:center;color:var(--ui-text-3)">
              <div style="display:inline-flex;flex-direction:column;align-items:center;gap:8px">
                <div style="width:32px;height:32px;border:2.5px solid rgba(212,18,36,0.2);border-top-color:var(--brand);border-radius:50%;animation:spin 0.8s linear infinite"></div>
                <span style="font-size:0.8125rem">Cargando rendimiento...</span>
              </div>
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Tab: Tendencias de preguntas -->
  <div id="tab-trends" style="display:none">
    <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden;box-shadow:0 1px 4px var(--ui-shadow)">
      <div style="padding:14px 18px;border-bottom:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
        <div>
          <p style="font-size:0.875rem;font-weight:800;color:var(--ui-text-1);margin:0">Preguntas por tasa de error</p>
          <p style="font-size:0.75rem;color:var(--ui-text-3);margin:2px 0 0">Las preguntas con mayor tasa de error suelen requerir ajuste o revisión pedagógica</p>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          <select id="filter-competence" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-surface);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none;min-width:180px"
            onfocus="this.style.borderColor='var(--brand)'" onblur="this.style.borderColor='var(--ui-border)'">
            <option value="">Todas las competencias</option>
          </select>
          <button id="btn-load-trends" class="btn-brand" style="padding:7px 16px;font-size:0.8125rem">
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            Cargar
          </button>
        </div>
      </div>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse">
          <thead>
            <tr style="border-bottom:1px solid var(--ui-border)">
              <th class="th">ID Pregunta</th>
              <th class="th">Enunciado (extracto)</th>
              <th class="th">Total resp.</th>
              <th class="th">Correctas</th>
              <th class="th">Tasa de error</th>
              <th class="th">Dificultad</th>
            </tr>
          </thead>
          <tbody id="trends-tbody">
            <tr><td colspan="6" style="padding:2.5rem;text-align:center;color:var(--ui-text-3)">
              <div style="display:inline-flex;flex-direction:column;align-items:center;gap:8px">
                <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                <span style="font-size:0.8125rem">Selecciona una competencia o presiona "Cargar" para ver todas.</span>
              </div>
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  @keyframes shimmer { 0%{background-position:-400px 0}100%{background-position:400px 0} }
  @keyframes spin    { to{transform:rotate(360deg)} }

  .skel-card {
    height:90px;
    background:linear-gradient(90deg,var(--ui-surface) 25%,var(--ui-border) 50%,var(--ui-surface) 75%);
    background-size:400px 100%;animation:shimmer 1.5s infinite;
  }
  .ov-card {
    background:var(--ui-card);border-radius:14px;padding:14px 16px;border:1px solid var(--ui-border);
    transition:border-color 0.2s,box-shadow 0.2s;
  }
  .ov-card:hover { border-color:rgba(212,18,36,0.25);box-shadow:0 4px 16px var(--ui-shadow-md); }

  .tab-btn {
    display:inline-flex;align-items:center;gap:6px;
    padding:7px 18px;border-radius:20px;font-size:0.8125rem;font-weight:600;
    border:1.5px solid var(--ui-border);background:var(--ui-card);color:var(--ui-text-2);
    cursor:pointer;font-family:inherit;transition:all 0.15s;
  }
  .tab-btn:hover  { border-color:var(--brand);color:var(--brand); }
  .tab-btn.active { background:var(--brand);color:white;border-color:var(--brand);box-shadow:0 3px 10px rgba(212,18,36,0.2); }

  .score-bar-wrap { width:80px;height:6px;background:var(--ui-border);border-radius:3px;overflow:hidden;display:inline-block;vertical-align:middle;margin-right:6px }
  .score-bar      { height:100%;border-radius:3px;transition:width 0.5s ease }
</style>

<script>
  import { requireAuth, isAdmin } from '../../lib/auth';
  import { apiFetch }             from '../../lib/api/client';
  import { competencesApi }       from '../../lib/api/competences.api';
  import { toast }                from '../../lib/toast';

  try {
    requireAuth();
    if (!isAdmin()) { window.location.replace('/dashboard'); throw new Error(); }
  } catch { throw new Error('redirect'); }

  // ── Tipos ────────────────────────────────────────────────────
  interface AdminOverview {
    totalStudents: number; activeStudents: number; inactiveStudents: number;
    totalQuestions: number; activeQuestions: number;
    totalCompetences: number; activeCompetences: number;
    totalTests: number; finishedTrieds: number; inProgressTrieds: number;
    openDoubts: number; totalAiSessions: number; avgScore: number; satisfactionRate: number;
  }
  interface StudentPerf {
    studentId: string; totalTrieds: number; avgScore: number;
    totalCorrect: number; totalQuestions: number; accuracyRate: number;
  }
  interface QuestionTrend {
    questionId: string; competenceId: string; statement?: string;
    totalAnswers: number; correctAnswers: number; errorRate: number;
  }

  // ── Overview ─────────────────────────────────────────────────
  async function loadOverview() {
    try {
      const res = await apiFetch<AdminOverview>('/api/stats/admin/overview');
      const d   = res.data!;
      const grid = document.getElementById('overview-grid')!;
      grid.innerHTML = '';

      const cards: { label: string; value: string | number; color: string; sub?: string }[] = [
        { label:'Estudiantes activos',  value: d.activeStudents,    color:'#059669', sub: `${d.inactiveStudents} inactivos` },
        { label:'Preguntas activas',    value: d.activeQuestions,   color:'#2563EB', sub: `de ${d.totalQuestions} total` },
        { label:'Competencias activas', value: d.activeCompetences, color:'#7C3AED', sub: `de ${d.totalCompetences} total` },
        { label:'Tests disponibles',    value: d.totalTests,        color:'#D97706' },
        { label:'Intentos finalizados', value: d.finishedTrieds,    color:'#D41224', sub: `${d.inProgressTrieds} en progreso` },
        { label:'Dudas abiertas',       value: d.openDoubts,        color: d.openDoubts > 0 ? '#D97706' : '#059669' },
        { label:'Sesiones IA',          value: d.totalAiSessions,   color:'#6366F1' },
        { label:'Puntaje promedio',     value: `${d.avgScore.toFixed(1)}%`, color: d.avgScore >= 60 ? '#059669' : '#DC2626', sub: d.avgScore >= 60 ? 'Sobre la meta (60%)' : 'Bajo la meta (60%)' },
        { label:'Nivel de rendimiento', value: `${d.satisfactionRate.toFixed(1)}%`, color:'#D41224' },
      ];

      cards.forEach(c => {
        const div = document.createElement('div');
        div.className = 'ov-card';
        div.style.borderLeft = `3px solid ${c.color}`;
        div.innerHTML = `
          <p style="font-size:0.625rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 8px">${c.label}</p>
          <p style="font-size:1.625rem;font-weight:900;color:${c.color};margin:0;line-height:1">${c.value}</p>
          ${c.sub ? `<p style="font-size:0.6875rem;color:var(--ui-text-3);margin:5px 0 0">${c.sub}</p>` : ''}
        `;
        grid.appendChild(div);
      });

      renderCharts(d);
    } catch (err: any) {
      toast.error('Error al cargar estadísticas', { description: err?.message });
      document.getElementById('overview-grid')!.innerHTML =
        `<div style="grid-column:1/-1;padding:1.5rem;text-align:center;color:var(--ui-text-3);font-size:0.875rem">No se pudieron cargar las estadísticas. Verifica la conexión con el servidor.</div>`;
    }
  }

  // ── Gráficas SVG (sin dependencias) ──────────────────────────
  function chartCard(title: string, subtitle: string, inner: string): string {
    return `<div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);padding:16px 18px;box-shadow:0 1px 4px var(--ui-shadow)">
      <p style="font-size:0.8125rem;font-weight:800;color:var(--ui-text-1);margin:0 0 2px">${title}</p>
      <p style="font-size:0.6875rem;color:var(--ui-text-3);margin:0 0 14px">${subtitle}</p>
      ${inner}</div>`;
  }

  function donut(segments: { label: string; value: number; color: string }[]): string {
    const total = segments.reduce((a, s) => a + s.value, 0) || 1;
    const R = 52, C = 2 * Math.PI * R;
    let offset = 0;
    const rings = segments.map(s => {
      const frac = s.value / total;
      const dash = `${(frac * C).toFixed(2)} ${(C - frac * C).toFixed(2)}`;
      const ring = `<circle cx="70" cy="70" r="${R}" fill="none" stroke="${s.color}" stroke-width="16"
        stroke-dasharray="${dash}" stroke-dashoffset="${(-offset * C).toFixed(2)}"
        transform="rotate(-90 70 70)" stroke-linecap="butt"></circle>`;
      offset += frac;
      return ring;
    }).join('');
    const legend = segments.map(s => {
      const pct = Math.round((s.value / total) * 100);
      return `<div style="display:flex;align-items:center;gap:7px;font-size:0.8125rem;color:var(--ui-text-2);margin:4px 0">
        <span style="width:10px;height:10px;border-radius:3px;background:${s.color};flex-shrink:0"></span>
        <span style="flex:1">${s.label}</span>
        <span style="font-size:0.6875rem;color:var(--ui-text-3)">${pct}%</span>
        <strong style="color:var(--ui-text-1);min-width:28px;text-align:right">${s.value}</strong>
      </div>`;
    }).join('');
    return `<div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
      <svg width="140" height="140" viewBox="0 0 140 140" style="flex-shrink:0">
        <circle cx="70" cy="70" r="52" fill="none" stroke="var(--ui-border)" stroke-width="16"></circle>
        ${rings}
        <text x="70" y="66" text-anchor="middle" style="font-size:22px;font-weight:900;fill:var(--ui-text-1)">${total}</text>
        <text x="70" y="84" text-anchor="middle" style="font-size:9px;fill:var(--ui-text-3)">TOTAL</text>
      </svg>
      <div style="flex:1;min-width:120px">${legend}</div></div>`;
  }

  function bars(items: { label: string; value: number; color: string }[]): string {
    const max = Math.max(1, ...items.map(i => i.value));
    return `<div style="display:flex;flex-direction:column;gap:10px">` + items.map(i =>
      `<div>
        <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--ui-text-2);margin-bottom:4px">
          <span>${i.label}</span><strong style="color:var(--ui-text-1)">${i.value}</strong></div>
        <div style="height:9px;background:var(--ui-surface);border-radius:5px;overflow:hidden;border:1px solid var(--ui-border)">
          <div style="height:100%;width:${(i.value / max * 100).toFixed(1)}%;background:${i.color};border-radius:5px;transition:width 0.6s ease"></div>
        </div></div>`).join('') + `</div>`;
  }

  function gauge(label: string, pct: number, color: string): string {
    const R = 46, C = Math.PI * R;
    const v = Math.max(0, Math.min(100, pct));
    const dash = `${(v / 100 * C).toFixed(2)} ${C.toFixed(2)}`;
    const level = v >= 70 ? 'Bueno' : v >= 50 ? 'Regular' : 'Bajo';
    return `<div style="text-align:center">
      <svg width="130" height="78" viewBox="0 0 130 78">
        <path d="M 19 65 A 46 46 0 0 1 111 65" fill="none" stroke="var(--ui-border)" stroke-width="11" stroke-linecap="round"></path>
        <path d="M 19 65 A 46 46 0 0 1 111 65" fill="none" stroke="${color}" stroke-width="11" stroke-linecap="round"
          stroke-dasharray="${dash}"></path>
        <text x="65" y="60" text-anchor="middle" style="font-size:21px;font-weight:900;fill:${color}">${v.toFixed(0)}%</text>
      </svg>
      <p style="font-size:0.8125rem;font-weight:700;color:var(--ui-text-1);margin:0">${label}</p>
      <span style="font-size:0.6875rem;padding:2px 8px;border-radius:20px;background:${color}18;color:${color};font-weight:700">${level}</span>
    </div>`;
  }

  function renderCharts(d: AdminOverview) {
    const grid = document.getElementById('charts-grid');
    if (!grid) return;
    const avg = d.avgScore ?? 0, sat = d.satisfactionRate ?? 0;
    grid.innerHTML = [
      chartCard('Distribución de estudiantes', 'Activos vs inactivos en la plataforma', donut([
        { label: 'Activos',   value: d.activeStudents,   color: '#059669' },
        { label: 'Inactivos', value: d.inactiveStudents, color: '#D4D4D4' },
      ])),
      chartCard('Actividad de la plataforma', 'Intentos, sesiones y tests en el sistema', bars([
        { label: 'Intentos finalizados', value: d.finishedTrieds,   color: '#D41224' },
        { label: 'En progreso',          value: d.inProgressTrieds, color: '#D97706' },
        { label: 'Sesiones IA',          value: d.totalAiSessions,  color: '#6366F1' },
        { label: 'Tests disponibles',    value: d.totalTests,       color: '#2563EB' },
      ])),
      chartCard('Indicadores de calidad', 'Puntaje promedio y satisfacción IRT',
        `<div style="display:flex;justify-content:space-around;align-items:flex-start;flex-wrap:wrap;gap:12px;padding-top:4px">
          ${gauge('Puntaje promedio', avg, avg >= 60 ? '#059669' : '#DC2626')}
          ${gauge('Nivel de rendimiento', sat, '#D41224')}
        </div>`),
    ].join('');
  }

  // ── Rendimiento de estudiantes ───────────────────────────────
  let allPerf: StudentPerf[] = [];

  async function loadPerformance() {
    try {
      const res = await apiFetch<StudentPerf[]>('/api/stats/admin/student-performance');
      allPerf = res.data ?? [];
      renderPerf(allPerf);
    } catch (err: any) {
      document.getElementById('perf-tbody')!.innerHTML =
        `<tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Error al cargar: ${err?.message}</td></tr>`;
    }
  }

  function renderPerf(data: StudentPerf[]) {
    const tbody = document.getElementById('perf-tbody')!;
    tbody.innerHTML = '';
    if (!data.length) {
      tbody.innerHTML = `<tr><td colspan="7" style="padding:3rem;text-align:center">
        <div style="display:inline-flex;flex-direction:column;align-items:center;gap:8px">
          <svg width="36" height="36" fill="none" stroke="var(--ui-text-3)" stroke-width="1.5" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          <p style="font-size:0.875rem;font-weight:700;color:var(--ui-text-1);margin:0">Sin datos de rendimiento</p>
          <p style="font-size:0.8125rem;color:var(--ui-text-3);margin:0">Los estudiantes aún no han completado tests.</p>
        </div>
      </td></tr>`;
      return;
    }
    data.forEach((s, idx) => {
      const score    = s.avgScore ?? 0;
      const accuracy = s.accuracyRate ?? 0;
      const barColor = score >= 70 ? '#059669' : score >= 50 ? '#D97706' : '#DC2626';
      const rank     = idx + 1;
      const medal    = rank === 1 ? '1°' : rank === 2 ? '2°' : rank === 3 ? '3°' : `#${rank}`;
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="td" style="font-weight:700;color:var(--ui-text-3);font-size:0.8125rem">${medal}</td>
        <td class="td">
          <code style="background:var(--ui-surface);padding:2px 8px;border-radius:6px;font-size:0.8125rem;font-weight:700;color:var(--brand);border:1px solid var(--ui-border)">${s.studentId}</code>
        </td>
        <td class="td" style="text-align:center;font-weight:700">${s.totalTrieds}</td>
        <td class="td">
          <div style="display:flex;align-items:center;gap:8px">
            <div class="score-bar-wrap"><div class="score-bar" style="width:${Math.min(score,100)}%;background:${barColor}"></div></div>
            <span style="font-weight:800;color:${barColor};min-width:44px">${score.toFixed(1)}%</span>
          </div>
        </td>
        <td class="td">
          <span class="rp-badge ${accuracy>=70?'rp-badge-success':accuracy>=50?'rp-badge-warning':'rp-badge-danger'}">
            ${accuracy.toFixed(1)}%
          </span>
        </td>
        <td class="td" style="font-size:0.8125rem;color:var(--ui-text-2)">${s.totalCorrect} / ${s.totalQuestions}</td>
        <td class="td">
          <div style="display:flex;gap:2px;align-items:flex-end">
            ${Array.from({length:5}, (_,i) => `<div style="width:6px;height:${10+(i*4)}px;border-radius:2px;background:${i < Math.round(score/20) ? barColor : 'var(--ui-border)'}"></div>`).join('')}
          </div>
        </td>`;
      tbody.appendChild(tr);
    });
  }

  document.getElementById('search-student')?.addEventListener('input', e => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    renderPerf(allPerf.filter(s => s.studentId.toLowerCase().includes(q)));
  });

  // ── Tendencias de preguntas ──────────────────────────────────
  async function loadTrends(competenceId?: string) {
    const tbody = document.getElementById('trends-tbody')!;
    tbody.innerHTML = `<tr><td colspan="6" style="padding:1.5rem;text-align:center;color:var(--ui-text-3)">
      <div style="display:inline-flex;align-items:center;gap:8px">
        <div style="width:16px;height:16px;border:2px solid rgba(212,18,36,0.2);border-top-color:var(--brand);border-radius:50%;animation:spin 0.7s linear infinite"></div> Cargando...
      </div>
    </td></tr>`;
    try {
      const qs  = competenceId ? `?competenceId=${competenceId}` : '';
      const res = await apiFetch<QuestionTrend[]>(`/api/stats/admin/question-trends${qs}`);
      const data = res.data ?? [];
      tbody.innerHTML = '';
      if (!data.length) {
        tbody.innerHTML = `<tr><td colspan="6" style="padding:2.5rem;text-align:center">
          <div style="display:inline-flex;flex-direction:column;align-items:center;gap:8px">
            <svg width="36" height="36" fill="none" stroke="var(--ui-text-3)" stroke-width="1.5" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <p style="font-size:0.875rem;font-weight:700;color:var(--ui-text-1);margin:0">Sin datos de respuestas</p>
            <p style="font-size:0.8125rem;color:var(--ui-text-3);margin:0">Los estudiantes aún no han respondido preguntas de esta competencia.</p>
          </div>
        </td></tr>`;
        return;
      }
      data.slice(0, 50).forEach(q => {
        const er    = q.errorRate ?? 0;
        const color = er >= 70 ? '#DC2626' : er >= 40 ? '#D97706' : '#059669';
        const label = er >= 70 ? 'Alta' : er >= 40 ? 'Media' : 'Baja';
        const badgeClass = er >= 70 ? 'rp-badge-danger' : er >= 40 ? 'rp-badge-warning' : 'rp-badge-success';
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="td">
            <code style="background:var(--ui-surface);padding:2px 8px;border-radius:6px;font-size:0.75rem;font-weight:700;color:var(--brand);border:1px solid var(--ui-border)">${q.questionId}</code>
          </td>
          <td class="td" style="max-width:260px;font-size:0.8125rem;color:var(--ui-text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${q.statement ?? ''}">${q.statement ?? '—'}</td>
          <td class="td" style="text-align:center;font-weight:700">${q.totalAnswers}</td>
          <td class="td" style="text-align:center;font-weight:700;color:#059669">${q.correctAnswers}</td>
          <td class="td">
            <div style="display:flex;align-items:center;gap:8px">
              <div class="score-bar-wrap"><div class="score-bar" style="width:${Math.min(er,100)}%;background:${color}"></div></div>
              <span style="font-weight:800;color:${color};min-width:44px">${er.toFixed(1)}%</span>
            </div>
          </td>
          <td class="td"><span class="rp-badge ${badgeClass}">${label}</span></td>`;
        tbody.appendChild(tr);
      });
    } catch (err: any) {
      tbody.innerHTML = `<tr><td colspan="6" style="padding:2rem;text-align:center;color:#DC2626;font-size:0.875rem">Error: ${err?.message}</td></tr>`;
    }
  }

  // Cargar competencias en el selector
  competencesApi.findAll(false).then(res => {
    const sel = document.getElementById('filter-competence') as HTMLSelectElement;
    (res.data ?? []).forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.competenceId;
      opt.textContent = c.competenceName;
      sel.appendChild(opt);
    });
  }).catch(() => {});

  document.getElementById('btn-load-trends')?.addEventListener('click', () => {
    const sel = document.getElementById('filter-competence') as HTMLSelectElement;
    loadTrends(sel.value || undefined);
  });

  // ── Tabs ─────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tab = btn.dataset.tab!;
      document.getElementById('tab-performance')!.style.display = tab === 'performance' ? 'block' : 'none';
      document.getElementById('tab-trends')!.style.display       = tab === 'trends'      ? 'block' : 'none';
    });
  });

  // ── Refresh ───────────────────────────────────────────────────
  document.getElementById('btn-refresh')?.addEventListener('click', () => {
    document.getElementById('overview-grid')!.innerHTML =
      Array(6).fill('<div class="ov-card skel-card"></div>').join('');
    document.getElementById('charts-grid')!.innerHTML = '';
    loadOverview();
    loadPerformance();
    toast.success('Estadísticas actualizadas');
  });

  // ── Init ─────────────────────────────────────────────────────
  loadOverview();
  loadPerformance();
</script>
