---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Gestión de Tests" currentPage="admin-tests">
  <div style="margin-bottom:1.25rem">
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--ui-text-3);margin-bottom:6px">
      <a href="/dashboard" style="color:var(--ui-text-3);text-decoration:none" onmouseover="this.style.color='var(--brand)'" onmouseout="this.style.color='var(--ui-text-3)'">Dashboard</a>
      <span>›</span><span style="color:var(--ui-text-1);font-weight:600">Tests</span>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
      <div>
        <h1 style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Tests</h1>
        <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Administra los simulacros disponibles en la plataforma.</p>
      </div>
      <button id="btn-new-test" style="display:inline-flex;align-items:center;gap:7px;padding:0.625rem 1.125rem;border-radius:10px;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-size:0.875rem;font-weight:700;border:none;cursor:pointer;font-family:inherit;box-shadow:0 3px 12px rgba(212,18,36,0.28)">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nuevo test
      </button>
    </div>
  </div>

  <!-- Filtros -->
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:1rem;align-items:center">
    <select id="filter-comp" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none">
      <option value="ALL">Todas las competencias</option>
    </select>
    <select id="filter-mode" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none">
      <option value="ALL">Todos los modos</option>
      <option value="PRACTICE">Práctica</option>
      <option value="EXAM">Examen</option>
      <option value="TIMED">Cronometrado</option>
    </select>
    <select id="filter-status" style="padding:7px 12px;border:1.5px solid var(--ui-border);border-radius:9px;background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;outline:none">
      <option value="ALL">Todos los estados</option>
      <option value="active">Activos</option>
      <option value="inactive">Inactivos</option>
    </select>
    <span id="count-label" style="font-size:0.8125rem;color:var(--ui-text-3);margin-left:auto"></span>
  </div>

  <!-- Tabla -->
  <div style="background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);overflow:hidden">
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse">
        <thead>
          <tr style="border-bottom:1px solid var(--ui-border)">
            <th class="th">ID</th>
            <th class="th">Nombre</th>
            <th class="th">Competencia</th>
            <th class="th">Modo</th>
            <th class="th">Duración</th>
            <th class="th">Preguntas</th>
            <th class="th">Estado</th>
            <th class="th">Acciones</th>
          </tr>
        </thead>
        <tbody id="tests-tbody">
          <tr><td colspan="8" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
    <div style="padding:0.875rem 1.25rem;border-top:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
      <span id="page-info" style="font-size:0.8125rem;color:var(--ui-text-3)"></span>
      <div style="display:flex;gap:6px">
        <button id="btn-prev" class="page-btn" disabled>← Anterior</button>
        <button id="btn-next" class="page-btn">Siguiente →</button>
      </div>
    </div>
  </div>
</AppLayout>

<!-- Modal crear test -->
<div id="create-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:20px;padding:2rem;max-width:480px;width:calc(100%-2rem);animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
      <h2 style="font-size:1.0625rem;font-weight:800;color:var(--ui-text-1);margin:0">Nuevo test</h2>
      <button id="modal-close" style="background:none;border:none;cursor:pointer;color:var(--ui-text-3);font-size:1.25rem;line-height:1">×</button>
    </div>
    <div id="create-error" style="display:none;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:10px 12px;font-size:0.8125rem;color:#B91C1C;margin-bottom:1rem"></div>
    <form id="create-form" novalidate>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:1rem">
        <div class="field-grp">
          <label class="field-lbl">Competencia *</label>
          <select id="c-comp" class="field-inp"><option value="">— Selecciona —</option></select>
        </div>
        <div class="field-grp">
          <label class="field-lbl">Nombre del test *</label>
          <input id="c-name" type="text" class="field-inp" placeholder="Ej: Simulacro Lectura Crítica I" maxlength="50" required />
        </div>
        <div class="field-grp">
          <label class="field-lbl">Descripción</label>
          <input id="c-desc" type="text" class="field-inp" placeholder="Descripción breve (opcional)" maxlength="100" />
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="field-grp">
            <label class="field-lbl">Modo *</label>
            <select id="c-mode" class="field-inp">
              <option value="PRACTICE">Práctica</option>
              <option value="EXAM">Examen</option>
              <option value="TIMED">Cronometrado</option>
            </select>
          </div>
          <div class="field-grp">
            <label class="field-lbl">Duración (min) *</label>
            <input id="c-dur" type="number" class="field-inp" min="1" value="60" required />
          </div>
          <div class="field-grp">
            <label class="field-lbl">Preguntas a presentar</label>
            <input id="c-qcount" type="number" class="field-inp" min="1" placeholder="Todas" />
          </div>
        </div>
      </div>
      <div style="display:flex;gap:8px">
        <button type="button" id="create-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
        <button type="submit" id="create-submit" style="flex:2;padding:0.6875rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(212,18,36,0.28)">
          <span id="create-label">Crear test</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Gestionar preguntas de un test (crear + ver existentes) -->
<div id="assoc-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:600;align-items:flex-start;justify-content:center;padding:2rem 1rem;overflow-y:auto;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:20px;width:100%;max-width:760px;overflow:hidden;animation:cardIn 0.3s ease both;box-shadow:0 20px 60px rgba(0,0,0,0.2)">

    <!-- Header -->
    <div style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between">
      <div>
        <h3 style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 2px">Gestionar preguntas del test</h3>
        <p id="assoc-test-name" style="font-size:0.75rem;color:var(--ui-text-3);margin:0"></p>
      </div>
      <button id="assoc-close" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--ui-border);background:var(--ui-surface);cursor:pointer;color:var(--ui-text-2);font-size:1rem;display:flex;align-items:center;justify-content:center">✕</button>
    </div>

    <!-- Tabs -->
    <div style="display:flex;border-bottom:1px solid var(--ui-border);padding:0 1.5rem">
      <button id="tab-existing" class="assoc-tab active" data-tab="existing">
        Preguntas asignadas <span id="assoc-count-badge" style="background:var(--brand);color:white;border-radius:20px;padding:1px 8px;font-size:0.625rem;font-weight:700;margin-left:6px">0</span>
      </button>
      <button id="tab-add" class="assoc-tab" data-tab="add">Agregar preguntas</button>
    </div>

    <!-- Panel: preguntas existentes -->
    <div id="panel-existing" style="padding:1rem 1.5rem">
      <div id="existing-list" style="display:flex;flex-direction:column;gap:6px;max-height:360px;overflow-y:auto"></div>
    </div>

    <!-- Panel: agregar preguntas -->
    <div id="panel-add" style="display:none;padding:0">
      <!-- Filtros -->
      <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--ui-border);display:flex;gap:10px;flex-wrap:wrap">
        <input id="assoc-search" type="text" placeholder="Buscar por enunciado..." style="flex:2;min-width:200px;padding:7px 10px;border-radius:8px;border:1.5px solid var(--ui-border);background:var(--ui-surface);font-family:inherit;font-size:0.8125rem;color:var(--ui-text-1);outline:none"/>
        <select id="assoc-filter-diff" style="flex:1;min-width:130px;padding:7px 10px;border-radius:8px;border:1.5px solid var(--ui-border);background:var(--ui-surface);font-family:inherit;font-size:0.8125rem;color:var(--ui-text-1)">
          <option value="ALL">Todas las dificultades</option>
          <option value="B">Básico</option>
          <option value="M">Medio</option>
          <option value="A">Alto</option>
        </select>
      </div>
      <!-- Lista -->
      <div id="assoc-question-list" style="max-height:320px;overflow-y:auto;padding:0.75rem 1.5rem;display:flex;flex-direction:column;gap:6px">
        <p style="font-size:0.875rem;color:var(--ui-text-3);text-align:center;padding:1.5rem">Cargando preguntas...</p>
      </div>
      <!-- Footer -->
      <div style="padding:1rem 1.5rem;border-top:1px solid var(--ui-border);display:flex;align-items:center;justify-content:space-between">
        <span id="assoc-selected-count" style="font-size:0.8125rem;color:var(--ui-text-3)">0 seleccionadas</span>
        <div style="display:flex;gap:8px">
          <button id="assoc-skip" style="padding:0.5rem 1rem;border-radius:9px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-2);font-family:inherit;font-weight:600;font-size:0.8125rem;cursor:pointer">Cerrar</button>
          <button id="assoc-save" style="padding:0.5rem 1.25rem;border-radius:9px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.8125rem;cursor:pointer;box-shadow:0 3px 10px rgba(212,18,36,0.25)">Agregar seleccionadas</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal toggle estado test -->
<div id="toggle-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:18px;padding:2rem;max-width:360px;width:calc(100%-2rem);text-align:center;animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div id="toggle-icon" style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem"></div>
    <h3 id="toggle-title" style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem"></h3>
    <p id="toggle-desc" style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.25rem;line-height:1.55"></p>
    <div style="display:flex;gap:8px">
      <button id="toggle-cancel" style="flex:1;padding:0.6875rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
      <button id="toggle-confirm" style="flex:1;padding:0.6875rem;border-radius:10px;border:none;color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Confirmar</button>
    </div>
  </div>
</div>

<style>
  @keyframes modalIn { from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)} }
  @keyframes cardIn  { from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)} }
  .th { padding:10px 14px;text-align:left;font-size:0.6875rem;font-weight:700;color:var(--ui-text-3);text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap }
  .td { padding:10px 14px;font-size:0.875rem;color:var(--ui-text-1);border-top:1px solid var(--ui-border) }
  .page-btn { padding:6px 14px;border-radius:8px;border:1.5px solid var(--ui-border);background:var(--ui-card);color:var(--ui-text-1);font-family:inherit;font-size:0.8125rem;font-weight:600;cursor:pointer;transition:all 0.15s }
  .page-btn:hover:not(:disabled) { border-color:var(--brand);color:var(--brand) }
  .page-btn:disabled { opacity:0.4;cursor:not-allowed }
  .field-grp { display:flex;flex-direction:column;gap:4px }
  .field-lbl { font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--ui-text-3) }
  .field-inp { padding:8px 12px;background:var(--ui-surface);border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;color:var(--ui-text-1);outline:none;transition:border-color 0.2s;width:100%;appearance:none }
  .field-inp:focus { border-color:var(--brand);box-shadow:0 0 0 3px rgba(212,18,36,0.1) }
  .assoc-tab {
    padding:10px 16px;border:none;background:transparent;font-family:inherit;font-size:0.8125rem;font-weight:600;color:var(--ui-text-3);cursor:pointer;border-bottom:2px solid transparent;transition:all 0.15s;
  }
  .assoc-tab.active { color:var(--brand);border-bottom-color:var(--brand); }
  .assoc-tab:hover:not(.active) { color:var(--ui-text-1); }
</style>

<script>
  import { requireAuth, isAdmin } from '../../lib/auth';
  import { testsApi }       from '../../lib/api/tests.api';
  import { competencesApi } from '../../lib/api/competences.api';
  import { toast }          from '../../lib/toast';
  import type { TestDto }   from '../../lib/api/types';

  const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';

  declare global {
    interface Window { rpLoader?: { show: (m?: string) => void; hide: () => void; } }
  }

  try {
    requireAuth();
    if (!isAdmin()) { window.location.replace('/dashboard'); throw new Error(); }
  } catch { throw new Error('redirect'); }

  const MODE_LABEL: Record<string, string> = { PRACTICE:'Práctica', EXAM:'Examen', TIMED:'Cronometrado' };
  const MODE_COLOR: Record<string, string> = { PRACTICE:'#059669', EXAM:'#2563EB', TIMED:'#D97706' };
  const MODE_BG:    Record<string, string> = { PRACTICE:'#D1FAE5', EXAM:'#DBEAFE', TIMED:'#FEF3C7' };

  let page = 0;
  const SIZE = 15;
  let totalPages = 1;
  let allTests: TestDto[] = [];
  let filteredTests: TestDto[] = [];
  let competenceMap: Record<string, string> = {};
  let pendingToggle = { testId: '', competenceId: '', activate: false };

  // ── Competencias ──────────────────────────────────────────────────────
  competencesApi.findAll(false).then(res => {
    if (!res.data) return;
    res.data.forEach(c => { competenceMap[c.competenceId] = c.competenceName; });
    const filterSel = document.getElementById('filter-comp') as HTMLSelectElement;
    const formSel   = document.getElementById('c-comp')      as HTMLSelectElement;
    res.data.forEach(c => {
      [filterSel, formSel].forEach(sel => {
        const opt = document.createElement('option');
        opt.value = c.competenceId;
        opt.textContent = c.competenceName;
        sel.appendChild(opt);
      });
    });
  }).catch(() => {});

  // ── Filtros ───────────────────────────────────────────────────────────
  function applyFilters() {
    const comp   = (document.getElementById('filter-comp') as HTMLSelectElement).value;
    const mode   = (document.getElementById('filter-mode') as HTMLSelectElement).value;
    const status = (document.getElementById('filter-status') as HTMLSelectElement).value;
    filteredTests = allTests.filter(t =>
      (comp === 'ALL'   || t.competenceId === comp) &&
      (mode === 'ALL'   || t.testMode === mode) &&
      (status === 'ALL' || (status === 'active' && t.isActive) || (status === 'inactive' && !t.isActive))
    );
    const countEl = document.getElementById('count-label');
    if (countEl) countEl.textContent = `${filteredTests.length} test(s)`;
    renderTable();
  }

  async function loadPage() {
    try {
      const res = await testsApi.findAll(page, SIZE);
      if (!res.data) return;
      allTests   = res.data.content;
      totalPages = res.data.totalPages;
      (document.getElementById('page-info') as HTMLElement).textContent = `Pág. ${page + 1} de ${totalPages || 1}`;
      (document.getElementById('btn-prev') as HTMLButtonElement).disabled = page === 0;
      (document.getElementById('btn-next') as HTMLButtonElement).disabled = page >= totalPages - 1;
      applyFilters();
    } catch (err: any) {
      toast.error('Error al cargar tests', { description: err?.message });
    }
  }

  function renderTable() {
    const tbody = document.getElementById('tests-tbody')!;
    tbody.innerHTML = '';
    if (!filteredTests.length) {
      tbody.innerHTML = '<tr><td colspan="8" style="padding:2rem;text-align:center;color:var(--ui-text-3)">Sin resultados</td></tr>';
      return;
    }
    filteredTests.forEach(t => {
      const durMin    = Math.floor(t.durationSeconds / 60);
      const compName  = t.competenceName ?? competenceMap[t.competenceId] ?? t.competenceId;
      const tr        = document.createElement('tr');
      tr.innerHTML = `
        <td class="td"><code style="background:var(--ui-surface);padding:2px 7px;border-radius:5px;font-size:0.75rem;font-family:monospace">${t.testId}</code></td>
        <td class="td" style="font-weight:600;max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${t.testName}">${t.testName}</td>
        <td class="td" style="font-size:0.8125rem;color:var(--ui-text-2)">${compName}</td>
        <td class="td"><span style="padding:3px 9px;border-radius:12px;font-size:0.6875rem;font-weight:700;background:${MODE_BG[t.testMode]??'#F3F4F6'};color:${MODE_COLOR[t.testMode]??'#6B7280'}">${MODE_LABEL[t.testMode]??t.testMode}</span></td>
        <td class="td" style="font-size:0.8125rem">${durMin} min</td>
        <td class="td" style="font-size:0.8125rem">${t.questionsToPresent ?? '—'}</td>
        <td class="td"><span style="padding:3px 9px;border-radius:12px;font-size:0.6875rem;font-weight:700;background:${t.isActive?'#D1FAE5':'#FEE2E2'};color:${t.isActive?'#059669':'#DC2626'}">${t.isActive?'Activo':'Inactivo'}</span></td>
        <td class="td">
          <div style="display:flex;gap:5px;flex-wrap:wrap">
            <button class="action-btn btn-manage" data-test="${t.testId}" data-comp="${t.competenceId}" data-name="${t.testName.replace(/"/g,'&quot;')}"
              style="padding:4px 10px;border-radius:7px;border:1.5px solid var(--ui-border-2);background:var(--ui-surface);color:var(--ui-text-1);font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit">
              ✏️ Preguntas
            </button>
            <button class="action-btn btn-toggle" data-test="${t.testId}" data-comp="${t.competenceId}" data-name="${t.testName.replace(/"/g,'&quot;')}" data-active="${t.isActive}"
              style="padding:4px 10px;border-radius:7px;border:1.5px solid ${t.isActive?'#FECACA':'#A7F3D0'};background:${t.isActive?'#FEF2F2':'#D1FAE5'};color:${t.isActive?'#DC2626':'#059669'};font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit">
              ${t.isActive ? '⏸ Desactivar' : '▶ Activar'}
            </button>
          </div>
        </td>`;
      tbody.appendChild(tr);
    });

    // Gestionar preguntas
    document.querySelectorAll<HTMLButtonElement>('.btn-manage').forEach(btn => {
      btn.addEventListener('click', () => {
        openAssocModal(btn.dataset.test!, btn.dataset.comp!, btn.dataset.name!);
      });
    });

    // Toggle activar/desactivar
    document.querySelectorAll<HTMLButtonElement>('.btn-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const isActive = btn.dataset.active === 'true';
        pendingToggle = { testId: btn.dataset.test!, competenceId: btn.dataset.comp!, activate: !isActive };
        const icon    = document.getElementById('toggle-icon')!;
        const title   = document.getElementById('toggle-title')!;
        const desc    = document.getElementById('toggle-desc')!;
        const confirm = document.getElementById('toggle-confirm') as HTMLButtonElement;
        if (isActive) {
          icon.style.background = '#FEE2E2';
          icon.innerHTML = '<svg width="24" height="24" fill="none" stroke="#DC2626" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
          title.textContent = '¿Desactivar test?';
          desc.textContent  = `"${btn.dataset.name}" no estará disponible para nuevos intentos.`;
          confirm.style.background = 'linear-gradient(135deg,#DC2626,#991B1B)';
        } else {
          icon.style.background = '#D1FAE5';
          icon.innerHTML = '<svg width="24" height="24" fill="none" stroke="#059669" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>';
          title.textContent = '¿Activar test?';
          desc.textContent  = `"${btn.dataset.name}" estará disponible para los estudiantes.`;
          confirm.style.background = 'linear-gradient(135deg,#059669,#047857)';
        }
        (document.getElementById('toggle-modal') as HTMLElement).style.display = 'flex';
      });
    });
  }

  ['filter-comp','filter-mode','filter-status'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', applyFilters);
  });

  document.getElementById('btn-prev')?.addEventListener('click', () => { if (page > 0) { page--; loadPage(); } });
  document.getElementById('btn-next')?.addEventListener('click', () => { if (page < totalPages - 1) { page++; loadPage(); } });

  // ── Toggle modal ──────────────────────────────────────────────────────
  const toggleModal = document.getElementById('toggle-modal')!;
  document.getElementById('toggle-cancel')?.addEventListener('click', () => { toggleModal.style.display = 'none'; });
  toggleModal.addEventListener('click', e => { if (e.target === toggleModal) toggleModal.style.display = 'none'; });
  document.getElementById('toggle-confirm')?.addEventListener('click', async () => {
    toggleModal.style.display = 'none';
    window.rpLoader?.show(pendingToggle.activate ? 'Activando test...' : 'Desactivando test...');
    try {
      if (!pendingToggle.activate) {
        await testsApi.deactivate(pendingToggle.testId, pendingToggle.competenceId);
        toast.success('Test desactivado');
      } else {
        // Activar: usar un endpoint PUT o update si existe, sino toggle via API custom
        // Como el backend solo tiene deactivate (DELETE), necesitamos un endpoint de activación
        // Por ahora hacemos un PUT simulado
        const token = localStorage.getItem('rp_token');
        const res = await fetch(`${apiBase}/api/tests/${pendingToggle.testId}/${pendingToggle.competenceId}/activate`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) {
          const j = await res.json().catch(() => ({}));
          throw new Error(j.message || 'No se pudo activar');
        }
        toast.success('Test activado');
      }
      loadPage();
    } catch (err: any) {
      toast.error('Error', { description: err?.message });
    } finally {
      window.rpLoader?.hide();
    }
  });

  // ── Create modal ──────────────────────────────────────────────────────
  const createModal = document.getElementById('create-modal')!;
  document.getElementById('btn-new-test')?.addEventListener('click',  () => { createModal.style.display = 'flex'; });
  document.getElementById('modal-close')?.addEventListener('click',   () => { createModal.style.display = 'none'; });
  document.getElementById('create-cancel')?.addEventListener('click', () => { createModal.style.display = 'none'; });
  createModal.addEventListener('click', e => { if (e.target === createModal) createModal.style.display = 'none'; });

  document.getElementById('create-form')?.addEventListener('submit', async e => {
    e.preventDefault();
    const errEl  = document.getElementById('create-error')!;
    const lblEl  = document.getElementById('create-label')!;
    const submit = document.getElementById('create-submit') as HTMLButtonElement;
    errEl.style.display = 'none';

    const competenceId       = (document.getElementById('c-comp') as HTMLSelectElement).value;
    const testName           = (document.getElementById('c-name') as HTMLInputElement).value.trim();
    const description        = (document.getElementById('c-desc') as HTMLInputElement).value.trim() || undefined;
    const testMode           = (document.getElementById('c-mode') as HTMLSelectElement).value;
    const durMin             = Number((document.getElementById('c-dur') as HTMLInputElement).value);
    const questionsToPresent = Number((document.getElementById('c-qcount') as HTMLInputElement).value) || undefined;

    if (!competenceId || !testName || durMin < 1) {
      errEl.textContent = 'Completa los campos obligatorios.';
      errEl.style.display = 'block'; return;
    }

    submit.disabled = true; lblEl.textContent = 'Creando...';
    window.rpLoader?.show('Creando test...');
    try {
      const res = await testsApi.create({ competenceId, testName, description, durationSeconds: durMin * 60, questionsToPresent, testMode });
      const t = res.data!;
      toast.success('Test creado. Ahora agrega preguntas.');
      createModal.style.display = 'none';
      (document.getElementById('create-form') as HTMLFormElement).reset();
      await loadPage();
      openAssocModal(t.testId, t.competenceId, t.testName);
    } catch (err: any) {
      errEl.textContent = err?.message ?? 'Error al crear test.';
      errEl.style.display = 'block';
    } finally {
      submit.disabled = false; lblEl.textContent = 'Crear test';
      window.rpLoader?.hide();
    }
  });

  // ══════════════════════════════════════════════════════════════════
  //  MODAL GESTIONAR PREGUNTAS
  // ══════════════════════════════════════════════════════════════════
  let assocTestId  = '';
  let assocCompId  = '';
  let assocSelected = new Set<string>();
  let allAvailableQuestions: any[] = [];
  let assignedQuestionIds = new Set<string>();

  async function openAssocModal(testId: string, compId: string, testName: string) {
    assocTestId   = testId;
    assocCompId   = compId;
    assocSelected.clear();
    document.getElementById('assoc-test-name')!.textContent = testName;
    document.getElementById('assoc-modal')!.style.display   = 'flex';
    document.getElementById('assoc-selected-count')!.textContent = '0 seleccionadas';
    (document.getElementById('assoc-search') as HTMLInputElement).value = '';
    switchAssocTab('existing');
    await loadExistingQuestions();
    await loadAvailableQuestions();
  }

  async function loadExistingQuestions() {
    const listEl = document.getElementById('existing-list')!;
    const badge  = document.getElementById('assoc-count-badge')!;
    listEl.innerHTML = '<p style="font-size:0.875rem;color:var(--ui-text-3);text-align:center;padding:1rem">Cargando...</p>';
    try {
      const token = localStorage.getItem('rp_token');
      const res   = await fetch(`${apiBase}/api/tests/${assocTestId}/${assocCompId}/questions`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const json = await res.json();
      const questions: any[] = json.data ?? [];

      assignedQuestionIds = new Set(questions.map((q: any) => q.questionId));
      badge.textContent   = String(questions.length);

      listEl.innerHTML = '';
      if (!questions.length) {
        listEl.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--ui-text-3)"><p style="font-size:0.875rem;font-weight:600;margin:0 0 4px">Sin preguntas asignadas</p><p style="font-size:0.8125rem">Usa la pestaña "Agregar preguntas" para añadir.</p></div>';
        return;
      }

      const diffMap: Record<string, string> = { B:'Básico', M:'Medio', A:'Alto' };
      const diffColors: Record<string, string> = { B:'#059669', M:'#D97706', A:'#DC2626' };

      questions.forEach((q: any, i: number) => {
        const diff = q.difficultyLevel ?? 'M';
        const row  = document.createElement('div');
        row.style.cssText = 'display:flex;align-items:flex-start;gap:10px;padding:10px 12px;border-radius:10px;border:1px solid var(--ui-border);background:var(--ui-surface)';
        row.innerHTML = `
          <span style="min-width:22px;height:22px;border-radius:5px;background:var(--brand-pale);color:var(--brand);font-size:0.625rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px">${i+1}</span>
          <div style="flex:1;min-width:0">
            <p style="font-size:0.8125rem;color:var(--ui-text-1);margin:0 0 4px;line-height:1.5">${(q.statement ?? '').substring(0,120)}${(q.statement?.length??0)>120?'…':''}</p>
            <span style="font-size:0.625rem;font-weight:700;padding:2px 8px;border-radius:10px;color:${diffColors[diff]};background:${diffColors[diff]}1A">${diffMap[diff]??diff}</span>
          </div>
          <button class="btn-remove-q" data-qid="${q.questionId}" style="flex-shrink:0;padding:4px 10px;border-radius:7px;border:1.5px solid #FECACA;background:#FEF2F2;color:#DC2626;font-size:0.75rem;font-weight:600;cursor:pointer;font-family:inherit;white-space:nowrap">Quitar</button>`;
        listEl.appendChild(row);
      });

      document.querySelectorAll<HTMLButtonElement>('.btn-remove-q').forEach(btn => {
        btn.addEventListener('click', async () => {
          const qid = btn.dataset.qid!;
          btn.disabled = true; btn.textContent = '...';
          try {
            await testsApi.removeQuestion(assocTestId, assocCompId, qid);
            toast.success('Pregunta quitada del test');
            await loadExistingQuestions();
            await loadAvailableQuestions();
          } catch (err: any) {
            toast.error('Error', { description: err?.message });
            btn.disabled = false; btn.textContent = 'Quitar';
          }
        });
      });
    } catch (err) {
      listEl.innerHTML = '<p style="color:#DC2626;text-align:center;padding:1rem;font-size:0.875rem">Error al cargar preguntas asignadas</p>';
    }
  }

  async function loadAvailableQuestions() {
    const list = document.getElementById('assoc-question-list')!;
    list.innerHTML = '<p style="font-size:0.875rem;color:var(--ui-text-3);text-align:center;padding:1.5rem">Cargando...</p>';
    try {
      const token = localStorage.getItem('rp_token');
      const res   = await fetch(`${apiBase}/api/competences/${assocCompId}/questions?page=0&size=200`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const json = await res.json();
      allAvailableQuestions = (json.data?.content ?? []).filter((q: any) => q.isActive !== false);
      renderAvailableQuestions();
    } catch {
      list.innerHTML = '<p style="color:#DC2626;text-align:center;padding:1.5rem;font-size:0.875rem">Error al cargar preguntas</p>';
    }
  }

  function renderAvailableQuestions() {
    const list    = document.getElementById('assoc-question-list')!;
    const search  = (document.getElementById('assoc-search') as HTMLInputElement).value.toLowerCase();
    const diff    = (document.getElementById('assoc-filter-diff') as HTMLSelectElement).value;

    const filtered = allAvailableQuestions.filter(q => {
      const matchSearch = !search || (q.statement ?? '').toLowerCase().includes(search);
      const matchDiff   = diff === 'ALL' || q.difficultyLevel === diff;
      const notAssigned = !assignedQuestionIds.has(q.questionId);
      return matchSearch && matchDiff && notAssigned;
    });

    if (!filtered.length) {
      list.innerHTML = '<p style="font-size:0.875rem;color:var(--ui-text-3);text-align:center;padding:1.5rem">No hay preguntas disponibles para agregar.</p>';
      return;
    }

    list.innerHTML = '';
    const diffMap: Record<string, string>    = { B:'Básico', M:'Medio', A:'Alto' };
    const diffColors: Record<string, string> = { B:'#059669', M:'#D97706', A:'#DC2626' };

    filtered.forEach(q => {
      const checked = assocSelected.has(q.questionId);
      const diff    = q.difficultyLevel ?? 'M';
      const row     = document.createElement('label');
      row.style.cssText = `display:flex;align-items:flex-start;gap:10px;padding:10px 12px;border-radius:10px;border:1.5px solid ${checked ? 'var(--brand)' : 'var(--ui-border)'};background:${checked ? 'rgba(212,18,36,0.04)' : 'var(--ui-surface)'};cursor:pointer;transition:all 0.15s`;

      row.innerHTML = `
        <input type="checkbox" data-qid="${q.questionId}" ${checked ? 'checked' : ''}
          style="margin-top:3px;accent-color:var(--brand);width:15px;height:15px;flex-shrink:0" />
        <div style="flex:1;min-width:0">
          <p style="font-size:0.8125rem;color:var(--ui-text-1);margin:0 0 4px;line-height:1.5;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">
            ${q.statement ?? 'Sin enunciado'}
          </p>
          <span style="font-size:0.625rem;font-weight:700;padding:2px 8px;border-radius:10px;color:${diffColors[diff]};background:${diffColors[diff]}1A">${diffMap[diff]??diff}</span>
        </div>`;

      row.querySelector('input')?.addEventListener('change', (e) => {
        const chk = e.target as HTMLInputElement;
        if (chk.checked) assocSelected.add(q.questionId);
        else             assocSelected.delete(q.questionId);
        row.style.borderColor = chk.checked ? 'var(--brand)' : 'var(--ui-border)';
        row.style.background  = chk.checked ? 'rgba(212,18,36,0.04)' : 'var(--ui-surface)';
        document.getElementById('assoc-selected-count')!.textContent =
          `${assocSelected.size} seleccionada(s)`;
      });
      list.appendChild(row);
    });
  }

  // Tabs
  function switchAssocTab(tab: 'existing' | 'add') {
    document.getElementById('tab-existing')!.classList.toggle('active', tab === 'existing');
    document.getElementById('tab-add')!.classList.toggle('active', tab === 'add');
    document.getElementById('panel-existing')!.style.display = tab === 'existing' ? 'block' : 'none';
    document.getElementById('panel-add')!.style.display      = tab === 'add'      ? 'flex' : 'none';
    (document.getElementById('panel-add') as HTMLElement).style.flexDirection = 'column';
  }

  document.getElementById('tab-existing')?.addEventListener('click', () => switchAssocTab('existing'));
  document.getElementById('tab-add')?.addEventListener('click',      () => switchAssocTab('add'));

  // Filtros en tiempo real
  document.getElementById('assoc-filter-diff')?.addEventListener('change', renderAvailableQuestions);
  let searchDebounce: ReturnType<typeof setTimeout>;
  document.getElementById('assoc-search')?.addEventListener('input', () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(renderAvailableQuestions, 250);
  });

  // Cerrar
  document.getElementById('assoc-close')?.addEventListener('click', async () => {
    document.getElementById('assoc-modal')!.style.display = 'none';
    await loadPage();
  });
  document.getElementById('assoc-skip')?.addEventListener('click', async () => {
    document.getElementById('assoc-modal')!.style.display = 'none';
    await loadPage();
  });

  // Guardar asociaciones
  document.getElementById('assoc-save')?.addEventListener('click', async () => {
    if (!assocSelected.size) {
      toast.warning('Selecciona al menos una pregunta');
      return;
    }
    window.rpLoader?.show('Asociando preguntas...');
    try {
      for (const questionId of assocSelected) {
        await testsApi.addQuestion(assocTestId, assocCompId, questionId);
      }
      toast.success(`${assocSelected.size} pregunta(s) agregadas`);
      assocSelected.clear();
      document.getElementById('assoc-selected-count')!.textContent = '0 seleccionadas';
      await loadExistingQuestions();
      await loadAvailableQuestions();
      switchAssocTab('existing');
    } catch (err: any) {
      toast.error('Error al agregar preguntas', { description: err?.message });
    } finally {
      window.rpLoader?.hide();
    }
  });

  loadPage();
</script>