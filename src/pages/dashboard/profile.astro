---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Mi perfil" currentPage="profile" requiredRole="STUDENT">
<style>
  @keyframes fadeUp { from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)} }

  .pro-wrap { display:flex;flex-direction:column;gap:1rem;animation:fadeUp 0.4s ease both; }

  /* ── Hero card ───────────────────────────────────── */
  .hero-card {
    background:var(--ui-card);border-radius:20px;border:1px solid var(--ui-border);
    overflow:hidden;position:relative;
  }
  .hero-banner {
    height:100px;background:linear-gradient(135deg,var(--brand) 0%,var(--brand-dark) 60%,#6B1318 100%);
    position:relative;overflow:hidden;
  }
  .hero-banner::before {
    content:'';position:absolute;right:-60px;top:-60px;
    width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,0.07);
  }
  .hero-banner::after {
    content:'';position:absolute;left:40%;bottom:-40px;
    width:160px;height:160px;border-radius:50%;background:rgba(255,255,255,0.04);
  }
  .hero-body {
    padding:0 1.75rem 1.5rem;
    display:flex;align-items:flex-end;gap:1.25rem;flex-wrap:wrap;
  }
  .hero-avatar-wrap { margin-top:-36px;position:relative;flex-shrink:0; }
  .hero-avatar {
    width:72px;height:72px;border-radius:18px;
    background:linear-gradient(135deg,var(--brand),var(--brand-dark));
    border:3px solid var(--ui-card);
    display:flex;align-items:center;justify-content:center;
    color:white;font-weight:900;font-size:1.5rem;
    font-family:var(--font-ui);
    box-shadow:0 6px 20px rgba(0,0,0,0.15);
  }
  .hero-online {
    position:absolute;bottom:0;right:0;
    width:16px;height:16px;border-radius:50%;background:#22c55e;
    border:2.5px solid var(--ui-card);
  }
  .hero-info { flex:1;min-width:180px;padding-top:0.75rem; }
  .hero-name {
    font-size:1.25rem;font-weight:900;color:var(--ui-text-1);
    margin:0 0 4px;letter-spacing:-0.4px;line-height:1.2;
  }
  .hero-meta {
    display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  }
  .hero-role {
    display:inline-flex;align-items:center;gap:5px;
    padding:3px 10px;border-radius:20px;
    font-size:0.6875rem;font-weight:700;
    font-family:var(--font-ui);
  }
  .hero-email {
    font-size:0.8125rem;color:var(--ui-text-3);
    font-family:var(--font-ui);
  }

  /* ── Info list ───────────────────────────────────── */
  .info-card {
    background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);
    overflow:hidden;
  }
  .info-section-title {
    padding:0.875rem 1.25rem;
    font-size:0.625rem;font-weight:700;text-transform:uppercase;
    letter-spacing:0.08em;color:var(--ui-text-3);
    border-bottom:1px solid var(--ui-border);
    font-family:var(--font-ui);
    background:var(--ui-surface);
  }
  .info-row {
    display:flex;align-items:center;justify-content:space-between;
    padding:0.875rem 1.25rem;border-bottom:1px solid var(--ui-border);gap:12px;
  }
  .info-row:last-child { border-bottom:none; }
  .info-key {
    font-size:0.8125rem;font-weight:500;color:var(--ui-text-3);
    font-family:var(--font-ui);flex-shrink:0;min-width:120px;
  }
  .info-val {
    font-size:0.875rem;font-weight:600;color:var(--ui-text-1);
    text-align:right;word-break:break-all;
  }
  .info-mono {
    font-family:var(--font-mono);
    background:var(--ui-surface);padding:2px 8px;border-radius:6px;
    border:1px solid var(--ui-border);font-size:0.8125rem;
  }


  /* ── Sesión ──────────────────────────────────────── */
  .sess-bar-wrap { height:5px;background:var(--ui-border);border-radius:3px;overflow:hidden;margin-top:6px; }
  .sess-bar      { height:100%;border-radius:3px;transition:width 1s; }

  /* ── Grid dos columnas ───────────────────────────── */
  .pro-grid { display:grid;grid-template-columns:1fr 1fr;gap:1rem; }
  @media(max-width:720px){ .pro-grid{ grid-template-columns:1fr; } }
</style>

<div class="pro-wrap">

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <div class="hero-card">
    <div class="hero-banner"></div>
    <div class="hero-body">
      <div class="hero-avatar-wrap">
        <div class="hero-avatar" id="hero-av">?</div>
        <div class="hero-online"></div>
      </div>
      <div class="hero-info">
        <h1 class="hero-name" id="hero-name">Cargando...</h1>
        <div class="hero-meta">
          <span class="hero-role" id="hero-role" style="background:rgba(212,18,36,0.1);color:var(--brand)"></span>
          <span class="hero-email" id="hero-email"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Grid de info ──────────────────────────────────────── -->
  <div class="pro-grid">

    <!-- Columna 1: Datos de la cuenta -->
    <div class="info-card">
      <p class="info-section-title">Cuenta</p>

      <div class="info-row">
        <span class="info-key">Nombre</span>
        <span class="info-val" id="d-name">-</span>
      </div>
      <div class="info-row">
        <span class="info-key">Correo</span>
        <span class="info-val" id="d-email" style="font-size:0.8125rem">-</span>
      </div>
      <div class="info-row" id="row-phone" style="display:none">
        <span class="info-key">Teléfono</span>
        <span class="info-val info-mono" id="d-phone">-</span>
      </div>
      <div class="info-row">
        <span class="info-key" id="lbl-code">Código</span>
        <span class="info-val info-mono" id="d-code">-</span>
      </div>
      <div class="info-row" id="row-program" style="display:none">
        <span class="info-key">Programa</span>
        <span class="info-val" id="d-program" style="text-align:right;font-family:var(--font-ui);font-size:0.8125rem">-</span>
      </div>
      <div class="info-row" id="row-lastlogin" style="display:none">
        <span class="info-key">Último acceso</span>
        <span class="info-val" id="d-lastlogin" style="font-size:0.8125rem">-</span>
      </div>
    </div>

    <!-- Columna 2: Estado + Sesión -->
    <div style="display:flex;flex-direction:column;gap:1rem">


      <!-- Sesión JWT -->
      <div class="info-card">
        <p class="info-section-title">Sesión actual</p>
        <div class="info-row">
          <span class="info-key">Estado</span>
          <span id="sess-badge"></span>
        </div>
        <div class="info-row">
          <span class="info-key">Inició</span>
          <span class="info-val" id="jwt-iat" style="font-size:0.8125rem">-</span>
        </div>
        <div class="info-row" style="flex-direction:column;align-items:flex-start;gap:6px">
          <div style="display:flex;justify-content:space-between;width:100%">
            <span class="info-key">Tiempo restante</span>
            <span id="jwt-remain" style="font-size:0.8125rem;font-weight:700;color:var(--ui-text-1);font-family:var(--font-ui)">-</span>
          </div>
          <div class="sess-bar-wrap" style="width:100%">
            <div class="sess-bar" id="sess-fill"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- ── Editar mi información ── -->
<div style="max-width:640px;margin:1.25rem auto 0;background:var(--ui-card);border:1px solid var(--ui-border);border-radius:16px;padding:1.5rem">
  <div style="display:flex;align-items:center;gap:10px">
    <div style="width:36px;height:36px;border-radius:9px;background:var(--brand-pale);display:flex;align-items:center;justify-content:center;flex-shrink:0">
      <svg width="18" height="18" fill="none" stroke="var(--brand)" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
    </div>
    <div style="flex:1;min-width:0">
      <h2 style="font-size:0.9375rem;font-weight:800;color:var(--ui-text-1);margin:0">Editar mi información</h2>
      <p style="font-size:0.75rem;color:var(--ui-text-3);margin:0">Nombres y celular. Tu código y correo no cambian.</p>
    </div>
    <button id="ep-toggle" type="button" class="acc-btn">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      Editar
    </button>
  </div>
  <div id="ep-body" style="display:none;margin-top:16px">
    <div id="ep-msg" style="display:none;margin-bottom:12px;padding:10px 12px;border-radius:9px;font-size:0.8125rem"></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
      <div><label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Primer nombre *</label>
        <input id="ep-fname" type="text" maxlength="15" class="ep-inp"/></div>
      <div><label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Segundo nombre</label>
        <input id="ep-mname" type="text" maxlength="15" class="ep-inp"/></div>
      <div><label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Primer apellido *</label>
        <input id="ep-lname1" type="text" maxlength="15" class="ep-inp"/></div>
      <div><label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Segundo apellido</label>
        <input id="ep-lname2" type="text" maxlength="15" class="ep-inp"/></div>
      <div style="grid-column:1 / -1"><label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Celular (+57...)</label>
        <input id="ep-phone" type="tel" maxlength="15" class="ep-inp"/></div>
    </div>
    <button id="ep-save" type="button" style="margin-top:12px;padding:0.625rem 1.125rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Guardar cambios</button>
  </div>
</div>
<style>
  .ep-inp { width:100%;padding:10px 12px;border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;background:var(--ui-surface);color:var(--ui-text-1);box-sizing:border-box;outline:none }
  .ep-inp:focus { border-color:var(--brand) }
  .acc-btn { display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:10px;border:1.5px solid var(--ui-border);background:var(--ui-surface);color:var(--ui-text-1);font-family:inherit;font-weight:700;font-size:0.8125rem;cursor:pointer;transition:all 0.15s;flex-shrink:0;white-space:nowrap }
  .acc-btn:hover { border-color:var(--brand);color:var(--brand) }
  .acc-btn.open { background:var(--brand);color:#fff;border-color:var(--brand) }
</style>

<!-- ── Cambiar contraseña ── -->
<div style="max-width:640px;margin:1.25rem auto 0;background:var(--ui-card);border:1px solid var(--ui-border);border-radius:16px;padding:1.5rem">
  <div style="display:flex;align-items:center;gap:10px">
    <div style="width:36px;height:36px;border-radius:9px;background:var(--brand-pale);display:flex;align-items:center;justify-content:center;flex-shrink:0">
      <svg width="18" height="18" fill="none" stroke="var(--brand)" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </div>
    <div style="flex:1;min-width:0">
      <h2 style="font-size:0.9375rem;font-weight:800;color:var(--ui-text-1);margin:0">Cambiar contraseña</h2>
      <p style="font-size:0.75rem;color:var(--ui-text-3);margin:0">Por seguridad, te enviaremos un código a tu correo.</p>
    </div>
    <button id="cp-toggle" type="button" class="acc-btn">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Cambiar
    </button>
  </div>

  <div id="cp-body" style="display:none;margin-top:16px">
  <div id="cp-msg" style="display:none;margin:0 0 12px;padding:10px 12px;border-radius:9px;font-size:0.8125rem"></div>

  <!-- Paso 1: solicitar código -->
  <div id="cp-step1">
    <button id="cp-request" type="button" style="padding:0.625rem 1.125rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Enviar código de verificación</button>
  </div>

  <!-- Paso 2: formulario -->
  <div id="cp-step2" style="display:none;margin-top:14px;flex-direction:column;gap:10px">
    <div>
      <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Código de verificación (correo)</label>
      <input id="cp-code" type="text" inputmode="numeric" maxlength="6" placeholder="6 dígitos" style="width:100%;padding:10px 12px;border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.9375rem;letter-spacing:3px;background:var(--ui-surface);color:var(--ui-text-1);box-sizing:border-box;outline:none"/>
    </div>
    <div>
      <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Contraseña actual</label>
      <input id="cp-current" type="password" style="width:100%;padding:10px 12px;border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;background:var(--ui-surface);color:var(--ui-text-1);box-sizing:border-box;outline:none"/>
    </div>
    <div>
      <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Nueva contraseña (mín. 8)</label>
      <input id="cp-new" type="password" style="width:100%;padding:10px 12px;border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;background:var(--ui-surface);color:var(--ui-text-1);box-sizing:border-box;outline:none"/>
    </div>
    <div>
      <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--ui-text-2);margin-bottom:4px">Confirmar nueva contraseña</label>
      <input id="cp-confirm" type="password" style="width:100%;padding:10px 12px;border:1.5px solid var(--ui-border);border-radius:9px;font-family:inherit;font-size:0.875rem;background:var(--ui-surface);color:var(--ui-text-1);box-sizing:border-box;outline:none"/>
    </div>
    <button id="cp-submit" type="button" style="margin-top:4px;padding:0.625rem 1.125rem;border-radius:10px;border:none;background:linear-gradient(135deg,#059669,#047857);color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer">Actualizar contraseña</button>
  </div>
  </div><!-- /cp-body -->
</div>
</AppLayout>

<script>
import { requireAuth, isAdmin, getToken, updateStoredUser, getFullName } from '../../lib/auth';
import { studentsApi } from '../../lib/api/students.api';
import { programsApi } from '../../lib/api/programs.api';
import { adminsApi }   from '../../lib/api/admins.api';

let user: any;
try { user = requireAuth(); } catch { throw new Error('redirect'); }

// ── Helpers ───────────────────────────────────────────────────────
const el  = (id: string) => document.getElementById(id);
const set = (id: string, val: string) => { const e = el(id); if (e) e.textContent = val; };
const show = (id: string, d = 'flex') => { const e = el(id); if (e) e.style.display = d; };


const fmt = (ts: number) =>
  new Date(ts * 1000).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' });
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' });

// ── Iniciales desde caché ─────────────────────────────────────────
const ini0 = ((user.firstName?.[0] ?? '') + (user.firstSurname?.[0] ?? '')).toUpperCase() || user.id.slice(0,2).toUpperCase();
set('hero-av',   ini0);
set('hero-name', getFullName(user) || user.id);
set('hero-email', user.email?.toLowerCase() ?? '');
set('d-email',   user.email?.toLowerCase() ?? '-');
set('d-code',    user.id);
set('d-name',    getFullName(user) || user.id);
el('hero-role')!.textContent = isAdmin() ? '⚙ Administrador' : '🎓 Estudiante';
el('lbl-code')!.textContent  = isAdmin() ? 'ID administrador' : 'Código estudiante';

// ── JWT ──────────────────────────────────────────────────────────
const token = getToken();
if (token) {
  try {
    const p      = JSON.parse(atob(token.split('.')[1]));
    const now    = Date.now();
    const total  = (p.exp - p.iat) * 1000;
    const remain = Math.max(0, p.exp * 1000 - now);
    const pct    = Math.min(100, (remain / total) * 100);
    set('jwt-iat', fmt(p.iat));
    const h = Math.floor(remain / 3_600_000);
    const m = Math.floor((remain % 3_600_000) / 60_000);
    set('jwt-remain', h > 0 ? `${h}h ${m}m` : `${m}m`);
    const fill = el('sess-fill')!;
    fill.style.width = `${pct}%`;
    const [color, label, cls] = pct > 50
      ? ['#22c55e', 'Activa',      'chip-yes']
      : pct > 20
      ? ['#f59e0b', 'Por vencer',  'chip-warn']
      : ['#ef4444', 'Por expirar', 'chip-no'];
    fill.style.background = color;
    el('sess-badge')!.innerHTML = `<span class="${cls}">${label}</span>`;
  } catch {}
}

// ── Cargar desde API ─────────────────────────────────────────────
if (isAdmin()) {
  show('row-lastlogin', 'flex');
  adminsApi.me().then(res => {
    if (!res.data) return;
    const a = res.data;
    const parts = [a.firstName, a.secondName, a.firstSurname, a.secondSurname].filter(Boolean);
    const full  = parts.join(' ');
    const ini   = ((a.firstName?.[0] ?? '') + (a.firstSurname?.[0] ?? '')).toUpperCase();
    updateStoredUser({ firstName: a.firstName, secondName: a.secondName,
      firstSurname: a.firstSurname, secondSurname: a.secondSurname, email: a.email });
    set('hero-av',   ini);
    set('hero-name', full);
    set('hero-email', a.email?.toLowerCase() ?? '');
    set('d-name',    full);
    set('d-email',   a.email?.toLowerCase() ?? '-');
    set('d-code',    a.adminId ?? user.id);
    if (a.phone) { set('d-phone', a.phone); show('row-phone', 'flex'); }
    if (a.lastLoginAt) { try { set('d-lastlogin', fmtDate(a.lastLoginAt)); } catch {} }
    else set('d-lastlogin', 'Primer acceso');
  }).catch(() => {});
} else {
  studentsApi.me().then(res => {
    if (!res.data) return;
    const s = res.data;
    const parts = [s.firstName, s.secondName, s.firstSurname, s.secondSurname].filter(Boolean);
    const full  = parts.join(' ');
    const ini   = ((s.firstName?.[0] ?? '') + (s.firstSurname?.[0] ?? '')).toUpperCase();
    updateStoredUser({ firstName: s.firstName, secondName: s.secondName,
      firstSurname: s.firstSurname, secondSurname: s.secondSurname, email: s.email });
    set('hero-av',   ini);
    set('hero-name', full);
    set('hero-email', s.email?.toLowerCase() ?? '');
    set('d-name',    full);
    set('d-email',   s.email?.toLowerCase() ?? '-');
    set('d-code',    s.studentId ?? user.id);
    if (s.phone) { set('d-phone', s.phone); show('row-phone', 'flex'); }
    // Prefill del formulario de edición
    const setVal = (id: string, v?: string) => { const el = document.getElementById(id) as HTMLInputElement | null; if (el) el.value = v ?? ''; };
    setVal('ep-fname', s.firstName); setVal('ep-mname', s.secondName);
    setVal('ep-lname1', s.firstSurname); setVal('ep-lname2', s.secondSurname);
    setVal('ep-phone', s.phone);
    if (s.programId) {
      show('row-program', 'flex');
      set('d-program', `${s.programId}: Cargando...`);
      programsApi.findById(s.programId).then(pr => {
        if (pr.data) set('d-program', `${pr.data.programId}: ${pr.data.programName}`);
        else         set('d-program', s.programId!);
      }).catch(() => set('d-program', s.programId!));
    }
  }).catch(() => {});
}

// ── Toggles de las secciones (botones explícitos) ────────────────────────
function setupAccordion(toggleId: string, bodyId: string, openLabel: string, closeLabel: string) {
  const btn  = document.getElementById(toggleId);
  const body = document.getElementById(bodyId);
  if (!btn || !body) return;
  btn.addEventListener('click', () => {
    const open = body.style.display !== 'none';
    body.style.display = open ? 'none' : 'block';
    btn.classList.toggle('open', !open);
    // Conserva el icono y solo cambia el texto.
    const svg = btn.querySelector('svg')?.outerHTML ?? '';
    btn.innerHTML = `${svg} ${open ? openLabel : closeLabel}`;
  });
}
setupAccordion('ep-toggle', 'ep-body', 'Editar', 'Cancelar');
setupAccordion('cp-toggle', 'cp-body', 'Cambiar', 'Cancelar');

// ── Editar mi información ─────────────────────────────────────────────────
{
  const epMsg = (t: string, ok: boolean) => {
    const el = document.getElementById('ep-msg')!;
    el.textContent = t; el.style.display = 'block';
    el.style.background = ok ? '#D1FAE5' : '#FEF2F2';
    el.style.color = ok ? '#065F46' : '#B91C1C';
    el.style.border = `1px solid ${ok ? '#A7F3D0' : '#FECACA'}`;
  };
  document.getElementById('ep-save')?.addEventListener('click', async () => {
    const v = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    const firstName = v('ep-fname'), firstSurname = v('ep-lname1'), phone = v('ep-phone');
    if (!firstName || !firstSurname) return epMsg('El primer nombre y el primer apellido son obligatorios.', false);
    if (phone && !/^\+[1-9][0-9]{10,13}$/.test(phone)) return epMsg('El celular debe ir en formato internacional, ej: +573001234567', false);
    const btn = document.getElementById('ep-save') as HTMLButtonElement;
    btn.disabled = true; const prev = btn.textContent; btn.textContent = 'Guardando...';
    try {
      const { studentsApi } = await import('../../lib/api/students.api');
      const res = await studentsApi.updateMe({
        firstName, secondName: v('ep-mname') || undefined,
        firstSurname, secondSurname: v('ep-lname2') || undefined, phone: phone || undefined,
      });
      const s = res.data!;
      const full = [s.firstName, s.secondName, s.firstSurname, s.secondSurname].filter(Boolean).join(' ');
      set('hero-name', full); set('d-name', full);
      if (s.phone) { set('d-phone', s.phone); show('row-phone', 'flex'); }
      updateStoredUser({ firstName: s.firstName, secondName: s.secondName, firstSurname: s.firstSurname, secondSurname: s.secondSurname });
      // Avisar a sidebar y topbar para que repinten el nombre al instante (sin recargar).
      window.dispatchEvent(new CustomEvent('rp:user-updated'));
      epMsg('¡Datos actualizados!', true);
    } catch (e: any) {
      epMsg(e?.message ?? 'No se pudo actualizar.', false);
    } finally {
      btn.disabled = false; btn.textContent = prev ?? 'Guardar cambios';
    }
  });
}

// ── Cambiar contraseña (código por correo) ───────────────────────────────
{
  const cpMsg = (t: string, ok: boolean) => {
    const el = document.getElementById('cp-msg')!;
    el.textContent = t;
    el.style.display = 'block';
    el.style.background = ok ? '#D1FAE5' : '#FEF2F2';
    el.style.color = ok ? '#065F46' : '#B91C1C';
    el.style.border = `1px solid ${ok ? '#A7F3D0' : '#FECACA'}`;
  };
  document.getElementById('cp-request')?.addEventListener('click', async () => {
    const btn = document.getElementById('cp-request') as HTMLButtonElement;
    btn.disabled = true; const prev = btn.textContent; btn.textContent = 'Enviando...';
    try {
      const { authApi } = await import('../../lib/api/auth.api');
      await authApi.requestPasswordCode();
      cpMsg('Te enviamos un código a tu correo. Revisa tu bandeja (vence en 10 min).', true);
      (document.getElementById('cp-step1') as HTMLElement).style.display = 'none';
      (document.getElementById('cp-step2') as HTMLElement).style.display = 'flex';
    } catch (e: any) {
      cpMsg(e?.message ?? 'No se pudo enviar el código.', false);
      btn.disabled = false; btn.textContent = prev ?? 'Enviar código de verificación';
    }
  });
  document.getElementById('cp-submit')?.addEventListener('click', async () => {
    const code = (document.getElementById('cp-code') as HTMLInputElement).value.trim();
    const cur  = (document.getElementById('cp-current') as HTMLInputElement).value;
    const nw   = (document.getElementById('cp-new') as HTMLInputElement).value;
    const cf   = (document.getElementById('cp-confirm') as HTMLInputElement).value;
    if (code.length !== 6) return cpMsg('Ingresa el código de 6 dígitos.', false);
    if (nw.length < 8)     return cpMsg('La nueva contraseña debe tener al menos 8 caracteres.', false);
    if (nw !== cf)         return cpMsg('Las contraseñas nuevas no coinciden.', false);
    const btn = document.getElementById('cp-submit') as HTMLButtonElement;
    btn.disabled = true; const prev = btn.textContent; btn.textContent = 'Actualizando...';
    try {
      const { authApi } = await import('../../lib/api/auth.api');
      await authApi.changePassword(code, cur, nw);
      cpMsg('¡Contraseña actualizada! Úsala en tu próximo inicio de sesión.', true);
      (document.getElementById('cp-step2') as HTMLElement).style.display = 'none';
    } catch (e: any) {
      cpMsg(e?.message ?? 'No se pudo cambiar la contraseña.', false);
    } finally {
      btn.disabled = false; btn.textContent = prev ?? 'Actualizar contraseña';
    }
  });
}
</script>
