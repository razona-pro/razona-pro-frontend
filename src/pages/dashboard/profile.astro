---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Mi perfil" currentPage="profile" requiredRole="STUDENT">
<style>
  @keyframes fadeUp { from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)} }

  .pro-wrap { display:flex;flex-direction:column;gap:1rem;animation:fadeUp 0.4s ease both; }

  /* ── Hero card ───────────────────────────────────── */
  .hero-card {
    background:var(--ui-card);border-radius:20px;border:1px solid var(--ui-border);
    overflow:hidden;position:relative;
  }
  .hero-banner {
    height:100px;background:linear-gradient(135deg,var(--brand) 0%,var(--brand-dark) 60%,#6B1318 100%);
    position:relative;overflow:hidden;
  }
  .hero-banner::before {
    content:'';position:absolute;right:-60px;top:-60px;
    width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,0.07);
  }
  .hero-banner::after {
    content:'';position:absolute;left:40%;bottom:-40px;
    width:160px;height:160px;border-radius:50%;background:rgba(255,255,255,0.04);
  }
  .hero-body {
    padding:0 1.75rem 1.5rem;
    display:flex;align-items:flex-end;gap:1.25rem;flex-wrap:wrap;
  }
  .hero-avatar-wrap { margin-top:-36px;position:relative;flex-shrink:0; }
  .hero-avatar {
    width:72px;height:72px;border-radius:18px;
    background:linear-gradient(135deg,var(--brand),var(--brand-dark));
    border:3px solid var(--ui-card);
    display:flex;align-items:center;justify-content:center;
    color:white;font-weight:900;font-size:1.5rem;
    font-family:var(--font-ui);
    box-shadow:0 6px 20px rgba(0,0,0,0.15);
  }
  .hero-online {
    position:absolute;bottom:0;right:0;
    width:16px;height:16px;border-radius:50%;background:#22c55e;
    border:2.5px solid var(--ui-card);
  }
  .hero-info { flex:1;min-width:180px;padding-top:0.75rem; }
  .hero-name {
    font-size:1.25rem;font-weight:900;color:var(--ui-text-1);
    margin:0 0 4px;letter-spacing:-0.4px;line-height:1.2;
  }
  .hero-meta {
    display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  }
  .hero-role {
    display:inline-flex;align-items:center;gap:5px;
    padding:3px 10px;border-radius:20px;
    font-size:0.6875rem;font-weight:700;
    font-family:var(--font-ui);
  }
  .hero-email {
    font-size:0.8125rem;color:var(--ui-text-3);
    font-family:var(--font-ui);
  }

  /* ── Info list ───────────────────────────────────── */
  .info-card {
    background:var(--ui-card);border-radius:16px;border:1px solid var(--ui-border);
    overflow:hidden;
  }
  .info-section-title {
    padding:0.875rem 1.25rem;
    font-size:0.625rem;font-weight:700;text-transform:uppercase;
    letter-spacing:0.08em;color:var(--ui-text-3);
    border-bottom:1px solid var(--ui-border);
    font-family:var(--font-ui);
    background:var(--ui-surface);
  }
  .info-row {
    display:flex;align-items:center;justify-content:space-between;
    padding:0.875rem 1.25rem;border-bottom:1px solid var(--ui-border);gap:12px;
  }
  .info-row:last-child { border-bottom:none; }
  .info-key {
    font-size:0.8125rem;font-weight:500;color:var(--ui-text-3);
    font-family:var(--font-ui);flex-shrink:0;min-width:120px;
  }
  .info-val {
    font-size:0.875rem;font-weight:600;color:var(--ui-text-1);
    text-align:right;word-break:break-all;
  }
  .info-mono {
    font-family:var(--font-mono);
    background:var(--ui-surface);padding:2px 8px;border-radius:6px;
    border:1px solid var(--ui-border);font-size:0.8125rem;
  }


  /* ── Sesión ──────────────────────────────────────── */
  .sess-bar-wrap { height:5px;background:var(--ui-border);border-radius:3px;overflow:hidden;margin-top:6px; }
  .sess-bar      { height:100%;border-radius:3px;transition:width 1s; }

  /* ── Grid dos columnas ───────────────────────────── */
  .pro-grid { display:grid;grid-template-columns:1fr 1fr;gap:1rem; }
  @media(max-width:720px){ .pro-grid{ grid-template-columns:1fr; } }
</style>

<div class="pro-wrap">

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <div class="hero-card">
    <div class="hero-banner"></div>
    <div class="hero-body">
      <div class="hero-avatar-wrap">
        <div class="hero-avatar" id="hero-av">?</div>
        <div class="hero-online"></div>
      </div>
      <div class="hero-info">
        <h1 class="hero-name" id="hero-name">Cargando...</h1>
        <div class="hero-meta">
          <span class="hero-role" id="hero-role" style="background:rgba(212,18,36,0.1);color:var(--brand)"></span>
          <span class="hero-email" id="hero-email"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Grid de info ──────────────────────────────────────── -->
  <div class="pro-grid">

    <!-- Columna 1: Datos de la cuenta -->
    <div class="info-card">
      <p class="info-section-title">Cuenta</p>

      <div class="info-row">
        <span class="info-key">Nombre</span>
        <span class="info-val" id="d-name">-</span>
      </div>
      <div class="info-row">
        <span class="info-key">Correo</span>
        <span class="info-val" id="d-email" style="font-size:0.8125rem">-</span>
      </div>
      <div class="info-row" id="row-phone" style="display:none">
        <span class="info-key">Teléfono</span>
        <span class="info-val info-mono" id="d-phone">-</span>
      </div>
      <div class="info-row">
        <span class="info-key" id="lbl-code">Código</span>
        <span class="info-val info-mono" id="d-code">-</span>
      </div>
      <div class="info-row" id="row-program" style="display:none">
        <span class="info-key">Programa</span>
        <span class="info-val" id="d-program" style="text-align:right;font-family:var(--font-ui);font-size:0.8125rem">-</span>
      </div>
      <div class="info-row" id="row-lastlogin" style="display:none">
        <span class="info-key">Último acceso</span>
        <span class="info-val" id="d-lastlogin" style="font-size:0.8125rem">-</span>
      </div>
    </div>

    <!-- Columna 2: Estado + Sesión -->
    <div style="display:flex;flex-direction:column;gap:1rem">


      <!-- Sesión JWT -->
      <div class="info-card">
        <p class="info-section-title">Sesión actual</p>
        <div class="info-row">
          <span class="info-key">Estado</span>
          <span id="sess-badge"></span>
        </div>
        <div class="info-row">
          <span class="info-key">Inició</span>
          <span class="info-val" id="jwt-iat" style="font-size:0.8125rem">-</span>
        </div>
        <div class="info-row" style="flex-direction:column;align-items:flex-start;gap:6px">
          <div style="display:flex;justify-content:space-between;width:100%">
            <span class="info-key">Tiempo restante</span>
            <span id="jwt-remain" style="font-size:0.8125rem;font-weight:700;color:var(--ui-text-1);font-family:var(--font-ui)">-</span>
          </div>
          <div class="sess-bar-wrap" style="width:100%">
            <div class="sess-bar" id="sess-fill"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
</AppLayout>

<script>
import { requireAuth, isAdmin, getToken, updateStoredUser, getFullName } from '../../lib/auth';
import { studentsApi } from '../../lib/api/students.api';
import { programsApi } from '../../lib/api/programs.api';
import { adminsApi }   from '../../lib/api/admins.api';

let user: any;
try { user = requireAuth(); } catch { throw new Error('redirect'); }

// ── Helpers ───────────────────────────────────────────────────────
const el  = (id: string) => document.getElementById(id);
const set = (id: string, val: string) => { const e = el(id); if (e) e.textContent = val; };
const show = (id: string, d = 'flex') => { const e = el(id); if (e) e.style.display = d; };


const fmt = (ts: number) =>
  new Date(ts * 1000).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' });
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' });

// ── Iniciales desde caché ─────────────────────────────────────────
const ini0 = ((user.firstName?.[0] ?? '') + (user.firstSurname?.[0] ?? '')).toUpperCase() || user.id.slice(0,2).toUpperCase();
set('hero-av',   ini0);
set('hero-name', getFullName(user) || user.id);
set('hero-email', user.email?.toLowerCase() ?? '');
set('d-email',   user.email?.toLowerCase() ?? '-');
set('d-code',    user.id);
set('d-name',    getFullName(user) || user.id);
el('hero-role')!.textContent = isAdmin() ? '⚙ Administrador' : '🎓 Estudiante';
el('lbl-code')!.textContent  = isAdmin() ? 'ID administrador' : 'Código estudiante';

// ── JWT ──────────────────────────────────────────────────────────
const token = getToken();
if (token) {
  try {
    const p      = JSON.parse(atob(token.split('.')[1]));
    const now    = Date.now();
    const total  = (p.exp - p.iat) * 1000;
    const remain = Math.max(0, p.exp * 1000 - now);
    const pct    = Math.min(100, (remain / total) * 100);
    set('jwt-iat', fmt(p.iat));
    const h = Math.floor(remain / 3_600_000);
    const m = Math.floor((remain % 3_600_000) / 60_000);
    set('jwt-remain', h > 0 ? `${h}h ${m}m` : `${m}m`);
    const fill = el('sess-fill')!;
    fill.style.width = `${pct}%`;
    const [color, label, cls] = pct > 50
      ? ['#22c55e', 'Activa',      'chip-yes']
      : pct > 20
      ? ['#f59e0b', 'Por vencer',  'chip-warn']
      : ['#ef4444', 'Por expirar', 'chip-no'];
    fill.style.background = color;
    el('sess-badge')!.innerHTML = `<span class="${cls}">${label}</span>`;
  } catch {}
}

// ── Cargar desde API ─────────────────────────────────────────────
if (isAdmin()) {
  show('row-lastlogin', 'flex');
  adminsApi.me().then(res => {
    if (!res.data) return;
    const a = res.data;
    const parts = [a.firstName, a.secondName, a.firstSurname, a.secondSurname].filter(Boolean);
    const full  = parts.join(' ');
    const ini   = ((a.firstName?.[0] ?? '') + (a.firstSurname?.[0] ?? '')).toUpperCase();
    updateStoredUser({ firstName: a.firstName, secondName: a.secondName,
      firstSurname: a.firstSurname, secondSurname: a.secondSurname, email: a.email });
    set('hero-av',   ini);
    set('hero-name', full);
    set('hero-email', a.email?.toLowerCase() ?? '');
    set('d-name',    full);
    set('d-email',   a.email?.toLowerCase() ?? '-');
    set('d-code',    a.adminId ?? user.id);
    if (a.phone) { set('d-phone', a.phone); show('row-phone', 'flex'); }
    if (a.lastLoginAt) { try { set('d-lastlogin', fmtDate(a.lastLoginAt)); } catch {} }
    else set('d-lastlogin', 'Primer acceso');
  }).catch(() => {});
} else {
  studentsApi.me().then(res => {
    if (!res.data) return;
    const s = res.data;
    const parts = [s.firstName, s.secondName, s.firstSurname, s.secondSurname].filter(Boolean);
    const full  = parts.join(' ');
    const ini   = ((s.firstName?.[0] ?? '') + (s.firstSurname?.[0] ?? '')).toUpperCase();
    updateStoredUser({ firstName: s.firstName, secondName: s.secondName,
      firstSurname: s.firstSurname, secondSurname: s.secondSurname, email: s.email });
    set('hero-av',   ini);
    set('hero-name', full);
    set('hero-email', s.email?.toLowerCase() ?? '');
    set('d-name',    full);
    set('d-email',   s.email?.toLowerCase() ?? '-');
    set('d-code',    s.studentId ?? user.id);
    if (s.phone) { set('d-phone', s.phone); show('row-phone', 'flex'); }
    if (s.programId) {
      show('row-program', 'flex');
      set('d-program', `${s.programId}: Cargando...`);
      programsApi.findById(s.programId).then(pr => {
        if (pr.data) set('d-program', `${pr.data.programId}: ${pr.data.programName}`);
        else         set('d-program', s.programId!);
      }).catch(() => set('d-program', s.programId!));
    }
  }).catch(() => {});
}
</script>
