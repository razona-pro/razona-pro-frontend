---
import AppLayout from '../../layouts/AppLayout.astro';
import StatCard from '../../components/ui/StatCard.astro';
import WelcomeModal from '../../components/ui/WelcomeModal.astro';
---

<AppLayout title="Panel de control" currentPage="dashboard" requiredRole="STUDENT">

  <WelcomeModal />

  <!-- ══════════ ADMIN DASHBOARD ══════════ -->
  <div id="admin-dash" style="display:none">
    <!-- Header admin -->
    <div style="margin-bottom:1.5rem">
      <h1 id="admin-welcome-title" style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Panel de control</h1>
      <p id="admin-welcome-sub" style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Bienvenido de vuelta. Aquí tienes el resumen del sistema.</p>
    </div>

    <!-- Stats sistema -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:1.5rem" id="admin-stats-grid">
      <div class="admin-stat-card" style="border-left-color:#D41224">
        <div class="admin-stat-header">
          <span class="admin-stat-label">Estudiantes activos</span>
          <div class="admin-stat-icon" style="background:#FEE2E2">
            <svg width="14" height="14" fill="none" stroke="#D41224" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
        </div>
        <p id="admin-stat-students" class="admin-stat-value" style="color:#D41224">-</p>
        <p class="admin-stat-sub">en la plataforma</p>
      </div>
      <div class="admin-stat-card" style="border-left-color:#2563EB">
        <div class="admin-stat-header">
          <span class="admin-stat-label">Pruebas disponibles</span>
          <div class="admin-stat-icon" style="background:#DBEAFE">
            <svg width="14" height="14" fill="none" stroke="#2563EB" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
        </div>
        <p id="admin-stat-tests" class="admin-stat-value" style="color:#2563EB">-</p>
        <p class="admin-stat-sub">pruebas creadas</p>
      </div>
      <div class="admin-stat-card" style="border-left-color:#059669">
        <div class="admin-stat-header">
          <span class="admin-stat-label">Banco de preguntas</span>
          <div class="admin-stat-icon" style="background:#D1FAE5">
            <svg width="14" height="14" fill="none" stroke="#059669" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
        </div>
        <p id="admin-stat-questions" class="admin-stat-value" style="color:#059669">-</p>
        <p class="admin-stat-sub">preguntas activas</p>
      </div>
      <div class="admin-stat-card" style="border-left-color:#7C3AED">
        <div class="admin-stat-header">
          <span class="admin-stat-label">Pruebas realizadas</span>
          <div class="admin-stat-icon" style="background:#EDE9FE">
            <svg width="14" height="14" fill="none" stroke="#7C3AED" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
        </div>
        <p id="admin-stat-trieds" class="admin-stat-value" style="color:#7C3AED">-</p>
        <p class="admin-stat-sub">finalizados</p>
      </div>
    </div>

    <!-- Grid principal admin -->
    <div style="display:grid;grid-template-columns:1fr 320px;gap:16px">

      <!-- Accesos rápidos de gestión -->
      <div>
        <div class="admin-section-card">
          <h2 class="admin-section-title" style="margin-bottom:1rem">Gestión del sistema</h2>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
            <a href="/admin/students" class="admin-mgmt-card">
              <div class="admin-mgmt-icon" style="background:#FEE2E2;color:#D41224">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
              </div>
              <p class="admin-mgmt-label">Estudiantes</p>
              <p class="admin-mgmt-sub">Gestionar cuentas</p>
            </a>
            <a href="/admin/tests" class="admin-mgmt-card">
              <div class="admin-mgmt-icon" style="background:#DBEAFE;color:#2563EB">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/><polyline points="9 12 11 14 15 10"/></svg>
              </div>
              <p class="admin-mgmt-label">Pruebas</p>
              <p class="admin-mgmt-sub">Crear y editar</p>
            </a>
            <a href="/admin/questions" class="admin-mgmt-card">
              <div class="admin-mgmt-icon" style="background:#D1FAE5;color:#059669">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              </div>
              <p class="admin-mgmt-label">Preguntas</p>
              <p class="admin-mgmt-sub">Banco de preguntas</p>
            </a>
            <a href="/admin/programs" class="admin-mgmt-card">
              <div class="admin-mgmt-icon" style="background:#FEF3C7;color:#D97706">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              </div>
              <p class="admin-mgmt-label">Programas</p>
              <p class="admin-mgmt-sub">Programas académicos</p>
            </a>
            <a href="/admin/rankings" class="admin-mgmt-card">
              <div class="admin-mgmt-icon" style="background:#EDE9FE;color:#7C3AED">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round"><path d="M8 21H4a2 2 0 01-2-2V5a2 2 0 012-2h4M14 21h4a2 2 0 002-2V5a2 2 0 00-2-2h-4M10 7h4v14h-4z"/></svg>
              </div>
              <p class="admin-mgmt-label">Rankings</p>
              <p class="admin-mgmt-sub">Tablas de posiciones</p>
            </a>
            <a href="/admin/admins" class="admin-mgmt-card">
              <div class="admin-mgmt-icon" style="background:#FEE2E2;color:#9B1F24">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <p class="admin-mgmt-label">Administradores</p>
              <p class="admin-mgmt-sub">Cuentas de admin</p>
            </a>
          </div>
        </div>

        <!-- Métricas del sistema + Estado IA -->
<div class="admin-section-card" style="margin-top:16px">
  <h2 class="admin-section-title" style="margin-bottom:1rem">Métricas del sistema</h2>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
    <div class="metric-item">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
        <span style="font-size:0.8125rem;font-weight:600;color:var(--ui-text-1)">Tasa de satisfacción</span>
        <span id="admin-satisfaction" style="font-size:1rem;font-weight:900;color:#059669">-%</span>
      </div>
      <div style="height:6px;background:var(--ui-surface);border-radius:3px;overflow:hidden">
        <div id="admin-sat-bar" style="height:100%;border-radius:3px;background:linear-gradient(to right,#059669,#34D399);width:0%;transition:width 1.2s ease"></div>
      </div>
      <p style="font-size:0.6875rem;color:var(--ui-text-3);margin:4px 0 0">Pruebas con puntaje ≥60</p>
    </div>
    <div class="metric-item">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
        <span style="font-size:0.8125rem;font-weight:600;color:var(--ui-text-1)">Competencias activas</span>
        <span id="admin-comp-count" style="font-size:1rem;font-weight:900;color:#2563EB">-</span>
      </div>
      <div style="height:6px;background:var(--ui-surface);border-radius:3px;overflow:hidden">
        <div id="admin-comp-bar" style="height:100%;border-radius:3px;background:linear-gradient(to right,#2563EB,#60A5FA);width:0%;transition:width 1.2s ease"></div>
      </div>
      <p style="font-size:0.6875rem;color:var(--ui-text-3);margin:4px 0 0">De las 6 áreas Saber Pro</p>
    </div>
  </div>

  <!-- Estado módulo IA -->
  <div id="admin-ai-status" style="background:var(--ui-surface);border-radius:12px;padding:14px;border:1px solid var(--ui-border)">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
      <div style="display:flex;align-items:center;gap:8px">
        <div id="ai-status-dot" style="width:10px;height:10px;border-radius:50%;background:#D4D4D4;flex-shrink:0"></div>
        <span style="font-size:0.875rem;font-weight:700;color:var(--ui-text-1)">Módulo IA</span>
        <span id="ai-status-badge" style="font-size:0.625rem;padding:2px 8px;border-radius:12px;font-weight:700;background:#F3F4F6;color:#6B7280">Verificando...</span>
      </div>
      <span id="ai-model-label" style="font-size:0.75rem;color:var(--ui-text-3)"></span>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px">
      <div style="background:var(--ui-card);border-radius:9px;padding:10px;border:1px solid var(--ui-border);text-align:center">
        <p id="ai-stat-sessions" style="font-size:1.25rem;font-weight:900;color:#6366F1;margin:0 0 2px">-</p>
        <p style="font-size:0.625rem;color:var(--ui-text-3);margin:0;text-transform:uppercase;letter-spacing:0.4px">Sesiones IA</p>
      </div>
      <div style="background:var(--ui-card);border-radius:9px;padding:10px;border:1px solid var(--ui-border);text-align:center">
        <p id="ai-stat-questions" style="font-size:1.25rem;font-weight:900;color:#6366F1;margin:0 0 2px">-</p>
        <p style="font-size:0.625rem;color:var(--ui-text-3);margin:0;text-transform:uppercase;letter-spacing:0.4px">Preguntas gen.</p>
      </div>
      <div style="background:var(--ui-card);border-radius:9px;padding:10px;border:1px solid var(--ui-border);text-align:center">
        <p id="ai-stat-accuracy" style="font-size:1.25rem;font-weight:900;color:#6366F1;margin:0 0 2px">-</p>
        <p style="font-size:0.625rem;color:var(--ui-text-3);margin:0;text-transform:uppercase;letter-spacing:0.4px">% aciertos IA</p>
      </div>
    </div>
  </div>
</div>
      </div>

      <!-- Panel lateral admin -->
      <div style="display:flex;flex-direction:column;gap:14px">

        <!-- Estado del sistema -->
        <div class="admin-section-card">
          <h2 class="admin-section-title" style="margin-bottom:0.875rem">Estado del sistema</h2>
          <div style="display:flex;flex-direction:column;gap:8px">
            <div class="system-status-row">
              <div style="display:flex;align-items:center;gap:8px">
                <span class="status-dot green"></span>
                <span style="font-size:0.8125rem;font-weight:600;color:var(--ui-text-1)">API Backend</span>
              </div>
              <span style="font-size:0.6875rem;font-weight:700;color:#059669;background:#D1FAE5;padding:2px 8px;border-radius:12px">Activo</span>
            </div>
            <div class="system-status-row">
              <div style="display:flex;align-items:center;gap:8px">
                <span class="status-dot green"></span>
                <span style="font-size:0.8125rem;font-weight:600;color:var(--ui-text-1)">Base de datos</span>
              </div>
              <span style="font-size:0.6875rem;font-weight:700;color:#059669;background:#D1FAE5;padding:2px 8px;border-radius:12px">Activo</span>
            </div>
            <div class="system-status-row">
              <div style="display:flex;align-items:center;gap:8px">
                <span class="status-dot yellow"></span>
                <span style="font-size:0.8125rem;font-weight:600;color:var(--ui-text-1)">Módulo IA</span>
              </div>
              <span style="font-size:0.6875rem;font-weight:700;color:#D97706;background:#FEF3C7;padding:2px 8px;border-radius:12px">Beta</span>
            </div>
            <div class="system-status-row">
              <div style="display:flex;align-items:center;gap:8px">
                <span class="status-dot green"></span>
                <span style="font-size:0.8125rem;font-weight:600;color:var(--ui-text-1)">Servicio de email</span>
              </div>
              <span style="font-size:0.6875rem;font-weight:700;color:#059669;background:#D1FAE5;padding:2px 8px;border-radius:12px">Activo</span>
            </div>
          </div>
        </div>

        <!-- Acciones rápidas admin -->
        <div class="admin-section-card">
          <h2 class="admin-section-title" style="margin-bottom:0.875rem">Acciones rápidas</h2>
          <div style="display:flex;flex-direction:column;gap:6px">
            <a href="/admin/students" class="admin-quick-link">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              Ver todos los estudiantes
            </a>
            <a href="/admin/tests" class="admin-quick-link">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Crear nuevo test
            </a>
            <a href="/admin/questions" class="admin-quick-link">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              Agregar pregunta
            </a>
            <a href="/admin/rankings" class="admin-quick-link">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M8 21H4a2 2 0 01-2-2V5a2 2 0 012-2h4M14 21h4a2 2 0 002-2V5a2 2 0 00-2-2h-4M10 7h4v14h-4z"/></svg>
              Gestionar rankings
            </a>
            <a href="/dashboard/profile" class="admin-quick-link">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Mi perfil de admin
            </a>
          </div>
        </div>

        <!-- Info de plataforma -->
        <div style="background:linear-gradient(135deg,var(--brand),var(--brand-dark));border-radius:14px;padding:1.125rem">
          <p style="font-size:0.6875rem;font-weight:700;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px">RazonaPro</p>
          <p style="font-size:0.875rem;font-weight:800;color:white;margin:0 0 8px">Plataforma Saber Pro</p>
          <p style="font-size:0.75rem;color:rgba(255,255,255,0.65);margin:0;line-height:1.55">UFPSO · Gestión integral de preparación académica con Transfer Learning.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════ STUDENT DASHBOARD ══════════ -->
  <div id="student-dash" style="display:none">
    <div class="dashboard-header" style="margin-bottom:1.25rem">
      <h1 id="welcome-title" style="font-size:1.625rem;font-weight:900;color:var(--ui-text-1);margin:0 0 3px;letter-spacing:-0.5px">Panel de control</h1>
      <p id="welcome-sub" style="font-size:0.875rem;color:var(--ui-text-2);margin:0">Cargando...</p>
    </div>

    <!-- Quick actions -->
    <div class="qa-row" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:1.25rem;overflow-x:auto;padding-bottom:4px">
      <a href="/tests" class="qa-btn qa-primary"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg> Pruebas disponibles</a>
      <a href="/ai-practice" class="qa-btn"><svg width="14" height="14" fill="none" stroke="#7C3AED" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 12l2 2 4-4"/></svg> Práctica con IA</a>
      <a href="/dashboard/rankings" class="qa-btn"><svg width="14" height="14" fill="none" stroke="#D97706" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M8 21H4a2 2 0 01-2-2v-4a2 2 0 012-2h4M14 21h4a2 2 0 002-2V5a2 2 0 00-2-2h-4M10 7h4v14h-4z"/></svg> Rankings</a>
      <a href="/dashboard/history" class="qa-btn"><svg width="14" height="14" fill="none" stroke="#059669" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="12 8 12 12 14 14"/><path d="M3.05 11a9 9 0 1 0 .5-4.5"/><polyline points="3 3 3 7 7 7"/></svg> Mi historial</a>
    </div>

    <!-- Stats -->
    <div id="stats-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:1.25rem">
      <StatCard id="stat-tests"  label="Pruebas realizadas"  value="-" sub="pruebas"        icon="tabler:clipboard-check" color="#D41224" bg="#FEE2E2" />
      <StatCard id="stat-avg"    label="Promedio global"   value="-" sub="% de aciertos"      icon="tabler:chart-line"      color="#2563EB" bg="#DBEAFE" />
      <StatCard id="stat-rank"   label="Posición ranking"  value="-" sub="posición actual"   icon="tabler:trophy"          color="#D97706" bg="#FEF3C7" />
      <StatCard id="stat-streak" label="Racha activa"      value="-" sub="días consecutivos" icon="tabler:flame"           color="#059669" bg="#D1FAE5" />
    </div>

    <!-- Main grid -->
    <div id="main-grid" style="display:grid;grid-template-columns:1fr 300px;gap:16px">
      <div style="display:flex;flex-direction:column;gap:16px;min-width:0">
        <div class="card-section">
          <div class="card-header">
            <h2 class="card-title">Competencias Saber Pro</h2>
            <a href="/tests" class="card-link">Practicar →</a>
          </div>
          <div id="comp-list"><div style="color:var(--ui-text-3);font-size:0.875rem;padding:1rem 0">Cargando competencias...</div></div>
        </div>
        <div class="card-section">
          <div class="card-header">
            <h2 class="card-title">Historial de tests</h2>
            <a href="/dashboard/history" class="card-link">Ver todo →</a>
          </div>
          <div id="last-test-card" class="last-test-card">
            <div class="last-test-icon">
              <svg width="20" height="20" fill="none" stroke="#D41224" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/><polyline points="9 12 11 14 15 10"/></svg>
            </div>
            <div style="flex:1;min-width:100px">
              <p style="color:var(--ui-text-3);font-size:0.625rem;margin:0 0 2px;text-transform:uppercase;letter-spacing:0.6px;font-weight:700">Último test</p>
              <p id="lt-name" style="color:var(--ui-text-1);font-weight:800;font-size:0.9375rem;margin:0 0 2px">Sin intentos</p>
              <p id="lt-meta" style="color:var(--ui-text-3);font-size:0.75rem;margin:0">Comienza tu primera prueba</p>
            </div>
            <div style="text-align:right;flex-shrink:0">
              <p id="lt-score" style="font-size:1.75rem;font-weight:900;color:var(--brand);margin:0;letter-spacing:-1px">-</p>
              <p style="color:var(--ui-text-3);font-size:0.6875rem;margin:0">pts</p>
            </div>
          </div>
          <div id="recent-list"></div>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:16px">
        <div class="card-section">
          <div class="card-header">
            <h2 class="card-title">Rankings</h2>
            <a href="/dashboard/rankings" class="card-link">Ver todo →</a>
          </div>
          <div id="ranking-list" style="margin-bottom:0.75rem"></div>
          <div id="my-rank-card" style="display:none;margin-top:0.625rem;padding:0.625rem 0.75rem;background:#FFF1F2;border-radius:10px;border:1.5px solid #FECACA">
            <div style="display:flex;align-items:center;gap:0.625rem">
              <span style="font-size:1.125rem;font-weight:900;color:#D41224;min-width:28px">#<span id="my-rank-num">-</span></span>
              <div style="flex:1">
                <p id="my-rank-name" style="font-size:0.8125rem;font-weight:700;color:#991B1B;margin:0"></p>
                <p style="font-size:0.6875rem;color:#B91C1C;margin:0;opacity:0.6">Tu posición actual</p>
              </div>
              <span id="my-rank-score" style="font-size:1rem;font-weight:900;color:#D41224"></span>
            </div>
          </div>
