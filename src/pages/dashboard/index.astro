        <div class="cta-card-light">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:0.5rem">
            <div style="width:32px;height:32px;background:var(--brand-pale);border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg width="16" height="16" fill="#D41224" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <p style="font-size:0.875rem;font-weight:800;color:var(--ui-text-1);margin:0">¿Listo para practicar?</p>
          </div>
          <p style="font-size:0.75rem;color:var(--ui-text-2);margin:0 0 0.875rem;line-height:1.55">Toma una prueba y mejora tu posición en el ranking.</p>
          <a href="/tests" class="cta-btn-brand">Ver tests disponibles →</a>
        </div>
      </div>
