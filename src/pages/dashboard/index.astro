  .last-test-card {
    background: var(--ui-surface); border: 1.5px solid var(--ui-border); border-left: 4px solid var(--brand);
    border-radius: 12px; padding: 1rem 1.125rem; margin-bottom: 0.875rem;
    display: flex; align-items: center; gap: 0.875rem; flex-wrap: wrap;
