    white-space: nowrap; transition: all 0.15s; flex-shrink: 0;
  }
  .qa-btn:hover { border-color: var(--brand); color: var(--brand); }
  .qa-btn.qa-primary {
    background: linear-gradient(135deg, var(--brand), var(--brand-dark));
    color: white; border: none; box-shadow: 0 4px 14px rgba(212,18,36,0.28);
  }
  .qa-btn.qa-primary:hover { box-shadow: 0 6px 20px rgba(212,18,36,0.4); transform: translateY(-1px); }

  .card-section { background: var(--ui-card); border-radius: 16px; padding: 1.25rem 1.375rem; border: 1px solid var(--ui-border); }
  .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .card-title { font-size: 0.9375rem; font-weight: 800; color: var(--ui-text-1); margin: 0; }
