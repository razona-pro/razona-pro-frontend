  @media (max-width: 1023px) {
    #admin-stats-grid { grid-template-columns: repeat(2,1fr) !important; }
    #stats-grid       { grid-template-columns: repeat(2,1fr) !important; }
    #main-grid        { grid-template-columns: 1fr !important; }
    .app-content > div:nth-child(2) > div[style*="grid-template-columns:1fr 320px"] { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 640px) {
    #admin-stats-grid { grid-template-columns: repeat(2,1fr) !important; }
    #stats-grid       { grid-template-columns: repeat(2,1fr) !important; gap: 8px !important; }
  }
</style>

<script>
import { requireAuth, isAdmin, getUser, updateStoredUser } from '../../lib/auth';
import type { StoredUser } from '../../lib/auth';
import { studentsApi }    from '../../lib/api/students.api';
import { adminsApi }      from '../../lib/api/admins.api';
import { triedsApi }      from '../../lib/api/trieds.api';
import { competencesApi } from '../../lib/api/competences.api';
import { rankingsApi }    from '../../lib/api/rankings.api';
import { statsApi }       from '../../lib/api/stats.api';
import { getCompStyle, fmtDate, animCount, scoreColor } from '../../lib/utils';
import { toast } from '../../lib/toast';

let user: StoredUser;
try { user = requireAuth(); } catch { throw new Error('redirect'); }

const adminRole = isAdmin();

if (adminRole) {
  document.getElementById('admin-dash')!.style.display = 'block';
  initAdminDashboard();
} else {
  document.getElementById('student-dash')!.style.display = 'block';
  initStudentDashboard();
}

async function initAdminDashboard() {
  const h = new Date().getHours();
  const greet = h < 12 ? '¡Buenos días' : h < 18 ? '¡Buenas tardes' : '¡Buenas noches';
  const subEl = document.getElementById('admin-welcome-sub');

  try {
    const res = await adminsApi.me();
    if (res.data) {
      const a = res.data;
      updateStoredUser({ firstName: a.firstName, firstSurname: a.firstSurname, email: a.email });
      const full = a.firstSurname ? `${a.firstName} ${a.firstSurname}` : a.firstName;
      if (subEl) subEl.textContent = `${greet}, ${full}! Gestiona la plataforma RazonaPro desde aquí.`;
    }
  } catch {}

  try {
    const res = await statsApi.home();
    if (res.data) {
      const d = res.data;
      const animEl = (id: string, val: number) => {
        const el = document.getElementById(id) as HTMLElement | null;
        if (el) animCount(el, val);
      };
      animEl('admin-stat-students',  d.activeStudents);
      animEl('admin-stat-tests',     d.totalTests);
      animEl('admin-stat-questions', d.totalQuestions);
      animEl('admin-stat-trieds',    d.completedTrieds);

      const sat = Number(d.satisfactionRate.toFixed(0));
      const satEl = document.getElementById('admin-satisfaction');
      const barEl = document.getElementById('admin-sat-bar');
      if (satEl) satEl.textContent = `${sat}%`;
      if (barEl) setTimeout(() => { barEl.style.width = `${sat}%`; }, 400);

      const compCount = Number(d.activeCompetences);
      const compEl  = document.getElementById('admin-comp-count');
      const cBarEl  = document.getElementById('admin-comp-bar');
      if (compEl) compEl.textContent = String(compCount);
      if (cBarEl) setTimeout(() => { cBarEl.style.width = `${(compCount / 6) * 100}%`; }, 500);
    }
  } catch (err: any) {
    toast.error('Error al cargar estadísticas', { description: err?.message });
  }

  // Estado IA
try {
  const { aiTriedsApi } = await import('../../lib/api/ai-trieds.api');
  const { apiFetch }    = await import('../../lib/api/client');

  const aiStatus = await aiTriedsApi.status();
  const dot    = document.getElementById('ai-status-dot')!;
  const badge  = document.getElementById('ai-status-badge')!;
  const modelL = document.getElementById('ai-model-label')!;

  if (aiStatus.data?.enabled && aiStatus.data?.reachable) {
    dot.style.background   = '#22C55E';
    dot.style.boxShadow    = '0 0 6px rgba(34,197,94,0.5)';
    badge.textContent      = 'Activo';
    badge.style.background = '#D1FAE5';
    badge.style.color      = '#059669';
    modelL.textContent     = aiStatus.data.model;
  } else {
    dot.style.background   = '#EF4444';
    badge.textContent      = aiStatus.data?.enabled ? 'No alcanzable' : 'Deshabilitado';
    badge.style.background = '#FEE2E2';
    badge.style.color      = '#DC2626';
    modelL.textContent     = aiStatus.data?.provider ?? '';
  }

  // Stats de sesiones IA - consultar desde API
  const aiRes = await apiFetch<any>('/api/ai-trieds/my?page=0&size=1'); // solo para saber si hay datos
  // Como admin no tiene /my, usamos un endpoint diferente o simplemente mostramos "N/A"
  // Si tienes endpoint admin de ai_trieds, úsalo aquí
  document.getElementById('ai-stat-sessions')!.textContent  = '-';
  document.getElementById('ai-stat-questions')!.textContent = '-';
  document.getElementById('ai-stat-accuracy')!.textContent  = '-';
} catch {}
}

async function initStudentDashboard() {
  const h = new Date().getHours();
  const greet = h < 12 ? '¡Buenos días' : h < 18 ? '¡Buenas tardes' : '¡Buenas noches';

  const fullNameStored = user.firstSurname
    ? `${user.firstName} ${user.firstSurname}`
    : user.firstName;

  const welcomeTitle = document.getElementById('welcome-title');
  const welcomeSub   = document.getElementById('welcome-sub');
  if (welcomeTitle) welcomeTitle.textContent = 'Panel de control';
  if (welcomeSub)   welcomeSub.textContent   = `${greet}, ${fullNameStored}! Continúa preparándote para el Saber Pro.`;

  const setStatVal = (id: string, val: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = val;
  };

  Promise.allSettled([
    studentsApi.me(),
    triedsApi.findMy(0, 500),
    competencesApi.findAll(true),
    rankingsApi.findAll(true),
  ]).then(([profileR, triedsR, compsR, rankingsR]) => {

    if (profileR.status === 'fulfilled' && profileR.value.data) {
      const p = profileR.value.data;
      updateStoredUser({ firstName: p.firstName, firstSurname: p.firstSurname, email: p.email });
      const fullName = p.firstSurname ? `${p.firstName} ${p.firstSurname}` : p.firstName;
      if (welcomeSub) welcomeSub.textContent = `${greet}, ${fullName}! Continúa preparándote para el Saber Pro.`;
    }

    if (triedsR.status === 'fulfilled' && triedsR.value.data) {
      const trieds   = triedsR.value.data.content;
      const finished = trieds.filter(t => t.status === 'FINISHED');
      // El score es puntos crudos; para promedio y dominio usamos % de aciertos (correctas/total).
      const accOf    = (t: typeof finished[number]) =>
        t.totalQuestions > 0 ? ((t.correctAnswers ?? 0) / t.totalQuestions) * 100 : 0;
      const accs     = finished.map(accOf);
      const avgAcc   = accs.length ? accs.reduce((a, b) => a + b, 0) / accs.length : 0;

      const testEl = document.getElementById('stat-tests');
      if (testEl) animCount(testEl, finished.length);
      setStatVal('stat-avg', avgAcc > 0 ? `${avgAcc.toFixed(0)}%` : '-');
      setStatVal('stat-streak', String(calcStreak(finished)));

      const sorted = [...finished].sort((a, b) =>
        new Date(b.finishedAt ?? b.attemptTimestamp).getTime()
        - new Date(a.finishedAt ?? a.attemptTimestamp).getTime()
      );

      if (sorted.length > 0) {
        const lt = sorted[0];
        const ltName  = document.getElementById('lt-name');
        const ltMeta  = document.getElementById('lt-meta');
        const ltScore = document.getElementById('lt-score');
        if (ltName)  ltName.textContent  = lt.testName ?? lt.testId;
        if (ltMeta)  ltMeta.textContent  = `${fmtDate(lt.finishedAt ?? lt.attemptTimestamp)} · ${lt.totalQuestions} preguntas`;
        if (ltScore) { ltScore.textContent = lt.score?.toFixed(0) ?? '-'; ltScore.style.color = scoreColor(accOf(lt)); }
      }

      const recentList = document.getElementById('recent-list');
      if (recentList) {
        const recent = sorted.slice(1, 5);
        if (recent.length > 0) {
          recent.forEach(t => {
            const s = getCompStyle(t.competenceId, t.testName ?? '');
            const div = document.createElement('div');
            div.style.cssText = 'display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;border:1px solid var(--ui-border);background:var(--ui-surface);margin-bottom:6px;cursor:pointer;transition:all 0.15s';
            div.onclick = () => window.location.href = '/dashboard/history';
            div.innerHTML = `
              <div style="width:34px;height:34px;border-radius:8px;background:${s.bg};display:flex;align-items:center;justify-content:center;flex-shrink:0"><span style="font-size:10px;font-weight:900;color:${s.color}">${s.short}</span></div>
              <div style="flex:1;min-width:0"><p style="font-size:0.8125rem;font-weight:700;color:var(--ui-text-1);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${t.testName ?? t.testId}</p><p style="font-size:0.6875rem;color:var(--ui-text-3);margin:0">${fmtDate(t.finishedAt ?? t.attemptTimestamp)} · ${t.totalQuestions} preg.</p></div>
              <div style="text-align:right;flex-shrink:0"><p style="font-size:1rem;font-weight:900;color:${scoreColor(accOf(t))};margin:0">${t.score?.toFixed(0) ?? '-'}</p><p style="font-size:0.625rem;color:var(--ui-text-3);margin:0">pts</p></div>`;
            recentList.appendChild(div);
          });
        } else {
          recentList.innerHTML = '<p style="font-size:0.875rem;color:var(--ui-text-3);text-align:center;padding:1rem 0">Sin intentos previos</p>';
        }
      }

      if (compsR.status === 'fulfilled' && compsR.value.data) {
        // Dominio por competencia = promedio del % de aciertos (no de los puntos crudos).
        const byComp: Record<string, number[]> = {};
        finished.forEach(t => {
          if (!byComp[t.competenceId]) byComp[t.competenceId] = [];
          byComp[t.competenceId].push(accOf(t));
        });

        const compList = document.getElementById('comp-list');
        if (compList) {
          compList.innerHTML = '';
          compsR.value.data.forEach((c, i) => {
            const compScores = byComp[c.competenceId] ?? [];
            const score = compScores.length ? Math.round(compScores.reduce((a, b) => a + b, 0) / compScores.length) : 0;
            const s = getCompStyle(c.competenceId, c.competenceName);
            const div = document.createElement('div');
            div.style.cssText = 'margin-bottom:1rem;cursor:pointer';
            div.onclick = () => window.location.href = `/tests?c=${s.key}`;
            div.innerHTML = `
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;gap:8px">
                <div style="display:flex;align-items:center;gap:8px;min-width:0">
                  <div style="width:27px;height:27px;border-radius:7px;background:${s.bg};display:flex;align-items:center;justify-content:center;flex-shrink:0"><span style="font-size:9px;font-weight:900;color:${s.color}">${s.short}</span></div>
                  <span style="font-size:0.8125rem;font-weight:600;color:var(--ui-text-1)">${c.competenceName}</span>
                </div>
                <div style="display:flex;align-items:baseline;gap:3px;flex-shrink:0">
                  <span style="font-size:1rem;font-weight:900;color:${s.color}">${score > 0 ? score : '-'}</span>
                  <span style="font-size:0.6875rem;color:var(--ui-text-3)">/100</span>
                </div>
              </div>
              <div style="height:6px;background:var(--ui-surface);border-radius:3px;overflow:hidden;margin-bottom:3px">
                <div id="cbar-${i}" style="height:100%;border-radius:3px;background:${s.color};width:0%;transition:width 1.3s cubic-bezier(0.4,0,0.2,1)"></div>
              </div>
              <div style="display:flex;justify-content:space-between">
                <span style="font-size:0.6875rem;color:var(--ui-text-3)">${compScores.length} intento(s)</span>
                <span style="font-size:0.6875rem;color:${s.color};font-weight:600">Practicar →</span>
              </div>`;
            compList.appendChild(div);
            setTimeout(() => { const bar = document.getElementById(`cbar-${i}`); if (bar) bar.style.width = `${score}%`; }, 350 + i * 80);
          });
        }
      }
    }

    if (rankingsR.status === 'fulfilled' && rankingsR.value.data && rankingsR.value.data.length > 0) {
      const ranking = rankingsR.value.data.find(r => r.periodType === 'GENERAL') ?? rankingsR.value.data[0];
      rankingsApi.getLeaderboard(ranking.rankingId, 0, 50).then(lbRes => {
        if (!lbRes.data) return;
        const items       = lbRes.data.content;
        const currentUser = getUser();
        const medals      = ['🥇', '🥈', '🥉'];
        const rankList    = document.getElementById('ranking-list');
        if (rankList) {
          items.slice(0, 5).forEach((r, i) => {
            const div = document.createElement('div');
            div.style.cssText = 'display:flex;align-items:center;gap:10px;padding:6px 8px;border-radius:10px;transition:background 0.15s;cursor:default';
            div.onmouseenter = () => div.style.background = 'var(--ui-surface)';
            div.onmouseleave = () => div.style.background = '';
            div.innerHTML = `
              <span style="font-size:0.9375rem;min-width:26px;text-align:center">${medals[i] ?? (i + 1)}</span>
              <div style="flex:1;min-width:0"><p style="font-size:0.8125rem;font-weight:700;color:var(--ui-text-1);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${r.studentName ?? r.studentId}</p><p style="font-size:0.6875rem;color:var(--ui-text-3);margin:0">Prog. ${r.programId}</p></div>
              <span style="font-size:0.9375rem;font-weight:900;color:var(--brand);flex-shrink:0">${Number(r.totalScore).toFixed(1)}</span>`;
            rankList.appendChild(div);
          });
        }
        const myIdx = currentUser ? items.findIndex(r => r.studentId === currentUser.id) : -1;
        if (myIdx >= 0) {
          const me = items[myIdx];
          const myRankCard  = document.getElementById('my-rank-card');
          if (myRankCard) myRankCard.style.display = 'block';
          const myRankNum   = document.getElementById('my-rank-num');
          const myRankName  = document.getElementById('my-rank-name');
          const myRankScore = document.getElementById('my-rank-score');
          if (myRankNum)   myRankNum.textContent   = String(myIdx + 1);
          if (myRankName)  myRankName.textContent  = me.studentName ?? currentUser!.id;
          if (myRankScore) myRankScore.textContent = Number(me.totalScore).toFixed(1);
          setStatVal('stat-rank', `#${myIdx + 1}`);
        }
      }).catch(() => {});
    }

  }).catch(err => {
    toast.error('Error al cargar datos');
  });
}

function calcStreak(finished: any[]): number {
  if (finished.length === 0) return 0;
  const days = [...new Set(
    finished.map(t => {
      const d = new Date(t.finishedAt ?? t.attemptTimestamp);
      return `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
    })
  )].sort((a, b) => (a < b ? 1 : -1));
  let streak = 1;
  for (let i = 0; i < days.length - 1; i++) {
    const curr = new Date(days[i]);
    const next = new Date(days[i + 1]);
    const diff = (curr.getTime() - next.getTime()) / (1000 * 60 * 60 * 24);
    if (Math.round(diff) === 1) streak++;
    else break;
  }
  return streak;
}
</script>