---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
const apiBase = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
---

<BaseLayout title="Inicio" description="Plataforma inteligente de preparación Saber Pro — UFPSO">

<style>
  :root {
    --rp-primary: #D41224;
    --rp-dark:    #9B1F24;
    --rp-light:   #FF2D42;
    --rp-muted:   #C0000E;
  }

  * { box-sizing: border-box; }

  body {
    font-family: var(--font-sans);
    background: var(--ui-bg);
    color: var(--ui-text-1);
    overflow-x: hidden;
  }

  /* ── NAVBAR ─────────────────────────────────────────────── */
#navbar {
  position: fixed; top: 0; width: 100%; z-index: 50;
  transition: background 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
}
#navbar.scrolled {
  background: var(--ui-overlay);
  backdrop-filter: blur(20px);
  box-shadow: 0 2px 20px rgba(212,18,36,0.06);
}
  .nav-inner {
    max-width: 75rem; margin: 0 auto; padding: 0 1.5rem;
    height: 64px; display: flex; align-items: center;
    justify-content: space-between; gap: 1rem;
  }
  .nav-logo {
    display: flex; align-items: center; gap: 0.5rem;
    text-decoration: none; font-weight: 800; font-size: 1.1rem;
    color: var(--ui-text-1);
  }
  .nav-logo-icon {
    width: 34px; height: 34px;
    background: linear-gradient(135deg, var(--rp-primary), var(--rp-dark));
    border-radius: 9px; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 3px 12px rgba(212,18,36,0.35);
  }
  .nav-logo span { color: var(--rp-primary); }
  .nav-links {
    display: none; list-style: none; margin: 0; padding: 0;
    align-items: center; gap: 0.25rem;
  }
  @media (min-width: 768px) { .nav-links { display: flex; } }
  .nav-link {
    display: block; padding: 0.375rem 0.75rem; border-radius: 0.5rem;
    font-size: 0.875rem; font-weight: 500; color: var(--ui-text-2);
    text-decoration: none; transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover { color: var(--ui-text-1); background: var(--ui-hover); }
  .btn-primary-nav {
    background: linear-gradient(135deg, var(--rp-primary), var(--rp-dark));
    color: white; padding: 0.4rem 1.125rem; border-radius: 10px;
    font-size: 0.875rem; font-weight: 600; text-decoration: none;
    box-shadow: 0 3px 14px rgba(212,18,36,0.3); transition: all 0.2s;
  }
  .btn-primary-nav:hover {
    box-shadow: 0 6px 22px rgba(212,18,36,0.45); transform: translateY(-1px);
  }
  .nav-ctas { display: flex; align-items: center; gap: 0.75rem; }
  .nav-signin-link {
    font-size: 0.875rem; color: var(--ui-text-2);
    text-decoration: none; transition: color 0.2s;
  }
  .nav-signin-link:hover { color: var(--rp-primary); }

  /* ── HERO ───────────────────────────────────────────────── */
  .hero {
    min-height: 100vh; display: flex; align-items: center;
    padding: 7rem 1.5rem 4rem; position: relative;
  }
  .hero-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .orb {
    position: absolute; border-radius: 50%; filter: blur(90px);
    animation: orbFloat 14s ease-in-out infinite;
  }
  @keyframes orbFloat {
    0%,100% { transform: translate(0,0); }
    33%      { transform: translate(20px,-15px); }
    66%      { transform: translate(-10px,18px); }
  }
  .orb-1 { width: 480px; height: 480px; top: -80px; left: 8%; background: rgba(212,18,36,0.07); }
  .orb-2 { width: 340px; height: 340px; top: 40%; right: 4%; background: rgba(160,13,27,0.05); animation-delay: -5s; }
  .grid-overlay {
    background-image:
      linear-gradient(rgba(212,18,36,0.8) 1px, transparent 1px),
      linear-gradient(to right, rgba(212,18,36,0.8) 1px, transparent 1px);
    background-size: 60px 60px; opacity: 0.03;
  }
  .hero-inner {
    max-width: 75rem; margin: 0 auto; width: 100%;
    display: grid; gap: 3rem; align-items: center;
  }
  @media (min-width: 1024px) { .hero-inner { grid-template-columns: 1fr 1fr; } }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.375rem 1rem; border-radius: 99px;
    border: 1px solid rgba(212,18,36,0.4); background: rgba(212,18,36,0.08);
    font-size: 0.75rem; font-weight: 600; color: var(--rp-muted);
    margin-bottom: 1.5rem;
    animation: fadeUp 0.6s ease both;
  }
  html.dark .hero-badge { color: #F87171; }

  .pulse {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--rp-primary);
    animation: ping 2s ease-in-out infinite;
  }
  @keyframes ping {
    0%,100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.4; transform: scale(1.6); }
  }

  .hero-headline {
    font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; line-height: 1.08;
    margin: 0 0 1.25rem; letter-spacing: -1px;
    color: var(--ui-text-1);
    animation: fadeUp 0.6s 0.1s ease both;
  }
  .text-gradient {
    background: linear-gradient(135deg, var(--rp-primary) 0%, var(--rp-light) 60%, var(--rp-muted) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .hero-sub {
    font-size: 1.0625rem; color: var(--ui-text-2); line-height: 1.75;
    margin: 0 0 2rem; max-width: 30rem;
    animation: fadeUp 0.6s 0.2s ease both;
  }
  .hero-ctas {
    display: flex; flex-wrap: wrap; gap: 1rem;
    margin-bottom: 2rem;
    animation: fadeUp 0.6s 0.3s ease both;
  }
  .btn-hero-primary {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.875rem 1.75rem; border-radius: 12px;
    background: linear-gradient(135deg, var(--rp-primary), var(--rp-dark));
    color: white; font-weight: 700; font-size: 0.9375rem; text-decoration: none;
    box-shadow: 0 4px 20px rgba(212,18,36,0.3); transition: all 0.25s;
  }
  .btn-hero-primary:hover {
    transform: translateY(-1px); box-shadow: 0 8px 28px rgba(212,18,36,0.5);
  }
  .btn-hero-ghost {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.875rem 1.75rem; border-radius: 12px;
    border: 1px solid var(--ui-border-2);
    color: var(--ui-text-2);
    font-weight: 600; font-size: 0.9375rem; text-decoration: none;
    transition: all 0.25s;
  }
  .btn-hero-ghost:hover {
    border-color: rgba(212,18,36,0.5); color: var(--rp-primary);
    background: rgba(212,18,36,0.04);
  }

  /* ── HERO CARD ──────────────────────────────────────────── */
  .hero-card {
    background: var(--ui-card);
    border: 1px solid var(--ui-border);
    border-radius: 20px; padding: 1.75rem;
    box-shadow: 0 12px 48px rgba(212,18,36,0.08);
    transition: background 0.25s, border-color 0.25s;
  }

  /* Badge "Activo" en la hero card — definido correctamente */
  .hero-card-badge {
    display: inline-block;
    padding: 4px 12px; border-radius: 20px;
    font-size: 0.625rem; font-weight: 700; letter-spacing: 0.04em;
    background: rgba(5,150,105,0.12);
    color: #059669;
    border: 1px solid rgba(5,150,105,0.3);
    flex-shrink: 0;
  }
  html.dark .hero-card-badge {
    background: rgba(5,150,105,0.18);
    border-color: rgba(5,150,105,0.4);
  }

  .hero-card-header-title {
    font-size: 0.625rem; text-transform: uppercase;
    letter-spacing: 0.18em; color: var(--ui-text-3); margin: 0 0 3px;
  }
  .hero-card-subtitle {
    font-size: 0.9375rem; font-weight: 600; color: var(--ui-text-1); margin: 0;
  }

  /* Barra de progreso de competencias */
  .comp-bar-row {
    display: flex; justify-content: space-between;
    font-size: 0.75rem; margin-bottom: 5px;
  }
  .comp-bar-name  { color: var(--ui-text-2); }

  /* Track de la barra */
  .hero-bar-track {
    height: 6px;
    background: var(--ui-surface);
    border: 1px solid var(--ui-border);
    border-radius: 3px; overflow: hidden;
  }

  /* Cajas de estadísticas en la hero card */
  .hero-stat-box {
    background: rgba(212,18,36,0.05);
    border: 1px solid rgba(212,18,36,0.12);
    border-radius: 10px; padding: 10px 8px; text-align: center;
    transition: background 0.25s;
  }
  html.dark .hero-stat-box {
    background: rgba(212,18,36,0.08);
    border-color: rgba(212,18,36,0.22);
  }
  .hero-stat-val {
    font-size: 1.0625rem; font-weight: 900;
    color: var(--ui-text-1); margin: 0; line-height: 1;
  }
  .hero-stat-lbl {
    font-size: 0.625rem; color: var(--ui-text-3); margin: 2px 0 0;
  }

  /* ── STATS BAR ──────────────────────────────────────────── */
  .stats-bar {
    border-top: 1px solid var(--ui-border);
    border-bottom: 1px solid var(--ui-border);
    padding: 3rem 1.5rem;
    background: var(--ui-surface);
    transition: background 0.25s, border-color 0.25s;
  }
  .stats-inner {
    max-width: 75rem; margin: 0 auto;
    display: grid; grid-template-columns: repeat(2,1fr); gap: 2rem; text-align: center;
  }
  @media (min-width: 768px) { .stats-inner { grid-template-columns: repeat(4,1fr); } }
  .stat-item { transition: transform 0.3s; }
  .stat-item:hover { transform: scale(1.04); }
  .stat-value {
    font-size: clamp(2.25rem, 4vw, 3rem); font-weight: 900; line-height: 1;
    margin: 0 0 0.25rem;
    background: linear-gradient(135deg, var(--rp-primary), var(--rp-light), var(--rp-muted));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .stat-label {
    font-size: 0.6875rem; color: var(--ui-text-3);
    text-transform: uppercase; letter-spacing: 0.2em;
  }

  /* ── HOW IT WORKS ───────────────────────────────────────── */
  .section { padding: 6rem 1.5rem; }
  .section-inner { max-width: 75rem; margin: 0 auto; }
  .section-label {
    display: inline-block; font-size: 0.625rem; text-transform: uppercase;
    letter-spacing: 0.22em; color: var(--rp-primary); font-weight: 700; margin-bottom: 0.75rem;
  }
  .section-title {
    font-size: clamp(1.875rem, 4vw, 2.875rem); font-weight: 900;
    margin: 0 0 1rem; letter-spacing: -0.5px; line-height: 1.1;
    color: var(--ui-text-1);
  }
  .section-sub {
    font-size: 1.0625rem; color: var(--ui-text-2);
    max-width: 36rem; line-height: 1.7;
  }
  .cards-grid { display: grid; gap: 1.25rem; margin-top: 3rem; }
  @media (min-width: 768px) { .cards-grid { grid-template-columns: repeat(3,1fr); } }
  .how-card {
    background: var(--ui-card);
    border: 1px solid var(--ui-border);
    border-radius: 18px; padding: 1.75rem;
    transition: all 0.35s;
    box-shadow: 0 2px 8px rgba(212,18,36,0.04);
  }
  .how-card:hover {
    border-color: rgba(212,18,36,0.4); transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(212,18,36,0.12);
  }
  .how-icon {
    width: 48px; height: 48px; border-radius: 13px;
    background: rgba(212,18,36,0.08);
    border: 1px solid rgba(212,18,36,0.25);
    display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;
  }
  .how-num {
    font-size: 3.5rem; font-weight: 900;
    color: rgba(212,18,36,0.06); line-height: 1; margin-bottom: 0.75rem;
  }
  html.dark .how-num { color: rgba(212,18,36,0.12); }
  .how-card:hover .how-num { color: rgba(212,18,36,0.12); }
  html.dark .how-card:hover .how-num { color: rgba(212,18,36,0.2); }
  .how-title { font-size: 1.125rem; font-weight: 800; color: var(--ui-text-1); margin: 0 0 0.625rem; }
  .how-text  { font-size: 0.875rem; color: var(--ui-text-2); line-height: 1.75; }

  /* ── CTA ────────────────────────────────────────────────── */
  .cta-section { padding: 5rem 1.5rem; }
  .cta-card {
    max-width: 52rem; margin: 0 auto; text-align: center;
    background: var(--ui-surface);
    border: 1px solid var(--ui-border);
    border-radius: 24px; padding: 4rem 2rem;
    box-shadow: 0 0 60px rgba(212,18,36,0.07);
    position: relative; overflow: hidden;
    transition: background 0.25s, border-color 0.25s;
  }
  .cta-title {
    font-size: clamp(1.75rem, 4vw, 3rem); font-weight: 900;
    margin: 0 0 1rem; letter-spacing: -0.5px;
    color: var(--ui-text-1);
  }
  .cta-sub {
    font-size: 1.0625rem; color: var(--ui-text-2);
    margin: 0 0 2.5rem; line-height: 1.7;
  }

  /* ── FOOTER ─────────────────────────────────────────────── */
  .footer {
    border-top: 1px solid var(--ui-border);
    padding: 3rem 1.5rem 2rem;
    background: var(--ui-card);
    transition: background 0.25s, border-color 0.25s;
  }
  .footer-inner { max-width: 75rem; margin: 0 auto; }
  .footer-copy { font-size: 0.75rem; color: var(--ui-text-3); margin: 0; }

  /* ── ANIMACIONES ─────────────────────────────────────────── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .reveal {
    opacity: 0; transform: translateY(18px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* ── AUTH-AWARE ──────────────────────────────────────────── */
  #nav-auth-logged  { display: none; }
  #nav-auth-guest   { display: flex; align-items: center; gap: 0.75rem; }
  #hero-cta-logged  { display: none; }
  #hero-cta-guest   { display: flex; }
</style>

<!-- Navbar -->
<header id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <div class="nav-logo-icon">
        <Icon name="tabler:brain" size={20} class="text-white"/>
      </div>
      Razona<span>Pro</span>
    </a>
    <ul class="nav-links">
      <li><a href="#como-funciona" class="nav-link">Cómo funciona</a></li>
      <li><a href="#simulacros" class="nav-link">Simulacros</a></li>
    </ul>
    <div class="nav-ctas">
      <!-- Guest -->
      <div id="nav-auth-guest">
        <a href="/auth" class="nav-signin-link">Iniciar sesión</a>
        <a href="/auth?tab=register" class="btn-primary-nav">Registrarse</a>
      </div>
      <!-- Logged in -->
      <a id="nav-auth-logged" href="/dashboard" class="btn-primary-nav">Mi panel</a>
    </div>
  </div>
</header>

<!-- Hero -->
<section class="hero">
  <div class="hero-bg">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="grid-overlay" style="position:absolute;inset:0;"></div>
  </div>
  <div class="hero-inner">
    <div>
      <div class="hero-badge">
        <span class="pulse"></span>
        Potenciado por IA Adaptativa e IRT
      </div>
      <h1 class="hero-headline">
        Tu éxito en el<br/>
        <span class="text-gradient">Saber Pro,</span><br/>
        impulsado por IA.
      </h1>
      <p class="hero-sub">
        RazonaPro ajusta la dificultad en tiempo real y te prepara con simulacros adaptativos.
        Supera las pruebas de Estado con un plan que evoluciona contigo.
      </p>

      <!-- CTAs invitados -->
      <div class="hero-ctas" id="hero-cta-guest">
        <a href="/auth?tab=register" class="btn-hero-primary">
          Comenzar gratis
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="#como-funciona" class="btn-hero-ghost">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          Cómo funciona
        </a>
      </div>

      <!-- CTAs autenticados -->
      <div class="hero-ctas" id="hero-cta-logged" style="display:none">
        <a href="/dashboard" class="btn-hero-primary">
          Ir a mi panel
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="/tests" class="btn-hero-ghost">
          Ver simulacros disponibles
        </a>
      </div>
    </div>

    <!-- Tarjeta decorativa -->
    <div style="position:relative">
      <div class="hero-card">
        <!-- Encabezado card -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;">
          <div>
            <p class="hero-card-header-title">Panel de Progreso</p>
            <h3 class="hero-card-subtitle">Calibración Adaptativa</h3>
          </div>
          <span class="hero-card-badge">Activo</span>
        </div>

        <!-- Barras de competencia -->
        <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:1.25rem;">
          {[
            { name: 'Lectura Crítica',        pct: 87, color: '#D41224' },
            { name: 'Razonamiento Cuant.',     pct: 74, color: '#2563EB' },
            { name: 'Comp. Ciudadanas',        pct: 91, color: '#059669' },
            { name: 'Comunicación Escrita',    pct: 83, color: '#7C3AED' },
          ].map(s => (
            <div>
              <div class="comp-bar-row">
                <span class="comp-bar-name">{s.name}</span>
                <span style={{ color: s.color, fontWeight: 600 }}>{s.pct}%</span>
              </div>
              <div class="hero-bar-track">
                <div
                  class="hero-bar"
                  style={{ height: '100%', borderRadius: '2px', background: `linear-gradient(to right, ${s.color}99, ${s.color})`, width: '0%' }}
                  data-pct={s.pct}
                ></div>
              </div>
            </div>
          ))}
        </div>

        <!-- Stats rápidas -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
          {[
            { val: '—', label: 'Simulacros',   id: 'hero-stat-tests'    },
            { val: '—', label: 'Satisfacción', id: 'hero-stat-avg'      },
            { val: '—', label: 'Estudiantes',  id: 'hero-stat-students' },
          ].map(s => (
            <div class="hero-stat-box">
              <p id={s.id} class="hero-stat-val">{s.val}</p>
              <p class="hero-stat-lbl">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats bar -->
<section class="stats-bar">
  <div class="stats-inner">
    <div class="stat-item reveal">
      <p class="stat-value"><span class="counter" data-target="0" id="stat-students">0</span>+</p>
      <p class="stat-label">Estudiantes Activos</p>
    </div>
    <div class="stat-item reveal" style="animation-delay:0.1s">
      <p class="stat-value"><span class="counter" data-target="0" id="stat-trieds">0</span>+</p>
      <p class="stat-label">Simulacros Realizados</p>
    </div>
    <div class="stat-item reveal" style="animation-delay:0.2s">
      <p class="stat-value"><span class="counter" data-target="0" id="stat-questions">0</span>+</p>
      <p class="stat-label">Preguntas Disponibles</p>
    </div>
    <div class="stat-item reveal" style="animation-delay:0.3s">
      <p class="stat-value"><span class="counter" data-target="0" id="stat-competences">0</span></p>
      <p class="stat-label">Competencias Saber Pro</p>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="section" id="como-funciona">
  <div class="section-inner">
    <div style="text-align:center;margin-bottom:1rem">
      <span class="section-label reveal">Proceso</span>
      <h2 class="section-title reveal">¿Cómo funciona <span class="text-gradient">RazonaPro</span>?</h2>
      <p class="section-sub reveal" style="margin:0 auto">
        Un ecosistema de aprendizaje adaptativo diseñado para maximizar tu desempeño.
      </p>
    </div>
    <div class="cards-grid">
      <div class="how-card reveal">
        <div class="how-num">01</div>
        <div class="how-icon">
          <svg width="22" height="22" fill="none" stroke="#D41224" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="how-title">Aprendizaje Personalizado</h3>
        <p class="how-text">Cada pregunta se adapta a tu nivel mediante IRT (Teoría de Respuesta al Ítem) y un modelo de lenguaje avanzado, identificando con precisión tus áreas de mejora.</p>
      </div>
      <div class="how-card reveal" style="animation-delay:0.1s">
        <div class="how-num">02</div>
        <div class="how-icon">
          <svg width="22" height="22" fill="none" stroke="#D41224" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
        </div>
        <h3 class="how-title">Retroalimentación Inmediata</h3>
        <p class="how-text">Recibe explicaciones detalladas generadas por IA especializada en el currículo Saber Pro, con pistas progresivas cuando las necesites.</p>
      </div>
