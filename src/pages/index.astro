<script>
  // Navbar scroll
  window.addEventListener('scroll', () => {
    document.getElementById('navbar')?.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });

  // Smooth scroll
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const target = document.querySelector(a.getAttribute('href') ?? '');
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
    });
  });

  // Animar barras de competencia en el hero
  setTimeout(() => {
    document.querySelectorAll<HTMLElement>('.hero-bar').forEach(bar => {
      bar.style.transition = 'width 1.2s cubic-bezier(0.4,0,0.2,1)';
      bar.style.width = `${bar.dataset.pct ?? 0}%`;
    });
  }, 500);

  // Reveal on scroll
  const revealObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); }
    });
  }, { threshold: 0.18 });
  document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

  // Counter animation
  function animCounter(el: HTMLElement, target: number) {
    const dur = 1600; const start = performance.now();
    function step(now: number) {
      const p    = Math.min((now - start) / dur, 1);
      const ease = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.floor(ease * target).toLocaleString('es-CO');
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = target.toLocaleString('es-CO');
    }
    requestAnimationFrame(step);
  }
  (window as any).__animCounter = animCounter;

  const counterObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      animCounter(el, Number(el.dataset.target ?? 0));
      counterObs.unobserve(el);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.counter').forEach(el => counterObs.observe(el));

  // UI según estado de auth
  (function checkAuth() {
    const token = localStorage.getItem('rp_token');
    if (!token) return;
    try {
      const p = JSON.parse(atob(token.split('.')[1]));
      if (typeof p.exp === 'number' && p.exp * 1000 > Date.now()) {
        document.getElementById('nav-auth-guest')!.style.display  = 'none';
        document.getElementById('nav-auth-logged')!.style.display = 'flex';
        document.getElementById('hero-cta-guest')!.style.display  = 'none';
        document.getElementById('hero-cta-logged')!.style.display = 'flex';
        const ctaBtn = document.getElementById('cta-main-btn') as HTMLAnchorElement;
        if (ctaBtn) { ctaBtn.href = '/dashboard'; ctaBtn.textContent = 'Ir a mi panel'; }
      }
    } catch {}
  })();
</script>

<script define:vars={{ apiBase }}>
  const MOCK = {
    activeStudents: 2847, completedTrieds: 12530,
    totalQuestions: 2150, activeCompetences: 6,
    totalTests: 42, satisfactionRate: 94,
  };

  function applyStats(d) {
    const setTarget = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.dataset.target = String(val);
    };
    setTarget('stat-students',    d.activeStudents);
    setTarget('stat-trieds',      d.completedTrieds);
    setTarget('stat-questions',   d.totalQuestions);
    setTarget('stat-competences', d.activeCompetences);

    const heroTests    = document.getElementById('hero-stat-tests');
    const heroAvg      = document.getElementById('hero-stat-avg');
    const heroStudents = document.getElementById('hero-stat-students');
    if (heroTests)    heroTests.textContent    = String(d.totalTests);
    if (heroAvg)      heroAvg.textContent      = Number(d.satisfactionRate).toFixed(0) + '%';
    if (heroStudents) heroStudents.textContent = String(d.activeStudents);

    const animFn = window.__animCounter;
    if (animFn) {
      document.querySelectorAll('.counter').forEach(el => {
        const t = Number(el.dataset.target ?? 0);
        if (t > 0) animFn(el, t);
      });
    }
  }

  fetch(apiBase + '/api/stats/home')
    .then(r => { if (!r.ok) throw new Error(); return r.json(); })
    .then(json => {
      const d = json.data ?? json;
      if (d?.activeStudents !== undefined) applyStats(d);
      else applyStats(MOCK);
    })
    .catch(() => applyStats(MOCK));
</script>

