---
// RazonaPro — Landing Page
// Universidad Francisco de Paula Santander Ocaña
// Trabajo de Grado · Ingeniería de Sistemas · 2026
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="RazonaPro — Sistema inteligente con Transfer Learning para la gestión de simulacros Saber Pro. UFPSO." />
  <title>RazonaPro | Domina el Saber Pro con IA Adaptativa</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />


<!-- ─── STYLES ─────────────────────────────────────────────────────── -->
<style is:global>
  /* ── CSS Variables ─────────────────────────────────── */
  :root {
    --rp-primary:    #D41224;
    --rp-light:      #FF2D42;
    --rp-muted:      #C0000E;
    --rp-dark:       #A00D1B;
    --rp-deeper:     #6B0812;
    --rp-darkest:    #3D0409;
    --bg-primary:    #FFFFFF;
    --bg-secondary:  #FDF5F5;
    --bg-card:       #FFFFFF;
    --bg-section:    #FBF0F1;
    --rp-border:     rgba(212,18,36,0.14);
    --rp-text:       #12030A;
    --rp-text-sec:   #5A2028;
    --rp-text-muted: #8B5A60;
    --rp-shadow:     rgba(212,18,36,0.1);
  }

  /* ── Typography ─────────────────────────────────────── */
  .font-display { font-family: 'Syne', sans-serif; }
  .font-body    { font-family: 'DM Sans', sans-serif; }
  body          { font-family: 'DM Sans', sans-serif; }

  /* ── Color Utilities ────────────────────────────────── */
  .bg-rp-bg       { background-color: var(--bg-primary); }
  .bg-rp-card     { background-color: var(--bg-card); }
  .text-rp-primary{ color: var(--rp-primary); }
  .text-rp-muted  { color: var(--rp-muted); }
  .text-rp-text   { color: var(--rp-text); }
  .border-rp-border{ border-color: var(--rp-border); }

  .text-gradient {
    background: linear-gradient(135deg, var(--rp-primary) 0%, var(--rp-light) 50%, var(--rp-muted) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Keyframes ───────────────────────────────────────── */
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-left {
    from { opacity: 0; transform: translateX(40px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes orb-float {
    0%,100% { transform: translate(0,0) scale(1); }
    33%     { transform: translate(20px,-15px) scale(1.05); }
    66%     { transform: translate(-10px,20px) scale(0.95); }
  }
  @keyframes ping-slow {
    0%,100% { opacity: 1; transform: scale(1); }
    50%     { opacity: 0.4; transform: scale(1.6); }
  }
  @keyframes bounce-slow {
    0%,100% { transform: translateY(0) translateX(-50%); }
    50%     { transform: translateY(7px) translateX(-50%); }
  }
  @keyframes bar-grow {
    from { width: 0; }
  }
  @keyframes reveal-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes ticker {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Hero entrance animations ─────────────────────── */
  .hero-badge    { animation: fade-up .6s ease both; }
  .hero-headline { animation: fade-up .6s .12s ease both; }
  .hero-sub      { animation: fade-up .6s .22s ease both; }
  .hero-ctas     { animation: fade-up .6s .32s ease both; }
  .hero-trust    { animation: fade-up .6s .42s ease both; }
  .hero-widget   { animation: fade-left .7s .18s ease both; }

  /* ── Scroll reveal ───────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity .55s ease, transform .55s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Background elements ─────────────────────────── */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    animation: orb-float 12s ease-in-out infinite;
  }
  .orb-1 {
    width: 500px; height: 500px;
    top: -100px; left: 10%;
    background: rgba(212,18,36,0.08);
    animation-duration: 14s;
  }
  .orb-2 {
    width: 350px; height: 350px;
    top: 40%; right: 5%;
    background: rgba(160,13,27,0.06);
    animation-duration: 10s;
    animation-delay: -4s;
  }
  .orb-3 {
    width: 400px; height: 400px;
    bottom: 10%; left: 20%;
    background: rgba(107,8,18,0.05);
    animation-duration: 16s;
    animation-delay: -8s;
  }
  .grid-overlay {
    background-image:
      linear-gradient(rgba(212,18,36,1) 1px, transparent 1px),
      linear-gradient(to right, rgba(212,18,36,1) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.04;
  }
  .noise-overlay {
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 128px 128px;
  }

  /* ── Navbar ──────────────────────────────────────── */
  #navbar.scrolled {
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--rp-border);
    box-shadow: 0 2px 20px rgba(212,18,36,0.06);
  }
  .nav-link {
    color: rgba(18,3,10,0.55);
    transition: color .2s;
    position: relative;
    padding-bottom: 2px;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px; left: 0;
    height: 1px; width: 0;
    background: var(--rp-primary);
    transition: width .25s ease;
  }
  .nav-link:hover { color: var(--rp-text); }
  .nav-link:hover::after { width: 100%; }
  .mobile-nav-link {
    color: rgba(18,3,10,0.6);
    transition: color .2s;
    font-size: 0.9rem;
  }
  .mobile-nav-link:hover { color: var(--rp-primary); }

  /* ── Buttons ─────────────────────────────────────── */
  .btn-primary {
    background: linear-gradient(135deg, var(--rp-primary) 0%, var(--rp-dark) 100%);
    color: white;
    border: 1px solid rgba(212,18,36,0.4);
    box-shadow: 0 4px 20px rgba(212,18,36,0.3), inset 0 1px 0 rgba(255,255,255,0.1);
    transition: all .25s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 60%);
    opacity: 0;
    transition: opacity .25s;
  }
  .btn-primary:hover {
    box-shadow: 0 6px 28px rgba(212,18,36,0.5), inset 0 1px 0 rgba(255,255,255,0.15);
    transform: translateY(-1px);
  }
  .btn-primary:hover::before { opacity: 1; }
  .btn-primary:active { transform: translateY(0); }
  .btn-primary:disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .btn-ghost {
    color: rgba(18,3,10,0.7);
    border: 1px solid rgba(18,3,10,0.18);
    transition: all .25s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .btn-ghost:hover {
    border-color: rgba(212,18,36,0.5);
    color: var(--rp-primary);
    background: rgba(212,18,36,0.05);
  }

  /* ── Logo Icon ───────────────────────────────────── */
  .logo-icon {
    background: linear-gradient(135deg, var(--rp-primary) 0%, var(--rp-deeper) 100%);
    box-shadow: 0 0 16px rgba(212,18,36,0.4);
  }

  /* ── Pulse dot ───────────────────────────────────── */
  .pulse-dot {
    animation: ping-slow 2s ease-in-out infinite;
  }

  /* ── Scroll cue ─────────────────────────────────── */
  .scroll-cue {
    animation: bounce-slow 2.5s ease-in-out infinite;
  }

  /* ── Avatar dots ─────────────────────────────────── */
  .avatar-dot {
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 800;
    color: white;
    font-family: 'Syne', sans-serif;
  }

  /* ── Card Glass ──────────────────────────────────── */
  .card-glass {
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(212,18,36,0.18);
    box-shadow: 0 8px 40px rgba(212,18,36,0.08), 0 2px 8px rgba(0,0,0,0.04);
  }

  /* ── Status Badge ────────────────────────────────── */
  .status-badge {
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    background: rgba(16,185,129,0.15);
    color: #34d399;
    border-radius: 20px;
    border: 1px solid rgba(16,185,129,0.3);
  }

  /* ── Skill Bars ──────────────────────────────────── */
  .skill-bar-item .skill-label-row {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-bottom: 6px;
  }
  .skill-bar-item .skill-label { color: rgba(18,3,10,0.6); }
  .skill-bar-item .skill-val   { color: var(--rp-primary); font-weight: 600; }
  .skill-bar-item .skill-track {
    height: 6px;
    background: rgba(212,18,36,0.08);
    border-radius: 3px;
    overflow: hidden;
  }
  .skill-bar-item .skill-fill {
    height: 100%;
    border-radius: 3px;
    width: 0;
    transition: width 1.2s cubic-bezier(.25,.46,.45,.94);
    background: linear-gradient(to right, var(--rp-dark), var(--rp-primary), var(--rp-light));
  }

  /* ── AI Box ──────────────────────────────────────── */
  .ai-box {
    background: rgba(212,18,36,0.05);
    border: 1px solid rgba(212,18,36,0.2);
  }
  .ai-icon-wrap {
    background: rgba(212,18,36,0.1);
    border: 1px solid rgba(212,18,36,0.25);
  }

  /* ── Mini Stats ──────────────────────────────────── */
  .mini-stat {
    background: rgba(212,18,36,0.04);
    border-radius: 10px;
    padding: 10px 8px;
    text-align: center;
    border: 1px solid rgba(212,18,36,0.1);
    display: flex; flex-direction: column; gap: 2px;
  }
  .mini-stat-val   { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 800; color: var(--rp-text); }
  .mini-stat-label { font-size: 10px; color: var(--rp-text-muted); }

  /* ── Stats Section ───────────────────────────────── */
  .stats-bg {
    background: linear-gradient(to right, #FBF0F1 0%, #FDF5F5 50%, #FBF0F1 100%);
  }
  .stat-card { transition: transform .3s ease; }
  .stat-card:hover { transform: scale(1.03); }

  /* ── Section Label ───────────────────────────────── */
  .section-label {
    display: inline-block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .22em;
    color: var(--rp-primary);
    font-weight: 700;
    margin-bottom: 12px;
  }

  /* ── How Cards ───────────────────────────────────── */
  .how-card {
    background: #FFFFFF;
    border: 1px solid rgba(212,18,36,0.12);
    border-radius: 18px;
    padding: 1px;
    transition: all .4s ease;
    cursor: default;
    box-shadow: 0 2px 12px rgba(212,18,36,0.04);
  }
  .how-card:hover {
    border-color: rgba(212,18,36,0.35);
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(212,18,36,0.12);
  }
  .how-card-inner { padding: 28px; height: 100%; }
  .how-icon-wrap {
    width: 48px; height: 48px;
    border-radius: 13px;
    background: rgba(212,18,36,0.08);
    border: 1px solid rgba(212,18,36,0.25);
    display: flex; align-items: center; justify-content: center;
  }
  .how-step {
    font-family: 'Syne', sans-serif;
    font-size: 52px;
    font-weight: 900;
    color: rgba(212,18,36,0.06);
    line-height: 1;
    transition: color .4s;
  }
  .how-card:hover .how-step { color: rgba(212,18,36,0.12); }
  .how-line {
    width: 0;
    height: 1px;
    background: linear-gradient(to right, var(--rp-primary), transparent);
    margin-top: 24px;
    transition: width .5s ease;
  }

  /* ── Features Background ─────────────────────────── */
  .features-bg-stripe {
    background: linear-gradient(180deg,
      transparent 0%,
      rgba(251,240,241,0.7) 30%,
      rgba(251,240,241,0.9) 70%,
      transparent 100%
    );
  }

  /* ── Feat Check Items ────────────────────────────── */
  .feat-check {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
    color: rgba(18,3,10,0.65);
    transition: color .2s;
  }
  .feat-check:hover { color: var(--rp-text); }
  .feat-check-icon {
    width: 20px; height: 20px;
    border-radius: 50%;
    background: rgba(212,18,36,0.08);
    border: 1px solid rgba(212,18,36,0.35);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    color: var(--rp-primary);
    transition: background .2s, border-color .2s;
  }
  .feat-check:hover .feat-check-icon {
    background: var(--rp-primary);
    border-color: var(--rp-light);
    color: white;
  }

  /* ── Feat Tiles ──────────────────────────────────── */
  .feat-tile {
    background: #FFFFFF;
    border: 1px solid rgba(212,18,36,0.12);
    border-radius: 14px;
    padding: 20px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    transition: all .3s ease;
    box-shadow: 0 2px 8px rgba(212,18,36,0.04);
  }
  .feat-tile:hover {
    border-color: rgba(212,18,36,0.35);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(212,18,36,0.1);
  }
  .feat-tile-icon {
    width: 40px; height: 40px;
    border-radius: 11px;
    background: rgba(212,18,36,0.08);
    border: 1px solid rgba(212,18,36,0.25);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  /* ── Quiz ─────────────────────────────────────────── */
  .comp-badge {
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 700;
    background: rgba(212,18,36,0.15);
    color: var(--rp-muted);
    border-radius: 20px;
    border: 1px solid rgba(212,18,36,0.3);
  }
  .quiz-opt {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid rgba(18,3,10,0.1);
    text-align: left;
    cursor: pointer;
    transition: all .2s ease;
    background: rgba(18,3,10,0.02);
  }
  .quiz-opt:hover {
    border-color: rgba(212,18,36,0.4);
    background: rgba(212,18,36,0.04);
  }
  .quiz-opt.selected {
    border-color: rgba(212,18,36,0.5);
    background: rgba(212,18,36,0.07);
  }
  .quiz-opt.correct {
    border-color: rgba(16,185,129,0.5);
    background: rgba(16,185,129,0.06);
  }
  .quiz-opt.incorrect {
    border-color: rgba(239,68,68,0.4);
    background: rgba(239,68,68,0.05);
  }
  .opt-letter {
    width: 30px; height: 30px;
    border-radius: 8px;
    border: 1px solid rgba(18,3,10,0.15);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: rgba(18,3,10,0.45);
    flex-shrink: 0;
    transition: all .2s;
  }
  .quiz-opt.selected .opt-letter {
    background: rgba(212,18,36,0.1);
    border-color: var(--rp-primary);
    color: var(--rp-primary);
  }
  .quiz-opt.correct .opt-letter {
    background: rgba(16,185,129,0.15);
    border-color: #059669;
    color: #059669;
  }
  .quiz-opt.incorrect .opt-letter {
    background: rgba(239,68,68,0.12);
    border-color: #dc2626;
    color: #dc2626;
  }
  .opt-text { font-size: 13.5px; color: rgba(18,3,10,0.65); transition: color .2s; }
  .quiz-opt:hover .opt-text,
  .quiz-opt.selected .opt-text { color: var(--rp-text); }

  /* ── CTA Card ─────────────────────────────────────── */
  .cta-card {
    border: 1px solid rgba(212,18,36,0.2);
    background: linear-gradient(135deg, #FDF5F5 0%, #FBF0F1 100%);
    box-shadow: 0 0 80px rgba(212,18,36,0.08), 0 20px 60px rgba(0,0,0,0.06);
  }

  /* ── Footer ───────────────────────────────────────── */
  .footer-link {
    display: block;
    font-size: 13.5px;
    color: rgba(18,3,10,0.45);
    transition: color .2s;
  }
  .footer-link:hover { color: var(--rp-primary); }

  /* ── Scrollbar ───────────────────────────────────── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: #FDF5F5; }
  ::-webkit-scrollbar-thumb {
    background: rgba(212,18,36,0.3);
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover { background: var(--rp-primary); }

  /* ── Selection ───────────────────────────────────── */
  ::selection {
    background: rgba(212,18,36,0.35);
    color: white;
  }
</style>
</head>

<body class="bg-white text-rp-text antialiased overflow-x-hidden font-body">

  <!-- ─── AMBIENT BACKGROUND ─────────────────────────────────────────── -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="grid-overlay"></div>
    <div class="noise-overlay"></div>
  </div>

  <!-- ─── NAVBAR ─────────────────────────────────────────────────────── -->
  <header id="navbar" class="fixed top-0 w-full z-50 transition-all duration-500">
    <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" aria-label="RazonaPro inicio">
        <div class="logo-icon w-9 h-9 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:scale-105">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polygon points="9,1 17,5.5 17,12.5 9,17 1,12.5 1,5.5" fill="white" fill-opacity="0.2" stroke="white" stroke-width="1"/>
            <polygon points="9,4.5 13.5,7 13.5,11 9,13.5 4.5,11 4.5,7" fill="white" fill-opacity="0.6"/>
            <circle cx="9" cy="9" r="2.2" fill="white"/>
          </svg>
        </div>
        <span class="font-display text-xl font-extrabold tracking-tight text-gray-900">
          Razona<span class="text-rp-primary">Pro</span>
        </span>
      </a>

      <!-- Desktop Links -->
      <div class="hidden md:flex items-center gap-7">
        <a href="#como-funciona" class="nav-link text-sm font-medium">Cómo funciona</a>
        <a href="#caracteristicas" class="nav-link text-sm font-medium">Características</a>
        <a href="#simulacros" class="nav-link text-sm font-medium">Simulacros</a>
        <a href="#contacto" class="nav-link text-sm font-medium">Contacto</a>
      </div>

      <!-- CTA Buttons -->
      <div class="flex items-center gap-3">
        <a href="/login" class="hidden md:inline-block text-sm text-gray-600 hover:text-gray-900 transition-colors px-3 py-2 rounded-lg hover:bg-gray-50">
          Iniciar sesión
        </a>
        <a href="/registro" class="btn-primary text-sm px-5 py-2.5 rounded-xl font-semibold">
          Registrarse
        </a>
        <!-- Hamburger -->
        <button id="menu-btn" class="md:hidden p-2 text-gray-700 hover:text-gray-900 transition-colors" aria-label="Menú móvil" aria-expanded="false">
          <svg id="icon-open" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="hidden" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-rp-border bg-white/95 backdrop-blur-xl px-6 py-5">
      <div class="flex flex-col gap-4">
        <a href="#como-funciona" class="mobile-nav-link">Cómo funciona</a>
        <a href="#caracteristicas" class="mobile-nav-link">Características</a>
