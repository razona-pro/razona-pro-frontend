---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="Acceso al portal">
  <div class="auth-bg" aria-hidden="true">
    <div class="auth-orb orb-1"></div>
    <div class="auth-orb orb-2"></div>
  </div>

  <main class="auth-main">
    <div class="auth-card" id="auth-card">

      <!-- ── LEFT: Forms ── -->
      <div class="auth-forms">

        <!-- VIEW: LOGIN -->
        <div class="auth-view" id="view-login">
          <div class="auth-form-wrap">
            <div class="auth-logo" aria-label="RazonaPro">
              <div class="auth-logo-icon">
                <Icon name="tabler:brain" size={20} class="text-white"/>
              </div>
              <span>Razona<strong>Pro</strong></span>
            </div>
            <h1 class="auth-title">Iniciar sesión</h1>
            <p class="auth-sub">Bienvenido de nuevo</p>

            <div id="login-msg" class="auth-msg" style="display:none"></div>

            <form id="login-form" novalidate>
              <div class="field-group">
                <label for="l-code">Código</label>
                <div class="field-wrap">
                  <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="4" y="3" width="12" height="14" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 7h6M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  <input id="l-code" type="text" placeholder="0190000 o AMN001" autocomplete="username" required />
                </div>
              </div>
              <div class="field-group">
                <label for="l-email">Correo electrónico</label>
                <div class="field-wrap">
                  <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="3" y="5" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M3 5l7 6 7-6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                  <input id="l-email" type="email" placeholder="tu@ufpso.edu.co" autocomplete="email" required />
                </div>
              </div>
              <div class="field-group">
                <label for="l-password">Contraseña</label>
                <div class="field-wrap">
                  <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="5" y="9" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 9V6.5a3 3 0 016 0V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  <input id="l-password" type="password" placeholder="••••••••" autocomplete="current-password" required />
                  <button type="button" class="toggle-pw" data-target="l-password" aria-label="Mostrar contraseña">
                    <svg viewBox="0 0 20 20" fill="none" width="15" height="15"><ellipse cx="10" cy="10" rx="7" ry="4.5" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
                  </button>
                </div>
              </div>
              <button type="button" class="forgot-link" id="go-forgot">¿Olvidaste tu contraseña?</button>
              <button type="submit" id="login-btn" class="auth-btn">
                <span id="login-label">Ingresar</span>
                <svg viewBox="0 0 16 16" fill="none" width="14" height="14"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </form>

            <p class="auth-switch">
              ¿No tienes cuenta?
              <button type="button" id="go-register-mobile" class="switch-btn">Regístrate</button>
            </p>
            <a href="/" class="back-home">← Volver al inicio</a>
          </div>
        </div>

        <!-- VIEW: REGISTER -->
        <div class="auth-view" id="view-register" style="display:none">
          <div class="auth-form-wrap">
            <div class="auth-logo" aria-label="RazonaPro">
              <div class="auth-logo-icon">
                <Icon name="tabler:brain" size={20} class="text-white"/>
              </div>
              <span>Razona<strong>Pro</strong></span>
            </div>
            <h1 class="auth-title">Crear cuenta</h1>
            <p class="auth-sub">Completa tu información</p>

            <div id="register-msg" class="auth-msg" style="display:none"></div>

            <form id="register-form" novalidate>
              <div class="fields-grid">
                <div class="field-group">
                  <label for="r-fname">Primer nombre *</label>
                  <div class="field-wrap"><input id="r-fname" type="text" placeholder="Juan" required maxlength="15" /></div>
                </div>
                <div class="field-group">
                  <label for="r-mname">Segundo nombre</label>
                  <div class="field-wrap"><input id="r-mname" type="text" placeholder="Carlos" maxlength="15" /></div>
                </div>
                <div class="field-group">
                  <label for="r-lname1">Primer apellido *</label>
                  <div class="field-wrap"><input id="r-lname1" type="text" placeholder="Pérez" required maxlength="15" /></div>
                </div>
                <div class="field-group">
                  <label for="r-lname2">Segundo apellido</label>
                  <div class="field-wrap"><input id="r-lname2" type="text" placeholder="García" maxlength="15" /></div>
                </div>
                <div class="field-group">
                  <label for="r-sid">Código de estudiante *</label>
                  <div class="field-wrap">
                    <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="4" y="3" width="12" height="14" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 7h6M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    <input id="r-sid" type="text" placeholder="0192270" required maxlength="7" pattern="[0-9]{7}" />
                  </div>
                </div>
                <div class="field-group">
                  <label for="r-phone">Celular *</label>
                  <div class="field-wrap">
                    <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="6" y="2" width="8" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="15" r="0.8" fill="currentColor"/></svg>
                    <input id="r-phone" type="tel" placeholder="+573001234567" required />
                  </div>
                </div>
                <div class="field-group field-full">
                  <label for="r-email">Correo institucional *</label>
                  <div class="field-wrap">
                    <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="3" y="5" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M3 5l7 6 7-6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                    <input id="r-email" type="email" placeholder="tu@ufpso.edu.co" required />
                  </div>
                </div>
                <div class="field-group">
                  <label for="r-password">Contraseña *</label>
                  <div class="field-wrap">
                    <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="5" y="9" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 9V6.5a3 3 0 016 0V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    <input id="r-password" type="password" placeholder="Mín. 8 caracteres" required autocomplete="new-password" />
                    <button type="button" class="toggle-pw" data-target="r-password" aria-label="Ver contraseña">
                      <svg viewBox="0 0 20 20" fill="none" width="15" height="15"><ellipse cx="10" cy="10" rx="7" ry="4.5" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
                    </button>
                  </div>
                </div>
                <div class="field-group">
                  <label for="r-confirm">Confirmar *</label>
                  <div class="field-wrap">
                    <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="5" y="9" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 9V6.5a3 3 0 016 0V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    <input id="r-confirm" type="password" placeholder="Repetir contraseña" required autocomplete="new-password" />
                    <button type="button" class="toggle-pw" data-target="r-confirm" aria-label="Ver contraseña">
                      <svg viewBox="0 0 20 20" fill="none" width="15" height="15"><ellipse cx="10" cy="10" rx="7" ry="4.5" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
                    </button>
                  </div>
                </div>
              </div>
              <div class="terms-wrap" id="terms-wrap">
                <input type="checkbox" id="r-terms" />
                <label for="r-terms">Acepto los <a href="#">términos y condiciones</a></label>
              </div>
              <button type="submit" id="register-btn" class="auth-btn">
                <span id="register-label">Crear cuenta</span>
                <svg viewBox="0 0 16 16" fill="none" width="14" height="14"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </form>

            <p class="auth-switch">
              ¿Ya tienes cuenta?
              <button type="button" id="go-login-mobile" class="switch-btn">Inicia sesión</button>
            </p>
          </div>
        </div>

        <!-- VIEW: FORGOT -->
        <div class="auth-view" id="view-forgot" style="display:none">
          <div class="auth-form-wrap">
            <div class="auth-logo"><div class="auth-logo-icon"><Icon name="tabler:brain" size={20} class="text-white"/></div><span>Razona<strong>Pro</strong></span></div>
            <h1 class="auth-title">Recuperar acceso</h1>
            <p class="auth-sub">Ingresa tus datos para recibir el enlace de recuperación</p>

            <div id="forgot-msg" class="auth-msg" style="display:none"></div>

            <form id="forgot-form" novalidate>
              <div class="field-group">
                <label for="f-email">Correo electrónico</label>
                <div class="field-wrap">
                  <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="3" y="5" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M3 5l7 6 7-6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                  <input id="f-email" type="email" placeholder="tu@correo.com" required />
                </div>
              </div>
              <div class="field-group">
                <label for="f-code">Código</label>
                <div class="field-wrap">
                  <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="4" y="3" width="12" height="14" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 7h6M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  <input id="f-code" type="text" placeholder="0192270 o AMN001" required />
                </div>
              </div>
              <div class="field-group">
                <label for="f-phone">Teléfono</label>
                <div class="field-wrap">
                  <svg class="field-icon" viewBox="0 0 20 20" fill="none"><rect x="6" y="2" width="8" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="15" r="0.8" fill="currentColor"/></svg>
                  <input id="f-phone" type="tel" placeholder="+573001234567" required />
                </div>
              </div>
              <button type="submit" id="forgot-btn" class="auth-btn">
                <span id="forgot-label">Enviar enlace</span>
                <svg viewBox="0 0 16 16" fill="none" width="14" height="14"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </form>
            <button type="button" id="go-login-from-forgot" class="switch-btn" style="margin-top:1rem;display:block;text-align:center">← Volver al login</button>
          </div>
        </div>
      </div>

      <!-- ── RIGHT: Decorative panel ── -->
      <div class="auth-deco" id="auth-deco">
        <!-- Login panel -->
        <div class="deco-content" id="deco-login">
          <div class="deco-icon-wrap">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.9)" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-8 8-8s8 4 8 8"/></svg>
          </div>
          <h2>¡Hola de nuevo!</h2>
          <p>Accede con tu código institucional y correo UFPSO para continuar tu preparación.</p>
          <button type="button" id="deco-go-register" class="deco-btn">Crear cuenta</button>
        </div>
        <!-- Register panel -->
        <div class="deco-content" id="deco-register" style="display:none">
          <div class="deco-icon-wrap">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.9)" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          </div>
          <h2>¡Bienvenido!</h2>
          <p>Regístrate con tu código de estudiante UFPSO y comienza a prepararte hoy.</p>
          <button type="button" id="deco-go-login" class="deco-btn">Iniciar sesión</button>
        </div>
        <!-- Forgot/Reset panel -->
        <div class="deco-content" id="deco-forgot" style="display:none">
          <div class="deco-icon-wrap">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.9)" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h2>Recupera tu acceso</h2>
          <p>Recibirás un enlace en tu correo institucional para restablecer tu contraseña.</p>
          <button type="button" id="deco-go-login2" class="deco-btn">← Al login</button>
        </div>
      </div>
    </div>
    <div id="info-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:200;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:white;border-radius:20px;padding:2.5rem 2rem;max-width:380px;width:calc(100% - 2rem);text-align:center;animation:slideIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both;box-shadow:0 20px 60px rgba(0,0,0,0.15)">
    <div id="info-modal-icon" style="width:64px;height:64px;border-radius:50%;margin:0 auto 1rem;display:flex;align-items:center;justify-content:center"></div>
    <h3 id="info-modal-title" style="font-family:'Poppins',sans-serif;font-size:1.125rem;font-weight:800;color:#1A1A1A;margin:0 0 0.5rem"></h3>
    <p id="info-modal-desc"  style="font-family:'Poppins',sans-serif;font-size:0.875rem;color:#6B7280;margin:0 0 1.5rem;line-height:1.65"></p>
    <button id="info-modal-ok" style="width:100%;padding:0.75rem;border-radius:12px;background:linear-gradient(135deg,#D41224,#9B1F24);color:white;font-family:'Poppins',sans-serif;font-weight:700;font-size:0.875rem;border:none;cursor:pointer;box-shadow:0 4px 14px rgba(212,18,36,.3)">Entendido</button>
  </div>
</div>
  </main>
</BaseLayout>

<style>
  :root {
    --auth-red:      #D41224;
    --auth-red-dark: #9B1F24;
  }

  .auth-bg {
    position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: 0;
    background: #F5EEEE;
  }
  .auth-orb { position: absolute; border-radius: 50%; opacity: 0.07; background: var(--auth-red); }
  .auth-orb.orb-1 { width: 550px; height: 550px; top: -150px; left: -160px; }
  .auth-orb.orb-2 { width: 400px; height: 400px; bottom: -120px; right: -120px; }

  .auth-main {
    position: relative; z-index: 1;
    min-height: 100dvh;
    display: flex; align-items: center; justify-content: center;
    padding: 1.25rem;
  }

  .auth-card {
    width: min(980px, 100%);
    min-height: 600px;
    background: white;
    border-radius: 22px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.12), 0 4px 16px rgba(0,0,0,0.06);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 340px;
    position: relative;
  }

  /* Forms area */
  .auth-forms {
    position: relative; overflow: hidden; min-height: 560px;
  }

  .auth-view {
    position: absolute; top: 0; left: 0; right: 0;
    min-height: 100%;
    display: flex; align-items: center; justify-content: center;
    padding: 2.5rem 2rem;
    animation: slideIn 0.45s cubic-bezier(0.4,0,0.2,1) both;
  }
  @keyframes slideIn {
    from { opacity: 0; transform: translateX(-20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .auth-form-wrap { width: 100%; max-width: 320px; }
  #view-register .auth-form-wrap { max-width: 500px; }

  /* Logo */
  .auth-logo {
    display: flex; align-items: center; gap: 0.625rem;
    margin-bottom: 1.25rem;
    font-size: 1.125rem; font-weight: 700; color: #1A1A1A;
    font-family: 'Poppins', sans-serif;
  }
  .auth-logo strong { color: var(--auth-red); }
  .auth-logo-icon {
    width: 38px; height: 38px; border-radius: 9px;
    background: linear-gradient(135deg, var(--auth-red), var(--auth-red-dark));
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 12px rgba(212,18,36,0.3);
    flex-shrink: 0;
  }

  .auth-title {
    font-family: 'Poppins', sans-serif;
    font-size: 1.625rem; font-weight: 800; color: #1A1A1A;
    margin: 0 0 0.25rem; letter-spacing: -0.4px;
  }
  .auth-sub { font-size: 0.8125rem; color: #787878; margin: 0 0 1.5rem; }

  /* Messages */
  .auth-msg {
    padding: 0.625rem 0.875rem; border-radius: 8px;
    font-size: 0.8125rem; line-height: 1.5; margin-bottom: 0.875rem;
  }
  .auth-msg.error   { background: #FEF2F2; border: 1px solid #FECACA; color: #B91C1C; }
  .auth-msg.success { background: #F0FDF4; border: 1px solid #BBF7D0; color: #15803D; }

  /* Fields */
  .fields-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.625rem;
    margin-bottom: 0.625rem;
  }
  .field-full { grid-column: 1 / -1; }
  .field-group { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 0.75rem; }
  .field-group label {
    font-size: 0.625rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.07em; color: #787878;
  }
  .field-wrap {
    position: relative; display: flex; align-items: center;
    background: #F5F5F5; border: 1.5px solid transparent; border-radius: 9px;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  .field-wrap:focus-within {
    background: white; border-color: var(--auth-red);
    box-shadow: 0 0 0 3px rgba(212,18,36,0.1);
  }
  .field-icon { width: 15px; height: 15px; flex-shrink: 0; margin-left: 11px; color: #A3A3A3; pointer-events: none; }
  .field-wrap input {
    flex: 1; border: none; background: transparent;
    padding: 0.5625rem 0.75rem; font-family: inherit;
    font-size: 0.875rem; color: #1A1A1A; outline: none; min-width: 0;
  }
  .field-wrap input::placeholder { color: #C0C0C0; }

  .toggle-pw {
    background: none; border: none; cursor: pointer;
    padding: 0 10px; color: #A3A3A3; display: flex; align-items: center;
    transition: color 0.2s; flex-shrink: 0;
  }
  .toggle-pw:hover { color: var(--auth-red); }

  .forgot-link {
    display: block; text-align: right; font-size: 0.8125rem;
    color: var(--auth-red); background: none; border: none; cursor: pointer;
    font-family: inherit; font-weight: 500;
    margin-bottom: 0.875rem; transition: opacity 0.2s;
  }
  .forgot-link:hover { opacity: 0.7; }

  .terms-wrap {
    display: flex; align-items: flex-start; gap: 0.5rem;
    margin-bottom: 0.625rem; font-size: 0.75rem; color: #787878;
  }
  .terms-wrap input { accent-color: var(--auth-red); cursor: pointer; flex-shrink: 0; margin-top: 2px; }
  .terms-wrap label a { color: var(--auth-red); font-weight: 600; }

  /* Auth button */
  .auth-btn {
    display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    width: 100%; padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, var(--auth-red), var(--auth-red-dark));
    color: white; border: none; border-radius: 10px;
    font-family: inherit; font-size: 0.8125rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    cursor: pointer; transition: all 0.2s;
    box-shadow: 0 4px 16px rgba(212,18,36,0.3); margin-top: 0.25rem;
  }
  .auth-btn:hover:not(:disabled) {
    box-shadow: 0 6px 24px rgba(212,18,36,0.45); transform: translateY(-1px);
  }
  .auth-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  /* Switch link */
  .auth-switch {
    text-align: center; font-size: 0.8125rem; color: #787878;
    margin-top: 1rem;
  }
  .switch-btn {
    background: none; border: none; cursor: pointer;
    color: var(--auth-red); font-weight: 600; font-family: inherit;
    font-size: inherit; text-decoration: underline; padding: 0;
  }
  .back-home {
    display: block; text-align: center; font-size: 0.8125rem; color: #A3A3A3;
    margin-top: 0.75rem; text-decoration: none; transition: color 0.2s;
  }
  .back-home:hover { color: var(--auth-red); }

  /* Decorative panel */
  .auth-deco {
    background: linear-gradient(150deg, var(--auth-red) 0%, var(--auth-red-dark) 100%);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 2.5rem 2rem; position: relative; overflow: hidden;
  }
  .auth-deco::before, .auth-deco::after {
    content: ''; position: absolute; border-radius: 50%; background: rgba(255,255,255,0.05);
  }
  .auth-deco::before { width: 280px; height: 280px; top: -80px; right: -80px; }
  .auth-deco::after  { width: 200px; height: 200px; bottom: -60px; left: -60px; }

  .deco-content {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; align-items: center;
    text-align: center; gap: 1rem;
    animation: decoIn 0.5s cubic-bezier(0.4,0,0.2,1) both;
  }
  @keyframes decoIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .deco-icon-wrap {
    width: 72px; height: 72px; border-radius: 50%;
    background: rgba(255,255,255,0.12); border: 1.5px solid rgba(255,255,255,0.25);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 0.25rem;
  }
  .deco-content h2 {
    font-family: 'Poppins', sans-serif; font-size: 1.75rem;
    font-weight: 700; color: white; line-height: 1.2; margin: 0;
  }
  .deco-content p {
    font-size: 0.875rem; line-height: 1.7; color: rgba(255,255,255,0.8);
    max-width: 210px; margin: 0;
  }
  .deco-btn {
    padding: 0.625rem 1.5rem; border: 1.5px solid rgba(255,255,255,0.6);
    border-radius: 10px; background: transparent; color: white;
    font-family: inherit; font-size: 0.8125rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    cursor: pointer; transition: background 0.2s; margin-top: 0.5rem;
  }
  .deco-btn:hover { background: rgba(255,255,255,0.15); }

  /* Responsive */
  @media (max-width: 860px) {
    .auth-card { grid-template-columns: 1fr; min-height: unset; }
    .auth-deco { display: none; }
    .auth-view { position: relative; min-height: unset; }
    .auth-forms { min-height: unset; }
    .fields-grid { grid-template-columns: 1fr; }
    .field-full { grid-column: 1; }
  }
  @media (max-width: 480px) {
    .auth-main { padding: 0.75rem; }
    .auth-card { border-radius: 18px; }
    .auth-view { padding: 2rem 1.25rem; }
  }
</style>

<script>
  import { authApi } from '../lib/api/auth.api';
  import { saveSession, redirectIfAuthenticated } from '../lib/auth';
  import { toast } from '../lib/toast';

  redirectIfAuthenticated('/dashboard');

  // ── View management ───────────────────────────────────────────────
  type View = 'login' | 'register' | 'forgot';

  const views: Record<View, string> = {
    login: 'view-login', register: 'view-register',
    forgot: 'view-forgot'
  };
  const decos: Record<View, string> = {
    login: 'deco-login', register: 'deco-register',
    forgot: 'deco-forgot'
  };

  let current: View = 'login';

  function switchView(v: View) {
    // Hide all views
    Object.values(views).forEach(id => {
      const el = document.getElementById(id);
      if (el) { el.style.display = 'none'; (el as HTMLElement).style.position = 'relative'; }
    });
    Object.values(decos).forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });

    // Show target
    const viewEl = document.getElementById(views[v]);
    const decoEl = document.getElementById(decos[v]);
    if (viewEl) { viewEl.style.display = 'flex'; viewEl.style.position = 'relative'; }
    if (decoEl) { decoEl.style.display = 'flex'; decoEl.style.flexDirection = 'column'; decoEl.style.alignItems = 'center'; }

    current = v;

    // Update URL without reload
    const url = new URL(window.location.href);
    if (v === 'login') url.searchParams.delete('tab');
    else url.searchParams.set('tab', v);
    window.history.replaceState({}, '', url.toString());
  }

  // ── Init from URL param ───────────────────────────────────────────
  const urlParams = new URLSearchParams(window.location.search);
  const tabParam  = urlParams.get('tab') as View | null;
  const tokenParam = urlParams.get('token');

  if (tabParam && tabParam in views) {
    switchView(tabParam);
  } else {
    switchView('login');
  }

  // ── Toggle buttons ────────────────────────────────────────────────
  document.getElementById('go-register-mobile')?.addEventListener('click', () => switchView('register'));
  document.getElementById('go-login-mobile')?.addEventListener('click',    () => switchView('login'));
  document.getElementById('go-forgot')?.addEventListener('click',          () => switchView('forgot'));
  document.getElementById('go-login-from-forgot')?.addEventListener('click', () => switchView('login'));
  document.getElementById('deco-go-register')?.addEventListener('click',   () => switchView('register'));
  document.getElementById('deco-go-login')?.addEventListener('click',      () => switchView('login'));
  document.getElementById('deco-go-login2')?.addEventListener('click',     () => switchView('login'));

  // ── Password visibility ───────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.toggle-pw').forEach(btn => {
    btn.addEventListener('click', () => {
      const input = document.getElementById(btn.dataset.target ?? '') as HTMLInputElement | null;
      if (!input) return;
      input.type = input.type === 'password' ? 'text' : 'password';
    });
  });

  // ── Message helpers ───────────────────────────────────────────────
  function showMsg(id: string, text: string, type: 'error' | 'success') {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = text;
    el.className = `auth-msg ${type}`;
    el.style.display = 'block';
  }
  function hideMsg(id: string) {
    const el = document.getElementById(id);
    if (el) el.style.display = 'none';
  }
  function setLoading(btnId: string, labelId: string, loading: boolean, defaultText: string) {
    const btn = document.getElementById(btnId) as HTMLButtonElement | null;
    const lbl = document.getElementById(labelId);
    if (btn) btn.disabled = loading;
    if (lbl) lbl.textContent = loading ? 'Un momento...' : defaultText;
  }

  // ── LOGIN ─────────────────────────────────────────────────────────
  document.getElementById('login-form')?.addEventListener('submit', async e => {
    e.preventDefault();
    hideMsg('login-msg');

    const code     = (document.getElementById('l-code')     as HTMLInputElement).value.trim();
    const email    = (document.getElementById('l-email')    as HTMLInputElement).value.trim();
    const password = (document.getElementById('l-password') as HTMLInputElement).value;

    if (!code || !email || !password) {
      showMsg('login-msg', 'Por favor completa todos los campos.', 'error');
      return;
    }

    setLoading('login-btn', 'login-label', true, 'Ingresar');
    try {
      const res = await authApi.login(email, password, code);
      if (res.data?.token) {
        saveSession(res.data.token);
        toast.success('¡Bienvenido!', { description: 'Sesión iniciada correctamente.' });
        setTimeout(() => window.location.replace('/dashboard'), 600);
      }
    } catch (err: any) {
      showInfoModal('error', 'Error al ingresar', err?.message ?? 'Credenciales incorrectas.');
    } finally {
      setLoading('login-btn', 'login-label', false, 'Ingresar');
    }
  });

  // ── REGISTER ──────────────────────────────────────────────────────
  document.getElementById('register-form')?.addEventListener('submit', async e => {
    e.preventDefault();
    hideMsg('register-msg');

    const terms = (document.getElementById('r-terms') as HTMLInputElement).checked;
    if (!terms) {
      showMsg('register-msg', 'Debes aceptar los términos y condiciones.', 'error');
      return;
    }

    const pw  = (document.getElementById('r-password') as HTMLInputElement).value;
    const cpw = (document.getElementById('r-confirm')  as HTMLInputElement).value;
    if (pw !== cpw) {
      showMsg('register-msg', 'Las contraseñas no coinciden.', 'error');
      return;
    }

    const studentId = (document.getElementById('r-sid') as HTMLInputElement).value.trim();
    if (!/^[0-9]{7}$/.test(studentId)) {
      showMsg('register-msg', 'El código de estudiante debe tener exactamente 7 dígitos.', 'error');
      return;
    }

    const email = (document.getElementById('r-email') as HTMLInputElement).value.trim();

    setLoading('register-btn', 'register-label', true, 'Crear cuenta');
    try {
      await authApi.register({
        studentId,
        firstName:     (document.getElementById('r-fname')  as HTMLInputElement).value.trim(),
        secondName:    (document.getElementById('r-mname')  as HTMLInputElement).value.trim() || undefined,
        firstSurname:  (document.getElementById('r-lname1') as HTMLInputElement).value.trim(),
        secondSurname: (document.getElementById('r-lname2') as HTMLInputElement).value.trim() || undefined,
        email,
        phone:         (document.getElementById('r-phone')  as HTMLInputElement).value.trim(),
        password: pw,
      });
      showInfoModal('success', '¡Registro exitoso!', 'Revisa tu correo para verificar tu cuenta.', () => switchView('login'));
      toast.success('¡Registro exitoso!', { description: 'Verifica tu correo antes de iniciar sesión.' });
      setTimeout(() => switchView('login'), 3000);
    } catch (err: any) {
      const msgs = err?.errors ? Object.values(err.errors as Record<string, string>).join(' ') : err?.message;
      showMsg('register-msg', msgs ?? 'Error al registrarse.', 'error');
    } finally {
      setLoading('register-btn', 'register-label', false, 'Crear cuenta');
    }
  });

  // ── FORGOT PASSWORD ───────────────────────────────────────────────
  document.getElementById('forgot-form')?.addEventListener('submit', async e => {
    e.preventDefault();
    hideMsg('forgot-msg');

    const email = (document.getElementById('f-email') as HTMLInputElement).value.trim();
    const code  = (document.getElementById('f-code')  as HTMLInputElement).value.trim();
    const phone = (document.getElementById('f-phone') as HTMLInputElement).value.trim();

    setLoading('forgot-btn', 'forgot-label', true, 'Enviar enlace');
    try {
      await authApi.forgotPassword(email, code, phone);
      showInfoModal('info', 'Correo enviado', 'Si los datos coinciden recibirás un enlace. Revisa tu bandeja de entrada.', () => switchView('login'));
      toast.success('Correo enviado', { description: 'Revisa tu bandeja de entrada.' });
    } catch {
      // Always show success for security (don't reveal if email exists)
      showInfoModal('info', 'Correo enviado', 'Si los datos coinciden recibirás un enlace. Revisa tu bandeja de entrada.', () => switchView('login'));
    } finally {
      setLoading('forgot-btn', 'forgot-label', false, 'Enviar enlace');
    }
  });

  function showInfoModal(type: 'success' | 'error' | 'info', title: string, desc: string, onOk?: () => void) {
    const modal    = document.getElementById('info-modal')!;
    const iconEl   = document.getElementById('info-modal-icon')!;
    const titleEl  = document.getElementById('info-modal-title')!;
    const descEl   = document.getElementById('info-modal-desc')!;
    const okBtn    = document.getElementById('info-modal-ok')!;

    const configs = {
        success: { bg: '#D1FAE5', color: '#059669', icon: '<svg width="28" height="28" fill="none" stroke="#059669" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>' },
        error:   { bg: '#FEE2E2', color: '#DC2626', icon: '<svg width="28" height="28" fill="none" stroke="#DC2626" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' },
        info:    { bg: '#DBEAFE', color: '#2563EB', icon: '<svg width="28" height="28" fill="none" stroke="#2563EB" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' },
    };
    const cfg = configs[type];
    iconEl.style.background = cfg.bg;
    iconEl.innerHTML = cfg.icon;
    titleEl.textContent = title;
    descEl.textContent  = desc;
    modal.style.display = 'flex';

    const handler = () => {
        modal.style.display = 'none';
        okBtn.removeEventListener('click', handler);
        onOk?.();
    };
    okBtn.addEventListener('click', handler);
}
</script>