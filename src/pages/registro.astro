---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Registro · RazonaPro">
  <main class="min-h-screen flex flex-col items-center justify-center px-4 py-12 bg-gray-50 relative overflow-hidden">

    <!-- Fondo decorativo -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full opacity-10"
           style="background: radial-gradient(circle, #D41224 0%, transparent 70%)"></div>
      <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full opacity-10"
           style="background: radial-gradient(circle, #9B1F24 0%, transparent 70%)"></div>
    </div>

    <div class="relative z-10 w-full max-w-lg">

      <!-- Header -->
      <div class="text-center mb-8">
        <a href="/" class="inline-block">
          <span class="text-3xl font-black tracking-tight text-ufpso">Razona<span class="text-gray-800">Pro</span></span>
        </a>
        <p class="mt-2 text-sm text-gray-500">Crea tu cuenta de estudiante</p>
      </div>

      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">

        <div class="px-8 pt-7 pb-2 border-b border-gray-50">
          <h1 class="text-lg font-bold text-gray-900">Crear cuenta</h1>
          <p class="text-xs text-gray-400 mt-0.5">Todos los campos marcados con * son obligatorios</p>
        </div>

        <div class="p-8">

          <!-- Éxito -->
          <div id="success-box" class="hidden mb-5 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm leading-relaxed"></div>

          <!-- Error -->
          <div id="error-box" class="hidden mb-5 p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm"></div>

          <form id="register-form" novalidate class="space-y-5">

            <!-- Nombres -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1.5">
                  Primer nombre *
                </label>
                <input
                  type="text"
                  name="firstName"
                  placeholder="Juan"
                  required
                  maxlength="15"
                  class="field-input w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-800
                         placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-ufpso/40
                         focus:border-ufpso transition-all"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1.5">
                  Segundo nombre
                </label>
                <input
                  type="text"
                  name="secondName"
                  placeholder="Carlos"
                  maxlength="15"
                  class="field-input w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-800
                         placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-ufpso/40
                         focus:border-ufpso transition-all"
                />
              </div>
            </div>

            <!-- Apellidos -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1.5">
                  Primer apellido *
                </label>
                <input
                  type="text"
                  name="firstSurname"
                  placeholder="Pérez"
                  required
                  maxlength="15"
                  class="field-input w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-800
                         placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-ufpso/40
                         focus:border-ufpso transition-all"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1.5">
                  Segundo apellido
                </label>
                <input
                  type="text"
                  name="secondSurname"
                  placeholder="García"
                  maxlength="15"
                  class="field-input w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-800
                         placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-ufpso/40
                         focus:border-ufpso transition-all"
                />
              </div>
            </div>

            <!-- Email -->
            <div>
              <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1.5">
                Correo electrónico *
              </label>
              <input
                type="email"
                name="email"
                placeholder="tu@correo.com"
                required
                maxlength="50"
                class="field-input w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-800
                       placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-ufpso/40
                       focus:border-ufpso transition-all"
              />
            </div>

            <!-- Teléfono -->
            <div>
              <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1.5">
                Teléfono *
              </label>
              <input
                type="tel"
                name="phone"
                placeholder="+57 300 123 4567"
                required
                maxlength="15"
                class="field-input w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-800
                       placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-ufpso/40
                       focus:border-ufpso transition-all"
              />
            </div>

            <!-- Programa -->
            <div>
              <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1.5">
                Programa académico *
              </label>
              <select
                name="programId"
                required
                id="program-select"
                class="field-input w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-800
                       focus:outline-none focus:ring-2 focus:ring-ufpso/40 focus:border-ufpso
                       transition-all appearance-none bg-white disabled:opacity-60"
              >
                <option value="">Cargando programas...</option>
              </select>
            </div>

            <!-- Contraseña -->
            <div>
              <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1.5">
                Contraseña *
              </label>
              <div class="relative">
                <input
                  type="password"
                  name="password"
                  id="password"
                  placeholder="Mínimo 8 caracteres"
                  required
                  class="field-input w-full px-4 py-3 rounded-xl border border-gray-200 text-sm text-gray-800
                         placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-ufpso/40
                         focus:border-ufpso transition-all pr-11"
                />
                <button
                  type="button"
                  id="toggle-password"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors"
                >
                  <span class="ti ti-eye text-lg"></span>
                </button>
              </div>
              <p class="mt-1.5 text-xs text-gray-400">Debe contener mayúscula, minúscula y número.</p>
            </div>

            <!-- Indicador de fuerza de contraseña -->
            <div id="strength-bar" class="hidden">
              <div class="flex gap-1 mb-1">
                <div id="s1" class="h-1 flex-1 rounded-full bg-gray-200 transition-all"></div>
                <div id="s2" class="h-1 flex-1 rounded-full bg-gray-200 transition-all"></div>
                <div id="s3" class="h-1 flex-1 rounded-full bg-gray-200 transition-all"></div>
                <div id="s4" class="h-1 flex-1 rounded-full bg-gray-200 transition-all"></div>
              </div>
              <p id="strength-label" class="text-xs text-gray-400"></p>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full py-3.5 rounded-xl bg-ufpso text-white font-semibold text-sm
                     hover:bg-ufpso-dark active:scale-[.98] transition-all
                     disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2 mt-2"
            >
              <span id="btn-label">Crear cuenta</span>
              <span id="btn-spinner" class="hidden ti ti-loader-2 animate-spin text-base"></span>
            </button>

          </form>

          <div class="mt-6 text-center text-sm text-gray-500">
            ¿Ya tienes cuenta?
            <a href="/login" class="text-ufpso font-semibold hover:underline ml-1">Inicia sesión</a>
          </div>

        </div>
      </div>

      <p class="text-center mt-6 text-xs text-gray-400">
        <a href="/" class="hover:text-ufpso transition-colors">← Volver al inicio</a>
      </p>

    </div>
  </main>
</BaseLayout>

<style>
  @keyframes spin { to { transform: rotate(360deg); } }
  .animate-spin { animation: spin 0.8s linear infinite; }
</style>

<script>
  import { authApi, programsApi } from '../lib/api';
  import { redirectIfAuthenticated } from '../lib/auth';

  redirectIfAuthenticated('/dashboard');

  // ── Cargar programas ─────────────────────────────────────────
  const programSelect = document.getElementById('program-select') as HTMLSelectElement;

  async function loadPrograms() {
    try {
      const res = await programsApi.findActive();
      programSelect.innerHTML = '<option value="">— Selecciona tu programa —</option>';
      if (res.data) {
        res.data.forEach(p => {
          const opt = document.createElement('option');
          opt.value = p.programId;
          opt.textContent = p.programName;
          programSelect.appendChild(opt);
        });
      }
    } catch {
      programSelect.innerHTML = '<option value="">Error cargando programas</option>';
    }
  }

  loadPrograms();

  // ── Toggle password ──────────────────────────────────────────
  const toggleBtn      = document.getElementById('toggle-password')!;
  const passwordInput  = document.getElementById('password') as HTMLInputElement;
  const strengthBar    = document.getElementById('strength-bar')!;
  const strengthLabel  = document.getElementById('strength-label')!;
  const segments       = [1,2,3,4].map(n => document.getElementById(`s${n}`)!);

  toggleBtn.addEventListener('click', () => {
    const hidden = passwordInput.type === 'password';
    passwordInput.type = hidden ? 'text' : 'password';
    toggleBtn.querySelector('span')!.className = hidden
      ? 'ti ti-eye-off text-lg'
      : 'ti ti-eye text-lg';
  });

  // ── Fuerza de contraseña ─────────────────────────────────────
  const colors = ['bg-red-400', 'bg-orange-400', 'bg-yellow-400', 'bg-green-500'];
  const labels = ['Débil', 'Regular', 'Buena', 'Fuerte'];

  passwordInput.addEventListener('input', () => {
    const val = passwordInput.value;
    if (!val) { strengthBar.classList.add('hidden'); return; }
    strengthBar.classList.remove('hidden');

    let score = 0;
    if (val.length >= 8)           score++;
    if (/[A-Z]/.test(val))         score++;
    if (/[a-z]/.test(val))         score++;
    if (/\d/.test(val))            score++;

    const color = colors[score - 1] ?? 'bg-gray-200';
    segments.forEach((s, i) => {
      s.className = `h-1 flex-1 rounded-full transition-all ${i < score ? color : 'bg-gray-200'}`;
    });
    strengthLabel.textContent = labels[score - 1] ?? '';
  });

  // ── Form submit ──────────────────────────────────────────────
  const form       = document.getElementById('register-form') as HTMLFormElement;
  const submitBtn  = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnLabel   = document.getElementById('btn-label')!;
  const btnSpinner = document.getElementById('btn-spinner')!;
  const errorBox   = document.getElementById('error-box')!;
  const successBox = document.getElementById('success-box')!;

  function setLoading(v: boolean) {
    submitBtn.disabled = v;
    btnLabel.textContent = v ? 'Registrando...' : 'Crear cuenta';
    btnSpinner.classList.toggle('hidden', !v);
  }

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
    successBox.classList.add('hidden');
  }

  function showSuccess(msg: string) {
    successBox.innerHTML = `<span class="ti ti-circle-check mr-2"></span>${msg}`;
    successBox.classList.remove('hidden');
    errorBox.classList.add('hidden');
    form.reset();
    programSelect.innerHTML = '<option value="">— Selecciona tu programa —</option>';
    loadPrograms();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    const data = new FormData(form);
    const payload = {
      firstName:     (data.get('firstName')   as string).trim(),
      secondName:    (data.get('secondName')  as string).trim() || undefined,
      firstSurname:  (data.get('firstSurname')  as string).trim(),
      secondSurname: (data.get('secondSurname') as string).trim() || undefined,
      email:         (data.get('email')       as string).trim(),
      phone:         (data.get('phone')       as string).trim(),
      password:      data.get('password')     as string,
      programId:     data.get('programId')    as string,
    };

    if (!payload.firstName || !payload.firstSurname || !payload.email || !payload.phone || !payload.password || !payload.programId) {
      showError('Por favor completa todos los campos obligatorios.');
      return;
    }

    setLoading(true);
    try {
      const res = await authApi.studentRegister(payload);
      if (res.success) {
        showSuccess('¡Cuenta creada! Revisa tu correo electrónico para verificar tu cuenta antes de iniciar sesión.');
      } else {
        showError(res.message ?? 'Error al registrarse.');
      }
    } catch (err: any) {
      // Puede venir con errors (validación de campos) o mensaje plano
      if (err?.errors) {
        const msgs = Object.values(err.errors as Record<string,string>).join(' ');
        showError(msgs);
      } else {
        showError(err?.message ?? 'No se pudo conectar con el servidor.');
      }
    } finally {
      setLoading(false);
    }
  });
</script>
