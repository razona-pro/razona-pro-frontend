---
import { Icon } from 'astro-icon/components';

interface Props {
  label: string;
  value: string | number;
  sub?: string;
  icon: string;
  color: string;
  bg: string;
  id?: string;
}

const { label, value, sub, icon, color, bg, id } = Astro.props;
---

<div class="stat-card" style={`border-left: 3px solid ${color}`}>
  <div class="stat-header">
    <span class="stat-label">{label}</span>
    <div class="stat-icon" style={`background:${bg}`}>
      <Icon name={icon} size={14} style={`color:${color}`} />
    </div>
  </div>
  <p class="stat-value" id={id} style={`color:${color}`}>{value}</p>
  {sub && <p class="stat-sub">{sub}</p>}
</div>

<style>
  .stat-card {
    background: var(--ui-card);
    border-radius: 14px; padding: 1rem 1.125rem;
    border: 1px solid var(--ui-border);
    transition: background 0.25s, border-color 0.25s;
  }
  .stat-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 0.5625rem;
  }
  .stat-label {
    font-size: 0.625rem; font-weight: 700; color: var(--ui-text-3);
    text-transform: uppercase; letter-spacing: 0.5px;
  }
  .stat-icon {
    width: 29px; height: 29px; border-radius: 7px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .stat-value {
    font-size: 1.75rem; font-weight: 900; letter-spacing: -0.8px;
    margin: 0; line-height: 1;
  }
  .stat-sub {
    font-size: 0.6875rem; color: var(--ui-text-3);
    margin: 4px 0 0;
  }
</style>