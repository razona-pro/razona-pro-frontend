---
import { Icon } from 'astro-icon/components';
import type { TriedDto } from '../../lib/api/types';
import { getCompStyle, fmtDate, fmtDuration, scoreColor } from '../../lib/utils';

interface Props {
  tried: TriedDto;
  compact?: boolean;
}

const { tried, compact = false } = Astro.props;
const s = getCompStyle(tried.competenceId, tried.testName ?? '');
const score = tried.score;
const sColor = scoreColor(score);
---

<div class:list={['tried-row', compact && 'compact']}>
  <div class="tried-icon" style={`background:${s.bg}`}>
    <Icon name="tabler:clipboard-check" size={compact ? 14 : 16} style={`color:${s.color}`} />
  </div>
  <div class="tried-info">
    <p class="tried-name">{tried.testName ?? tried.testId}</p>
    {!compact && (
      <p class="tried-meta">
        {fmtDate(tried.finishedAt ?? tried.attemptTimestamp)}
        {tried.timeSpentSeconds && ` · ${fmtDuration(tried.timeSpentSeconds)}`}
        · {tried.totalQuestions} preguntas
      </p>
    )}
    {compact && <p class="tried-meta">{fmtDate(tried.finishedAt ?? tried.attemptTimestamp)}</p>}
  </div>
  <div class="tried-score">
    {score != null
      ? <><span class="score-val" style={`color:${sColor}`}>{score.toFixed(0)}</span><span class="score-max">/100</span></>
      : <span class="score-pending">En progreso</span>
    }
  </div>
</div>

<style>
  .tried-row {
    display: flex; align-items: center; gap: 0.625rem;
    padding: 0.625rem 0.75rem; border-radius: 10px;
    border: 1px solid var(--ui-border); background: var(--ui-surface);
    margin-bottom: 0.4375rem; cursor: pointer; transition: all 0.15s;
  }
  .tried-row:hover { border-color: var(--ui-border-2); background: var(--ui-card); transform: translateX(2px); }

  .tried-icon {
    width: 36px; height: 36px; border-radius: 9px;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .tried-row.compact .tried-icon { width: 30px; height: 30px; border-radius: 7px; }

  .tried-info { flex: 1; min-width: 0; }
  .tried-name {
    font-size: 0.8125rem; font-weight: 700; color: var(--ui-text-1);
    margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .tried-meta {
    font-size: 0.6875rem; color: var(--ui-text-3); margin: 2px 0 0;
  }

  .tried-score { text-align: right; flex-shrink: 0; }
  .score-val { font-size: 1rem; font-weight: 900; }
  .score-max { font-size: 0.6875rem; color: var(--ui-text-3); }
  .score-pending { font-size: 0.6875rem; color: var(--brand); font-weight: 600; }
</style>