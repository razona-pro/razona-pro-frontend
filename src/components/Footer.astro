---
const year = new Date().getFullYear();
---

<footer class="rp-footer">
  <div class="rp-footer-inner">

    <!-- Marca -->
    <div class="rp-footer-brand">
      <span class="rp-footer-logo">
        Razona<span>Pro</span>
      </span>
      <p class="rp-footer-tagline">
        Preparación inteligente para el Saber Pro
      </p>
    </div>

    <!-- Copy -->
    <p class="rp-footer-copy">
      © {year} Universidad Francisco de Paula Santander Ocaña
    </p>

  </div>
</footer>

<style>
  .rp-footer {
    margin-top: auto;
    border-top: 1px solid var(--border-color, #E8E8E8);
    background: var(--bg-surface, #F9F9F9);
    transition: background 0.3s, border-color 0.3s;
  }

  .rp-footer-inner {
    max-width: 75rem;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  @media (min-width: 640px) {
    .rp-footer-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .rp-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .rp-footer-logo {
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main, #1A1A1A);
  }
  .rp-footer-logo span {
    color: var(--clr-brand, #D41224);
  }

  .rp-footer-tagline {
    font-family: 'Poppins', sans-serif;
    font-size: 0.75rem;
    color: var(--text-soft, #A8A8A8);
    margin: 0;
  }

  .rp-footer-copy {
    font-family: 'Poppins', sans-serif;
    font-size: 0.775rem;
    color: var(--text-soft, #A8A8A8);
    margin: 0;
  }
</style>
