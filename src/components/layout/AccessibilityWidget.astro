---
// Accessibility widget — bottom-right, fixed, non-intrusive
---

<!-- SVG daltonism filters -->
<svg aria-hidden="true" focusable="false" style="display:none;position:absolute;width:0;height:0;overflow:hidden">
  <defs>
    <filter id="rp-filter-deuteranopia" color-interpolation-filters="linearRGB">
      <feColorMatrix type="matrix" values="0.625 0.375 0 0 0 0.700 0.300 0 0 0 0 0.300 0.700 0 0 0 0 0 1 0"/>
    </filter>
    <filter id="rp-filter-protanopia" color-interpolation-filters="linearRGB">
      <feColorMatrix type="matrix" values="0.567 0.433 0 0 0 0.558 0.442 0 0 0 0 0.242 0.758 0 0 0 0 0 1 0"/>
    </filter>
    <filter id="rp-filter-tritanopia" color-interpolation-filters="linearRGB">
      <feColorMatrix type="matrix" values="0.950 0.050 0 0 0 0 0.433 0.567 0 0 0 0.475 0.525 0 0 0 0 0 1 0"/>
    </filter>
  </defs>
</svg>

<div id="rp-reading-mask" aria-hidden="true"></div>
<div id="rp-reading-guide" aria-hidden="true"></div>

<div id="rp-a11y-root" role="region" aria-label="Panel de accesibilidad">
  <!-- Panel -->
  <div id="rp-a11y-panel" class="rp-panel" role="dialog" aria-modal="false" aria-label="Opciones de accesibilidad" hidden>
    <div class="rp-panel-header">
      <div class="rp-header-icon-wrap">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="5" r="2.5"/><path d="M5.5 11.5L12 9L18.5 11.5M12 9L12 21M8.5 21L12 17L15.5 21M5.5 11.5L7.5 17M18.5 11.5L16.5 17"/></svg>
      </div>
      <span class="rp-panel-title">Accesibilidad</span>
      <button id="rp-a11y-close" class="rp-close-btn" aria-label="Cerrar" type="button">×</button>
    </div>

    <div class="rp-scroll">
      <section class="rp-section">
        <p class="rp-label">Tamaño de texto</p>
        <div class="rp-row5" role="group">
          <button class="rp-scale-btn" data-fs="pequeno" type="button">Pequeño</button>
          <button class="rp-scale-btn rp-default" data-fs="normal" type="button">Normal</button>
          <button class="rp-scale-btn" data-fs="grande" type="button">Grande</button>
          <button class="rp-scale-btn" data-fs="muy-grande" type="button">Muy</button>
          <button class="rp-scale-btn" data-fs="extra-grande" type="button">Extra</button>
        </div>
      </section>

      <section class="rp-section">
        <p class="rp-label">Contraste</p>
        <div class="rp-grid3" role="group">
          <button class="rp-opt" data-mode="light" type="button">Claro</button>
          <button class="rp-opt" data-mode="dark" type="button">Oscuro</button>
          <button class="rp-opt" data-mode="high-contrast" type="button">Alto</button>
          <button class="rp-opt" data-mode="inverted" type="button">Invertido</button>
          <button class="rp-opt" data-mode="contrast-light" type="button">Luz</button>
          <button class="rp-opt" data-mode="contrast-dark" type="button">Oscuro+</button>
        </div>
      </section>

      <section class="rp-section">
        <p class="rp-label">Espaciado de letras</p>
        <div class="rp-row5" role="group">
          <button class="rp-scale-btn rp-default" data-ls="normal" type="button">Normal</button>
          <button class="rp-scale-btn" data-ls="amplio" type="button">Amplio</button>
          <button class="rp-scale-btn" data-ls="mas-amplio" type="button">Más</button>
          <button class="rp-scale-btn" data-ls="muy-amplio" type="button">Mucho</button>
          <button class="rp-scale-btn" data-ls="extra-amplio" type="button">Máx</button>
        </div>
      </section>

      <section class="rp-section">
        <p class="rp-label">Altura de línea</p>
        <div class="rp-row4" role="group">
          <button class="rp-opt rp-opt-sm" data-lh="1" type="button">1.0</button>
          <button class="rp-opt rp-opt-sm rp-default" data-lh="1.6" type="button">1.6</button>
          <button class="rp-opt rp-opt-sm" data-lh="1.75" type="button">1.75</button>
          <button class="rp-opt rp-opt-sm" data-lh="2" type="button">2.0</button>
        </div>
      </section>

      <section class="rp-section">
        <p class="rp-label">Fuente</p>
        <div class="rp-col" role="group">
          <button class="rp-opt rp-opt-full rp-default" data-font="default" type="button">Lora (predeterminada)</button>
          <button class="rp-opt rp-opt-full" data-font="poppins" type="button">Poppins — compacta, sans-serif</button>
          <button class="rp-opt rp-opt-full" data-font="dyslexia" type="button">Lexend — apta para dislexia</button>
        </div>
      </section>

      <section class="rp-section">
        <p class="rp-label">Saturación</p>
        <div class="rp-row4" role="group">
          <button class="rp-opt rp-opt-sm rp-default" data-sat="normal" type="button">Normal</button>
          <button class="rp-opt rp-opt-sm" data-sat="low" type="button">Baja</button>
          <button class="rp-opt rp-opt-sm" data-sat="high" type="button">Alta</button>
          <button class="rp-opt rp-opt-sm" data-sat="desaturate" type="button">Sin</button>
        </div>
      </section>

      <section class="rp-section">
        <p class="rp-label">Visión del color</p>
        <div class="rp-col" role="group">
          <button class="rp-opt rp-opt-full rp-default" data-vision="none" type="button">Normal</button>
          <button class="rp-opt rp-opt-full" data-vision="deuteranopia" type="button">Deuteranopia</button>
          <button class="rp-opt rp-opt-full" data-vision="protanopia" type="button">Protanopia</button>
          <button class="rp-opt rp-opt-full" data-vision="tritanopia" type="button">Tritanopia</button>
        </div>
      </section>

      <section class="rp-section">
        <p class="rp-label">Extras</p>
        <div class="rp-toggles">
          <button class="rp-toggle" id="rp-toggle-cursor" data-toggle="cursor" type="button">
            <span class="rp-toggle-label">Cursor grande</span>
            <span class="rp-toggle-check" aria-hidden="true"></span>
          </button>
          <button class="rp-toggle" id="rp-toggle-links" data-toggle="links" type="button">
            <span class="rp-toggle-label">Resaltar enlaces</span>
            <span class="rp-toggle-check" aria-hidden="true"></span>
          </button>
          <button class="rp-toggle" id="rp-toggle-mask" data-toggle="mask" type="button">
            <span class="rp-toggle-label">Máscara de lectura</span>
            <span class="rp-toggle-check" aria-hidden="true"></span>
          </button>
          <button class="rp-toggle" id="rp-toggle-guide" data-toggle="guide" type="button">
            <span class="rp-toggle-label">Guía de lectura</span>
            <span class="rp-toggle-check" aria-hidden="true"></span>
          </button>
        </div>
      </section>
    </div>

    <div class="rp-panel-footer">
      <button id="rp-a11y-reset" class="rp-reset-btn" type="button">↺ Restablecer todo</button>
    </div>
  </div>

  <!-- FAB -->
  <button id="rp-a11y-fab" class="rp-fab" type="button"
    aria-label="Abrir opciones de accesibilidad"
    aria-expanded="false" aria-controls="rp-a11y-panel">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="5" r="2.4" fill="currentColor" stroke="none"/>
      <path d="M5 11.5L12 9L19 11.5M12 9L12 21M8 21L12 16.5L16 21M5 11.5L7 17.5M19 11.5L17 17.5"/>
    </svg>
  </button>
</div>

<style>
  #rp-a11y-root {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 9990;
    width: 44px;
    height: 44px;
    /* Aislamos el widget del filter del html para que no se vea afectado por invert/saturate */
    isolation: isolate;
  }

  .rp-fab {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--brand, #D41224);
    color: #fff; border: 2px solid rgba(255,255,255,0.2);
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 16px rgba(212,18,36,0.4), 0 2px 6px rgba(0,0,0,0.15);
    transition: transform 0.25s cubic-bezier(0.4,0,0.2,1), box-shadow 0.2s;
    outline: none; position: relative; z-index: 1;
  }
  .rp-fab:hover { transform: scale(1.08); box-shadow: 0 8px 24px rgba(212,18,36,0.5); }
  .rp-fab[aria-expanded="true"] { background: #9B1F24; transform: rotate(15deg) scale(1.02); }

  .rp-panel {
    position: absolute; bottom: calc(100% + 0.625rem); right: 0;
    width: 270px; background: var(--ui-card, #fff);
    border: 1px solid var(--ui-border, #E5E5E5);
    border-radius: 1rem;
    box-shadow: 0 16px 48px rgba(0,0,0,0.14), 0 4px 12px rgba(0,0,0,0.06);
    display: flex; flex-direction: column;
    max-height: calc(100vh - 6rem);
    animation: rp-in 0.2s cubic-bezier(0.34,1.56,0.64,1) both;
    transform-origin: bottom right;
    overflow: hidden; z-index: 2;
  }
  .rp-panel[hidden] { display: none !important; }

  @keyframes rp-in {
    from { opacity: 0; transform: translateY(10px) scale(0.95); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .rp-panel-header {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.75rem 0.875rem;
    border-bottom: 1px solid var(--ui-border, #E5E5E5);
    flex-shrink: 0;
  }
  .rp-header-icon-wrap {
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--brand, #D41224); color: #fff;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .rp-panel-title { font-size: 0.75rem; font-weight: 700; color: var(--ui-text-1, #1A1A1A); flex: 1; }
  .rp-close-btn {
    background: none; border: none; cursor: pointer;
    color: var(--ui-text-3, #A3A3A3); font-size: 1.125rem; line-height: 1;
    padding: 2px 4px; border-radius: 4px; transition: color 0.15s;
  }
  .rp-close-btn:hover { color: var(--ui-text-1); }

  .rp-scroll {
    overflow-y: auto; flex: 1; padding: 0.625rem 0.875rem;
    scrollbar-width: thin; scrollbar-color: var(--ui-border-2) transparent;
  }

  .rp-section { margin-bottom: 0.875rem; }
  .rp-label {
    font-size: 0.5625rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--ui-text-3, #A3A3A3); margin: 0 0 0.3rem;
  }

  .rp-row5 { display: grid; grid-template-columns: repeat(5,1fr); gap: 0.2rem; }
  .rp-row4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 0.2rem; }
  .rp-grid3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 0.2rem; }
  .rp-col   { display: flex; flex-direction: column; gap: 0.2rem; }

  .rp-scale-btn, .rp-opt {
    padding: 0.3rem 0.15rem; border: 1px solid var(--ui-border, #E5E5E5);
    border-radius: 0.375rem; background: var(--ui-surface, #F8F8F8);
    color: var(--ui-text-2, #6B6B6B); font-size: 0.5625rem; font-weight: 500;
    cursor: pointer; text-align: center; transition: all 0.15s;
    font-family: var(--font-sans, sans-serif); line-height: 1.2;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .rp-opt-sm   { font-size: 0.5625rem; }
  .rp-opt-full { width: 100%; text-align: left; padding: 0.375rem 0.5rem; font-size: 0.6875rem; }

  .rp-scale-btn:hover, .rp-scale-btn.active,
  .rp-opt:hover, .rp-opt.active {
    border-color: var(--brand, #D41224);
    background: var(--brand, #D41224);
    color: #fff; font-weight: 600;
  }

  .rp-toggles { display: flex; flex-direction: column; gap: 0.2rem; }
  .rp-toggle {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.375rem 0.5rem; border: 1px solid var(--ui-border, #E5E5E5);
    border-radius: 0.375rem; background: var(--ui-surface, #F8F8F8);
    color: var(--ui-text-2, #6B6B6B); font-size: 0.6875rem; font-weight: 500;
    cursor: pointer; transition: all 0.15s; font-family: var(--font-sans); width: 100%; text-align: left;
  }
  .rp-toggle-label { flex: 1; }
  .rp-toggle-check {
    width: 14px; height: 14px; border-radius: 3px;
    border: 1.5px solid var(--ui-border-2, #D4D4D4); flex-shrink: 0; transition: all 0.15s;
  }
  .rp-toggle.active .rp-toggle-check { background: var(--brand, #D41224); border-color: var(--brand); }
  .rp-toggle:hover { border-color: var(--brand); }
  .rp-toggle.active { border-color: rgba(212,18,36,0.35); background: rgba(212,18,36,0.05); color: var(--brand); font-weight: 600; }

  .rp-panel-footer { padding: 0.625rem 0.875rem; border-top: 1px solid var(--ui-border, #E5E5E5); flex-shrink: 0; }
  .rp-reset-btn {
    width: 100%; padding: 0.375rem; background: transparent;
    border: 1px solid var(--ui-border, #E5E5E5); border-radius: 0.375rem;
    color: var(--ui-text-2, #6B6B6B); font-size: 0.6875rem; font-weight: 500;
    cursor: pointer; transition: all 0.15s; font-family: var(--font-sans);
  }
  .rp-reset-btn:hover { background: var(--ui-hover); }

  @media (max-width: 480px) {
    .rp-panel { width: calc(100vw - 1.5rem); right: 0; }
    #rp-a11y-root { right: 0.75rem; bottom: 0.75rem; }
  }
</style>

<script>
const KEY = 'rp-a11y';

interface Prefs {
  fs: string; mode: string; vision: string;
  ls: string; lh: string; font: string;
  align: string; sat: string; cursor: string;
  links: boolean; mask: boolean; guide: boolean;
}

const DEFAULTS: Prefs = {
  fs: 'normal', mode: 'light', vision: 'none',
  ls: 'normal', lh: '1.6', font: 'default',
  align: 'left', sat: 'normal', cursor: 'normal',
  links: false, mask: false, guide: false,
};

const FONT_URLS: Record<string, string> = {
  dyslexia: 'https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@300;400;500;600;700&display=swap',
};

function load(): Prefs {
  try {
    const saved = JSON.parse(localStorage.getItem(KEY) ?? '{}');
    if (saved.font === 'legible' || saved.font === 'lora') saved.font = 'default';
    return { ...DEFAULTS, ...saved };
  }
  catch { return { ...DEFAULTS }; }
}
function save(p: Prefs) { localStorage.setItem(KEY, JSON.stringify(p)); }

function buildHtmlFilter(p: Prefs): string {
  const parts: string[] = [];
  if (p.vision !== 'none') parts.push(`url('#rp-filter-${p.vision}')`);
  if (p.sat === 'low')         parts.push('saturate(0.4)');
  else if (p.sat === 'high')   parts.push('saturate(1.8)');
  else if (p.sat === 'desaturate') parts.push('grayscale(1)');
  return parts.join(' ');
}

function ensureFont(font: string) {
  if (font === 'default' || document.getElementById(`rp-f-${font}`)) return;
  const l = document.createElement('link');
  l.id = `rp-f-${font}`; l.rel = 'stylesheet'; l.href = FONT_URLS[font] ?? '';
  document.head.appendChild(l);
}

function apply(p: Prefs) {
  const h = document.documentElement;
  h.setAttribute('data-fs', p.fs);
  h.classList.remove('dark','high-contrast','contrast-inverted','contrast-light','contrast-dark');
  const modeMap: Record<string, string> = {
    dark: 'dark', 'high-contrast': 'high-contrast',
    inverted: 'contrast-inverted', 'contrast-light': 'contrast-light', 'contrast-dark': 'contrast-dark',
  };
  if (modeMap[p.mode]) h.classList.add(modeMap[p.mode]);
  if (p.ls === 'normal') h.removeAttribute('data-ls');
  else h.setAttribute('data-ls', p.ls);
  h.setAttribute('data-lh', p.lh);
  ensureFont(p.font);
  if (p.font === 'default') h.removeAttribute('data-font');
  else h.setAttribute('data-font', p.font);
  if (p.align === 'left') h.removeAttribute('data-align');
  else h.setAttribute('data-align', p.align);

  // ── KEY FIX: aplicar filter al documentElement, NO al body ──
  // Si se aplica al body, los elementos position:fixed quedan atrapados
  // en el stacking context del filter y se descolocan del viewport.
  // Al aplicarlo al html, el widget con isolation:isolate queda libre.
  const filterVal = buildHtmlFilter(p);

  // Para invertido: el CSS maneja html.contrast-inverted con filter,
  // aquí solo aplicamos saturación/daltonismo sobre el html directamente.
  // Evitamos sobreescribir el filter de contrast-inverted del CSS.
  if (p.mode !== 'inverted') {
    h.style.filter = filterVal;
  } else {
    // En modo invertido, el CSS ya pone invert+hue-rotate en html.contrast-inverted.
    // Combinamos saturación/daltonismo encima si aplica.
    h.style.filter = filterVal;
  }

  h.classList.toggle('cursor-large', p.cursor === 'large');
  h.classList.toggle('highlight-links', p.links);
  h.classList.toggle('reading-mask', p.mask);
  h.classList.toggle('reading-guide', p.guide);
  syncButtons(p);
}

function syncButtons(p: Prefs) {
  const setActive = (el: Element, on: boolean) => {
    el.classList.toggle('active', on);
    el.setAttribute('aria-pressed', String(on));
  };
  document.querySelectorAll('[data-fs]').forEach(b => setActive(b, (b as HTMLElement).dataset.fs === p.fs));
  document.querySelectorAll('[data-mode]').forEach(b => setActive(b, (b as HTMLElement).dataset.mode === p.mode));
  document.querySelectorAll('[data-ls]').forEach(b => setActive(b, (b as HTMLElement).dataset.ls === (p.ls || 'normal')));
  document.querySelectorAll('[data-lh]').forEach(b => setActive(b, (b as HTMLElement).dataset.lh === p.lh));
  document.querySelectorAll('[data-font]').forEach(b => setActive(b, (b as HTMLElement).dataset.font === p.font));
  document.querySelectorAll('[data-sat]').forEach(b => setActive(b, (b as HTMLElement).dataset.sat === (p.sat || 'normal')));
  document.querySelectorAll('[data-vision]').forEach(b => setActive(b, (b as HTMLElement).dataset.vision === p.vision));
  ['cursor','links','mask','guide'].forEach(k => {
    const el = document.getElementById(`rp-toggle-${k}`);
    if (!el) return;
    const val = k === 'cursor' ? p.cursor === 'large' : (p as any)[k] as boolean;
    el.classList.toggle('active', val);
    el.setAttribute('aria-pressed', String(val));
  });
}

// Reading guide follows mouse
let raf = 0;
document.addEventListener('mousemove', e => {
  cancelAnimationFrame(raf);
  raf = requestAnimationFrame(() => {
    document.documentElement.style.setProperty('--rp-mask-y', e.clientY + 'px');
    const guide = document.getElementById('rp-reading-guide');
    if (guide) guide.style.top = e.clientY + 'px';
  });
});

const prefs = load();
apply(prefs);

const fab      = document.getElementById('rp-a11y-fab')!;
const panel    = document.getElementById('rp-a11y-panel')!;
const closeBtn = document.getElementById('rp-a11y-close')!;
const resetBtn = document.getElementById('rp-a11y-reset')!;

const openPanel  = () => { panel.removeAttribute('hidden'); fab.setAttribute('aria-expanded','true'); };
const closePanel = () => { panel.setAttribute('hidden',''); fab.setAttribute('aria-expanded','false'); };

fab.addEventListener('click', () => panel.hasAttribute('hidden') ? openPanel() : closePanel());
closeBtn.addEventListener('click', closePanel);

const btnHandler = (selector: string, key: keyof Prefs, getValue: (el: HTMLElement) => unknown) => {
  document.querySelectorAll<HTMLElement>(selector).forEach(btn => {
    btn.addEventListener('click', () => {
      (prefs as any)[key] = getValue(btn);
      save(prefs); apply(prefs);
    });
  });
};

btnHandler('[data-fs]',     'fs',     el => el.dataset.fs ?? 'normal');
btnHandler('[data-mode]',   'mode',   el => el.dataset.mode ?? 'light');
btnHandler('[data-ls]',     'ls',     el => el.dataset.ls ?? 'normal');
btnHandler('[data-lh]',     'lh',     el => el.dataset.lh ?? '1.6');
btnHandler('[data-font]',   'font',   el => el.dataset.font ?? 'default');
btnHandler('[data-sat]',    'sat',    el => el.dataset.sat ?? 'normal');
btnHandler('[data-vision]', 'vision', el => el.dataset.vision ?? 'none');

document.querySelectorAll<HTMLElement>('[data-toggle]').forEach(btn => {
  btn.addEventListener('click', () => {
    const k = btn.dataset.toggle!;
    if (k === 'cursor') prefs.cursor = prefs.cursor === 'large' ? 'normal' : 'large';
    else (prefs as any)[k] = !(prefs as any)[k];
    save(prefs); apply(prefs);
  });
});

resetBtn.addEventListener('click', () => { Object.assign(prefs, DEFAULTS); save(prefs); apply(prefs); });

document.addEventListener('click', e => {
  const root = document.getElementById('rp-a11y-root');
  if (root && !root.contains(e.target as Node) && !panel.hasAttribute('hidden')) closePanel();
});
document.addEventListener('keydown', e => { if (e.key === 'Escape' && !panel.hasAttribute('hidden')) closePanel(); });
</script>