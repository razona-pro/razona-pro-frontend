---
import { Icon } from 'astro-icon/components';

interface Props { currentPage?: string; }
const { currentPage = 'dashboard' } = Astro.props;

const mainNav = [
  { href: '/dashboard', icon: 'tabler:home', label: 'Inicio', page: 'dashboard' },
];
const studentAccountNav = [
  { href: '/dashboard/history',  icon: 'tabler:history', label: 'Mi historial', page: 'history' },
  { href: '/dashboard/rankings', icon: 'tabler:trophy',  label: 'Rankings',     page: 'rankings' },
];
const sharedAccountNav = [
  { href: '/dashboard/profile', icon: 'tabler:user-circle', label: 'Mi perfil', page: 'profile' },
];
const adminMgmtNav = [
  { href: '/admin/students',    icon: 'tabler:users',            label: 'Estudiantes',     page: 'admin-students' },
  { href: '/admin/tests',       icon: 'tabler:file-description', label: 'Pruebas',         page: 'admin-tests' },
  { href: '/admin/questions',   icon: 'tabler:list-check',       label: 'Preguntas',       page: 'admin-questions' },
  { href: '/admin/competences', icon: 'tabler:brain',            label: 'Competencias',    page: 'admin-competences' },
  { href: '/admin/programs',    icon: 'tabler:school',           label: 'Programas',       page: 'admin-programs' },
  { href: '/admin/admins',      icon: 'tabler:shield-check',     label: 'Administradores', page: 'admin-admins' },
  { href: '/admin/doubts',      icon: 'tabler:message-question', label: 'Dudas',           page: 'admin-doubts' },
];
const adminAnalysisNav = [
  { href: '/admin/trieds',      icon: 'tabler:clipboard-data',   label: 'Intentos',        page: 'admin-trieds' },
  { href: '/admin/stats',       icon: 'tabler:chart-bar',        label: 'Estadísticas',    page: 'admin-stats' },
  { href: '/admin/rankings',    icon: 'tabler:award',            label: 'Rankings',        page: 'admin-rankings' },
  { href: '/admin/ai',          icon: 'tabler:robot',            label: 'Sesiones IA',     page: 'admin-ai' },
];
---

<!-- Modal logout -->
<div id="logout-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9999;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:var(--ui-card);border-radius:18px;padding:2rem 1.75rem;max-width:340px;width:calc(100%-2rem);text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.2);animation:modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both">
    <div style="width:52px;height:52px;border-radius:14px;background:#FEE2E2;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
      <svg width="24" height="24" fill="none" stroke="#DC2626" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
    </div>
    <h3 style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem">¿Cerrar sesión?</h3>
    <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.25rem;line-height:1.55">Se cerrará tu sesión actual en la plataforma.</p>
    <div style="display:flex;gap:8px">
      <button id="logout-cancel" style="flex:1;padding:0.625rem;border-radius:10px;border:1.5px solid var(--ui-border);background:transparent;color:var(--ui-text-1);font-family:inherit;font-weight:600;font-size:0.875rem;cursor:pointer">Cancelar</button>
      <button id="logout-confirm" style="flex:1;padding:0.625rem;border-radius:10px;border:none;background:linear-gradient(135deg,#DC2626,#991B1B);color:white;font-family:inherit;font-weight:700;font-size:0.875rem;cursor:pointer;box-shadow:0 3px 12px rgba(220,38,38,0.3)">Salir</button>
    </div>
  </div>
</div>

<!-- Session expired -->
<div id="session-expired-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;align-items:center;justify-content:center;backdrop-filter:blur(6px)">
  <div style="background:var(--ui-card);border-radius:18px;padding:2rem 1.75rem;max-width:360px;width:calc(100%-2rem);text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.25)">
    <div style="width:52px;height:52px;border-radius:14px;background:#FEF3C7;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
      <svg width="24" height="24" fill="none" stroke="#D97706" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </div>
    <h3 style="font-size:1rem;font-weight:800;color:var(--ui-text-1);margin:0 0 0.5rem">Sesión expirada</h3>
    <p style="font-size:0.875rem;color:var(--ui-text-2);margin:0 0 1.25rem;line-height:1.55">Tu sesión ha expirado. Por favor inicia sesión nuevamente.</p>
    <a href="/auth" style="display:flex;align-items:center;justify-content:center;padding:0.625rem;border-radius:10px;background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:white;font-weight:700;font-size:0.875rem;text-decoration:none">Ir al login</a>
  </div>
</div>

<aside id="rp-sidebar">
  <!-- Logo (limpio, sin botón) -->
  <div class="sb-logo">
    <div class="sb-logo-icon"><Icon name="tabler:brain" size={18} /></div>
    <div class="sb-logo-text">
      <p class="sb-logo-name">Razona<span>Pro</span></p>
      <p class="sb-logo-sub">Preparación Saber Pro</p>
    </div>
  </div>

  <!-- User -->
  <div class="sb-user">
    <div class="sb-avatar" id="sb-avatar">?</div>
    <div class="sb-user-info">
      <p class="sb-user-name" id="sb-name">Cargando...</p>
      <p class="sb-user-sub" id="sb-sub">UFPSO</p>
    </div>
    <a href="/dashboard/profile" class="sb-settings" title="Perfil">
      <Icon name="tabler:user-circle" size={16} />
    </a>
  </div>

  <!-- Nav -->
  <nav class="sb-nav">
    <span class="sb-section">Principal</span>
    {mainNav.map(item => (
      <a id="sb-inicio-link" href={item.href} class:list={['sb-item', currentPage === item.page && 'active']}>
        <Icon name={item.icon} size={16} />
        <span class="sb-label">{item.label}</span>
      </a>
    ))}

    <!-- Solo estudiantes: Tests (con submenú de competencias) + IA -->
    <div id="sb-student-only" style="display:none">

      <!-- Tests: grupo expandible -->
      <div class="sb-group" id="sb-tests-group">
        <button type="button" class:list={['sb-item','sb-group-toggle', currentPage === 'tests' && 'active']}
                id="sb-tests-toggle" aria-expanded="false" aria-controls="sb-competences-list">
          <Icon name="tabler:clipboard-list" size={16} />
          <span class="sb-group-label">Pruebas</span>
          <Icon name="tabler:chevron-right" size={15} class="sb-chevron" />
        </button>
        <div class="sb-submenu" id="sb-tests-submenu">
          <a href="/tests" class="sb-subitem sb-subitem-all">Todas las pruebas</a>
          <div id="sb-competences-list">
            <div class="sb-skeleton"></div>
            <div class="sb-skeleton" style="width:75%"></div>
            <div class="sb-skeleton" style="width:85%"></div>
          </div>
        </div>
      </div>

      <!-- Práctica con IA -->
      <a href="/ai-practice" class:list={['sb-item', currentPage === 'ai-practice' && 'active']}>
        <Icon name="tabler:robot" size={16} />
        <span class="sb-label">Práctica con IA</span>
      </a>
    </div>

    <!-- Mi cuenta -->
    <span class="sb-section">Mi cuenta</span>

    <!-- Historial y Rankings: solo estudiantes -->
    <div id="sb-student-account" style="display:none">
      {studentAccountNav.map(item => (
        <a href={item.href} class:list={['sb-item', currentPage === item.page && 'active']}>
          <Icon name={item.icon} size={16} />
          <span class="sb-label">{item.label}</span>
        </a>
      ))}
    </div>

    <!-- Perfil: todos -->
    {sharedAccountNav.map(item => (
      <a id="sb-profile-link" href={item.href} class:list={['sb-item', currentPage === item.page && 'active']}>
        <Icon name={item.icon} size={16} />
        <span class="sb-label">{item.label}</span>
      </a>
    ))}

    <!-- Admin -->
    <div id="sb-admin-section" style="display:none">
      <span class="sb-section sb-section-admin">Gestión</span>
      {adminMgmtNav.map(item => (
        <a href={item.href} class:list={['sb-item', currentPage === item.page && 'active']}>
          <Icon name={item.icon} size={15} />
          <span class="sb-label">{item.label}</span>
        </a>
      ))}
      <span class="sb-section sb-section-admin">Análisis</span>
      {adminAnalysisNav.map(item => (
        <a href={item.href} class:list={['sb-item', currentPage === item.page && 'active']}>
          <Icon name={item.icon} size={16} />
          <span class="sb-label">{item.label}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- Ayuda (oculta en collapsed) -->
  <div class="sb-footer-links" id="sb-help-wrap">
    <a id="sb-help-link" href="/dashboard/help" class:list={['sb-item', currentPage === 'help' && 'active']}>
      <Icon name="tabler:help-circle" size={18} />
      <span class="sb-label">Ayuda</span>
    </a>
  </div>

  <!-- Botón colapsar - siempre visible (no dentro de sb-footer-links) -->
  <div style="padding:0.1875rem 0.5rem">
    <button id="sb-collapse-btn" class="sb-item" type="button" title="Contraer panel" aria-label="Contraer panel">
      <svg id="sb-collapse-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" style="flex-shrink:0;transition:transform 0.22s ease">
        <path d="M11 19l-7-7 7-7"/><path d="M21 19l-7-7 7-7"/>
      </svg>
      <span class="sb-label">Contraer panel</span>
    </button>
  </div>

  <!-- Logout -->
  <div class="sb-footer">
    <button id="sb-logout" class="sb-item sb-logout" type="button">
      <Icon name="tabler:logout" size={16} />
      <span class="sb-label">Cerrar sesión</span>
    </button>
  </div>
</aside>

<style>
  @keyframes modalIn { from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)} }
  @keyframes shimmer { 0%{background-position:-400px 0}100%{background-position:400px 0} }

  .sb-skeleton {
    height: 30px; border-radius: 9px; width: 100%; margin-bottom: 4px;
    background: linear-gradient(90deg, var(--sidebar-hover-bg) 25%, var(--sidebar-border) 50%, var(--sidebar-hover-bg) 75%);
    background-size: 800px 100%; animation: shimmer 1.5s infinite;
  }
  /* ─── SIDEBAR BASE ──────────────────────────────────── */
  #rp-sidebar {
    width: 232px;
    min-width: 232px;
    background: var(--sidebar-bg);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    border-right: 1px solid var(--sidebar-border);
    flex-shrink: 0;
    /* Solo animar el width - nada más para evitar glitches */
    transition: width 0.22s cubic-bezier(0.4,0,0.2,1),
                min-width 0.22s cubic-bezier(0.4,0,0.2,1),
                transform 0.3s cubic-bezier(0.4,0,0.2,1);
    z-index: 100;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
  }

  /* ─── LABELS: transición suave con max-width ─────────── */
  /* En lugar de display:none (instantáneo), usamos max-width+opacity */
  .sb-label {
    overflow: hidden;
    max-width: 180px;
    white-space: nowrap;
    opacity: 1;
    transition: max-width 0.22s cubic-bezier(0.4,0,0.2,1),
                opacity 0.15s ease;
    flex-shrink: 0;
  }
  /* El resto de elementos que se ocultan: también usan transición */
  .sb-logo-text,
  .sb-user-info,
  .sb-settings,
  .sb-group-label,
  .sb-chevron {
    overflow: hidden;
    max-width: 180px;
    opacity: 1;
    transition: max-width 0.22s cubic-bezier(0.4,0,0.2,1),
                opacity 0.15s ease;
  }
  .sb-section {
    overflow: hidden;
    max-height: 30px;
    opacity: 0.55;
    transition: max-height 0.22s cubic-bezier(0.4,0,0.2,1),
                opacity 0.15s ease;
  }

  /* ─── SIDEBAR COLAPSADO ──────────────────────────────── */
  /* Estado inicial SIN transición (aplicado desde <html> antes del primer paint) */
  html.sb-collapsed #rp-sidebar:not(.sb-ready) {
    width: 58px !important;
    min-width: 58px !important;
    overflow: visible;
    transition: none !important;
  }
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-label,
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-logo-text,
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-user-info,
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-settings,
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-group-label,
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-chevron {
    max-width: 0 !important; opacity: 0 !important; transition: none !important;
  }
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-section {
    max-height: 0 !important; opacity: 0 !important; transition: none !important;
  }
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-submenu,
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-subitem,
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-footer-links { display: none !important; }
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-item { justify-content: center; padding: 0.5rem; gap: 0; }
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-logo { justify-content: center; padding: 0.75rem 0.5rem; gap: 0; }
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-user { justify-content: center; padding: 0.625rem 0.5rem; gap: 0; }
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-avatar { margin: 0; }
  html.sb-collapsed #rp-sidebar:not(.sb-ready) .sb-nav { padding: 0.25rem 0.375rem; }

  /* Estado normal tras inicialización JS (con transiciones) */
  #rp-sidebar.collapsed {
    width: 58px;
    min-width: 58px;
    overflow: visible;       /* para que los tooltips salgan */
  }
  /* Ocultar labels con transición */
  #rp-sidebar.collapsed .sb-label,
  #rp-sidebar.collapsed .sb-logo-text,
  #rp-sidebar.collapsed .sb-user-info,
  #rp-sidebar.collapsed .sb-settings,
  #rp-sidebar.collapsed .sb-group-label,
  #rp-sidebar.collapsed .sb-chevron {
    max-width: 0;
    opacity: 0;
  }
  #rp-sidebar.collapsed .sb-section {
    max-height: 0;
    opacity: 0;
  }
  /* Elementos que no necesitan transición: ocultar directamente */
  #rp-sidebar.collapsed .sb-submenu,
  #rp-sidebar.collapsed .sb-subitem,
  #rp-sidebar.collapsed .sb-footer-links { display: none !important; }

  /* Layout de ítems en collapsed */
  #rp-sidebar.collapsed .sb-item    { justify-content: center; padding: 0.5rem; gap: 0; }
  #rp-sidebar.collapsed .sb-logo    { justify-content: center; padding: 0.75rem 0.5rem; gap: 0; }
  #rp-sidebar.collapsed .sb-user    { justify-content: center; padding: 0.625rem 0.5rem; gap: 0; }
  #rp-sidebar.collapsed .sb-avatar  { margin: 0; }
  #rp-sidebar.collapsed .sb-nav     { padding: 0.25rem 0.375rem; }
  /* Iconos un poco más grandes en collapsed para mejor lectura */
  #rp-sidebar.collapsed .sb-item svg { width: 20px !important; height: 20px !important; }

  /* ─── TOOLTIPS EN COLLAPSED ──────────────────────────── */
  #rp-sidebar.collapsed .sb-item { position: relative; }
  #rp-sidebar.collapsed .sb-item:hover::after {
    content: attr(data-label);
    position: absolute;
    left: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--ui-card);
    border: 1px solid var(--ui-border);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ui-text-1);
    white-space: nowrap;
    z-index: 9999;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    pointer-events: none;
    animation: tooltipIn 0.12s ease;
  }
  @keyframes tooltipIn { from { opacity:0; transform:translateY(-50%) translateX(-4px); } to { opacity:1; transform:translateY(-50%) translateX(0); } }

  /* ─── RESPONSIVE ─────────────────────────────────────── */
  @media (max-width: 1023px) {
    #rp-sidebar { position: fixed; top:0; left:0; bottom:0; transform: translateX(-260px); box-shadow: none; }
    #rp-sidebar.open { transform: translateX(0); box-shadow: 8px 0 40px rgba(0,0,0,0.25); }
    /* En móvil el collapse no aplica */
    #rp-sidebar.collapsed { width: 232px; min-width: 232px; }
    #rp-sidebar.collapsed .sb-label, #rp-sidebar.collapsed .sb-logo-text,
    #rp-sidebar.collapsed .sb-user-info, #rp-sidebar.collapsed .sb-settings,
    #rp-sidebar.collapsed .sb-group-label, #rp-sidebar.collapsed .sb-chevron,
    #rp-sidebar.collapsed .sb-section { max-width: 180px; max-height: 30px; opacity: 1; }
    #rp-sidebar.collapsed .sb-submenu, #rp-sidebar.collapsed .sb-subitem,
    #rp-sidebar.collapsed .sb-footer-links { display: flex !important; }
  }
  .sb-logo { display:flex;align-items:center;gap:0.5rem;padding:0.875rem 0.875rem 0.75rem;border-bottom:1px solid var(--sidebar-border);overflow:hidden; }
  .sb-logo-icon { width:30px;height:30px;background:linear-gradient(135deg,#D41224,#9B1F24);border-radius:8px;display:flex;align-items:center;justify-content:center;color:white;box-shadow:0 3px 10px rgba(212,18,36,0.35);flex-shrink:0; }
  .sb-logo-text { flex:1;min-width:0;overflow:hidden; }
  .sb-logo-name { color:var(--sidebar-hover-txt);font-weight:900;font-size:0.875rem;letter-spacing:-0.3px;margin:0;line-height:1.15; }
  .sb-logo-name span { color:#D41224; }
  .sb-logo-sub { color:var(--sidebar-text);font-size:0.5625rem;margin:0;letter-spacing:0.7px;text-transform:uppercase;opacity:0.65;white-space:nowrap; }
  .sb-user { display:flex;align-items:center;gap:0.5rem;padding:0.625rem 0.875rem;border-bottom:1px solid var(--sidebar-border); }
  .sb-avatar { width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#D41224,#9B1F24);display:flex;align-items:center;justify-content:center;color:white;font-weight:900;font-size:0.75rem;flex-shrink:0; }
  .sb-user-info { flex:1;min-width:0; }
  .sb-user-name { color:var(--sidebar-hover-txt);font-weight:700;font-size:0.8125rem;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:140px; }
  .sb-user-sub  { color:var(--sidebar-text);font-size:0.6875rem;margin:0;opacity:0.6; }
  .sb-settings  { color:var(--sidebar-text);opacity:0.45;text-decoration:none;padding:0.2rem;flex-shrink:0;transition:opacity 0.2s;display:flex;align-items:center; }
  .sb-settings:hover { opacity:0.85; }
  .sb-nav { padding:0.5rem;flex:1; }
  .sb-section { display:block;color:var(--sidebar-text);font-size:0.5625rem;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;padding:0 0.5rem;margin:0.625rem 0 0.1875rem;opacity:0.55; }
  .sb-section-admin { color:var(--brand) !important;opacity:0.65 !important; }
  .sb-item { display:flex;align-items:center;gap:0.625rem;padding:0.4375rem 0.5625rem;color:var(--sidebar-text);font-size:0.8125rem;font-weight:500;border-radius:8px;text-decoration:none;transition:all 0.15s;cursor:pointer;margin-bottom:1px;border:none;background:none;width:100%;text-align:left;font-family:inherit; }
  .sb-item:hover  { background:var(--sidebar-hover-bg);color:var(--sidebar-hover-txt); }
  .sb-item.active { background:var(--sidebar-active-bg);color:var(--sidebar-active-txt);font-weight:600; }
  /* Tamaño de icono ESTÁNDAR y slot fijo: el icono no cambia de tamaño ni salta al contraer */
  .sb-item > svg, .sb-item > .iconify { width:20px !important; height:20px !important; flex-shrink:0; }

  /* ── Grupo Tests con submenú de competencias ── */
  .sb-group { position: relative; }
  .sb-group-toggle .sb-group-label { flex: 1; }
  .sb-chevron { flex-shrink: 0; opacity: 0.7; transition: transform 0.2s ease; }
  .sb-submenu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease;
    margin-left: 0.5rem;
    border-left: 1.5px solid var(--sidebar-border);
    padding-left: 0.375rem;
  }
  .sb-submenu > * { overflow: hidden; min-height: 0; }
  /* Expandido SOLO por click (clase .open). Sin hover para que no se abra/cierre
     solo al mover el cursor por el sidebar. */
  .sb-group.open  .sb-submenu { grid-template-rows: 1fr; }
  .sb-group.open  .sb-chevron { transform: rotate(90deg); }
  .sb-subitem {
    display: flex; align-items: center; gap: 8px;
    padding: 6px 8px; margin-bottom: 1px;
    color: var(--sidebar-text); font-size: 0.75rem; font-weight: 500;
    border-radius: 7px; text-decoration: none; transition: all 0.15s;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .sb-subitem:hover { background: var(--sidebar-hover-bg); color: var(--sidebar-hover-txt); }
  .sb-subitem-all { font-weight: 600; opacity: 0.85; }
  .sb-footer-links { padding:0.5rem 0.5rem 0; }
  .sb-footer { padding:0.5rem;border-top:1px solid var(--sidebar-border); }
  .sb-logout { color:rgba(239,68,68,0.6)!important; }
  .sb-logout:hover { background:rgba(212,18,36,0.08)!important;color:rgba(239,68,68,0.9)!important; }
</style>

<script>
  import { getUser, isAdmin, logout, initSessionWatcher, updateStoredUser, getFullName, getInitials } from '../../lib/auth';
  import { competencesApi } from '../../lib/api/competences.api';
  import { studentsApi }    from '../../lib/api/students.api';
  import { adminsApi }      from '../../lib/api/admins.api';

  // ── Pintar usuario ──────────────────────────────────────────────
  function paintUser() {
  const u = getUser();
  if (!u) return;

  // Nombre completo con los 4 segmentos
  const full     = getFullName(u) || u.id;
  const initials = getInitials(u);
  const avatarEl = document.getElementById('sb-avatar');
  const nameEl   = document.getElementById('sb-name');
  const subEl    = document.getElementById('sb-sub');
  if (avatarEl) avatarEl.textContent = initials;
  if (nameEl)   nameEl.textContent   = full;
  if (subEl)    subEl.textContent    = isAdmin()
    ? 'Administrador'
    : (u.programId ? `Programa ${u.programId}` : 'Estudiante');

  if (isAdmin()) {
    // Admin: solo panel de administración, NO historial/rankings de estudiantes
    document.getElementById('sb-admin-section')?.style.setProperty('display', 'block');
    // Ocultar explícitamente las secciones de estudiante
    document.getElementById('sb-student-only')?.style.setProperty('display', 'none');
    document.getElementById('sb-student-account')?.style.setProperty('display', 'none');
    // Inicio → panel admin; perfil → admin profile
    const inicioLink = document.getElementById('sb-inicio-link') as HTMLAnchorElement | null;
    const profileLink = document.getElementById('sb-profile-link') as HTMLAnchorElement | null;
    const settingsLink = document.querySelector<HTMLAnchorElement>('.sb-settings');
    if (inicioLink) {
      inicioLink.href = '/admin/home';
      // Marcar "Inicio" como activo cuando el admin está en su panel de inicio
      if (window.location.pathname.startsWith('/admin/home')) inicioLink.classList.add('active');
    }
    if (profileLink) profileLink.href = '/admin/profile';
    if (settingsLink) settingsLink.href = '/admin/profile';
    // Ayuda → versión admin
    const helpLink = document.getElementById('sb-help-link') as HTMLAnchorElement | null;
    if (helpLink) helpLink.href = '/admin/help';
  } else {
    // Estudiante: Tests (con submenú de competencias), IA, historial, rankings
    document.getElementById('sb-student-only')?.style.setProperty('display', 'block');
    document.getElementById('sb-student-account')?.style.setProperty('display', 'block');
    document.getElementById('sb-admin-section')?.style.setProperty('display', 'none');
  }
}

  // ── Toggle del grupo "Pruebas" (click) - el hover lo maneja el CSS ──
  (function initTestsGroup() {
    const group  = document.getElementById('sb-tests-group');
    const toggle = document.getElementById('sb-tests-toggle');
    if (!group || !toggle) return;
    const path = window.location.pathname;
    const isTestsRoute = path.startsWith('/tests');
    // Abierto y activo si estamos en cualquier subruta de pruebas
    if (isTestsRoute) {
      group.classList.add('open');
      toggle.classList.add('active');
      toggle.setAttribute('aria-expanded', 'true');
    }
    // Marcar "Todas las pruebas" como activa si estamos en /tests exacto
    const allLink = group.querySelector<HTMLElement>('.sb-subitem-all');
    if (allLink && (path === '/tests' || path === '/tests/')) {
      allLink.style.background = 'var(--sidebar-active-bg)';
      allLink.style.color = 'var(--sidebar-active-txt)';
      allLink.style.fontWeight = '600';
    }
    toggle.addEventListener('click', () => {
      const open = group.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();

  paintUser();

  // Escuchar actualización de datos de usuario
  window.addEventListener('rp:user-updated', () => paintUser());

  // ── Cargar nombre real desde API ──────────────────────────────
  const u = getUser();
  if (u && !u.firstName) {
    if (isAdmin()) {
      adminsApi.me().then(res => {
        if (res.data) {
          updateStoredUser({
            firstName: res.data.firstName, secondName: res.data.secondName,
            firstSurname: res.data.firstSurname, secondSurname: res.data.secondSurname,
            email: res.data.email,
          });
          paintUser();
        }
      }).catch(() => {});
    } else {
      studentsApi.me().then(res => {
        if (res.data) {
          updateStoredUser({
            firstName: res.data.firstName, secondName: res.data.secondName,
            firstSurname: res.data.firstSurname, secondSurname: res.data.secondSurname,
            email: res.data.email,
          });
          paintUser();
        }
      }).catch(() => {});
    }
  }

  // ── Competencias dinámicas (solo estudiantes) ─────────────────
  if (!isAdmin()) {
    const COMP_KEYWORDS: [string, { color: string; key: string }][] = [
      ['lectura',   { color: '#D41224', key: 'lc' }],
      ['cuantit',   { color: '#2563EB', key: 'rq' }],
      ['razon',     { color: '#2563EB', key: 'rq' }],
      ['ciudadan',  { color: '#059669', key: 'cc' }],
      ['escrit',    { color: '#7C3AED', key: 'ce' }],
      ['comunicac', { color: '#7C3AED', key: 'ce' }],
      ['ingl',      { color: '#D97706', key: 'en' }],
    ];
    function getCompColor(name: string) {
      const n = name.toLowerCase();
      for (const [kw, s] of COMP_KEYWORDS) { if (n.includes(kw)) return s; }
      return { color: '#6B7280', key: '' };
    }

    competencesApi.findAll(true).then(res => {
      const listEl = document.getElementById('sb-competences-list');
      if (!listEl || !res.data?.length) return;
      listEl.innerHTML = '';
      res.data.forEach(comp => {
        const s    = getCompColor(comp.competenceName);
        const href = s.key ? `/tests/${s.key}` : '/tests';
        const a    = document.createElement('a');
        a.href = href;
        const isActive = window.location.pathname.startsWith(href);
        a.style.cssText = `display:flex;align-items:center;gap:9px;padding:9px 10px;color:var(--sidebar-text);font-size:0.8125rem;font-weight:500;border-radius:9px;text-decoration:none;transition:all 0.15s;cursor:pointer;margin-bottom:1px;width:100%;${isActive ? 'background:var(--sidebar-active-bg);color:var(--sidebar-active-txt);font-weight:600;' : ''}`;
        const dot = document.createElement('span');
        dot.style.cssText = `width:7px;height:7px;border-radius:50%;background:${s.color};flex-shrink:0;display:inline-block;`;
        const label = document.createElement('span');
        label.textContent = comp.competenceName;
        label.style.cssText = 'white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:0.8125rem;';
        a.appendChild(dot); a.appendChild(label);
        a.addEventListener('mouseenter', () => { if (!isActive) { a.style.background='var(--sidebar-hover-bg)'; a.style.color='var(--sidebar-hover-txt)'; } });
        a.addEventListener('mouseleave', () => { if (!isActive) { a.style.background=''; a.style.color='var(--sidebar-text)'; } });
        listEl.appendChild(a);
      });
    }).catch(() => {
      const listEl = document.getElementById('sb-competences-list');
      if (listEl) listEl.innerHTML = '<p style="font-size:0.75rem;color:var(--ui-text-3);padding:0 0.625rem;opacity:0.5">No disponible</p>';
    });
  }

  // ── Collapse / expand sidebar ─────────────────────────────────
  (function initCollapse() {
    const sidebar = document.getElementById('rp-sidebar')!;
    const btn     = document.getElementById('sb-collapse-btn')!;
    const icon    = document.getElementById('sb-collapse-icon') as SVGElement | null;

    function applyCollapsed(collapsed: boolean) {
      sidebar.classList.toggle('collapsed', collapsed);
      document.documentElement.classList.toggle('sb-collapsed', collapsed);
      if (icon) icon.style.transform = collapsed ? 'rotate(180deg)' : 'rotate(0deg)';
    }

    // Aplicar el estado guardado (el CSS en html.sb-collapsed ya lo colapsó sin flash)
    const savedCollapsed = localStorage.getItem('rp_sb_collapsed') === '1';
    applyCollapsed(savedCollapsed);
    // Marcar como ready: activa transiciones para futuros toggles
    sidebar.classList.add('sb-ready');

    btn.addEventListener('click', () => {
      const collapsed = !sidebar.classList.contains('collapsed');
      applyCollapsed(collapsed);
      localStorage.setItem('rp_sb_collapsed', collapsed ? '1' : '0');
    });

    // Añadir data-label a todos los sb-item para los tooltips
    sidebar.querySelectorAll<HTMLElement>('.sb-item').forEach(item => {
      if (!item.dataset.label) {
        // Usar solo el texto de sb-label si existe, sino todo el texto
        const label = item.querySelector<HTMLElement>('.sb-label, .sb-group-label');
        item.dataset.label = (label?.textContent ?? item.textContent)?.trim().replace(/\s+/g,' ') ?? '';
      }
    });
  })();

  // ── Logout con modal ──────────────────────────────────────────
  const logoutModal  = document.getElementById('logout-modal')!;
  const logoutCancel = document.getElementById('logout-cancel')!;
  const logoutConfirm = document.getElementById('logout-confirm')!;

  document.getElementById('sb-logout')?.addEventListener('click', () => { logoutModal.style.display='flex'; });
  logoutCancel?.addEventListener('click', () => { logoutModal.style.display='none'; });
  logoutConfirm?.addEventListener('click', () => {
    logoutModal.style.display='none';
    logout();
  });
  logoutModal?.addEventListener('click', e => { if (e.target===logoutModal) logoutModal.style.display='none'; });

  // ── Session watcher ───────────────────────────────────────────
  const expiredModal = document.getElementById('session-expired-modal')!;
  initSessionWatcher(() => { expiredModal.style.display='flex'; });

  // ── Mobile sidebar ────────────────────────────────────────────
  (window as any).__closeSidebar = () => {
    document.getElementById('rp-sidebar')?.classList.remove('open');
    document.getElementById('sidebar-overlay')?.classList.remove('visible');
    document.body.style.overflow = '';
  };
  (window as any).__openSidebar = () => {
    document.getElementById('rp-sidebar')?.classList.add('open');
    document.getElementById('sidebar-overlay')?.classList.add('visible');
    document.body.style.overflow = 'hidden';
  };
</script>