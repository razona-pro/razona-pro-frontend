---
import { Icon } from 'astro-icon/components';

interface Props {
  currentPage?: string;
}
const { currentPage = 'dashboard' } = Astro.props;

// Datos correctos y consistentes
const mainNav = [
  { href: '/dashboard',      icon: 'tabler:home',           label: 'Inicio',           page: 'dashboard' },
  { href: '/tests',          icon: 'tabler:clipboard-list', label: 'Tests',            page: 'tests' },
  { href: '/ai-practice',    icon: 'tabler:robot',          label: 'Práctica con IA',  page: 'ai-practice' },
];

const accountNav = [
  { href: '/dashboard/history',  icon: 'tabler:history',      label: 'Mi historial', page: 'history' },
  { href: '/dashboard/rankings', icon: 'tabler:trophy',       label: 'Rankings',    page: 'rankings' },
  { href: '/dashboard/profile',  icon: 'tabler:user-circle',  label: 'Mi perfil',   page: 'profile' },
];

const competences = [
  { key: 'lc', label: 'Lectura Crítica',        color: '#D41224' },
  { key: 'rq', label: 'Razon. Cuantitativo',    color: '#2563EB' },
  { key: 'cc', label: 'Comp. Ciudadanas',       color: '#059669' },
  { key: 'ce', label: 'Comunicación Escrita',   color: '#7C3AED' },
  { key: 'en', label: 'Inglés',                 color: '#D97706' },
];

const adminNav = [
  { href: '/admin/students',  icon: 'tabler:users',            label: 'Estudiantes',  page: 'admin-students' },
  { href: '/admin/tests',     icon: 'tabler:file-description', label: 'Tests',        page: 'admin-tests' },
  { href: '/admin/questions', icon: 'tabler:list-check',       label: 'Preguntas',    page: 'admin-questions' },
  { href: '/admin/programs',  icon: 'tabler:school',           label: 'Programas',    page: 'admin-programs' },
  { href: '/admin/rankings',  icon: 'tabler:award',            label: 'Rankings',     page: 'admin-rankings' },
];
---

<aside id="rp-sidebar">
  <!-- Logo -->
  <div class="sb-logo">
    <div class="sb-logo-icon">
      <Icon name="tabler:brain" size={20} />
    </div>
    <div>
      <p class="sb-logo-name">Razona<span>Pro</span></p>
      <p class="sb-logo-sub">Saber Pro · UFPSO</p>
    </div>
  </div>

  <!-- User -->
  <div class="sb-user">
    <div class="sb-avatar" id="sb-avatar">?</div>
    <div class="sb-user-info">
      <p class="sb-user-name" id="sb-name">Cargando...</p>
      <p class="sb-user-sub" id="sb-sub">UFPSO</p>
    </div>
    <a href="/dashboard/profile" class="sb-settings" title="Perfil">
      <Icon name="tabler:settings" size={15} />
    </a>
  </div>

  <!-- Nav -->
  <nav class="sb-nav">
    <span class="sb-section">Principal</span>
    {
      mainNav.map(item => (
        <a
          href={item.href}
          class:list={['sb-item', currentPage === item.page && 'active']}
          onclick="window.__closeSidebar && window.__closeSidebar()"
        >
          <Icon name={item.icon} size={16} />
          {item.label}
        </a>
      ))
    }

    <span class="sb-section">Competencias</span>
    {
      competences.map(c => (
        <a
          href={`/tests?c=${c.key}`}
          class:list={['sb-item sb-comp', currentPage === `comp-${c.key}` && 'active']}
          onclick="window.__closeSidebar && window.__closeSidebar()"
        >
          <span class="sb-dot" style={`background:${c.color}`}></span>
          {c.label}
        </a>
      ))
    }

    <span class="sb-section">Mi cuenta</span>
    {
      accountNav.map(item => (
        <a
          href={item.href}
          class:list={['sb-item', currentPage === item.page && 'active']}
          onclick="window.__closeSidebar && window.__closeSidebar()"
        >
          <Icon name={item.icon} size={16} />
          {item.label}
        </a>
      ))
    }

    <!-- Admin section — shown via JS if admin -->
    <div id="sb-admin-section" style="display:none">
      <span class="sb-section" style="color:rgba(212,18,36,0.5)">Administración</span>
      {
        adminNav.map(item => (
          <a
            href={item.href}
            class:list={['sb-item', currentPage === item.page && 'active']}
            onclick="window.__closeSidebar && window.__closeSidebar()"
          >
            <Icon name={item.icon} size={16} />
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>

  <!-- Logout -->
  <div class="sb-footer">
    <button id="sb-logout" class="sb-item sb-logout">
      <Icon name="tabler:logout" size={16} />
      Cerrar sesión
    </button>
  </div>
</aside>

<style>
  #rp-sidebar {
    width: 244px;
    min-width: 244px;
    background: var(--sidebar-bg);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    border-right: 1px solid var(--sidebar-border);
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 100;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
  }

  @media (max-width: 1023px) {
    #rp-sidebar {
      position: fixed;
      top: 0; left: 0; bottom: 0;
      transform: translateX(-260px);
      box-shadow: none;
    }
    #rp-sidebar.open {
      transform: translateX(0);
      box-shadow: 8px 0 40px rgba(0,0,0,0.25);
    }
  }

  /* Logo */
  .sb-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1.25rem 1rem 1rem;
    border-bottom: 1px solid var(--sidebar-border);
  }
  .sb-logo-icon {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, #D41224, #9B1F24);
    border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    color: white;
    box-shadow: 0 4px 12px rgba(212,18,36,0.35);
    flex-shrink: 0;
  }
  .sb-logo-name {
    color: var(--sidebar-hover-txt);
    font-weight: 900; font-size: 0.9375rem;
    letter-spacing: -0.4px; margin: 0; line-height: 1.1;
  }
  .sb-logo-name span { color: #D41224; }
  .sb-logo-sub {
    color: var(--sidebar-text);
    font-size: 0.625rem; margin: 0;
    letter-spacing: 0.9px; text-transform: uppercase;
    opacity: 0.5;
  }

  /* User */
  .sb-user {
    display: flex; align-items: center; gap: 0.625rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--sidebar-border);
  }
  .sb-avatar {
    width: 38px; height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, #D41224, #9B1F24);
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 900; font-size: 0.875rem;
    flex-shrink: 0;
  }
  .sb-user-info { flex: 1; min-width: 0; }
  .sb-user-name {
    color: var(--sidebar-hover-txt);
    font-weight: 700; font-size: 0.8125rem;
    margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .sb-user-sub {
    color: var(--sidebar-text);
    font-size: 0.6875rem; margin: 0; opacity: 0.5;
  }
  .sb-settings {
    color: var(--sidebar-text);
    opacity: 0.4; text-decoration: none;
    padding: 0.25rem; flex-shrink: 0;
    transition: opacity 0.2s;
    display: flex; align-items: center;
  }
  .sb-settings:hover { opacity: 0.8; }

  /* Nav */
  .sb-nav { padding: 0.625rem; flex: 1; }
  .sb-section {
    display: block;
    color: var(--sidebar-text);
    font-size: 0.625rem; font-weight: 700;
    letter-spacing: 0.9px; text-transform: uppercase;
    padding: 0 0.625rem;
    margin: 0.875rem 0 0.3125rem;
    opacity: 0.35;
  }

  .sb-item {
    display: flex; align-items: center; gap: 0.5625rem;
    padding: 0.5625rem 0.625rem;
    color: var(--sidebar-text);
    font-size: 0.875rem; font-weight: 500;
    border-radius: 9px; text-decoration: none;
    transition: all 0.15s;
    cursor: pointer; margin-bottom: 1px;
    border: none; background: none; width: 100%;
    text-align: left; font-family: inherit;
  }
  .sb-item:hover  { background: var(--sidebar-hover-bg); color: var(--sidebar-hover-txt); }
  .sb-item.active { background: var(--sidebar-active-bg); color: var(--sidebar-active-txt); font-weight: 600; }

  .sb-comp { padding-left: 0.625rem; }
  .sb-dot {
    width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
  }

  /* Footer */
  .sb-footer {
    padding: 0.625rem;
    border-top: 1px solid var(--sidebar-border);
  }
  .sb-logout { color: rgba(239, 68, 68, 0.5) !important; }
  .sb-logout:hover {
    background: rgba(212,18,36,0.08) !important;
    color: rgba(239,68,68,0.85) !important;
  }
</style>

<script>
  import { getUser, isAdmin, logout } from '../../lib/auth';

  const user = getUser();
  if (user) {
    const initials = ((user.firstName[0] ?? '') + (user.firstSurname[0] ?? '')).toUpperCase();
    const fullName = user.firstSurname ? `${user.firstName} ${user.firstSurname}` : user.firstName;

    const avatarEl = document.getElementById('sb-avatar');
    const nameEl   = document.getElementById('sb-name');
    const subEl    = document.getElementById('sb-sub');

    if (avatarEl) avatarEl.textContent = initials;
    if (nameEl)   nameEl.textContent = fullName;
    if (subEl)    subEl.textContent = isAdmin() ? 'Administrador · UFPSO' : (user.programId ?? 'Estudiante · UFPSO');

    if (isAdmin()) {
      const adminSection = document.getElementById('sb-admin-section');
      if (adminSection) adminSection.style.display = 'block';
    }
  }

  document.getElementById('sb-logout')?.addEventListener('click', logout);
</script>