---
import { Icon } from 'astro-icon/components';
import AccessibilityWidget from '../components/layout/AccessibilityWidget.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RazonaPro',
  description = 'Plataforma de preparación académica Saber Pro — UFPSO',
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · RazonaPro</title>

    <!-- Anti-FOUC: apply saved a11y prefs before first paint -->
    <script is:inline>
      (function () {
        try {
          var p = JSON.parse(localStorage.getItem('rp-a11y') || '{}');
          var h = document.documentElement;
          if (p.fs) h.setAttribute('data-fs', p.fs);
          var modes = { dark: 'dark', 'high-contrast': 'high-contrast', inverted: 'contrast-inverted', 'contrast-light': 'contrast-light', 'contrast-dark': 'contrast-dark' };
          if (modes[p.mode]) h.classList.add(modes[p.mode]);
          if (p.ls && p.ls !== 'normal') h.setAttribute('data-ls', p.ls);
          if (p.lh) h.setAttribute('data-lh', p.lh);
          if (p.font && p.font !== 'default') {
            h.setAttribute('data-font', p.font);
            var urls = { dyslexia: 'https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@400;500;600;700&display=swap', legible: 'https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,700;1,400&display=swap' };
            if (urls[p.font]) { var l = document.createElement('link'); l.rel = 'stylesheet'; l.href = urls[p.font]; document.head.appendChild(l); }
          }
          if (p.align && p.align !== 'left') h.setAttribute('data-align', p.align);
          if (p.cursor === 'large') h.classList.add('cursor-large');
          if (p.links) h.classList.add('highlight-links');
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col antialiased">
    <slot />
    <AccessibilityWidget />
  </body>
</html>