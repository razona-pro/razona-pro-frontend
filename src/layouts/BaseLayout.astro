---
import '../styles/global.css';
import AccessibilityWidget from '../components/layout/AccessibilityWidget.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RazonaPro',
  description = 'Plataforma de preparación académica Saber Pro — UFPSO',
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · RazonaPro</title>

    <script is:inline>
      (function () {
        try {
          var p = JSON.parse(localStorage.getItem('rp-a11y') || '{}');
          // Migrar: 'legible' y 'lora' → 'default' (Lora es la predeterminada)
          if (p.font === 'legible' || p.font === 'lora') { p.font = 'default'; localStorage.setItem('rp-a11y', JSON.stringify(p)); }
          var h = document.documentElement;
          if (p.fs) h.setAttribute('data-fs', p.fs);
          var modes = { dark: 'dark', 'high-contrast': 'high-contrast', inverted: 'contrast-inverted', 'contrast-light': 'contrast-light', 'contrast-dark': 'contrast-dark' };
          if (modes[p.mode]) h.classList.add(modes[p.mode]);
          if (p.ls && p.ls !== 'normal') h.setAttribute('data-ls', p.ls);
          if (p.lh) h.setAttribute('data-lh', p.lh);
          if (p.font && p.font !== 'default') {
            h.setAttribute('data-font', p.font);
            if (p.font === 'dyslexia') {
              var l = document.createElement('link'); l.rel = 'stylesheet';
              l.href = 'https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@400;500;600;700&display=swap';
              document.head.appendChild(l);
            }
          }
          if (p.align && p.align !== 'left') h.setAttribute('data-align', p.align);
          if (p.cursor === 'large') h.classList.add('cursor-large');
          if (p.links) h.classList.add('highlight-links');
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col antialiased">

    <!-- Global async loading overlay -->
    <div id="rp-global-loader" role="status" aria-label="Procesando" aria-live="polite">
      <div class="rp-loader-card">
        <div class="rp-loader-ring"></div>
        <p id="rp-loader-msg" class="rp-loader-text">Procesando...</p>
      </div>
    </div>

    <slot />
    <AccessibilityWidget />

    <script is:inline>
      window.rpLoader = {
        show: function(msg) {
          var el  = document.getElementById('rp-global-loader');
          var txt = document.getElementById('rp-loader-msg');
          if (txt) txt.textContent = msg || 'Procesando...';
          if (el) el.classList.add('active');
          document.body.style.overflow = 'hidden';
        },
        hide: function() {
          var el = document.getElementById('rp-global-loader');
          if (el) el.classList.remove('active');
          document.body.style.overflow = '';
        }
      };
    </script>
  </body>
</html>